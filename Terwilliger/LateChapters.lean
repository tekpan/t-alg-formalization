/-- **Lemma 33.2 (i), pointwise form.**  `E*_1 A_i E*_j ∈ Rspan`. -/
theorem Fe_A_estar_mem {Y : DRGData G x D} (hG : G.Connected)
    (hbi : IntersectionNumbersIndependent G) (hθ : Function.Injective Y.thetaStar)
    (hDall : ∀ a b : X, G.dist a b ≤ D) (i j : ℕ) :
    Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x j ∈ Rspan Y := by
  set R : Submodule ℂ (Matrix X X ℂ) := Rspan Y with hR
  have hFM : ∀ i : ℕ, Y.Fe * distMatrix (𝕜 := ℂ) G i ∈ R := fun i =>
    hR ▸ le_Rspan_1 (leftMulSpan_mem (distMatrix_mem_boseMesner (x := x) hG Y.drg hbi i))
  have hFJ : ∀ j : ℕ, Y.Fe * Y.Jm * subconst (𝕜 := ℂ) G x j ∈ R := fun j =>
    hR ▸ le_Rspan_2 (leftMulSpan_mem (subconst_mem_NbSub G x j))
  have hFE : ∀ j : ℕ, Y.Fe * Y.E1m * subconst (𝕜 := ℂ) G x j ∈ R := fun j =>
    hR ▸ le_Rspan_3 (leftMulSpan_mem (subconst_mem_NbSub G x j))
  have hOne : Y.Fe ∈ R := by
    have h := hFM 0
    rwa [distMatrix_zero (𝕜 := ℂ) G hG, mul_one] at h
  have hz01 : Y.Fe * distMatrix (𝕜 := ℂ) G 0 * subconst (𝕜 := ℂ) G x 1 = Y.Fe := by
    simp only [Fe]
    rw [distMatrix_zero (𝕜 := ℂ) G hG, mul_one, subconst_mul_subconst, if_pos rfl]
  have hz00 : Y.Fe * distMatrix (𝕜 := ℂ) G 0 * subconst (𝕜 := ℂ) G x 0 = 0 := by
    simp only [Fe]
    rw [distMatrix_zero (𝕜 := ℂ) G hG, mul_one, subconst_mul_subconst, if_neg (by norm_num)]
  have hAone := Fe_A_one_mul_subconst_zero (Y := Y) hG hDall
  have key : ∀ n : ℕ, ∀ i j : ℕ, i + j ≤ n →
      Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x j ∈ R := by
    intro n
    induction n with
    | zero =>
      intro i j hij
      have hi : i = 0 := by omega
      have hj : j = 0 := by omega
      rw [hi, hj, hz00]
      exact Submodule.zero_mem R
    | succ n ih =>
      intro i j hij
      by_cases hdi : D < i
      · rw [distMatrix_eq_zero_of_lt hDall hdi]
        simp
      by_cases hdj : D < j
      · rw [subconst_eq_zero_of_lt (x := x) Y.diam hdj, mul_zero]
        exact Submodule.zero_mem R
      by_cases hband : j + 1 < i ∨ i + 1 < j
      · rw [Fe_A_estar_eq_zero hG hband]
        exact Submodule.zero_mem R
      rcases Nat.lt_or_ge i j with hlt | hge
      · have hjeq : j = i + 1 := by omega
        rw [hjeq]
        by_cases hi0 : i = 0
        · subst hi0
          simp only [Nat.zero_add]
          rw [hz01]
          exact hOne
        · have hdec := Fe_mul_A_eq_three (Y := Y) hG Y.diam (i := i) (by omega) (by omega)
          have hgoal : Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x (i + 1)
              = Y.Fe * distMatrix (𝕜 := ℂ) G i
                - Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x (i - 1)
                - Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x i := by
            calc Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x (i + 1)
                = (Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x (i - 1)
                    + Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x i
                    + Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x (i + 1))
                  - Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x (i - 1)
                  - Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x i := by abel
              _ = Y.Fe * distMatrix (𝕜 := ℂ) G i
                  - Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x (i - 1)
                  - Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x i := by
                rw [← hdec]
          rw [hgoal]
          exact Submodule.sub_mem _ (Submodule.sub_mem _ (hFM i) (ih i (i - 1) (by omega)))
            (ih i i (by omega))
      · have hji : j ≤ i := hge
        by_cases hj0 : j = 0
        · subst hj0
          have hi2 : i ≤ 1 := by omega
          rcases Nat.eq_zero_or_pos i with hi0 | hipos
          · rw [hi0, hz00]
            exact Submodule.zero_mem R
          · have hi1 : i = 1 := by omega
            rw [hi1, hAone]
            exact hFJ 0
        · have hj1 : 1 ≤ j := by omega
          have hJ := Fe_mul_Jm_eq_three (Y := Y) hG hDall (j := j) hj1 (by omega)
          have hE := Fe_mul_E1m_eq_three (Y := Y) hG hDall (j := j) hj1 (by omega)
          have hP : Y.Fe * distMatrix (𝕜 := ℂ) G (j - 1) * subconst (𝕜 := ℂ) G x j ∈ R :=
            ih (j - 1) j (by omega)
          have hC0 : Y.Fe * Y.Jm * subconst (𝕜 := ℂ) G x j
              - Y.Fe * distMatrix (𝕜 := ℂ) G (j - 1) * subconst (𝕜 := ℂ) G x j ∈ R :=
            Submodule.sub_mem _ (hFJ j) hP
          have hC1 : Y.Fe * Y.E1m * subconst (𝕜 := ℂ) G x j
              - Y.thetaNat (j - 1) • (Y.Fe * distMatrix (𝕜 := ℂ) G (j - 1)
                * subconst (𝕜 := ℂ) G x j) ∈ R :=
            Submodule.sub_mem _ (hFE j) (Submodule.smul_mem _ _ hP)
          have hYmem : Y.Fe * distMatrix (𝕜 := ℂ) G (j + 1) * subconst (𝕜 := ℂ) G x j ∈ R := by
            by_cases hjD : j + 1 ≤ D
            · have hne : Y.thetaNat (j + 1) - Y.thetaNat j ≠ 0 := by
                intro hcon
                have heq : Y.thetaNat (j + 1) = Y.thetaNat j := by
                  linear_combination hcon
                have := thetaNat_injective hθ hjD (by omega) heq
                omega
              have hEq : (Y.thetaNat (j + 1) - Y.thetaNat j)
                  • (Y.Fe * distMatrix (𝕜 := ℂ) G (j + 1) * subconst (𝕜 := ℂ) G x j)
                  = (Y.Fe * Y.E1m * subconst (𝕜 := ℂ) G x j
                      - Y.thetaNat (j - 1) • (Y.Fe * distMatrix (𝕜 := ℂ) G (j - 1)
                        * subconst (𝕜 := ℂ) G x j))
                    - Y.thetaNat j • (Y.Fe * Y.Jm * subconst (𝕜 := ℂ) G x j
                      - Y.Fe * distMatrix (𝕜 := ℂ) G (j - 1)
                        * subconst (𝕜 := ℂ) G x j) := by
                rw [hE, hJ]
                module
              have hYval : Y.Fe * distMatrix (𝕜 := ℂ) G (j + 1) * subconst (𝕜 := ℂ) G x j
                  = (Y.thetaNat (j + 1) - Y.thetaNat j)⁻¹
                    • ((Y.Fe * Y.E1m * subconst (𝕜 := ℂ) G x j
                        - Y.thetaNat (j - 1) • (Y.Fe * distMatrix (𝕜 := ℂ) G (j - 1)
                          * subconst (𝕜 := ℂ) G x j))
                      - Y.thetaNat j • (Y.Fe * Y.Jm * subconst (𝕜 := ℂ) G x j
                        - Y.Fe * distMatrix (𝕜 := ℂ) G (j - 1)
                          * subconst (𝕜 := ℂ) G x j)) := by
                rw [← hEq, smul_smul, inv_mul_cancel₀ hne, one_smul]
              rw [hYval]
              exact Submodule.smul_mem _ _ (Submodule.sub_mem _ hC1 (Submodule.smul_mem _ _ hC0))
            · rw [distMatrix_eq_zero_of_lt hDall (by omega)]
              simp
          have hXmem : Y.Fe * distMatrix (𝕜 := ℂ) G j * subconst (𝕜 := ℂ) G x j ∈ R := by
            have hval : Y.Fe * distMatrix (𝕜 := ℂ) G j * subconst (𝕜 := ℂ) G x j
                = Y.Fe * Y.Jm * subconst (𝕜 := ℂ) G x j
                  - Y.Fe * distMatrix (𝕜 := ℂ) G (j - 1) * subconst (𝕜 := ℂ) G x j
                  - Y.Fe * distMatrix (𝕜 := ℂ) G (j + 1) * subconst (𝕜 := ℂ) G x j := by
              rw [hJ]; abel
            rw [hval]
            exact Submodule.sub_mem _ hC0 hYmem
          rcases Nat.eq_or_lt_of_le hji with heq | hlt'
          · rw [← heq]
            exact hXmem
          · have hieq : i = j + 1 := by omega
            rw [hieq]
            exact hYmem
  exact key (i + j) i j (le_refl _)

