/-! ## Chapter 29: the tridiagonal pair theorem -/

/-! ## Chapter 29: the tridiagonal pair theorem -/

/-! ### Machinery for Theorem 29.1

The proof below follows lecture 29: the block algebra `E i * A^j * W * E k = θᵢ^j θₖ^k ⬝ ...`
reduces both relations to scalar equations; the coefficients are the notes' explicit
`(beta)`, `(gamma1)`, `(delta)`; and sandwiching the `A`-side relation between `E*₃ = F 3`
and `E*₀ = F 0` (the notes' Claim 5) shows that the parameter `β` is *forced* by the dual
spectrum, so that the same `β` serves both relations. -/

section TridiagonalPair

variable {𝕜 : Type*} [Field 𝕜] {n : ℕ}

set_option maxHeartbeats 400000 in
/-! ## 1. Block algebra: powers of `A` against the idempotent decomposition -/

section Block

variable {A Astar : Matrix (Fin n) (Fin n) 𝕜} {E : Fin 4 → Matrix (Fin n) (Fin n) 𝕜}
  {θ : Fin 4 → 𝕜}

/-- `E i * A = θ i • E i`. -/
lemma tp_mul_eq_smul_of_idem (hE : ∀ i j, E i * E j = if i = j then E i else 0)
    (hA : A = ∑ i, θ i • E i) (i : Fin 4) : E i * A = θ i • E i := by
  rw [hA, Finset.mul_sum, Finset.sum_eq_single i]
  · rw [Matrix.mul_smul, hE i i, if_pos rfl]
  · intro k _ hk
    rw [Matrix.mul_smul, hE i k, if_neg (Ne.symm hk), smul_zero]
  · intro h
    exact absurd (Finset.mem_univ i) h

/-- `A * E i = θ i • E i`. -/
lemma tp_smul_mul_eq_of_idem (hE : ∀ i j, E i * E j = if i = j then E i else 0)
    (hA : A = ∑ i, θ i • E i) (i : Fin 4) : A * E i = θ i • E i := by
  rw [hA, Finset.sum_mul, Finset.sum_eq_single i]
  · rw [Matrix.smul_mul, hE i i, if_pos rfl]
  · intro k _ hk
    rw [Matrix.smul_mul, hE k i, if_neg hk, smul_zero]
  · intro h
    exact absurd (Finset.mem_univ i) h

/-- `E i * (A^j * W) * E k = θᵢ^j • (E i * W * E k)`. -/
lemma tp_block_left (i k : Fin 4) (j : ℕ) (W : Matrix (Fin n) (Fin n) 𝕜)
    (hE : ∀ i j, E i * E j = if i = j then E i else 0) (hA : A = ∑ i, θ i • E i) :
    E i * (A ^ j * W) * E k = (θ i) ^ j • (E i * W * E k) := by
  induction j with
  | zero => simp
  | succ j ih =>
      rw [pow_succ', mul_assoc A (A ^ j) W, ← mul_assoc (E i) A (A ^ j * W),
        tp_mul_eq_smul_of_idem hE hA i, Matrix.smul_mul, Matrix.smul_mul, ih, smul_smul, pow_succ']

/-- `E i * (W * A^j) * E k = θₖ^j • (E i * W * E k)`. -/
lemma tp_block_right (i k : Fin 4) (j : ℕ) (W : Matrix (Fin n) (Fin n) 𝕜)
    (hE : ∀ i j, E i * E j = if i = j then E i else 0) (hA : A = ∑ i, θ i • E i) :
    E i * (W * A ^ j) * E k = (θ k) ^ j • (E i * W * E k) := by
  induction j with
  | zero => simp
  | succ j ih =>
      rw [pow_succ, ← mul_assoc W (A ^ j) A, ← mul_assoc (E i) (W * A ^ j) A,
        mul_assoc (E i * (W * A ^ j)) A (E k), tp_smul_mul_eq_of_idem hE hA k, Matrix.mul_smul, ih,
        smul_smul, pow_succ']

/-- Sandwiching a difference. -/
lemma tp_block_sub (i k : Fin 4) (X Y : Matrix (Fin n) (Fin n) 𝕜) :
    E i * (X - Y) * E k = E i * X * E k - E i * Y * E k := by
  rw [mul_sub, sub_mul]

/-- Sandwiching a scalar multiple. -/
lemma tp_block_smul (i k : Fin 4) (c : 𝕜) (X : Matrix (Fin n) (Fin n) 𝕜) :
    E i * (c • X) * E k = c • (E i * X * E k) := by
  rw [Matrix.mul_smul, Matrix.smul_mul]

/-- The notes' bookkeeping `E i * A^j * A* * A^k * E ℓ = θᵢ^j θ_ℓ^k • (E i * A* * E ℓ)`, in the
form of the whole `A`-side expression of the tridiagonal relation sandwiched between two blocks. -/
lemma tp_block_theta (i k : Fin 4) (β γ δ : 𝕜)
    (hE : ∀ i j, E i * E j = if i = j then E i else 0) (hA : A = ∑ i, θ i • E i) :
    E i * (A ^ 3 * Astar - Astar * A ^ 3
        - (β + 1) • (A ^ 2 * Astar * A - A * Astar * A ^ 2)
        - γ • (A ^ 2 * Astar - Astar * A ^ 2)
        - δ • (A * Astar - Astar * A)) * E k
      = (θ i ^ 3 - θ k ^ 3 - (β + 1) * (θ i ^ 2 * θ k - θ i * θ k ^ 2)
          - γ * (θ i ^ 2 - θ k ^ 2) - δ * (θ i - θ k)) • (E i * Astar * E k) := by
  have e1 : E i * (A ^ 3 * Astar) * E k = (θ i) ^ 3 • (E i * Astar * E k) :=
    tp_block_left i k 3 Astar hE hA
  have e2 : E i * (Astar * A ^ 3) * E k = (θ k) ^ 3 • (E i * Astar * E k) :=
    tp_block_right i k 3 Astar hE hA
  have e3 : E i * (A ^ 2 * Astar * A) * E k = ((θ i) ^ 2 * θ k) • (E i * Astar * E k) := by
    have hr := tp_block_right (A := A) i k 1 (A ^ 2 * Astar) hE hA
    simp only [pow_one] at hr
    rw [hr, tp_block_left i k 2 Astar hE hA, smul_smul, mul_comm (θ k)]
  have e4 : E i * (A * Astar * A ^ 2) * E k = (θ i * (θ k) ^ 2) • (E i * Astar * E k) := by
    have hl := tp_block_left (A := A) i k 1 Astar hE hA
    simp only [pow_one] at hl
    rw [tp_block_right i k 2 (A * Astar) hE hA, hl, smul_smul, mul_comm ((θ k) ^ 2)]
  have e5 : E i * (A ^ 2 * Astar) * E k = (θ i) ^ 2 • (E i * Astar * E k) :=
    tp_block_left i k 2 Astar hE hA
  have e6 : E i * (Astar * A ^ 2) * E k = (θ k) ^ 2 • (E i * Astar * E k) :=
    tp_block_right i k 2 Astar hE hA
  have e7 : E i * (A * Astar) * E k = θ i • (E i * Astar * E k) := by
    simpa using tp_block_left i k 1 Astar hE hA
  have e8 : E i * (Astar * A) * E k = θ k • (E i * Astar * E k) := by
    simpa using tp_block_right i k 1 Astar hE hA
  simp only [tp_block_sub, tp_block_smul]
  rw [e1, e2, e3, e4, e5, e6, e7, e8]
  module

/-- `M` is the sum of its `E`-blocks. -/
lemma tp_blocks_decomp (M : Matrix (Fin n) (Fin n) 𝕜)
    (hEs : ∑ i, E i = (1 : Matrix (Fin n) (Fin n) 𝕜)) :
    M = ∑ i, ∑ k, E i * M * E k := by
  calc M = 1 * M * 1 := by rw [one_mul, mul_one]
    _ = (∑ i, E i) * M * (∑ k, E k) := by rw [hEs, one_mul, mul_one]
    _ = ∑ i, ∑ k, E i * M * E k := by
        rw [Finset.sum_mul, Finset.sum_mul]
        simp only [Finset.mul_sum]

end Block

/-! ## 2. The scalar content: the notes' (delta), (gamma1), (beta) -/

section Scalar

variable {θ : Fin 4 → 𝕜}

/-- The notes' bracket factors through the `(delta)` equation. -/
lemma tp_bracket_factor (β γ δ : 𝕜) (a b : 𝕜) :
    a ^ 3 - b ^ 3 - (β + 1) * (a ^ 2 * b - a * b ^ 2) - γ * (a ^ 2 - b ^ 2) - δ * (a - b)
      = (a - b) * (a ^ 2 - β * a * b + b ^ 2 - γ * (a + b) - δ) := by
  ring

/-- The bracket vanishes on the pairs `(i,k)` with `|i-k| ≤ 1`, for the notes' explicit
`β, γ, δ`. -/
lemma tp_scalar_zero (β γ δ : 𝕜) (hβ : β * (θ 1 - θ 2) = θ 0 - θ 1 + θ 2 - θ 3)
    (hγ : γ = θ 0 - β * θ 1 + θ 2)
    (hδ : δ = θ 0 ^ 2 - β * θ 0 * θ 1 + θ 1 ^ 2 - γ * (θ 0 + θ 1))
    (i k : Fin 4) (hik : ¬ (2 ≤ Int.natAbs ((i : ℕ) - (k : ℕ)))) :
    θ i ^ 3 - θ k ^ 3 - (β + 1) * (θ i ^ 2 * θ k - θ i * θ k ^ 2)
      - γ * (θ i ^ 2 - θ k ^ 2) - δ * (θ i - θ k) = 0 := by
  have hS0 : θ 0 ^ 2 - β * θ 0 * θ 1 + θ 1 ^ 2 - γ * (θ 0 + θ 1) - δ = 0 := by
    rw [hδ]; ring
  have hS1 : θ 1 ^ 2 - β * θ 1 * θ 2 + θ 2 ^ 2 - γ * (θ 1 + θ 2) - δ = 0 := by
    have hfac : (θ 0 ^ 2 - β * θ 0 * θ 1 + θ 1 ^ 2 - γ * (θ 0 + θ 1) - δ)
        - (θ 1 ^ 2 - β * θ 1 * θ 2 + θ 2 ^ 2 - γ * (θ 1 + θ 2) - δ)
        = (θ 0 - θ 2) * (θ 0 - β * θ 1 + θ 2 - γ) := by ring
    have hg : θ 0 - β * θ 1 + θ 2 - γ = 0 := by rw [hγ]; ring
    rw [hS0, hg, mul_zero] at hfac
    exact (sub_eq_zero.mp hfac).symm
  have hS2 : θ 2 ^ 2 - β * θ 2 * θ 3 + θ 3 ^ 2 - γ * (θ 2 + θ 3) - δ = 0 := by
    have hfac : (θ 1 ^ 2 - β * θ 1 * θ 2 + θ 2 ^ 2 - γ * (θ 1 + θ 2) - δ)
        - (θ 2 ^ 2 - β * θ 2 * θ 3 + θ 3 ^ 2 - γ * (θ 2 + θ 3) - δ)
        = (θ 1 - θ 3) * (θ 1 - β * θ 2 + θ 3 - γ) := by ring
    have hg : θ 1 - β * θ 2 + θ 3 - γ = 0 := by
      have hsplit : θ 1 - β * θ 2 + θ 3 - γ
          = (β * θ 1 - β * θ 2) - (θ 0 - θ 1 + θ 2 - θ 3) := by rw [hγ]; ring
      have hb' : β * θ 1 - β * θ 2 = θ 0 - θ 1 + θ 2 - θ 3 := by rw [← mul_sub, hβ]
      rw [hsplit, hb', sub_self]
    rw [hS1, hg, mul_zero] at hfac
    exact (sub_eq_zero.mp hfac).symm
  have hS01 : θ 1 ^ 2 - β * θ 1 * θ 0 + θ 0 ^ 2 - γ * (θ 1 + θ 0) - δ = 0 := by
    rw [show θ 1 ^ 2 - β * θ 1 * θ 0 + θ 0 ^ 2 - γ * (θ 1 + θ 0) - δ
        = θ 0 ^ 2 - β * θ 0 * θ 1 + θ 1 ^ 2 - γ * (θ 0 + θ 1) - δ from by ring, hS0]
  have hS12 : θ 2 ^ 2 - β * θ 2 * θ 1 + θ 1 ^ 2 - γ * (θ 2 + θ 1) - δ = 0 := by
    rw [show θ 2 ^ 2 - β * θ 2 * θ 1 + θ 1 ^ 2 - γ * (θ 2 + θ 1) - δ
        = θ 1 ^ 2 - β * θ 1 * θ 2 + θ 2 ^ 2 - γ * (θ 1 + θ 2) - δ from by ring, hS1]
  have hS23 : θ 3 ^ 2 - β * θ 3 * θ 2 + θ 2 ^ 2 - γ * (θ 3 + θ 2) - δ = 0 := by
    rw [show θ 3 ^ 2 - β * θ 3 * θ 2 + θ 2 ^ 2 - γ * (θ 3 + θ 2) - δ
        = θ 2 ^ 2 - β * θ 2 * θ 3 + θ 3 ^ 2 - γ * (θ 2 + θ 3) - δ from by ring, hS2]
  have hmul : ∀ a b : 𝕜, b = 0 → a * b = 0 := fun a b h => by rw [h, mul_zero]
  fin_cases i <;> fin_cases k <;>
    first
      | exact absurd hik (by decide)
      | (rw [tp_bracket_factor]; exact hmul _ _ hS0)
      | (rw [tp_bracket_factor]; exact hmul _ _ hS01)
      | (rw [tp_bracket_factor]; exact hmul _ _ hS1)
      | (rw [tp_bracket_factor]; exact hmul _ _ hS12)
      | (rw [tp_bracket_factor]; exact hmul _ _ hS2)
      | (rw [tp_bracket_factor]; exact hmul _ _ hS23)
      | (rw [tp_bracket_factor]; ring)

end Scalar

/-! ## 3. The one-sided tridiagonal relation -/

section OneSided

variable {A Astar : Matrix (Fin n) (Fin n) 𝕜} {E : Fin 4 → Matrix (Fin n) (Fin n) 𝕜}
  {θ : Fin 4 → 𝕜}

/-- `2 ≤ |i-k|` implies `1 < |i-k|` in the `Fin 4` index arithmetic of the draft hypotheses. -/
lemma tp_one_lt_natAbs {i k : Fin 4} (h : 2 ≤ Int.natAbs ((i : ℕ) - (k : ℕ))) :
    ((1 : Fin 4) : ℕ) < Int.natAbs ((i : ℕ) - (k : ℕ)) := by
  have hone : ((1 : Fin 4) : ℕ) = 1 := by decide
  omega

/-- One half of Theorem 29.1, with explicit coefficients: the notes' Claims 1, 5, 6, 7 in the
sharpened form in which the coefficients are produced rather than abstractly shown to exist. -/
theorem tp_relation_of_banded (hE : ∀ i j, E i * E j = if i = j then E i else 0)
    (hEs : ∑ i, E i = (1 : Matrix (Fin n) (Fin n) 𝕜))
    (hA : A = ∑ i, θ i • E i)
    (h1 : ∀ (h i j : Fin 4), (h : ℕ) < Int.natAbs ((i : ℕ) - (j : ℕ)) →
      E i * Astar ^ (h : ℕ) * E j = 0)
    (β γ δ : 𝕜) (hβ : β * (θ 1 - θ 2) = θ 0 - θ 1 + θ 2 - θ 3)
    (hγ : γ = θ 0 - β * θ 1 + θ 2)
    (hδ : δ = θ 0 ^ 2 - β * θ 0 * θ 1 + θ 1 ^ 2 - γ * (θ 0 + θ 1)) :
    A ^ 3 * Astar - Astar * A ^ 3
        - (β + 1) • (A ^ 2 * Astar * A - A * Astar * A ^ 2)
        - γ • (A ^ 2 * Astar - Astar * A ^ 2)
        - δ • (A * Astar - Astar * A) = 0 := by
  have hzero : ∀ i k : Fin 4,
      E i * (A ^ 3 * Astar - Astar * A ^ 3
        - (β + 1) • (A ^ 2 * Astar * A - A * Astar * A ^ 2)
        - γ • (A ^ 2 * Astar - Astar * A ^ 2)
        - δ • (A * Astar - Astar * A)) * E k = 0 := by
    intro i k
    rw [tp_block_theta (A := A) (Astar := Astar) (θ := θ) i k β γ δ hE hA]
    by_cases hfar : 2 ≤ Int.natAbs ((i : ℕ) - (k : ℕ))
    · have hz : E i * Astar * E k = 0 := by
        have hh := h1 (1 : Fin 4) i k (tp_one_lt_natAbs hfar)
        simpa using hh
      rw [hz, smul_zero]
    · have hb2 := tp_scalar_zero (θ := θ) β γ δ hβ hγ hδ i k hfar
      rw [hb2, zero_smul]
  have hdec := tp_blocks_decomp (E := E)
    (A ^ 3 * Astar - Astar * A ^ 3
      - (β + 1) • (A ^ 2 * Astar * A - A * Astar * A ^ 2)
      - γ • (A ^ 2 * Astar - Astar * A ^ 2)
      - δ • (A * Astar - Astar * A)) hEs
  rw [hdec]
  simp [hzero]

end OneSided

/-! ## 4. The explicit coefficients -/

section Coeffs

variable {θ : Fin 4 → 𝕜}

/-- The notes' `β = (θ₀-θ₁+θ₂-θ₃)/(θ₁-θ₂)`, `γ = θ₀-βθ₁+θ₂`, `δ = θ₀²-βθ₀θ₁+θ₁²-γ(θ₀+θ₁)`
satisfy the hypotheses of `tp_relation_of_banded`. -/
theorem tp_exists_coeffs (hθ : Function.Injective θ) :
    ∃ β γ δ : 𝕜, β * (θ 1 - θ 2) = θ 0 - θ 1 + θ 2 - θ 3 ∧
      γ = θ 0 - β * θ 1 + θ 2 ∧ δ = θ 0 ^ 2 - β * θ 0 * θ 1 + θ 1 ^ 2 - γ * (θ 0 + θ 1) := by
  have h12 : θ 1 - θ 2 ≠ 0 := sub_ne_zero.mpr (fun h => absurd (hθ h) (by decide))
  refine ⟨(θ 0 - θ 1 + θ 2 - θ 3) / (θ 1 - θ 2),
    θ 0 - (θ 0 - θ 1 + θ 2 - θ 3) / (θ 1 - θ 2) * θ 1 + θ 2,
    θ 0 ^ 2 - (θ 0 - θ 1 + θ 2 - θ 3) / (θ 1 - θ 2) * θ 0 * θ 1 + θ 1 ^ 2
      - (θ 0 - (θ 0 - θ 1 + θ 2 - θ 3) / (θ 1 - θ 2) * θ 1 + θ 2) * (θ 0 + θ 1),
    ?_, rfl, rfl⟩
  field_simp
  try ring

end Coeffs



variable {A Astar : Matrix (Fin n) (Fin n) 𝕜} {E F : Fin 4 → Matrix (Fin n) (Fin n) 𝕜}
  {θ θs : Fin 4 → 𝕜}

/-- Insertion helper: a middle factor `z` with `z * z = z` can be duplicated under
reassociation. -/
lemma tp_mid_idem (x y z w v : Matrix (Fin n) (Fin n) 𝕜) (hz : z * z = z) :
    x * (y * z * w) * v = (x * (y * z)) * (z * (w * v)) := by
  calc x * (y * z * w) * v = x * (y * (z * (w * v))) := by simp only [mul_assoc]
    _ = x * (y * ((z * z) * (w * v))) := by rw [hz]
    _ = (x * (y * z)) * (z * (w * v)) := by simp only [mul_assoc]


lemma tp_F_mid_zero
    (hF : ∀ i j, F i * F j = if i = j then F i else 0)
    (h2 : ∀ (h i j : Fin 4), (h : ℕ) < Int.natAbs ((i : ℕ) - (j : ℕ)) →
      F i * A ^ (h : ℕ) * F j = 0)
    (h : Fin 4) (hne : h ≠ 1) : F 3 * (A ^ 2 * F h * A) * F 0 = 0 := by
  have v2 : F 3 * A ^ 2 * F 0 = 0 := by
    simpa using h2 (2 : Fin 4) 3 0 (by decide)
  have v10 : F 3 * A * F 0 = 0 := by
    simpa using h2 (1 : Fin 4) 3 0 (by decide)
  have v21 : F 2 * A * F 0 = 0 := by
    simpa using h2 (1 : Fin 4) 2 0 (by decide)
  have v21' : F 2 * (A * F 0) = 0 := by rw [← mul_assoc]; exact v21
  have v10' : F 3 * (A * F 0) = 0 := by rw [← mul_assoc]; exact v10
  by_cases h0 : h = 0
  · subst h0
    rw [show F 3 * (A ^ 2 * F 0 * A) * F 0 = (F 3 * A ^ 2 * F 0) * (A * F 0) from by
      simp only [mul_assoc], v2, zero_mul]
  by_cases h2' : h = 2
  · subst h2'
    have hidem : F 2 * F 2 = F 2 := by rw [hF 2 2, if_pos rfl]
    rw [tp_mid_idem (F 3) (A ^ 2) (F 2) A (F 0) hidem, v21', mul_zero]
  by_cases h3 : h = 3
  · subst h3
    have hidem : F 3 * F 3 = F 3 := by rw [hF 3 3, if_pos rfl]
    rw [tp_mid_idem (F 3) (A ^ 2) (F 3) A (F 0) hidem, v10', mul_zero]
  exfalso
  fin_cases h
  · exact h0 rfl
  · exact hne rfl
  · exact h2' rfl
  · exact h3 rfl

lemma tp_F_mid_eq
    (hF : ∀ i j, F i * F j = if i = j then F i else 0)
    (hFs : ∑ i, F i = (1 : Matrix (Fin n) (Fin n) 𝕜))
    (h2 : ∀ (h i j : Fin 4), (h : ℕ) < Int.natAbs ((i : ℕ) - (j : ℕ)) →
      F i * A ^ (h : ℕ) * F j = 0) :
    F 3 * (A ^ 2 * F 1 * A) * F 0 = F 3 * A ^ 3 * F 0 := by
  have hsplit : F 3 * A ^ 3 * F 0 = ∑ h : Fin 4, F 3 * (A ^ 2 * F h * A) * F 0 := by
    have h3 : A ^ 3 = A ^ 2 * (1 : Matrix (Fin n) (Fin n) 𝕜) * A := by
      rw [mul_one, pow_succ]
    rw [h3, ← hFs]
    simp only [Finset.mul_sum, Finset.sum_mul]
  rw [hsplit, Finset.sum_eq_single 1]
  · intro h _ hne
    exact tp_F_mid_zero hF h2 h hne
  · intro h
    exact absurd (Finset.mem_univ (1 : Fin 4)) h


set_option maxHeartbeats 400000 in
theorem tp_F_sandwich
    (hF : ∀ i j, F i * F j = if i = j then F i else 0)
    (hFs : ∑ i, F i = (1 : Matrix (Fin n) (Fin n) 𝕜))
    (hAs : Astar = ∑ i, θs i • F i)
    (h2 : ∀ (h i j : Fin 4), (h : ℕ) < Int.natAbs ((i : ℕ) - (j : ℕ)) →
      F i * A ^ (h : ℕ) * F j = 0)
    (β γ δ : 𝕜) :
    F 3 * (A ^ 3 * Astar - Astar * A ^ 3
        - (β + 1) • (A ^ 2 * Astar * A - A * Astar * A ^ 2)
        - γ • (A ^ 2 * Astar - Astar * A ^ 2)
        - δ • (A * Astar - Astar * A)) * F 0
      = ((θs 0 - θs 3) - (β + 1) * (θs 1 - θs 2)) • (F 3 * A ^ 3 * F 0) := by
  have v2 : F 3 * A ^ 2 * F 0 = 0 := by
    simpa using h2 (2 : Fin 4) 3 0 (by decide)
  have v10 : F 3 * A * F 0 = 0 := by
    simpa using h2 (1 : Fin 4) 3 0 (by decide)
  have h2idem : F 2 * F 2 = F 2 := by rw [hF 2 2, if_pos rfl]
  have h3idem : F 3 * F 3 = F 3 := by rw [hF 3 3, if_pos rfl]
  have h0idem : F 0 * F 0 = F 0 := by rw [hF 0 0, if_pos rfl]
  have e1 : F 3 * (A ^ 3 * Astar) * F 0 = θs 0 • (F 3 * A ^ 3 * F 0) := by
    have hAs0 : Astar * F 0 = θs 0 • F 0 := tp_smul_mul_eq_of_idem hF hAs 0
    rw [show F 3 * (A ^ 3 * Astar) * F 0 = F 3 * A ^ 3 * (Astar * F 0) from by
      simp only [mul_assoc], hAs0, Matrix.mul_smul]
  have e2 : F 3 * (Astar * A ^ 3) * F 0 = θs 3 • (F 3 * A ^ 3 * F 0) := by
    have hF3 : F 3 * Astar = θs 3 • F 3 := tp_mul_eq_smul_of_idem hF hAs 3
    rw [show F 3 * (Astar * A ^ 3) * F 0 = (F 3 * Astar) * A ^ 3 * F 0 from by
      simp only [mul_assoc], hF3, Matrix.smul_mul, Matrix.smul_mul]
  have e3 : F 3 * (A ^ 2 * Astar * A) * F 0 = θs 1 • (F 3 * A ^ 3 * F 0) := by
    rw [hAs]
    simp only [Finset.mul_sum, Finset.sum_mul, Matrix.mul_smul, Matrix.smul_mul]
    rw [Finset.sum_eq_single 1]
    · rw [tp_F_mid_eq hF hFs h2]
    · intro h _ hne
      rw [tp_F_mid_zero hF h2 h hne, smul_zero]
    · intro h
      exact absurd (Finset.mem_univ (1 : Fin 4)) h
  have e4 : F 3 * (A * Astar * A ^ 2) * F 0 = θs 2 • (F 3 * A ^ 3 * F 0) := by
    have hmid : ∀ h : Fin 4, h ≠ 2 → F 3 * (A * F h * A ^ 2) * F 0 = 0 := by
      intro h hne
      by_cases h0 : h = 0
      · subst h0
        rw [show F 3 * (A * F 0 * A ^ 2) * F 0 = (F 3 * A * F 0) * (A ^ 2 * F 0) from by
          simp only [mul_assoc], v10, zero_mul]
      by_cases h1 : h = 1
      · subst h1
        have w : F 3 * A * F 1 = 0 := by
          simpa using h2 (1 : Fin 4) 3 1 (by decide)
        rw [show F 3 * (A * F 1 * A ^ 2) * F 0 = (F 3 * A * F 1) * (A ^ 2 * F 0) from by
          simp only [mul_assoc], w, zero_mul]
      by_cases h3 : h = 3
      · subst h3
        have hv : F 3 * (A ^ 2 * F 0) = 0 := by rw [← mul_assoc]; exact v2
        rw [tp_mid_idem (F 3) A (F 3) (A ^ 2) (F 0) h3idem, hv, mul_zero]
      exfalso
      fin_cases h
      · exact h0 rfl
      · exact h1 rfl
      · exact hne rfl
      · exact h3 rfl
    have hmid_eq : F 3 * (A * F 2 * A ^ 2) * F 0 = F 3 * A ^ 3 * F 0 := by
      have hsplit : F 3 * A ^ 3 * F 0 = ∑ h : Fin 4, F 3 * (A * F h * A ^ 2) * F 0 := by
        have h3 : A ^ 3 = A * (1 : Matrix (Fin n) (Fin n) 𝕜) * A ^ 2 := by
          rw [mul_one, ← pow_succ']
        rw [h3, ← hFs]
        simp only [Finset.mul_sum, Finset.sum_mul]
      rw [hsplit, Finset.sum_eq_single 2]
      · intro h _ hne
        exact hmid h hne
      · intro h
        exact absurd (Finset.mem_univ (2 : Fin 4)) h
    rw [hAs]
    simp only [Finset.mul_sum, Finset.sum_mul, Matrix.mul_smul, Matrix.smul_mul]
    rw [Finset.sum_eq_single 2]
    · rw [hmid_eq]
    · intro h _ hne
      rw [hmid h hne, smul_zero]
    · intro h
      exact absurd (Finset.mem_univ (2 : Fin 4)) h
  have e5 : F 3 * (A ^ 2 * Astar) * F 0 = 0 := by
    rw [hAs]
    simp only [Finset.mul_sum, Finset.sum_mul, Matrix.mul_smul, Matrix.smul_mul]
    refine Finset.sum_eq_zero (fun h _ => ?_)
    by_cases h0 : h = 0
    · subst h0
      rw [show F 3 * (A ^ 2 * F 0) * F 0 = (F 3 * A ^ 2 * F 0) * F 0 from by
        simp only [mul_assoc], v2, zero_mul, smul_zero]
    · rw [show F 3 * (A ^ 2 * F h) * F 0 = (F 3 * A ^ 2) * (F h * F 0) from by
        simp only [mul_assoc], hF h 0, if_neg h0, mul_zero, smul_zero]
  have e6 : F 3 * (Astar * A ^ 2) * F 0 = 0 := by
    rw [hAs]
    simp only [Finset.mul_sum, Finset.sum_mul, Matrix.mul_smul, Matrix.smul_mul]
    refine Finset.sum_eq_zero (fun h _ => ?_)
    by_cases h3 : h = 3
    · subst h3
      rw [show F 3 * (F 3 * A ^ 2) * F 0 = F 3 * A ^ 2 * F 0 from by
        rw [← mul_assoc, h3idem], v2, smul_zero]
    · rw [show F 3 * (F h * A ^ 2) * F 0 = (F 3 * F h) * (A ^ 2 * F 0) from by
        simp only [mul_assoc], hF 3 h, if_neg (Ne.symm h3), zero_mul, smul_zero]
  have e7 : F 3 * (A * Astar) * F 0 = 0 := by
    rw [hAs]
    simp only [Finset.mul_sum, Finset.sum_mul, Matrix.mul_smul, Matrix.smul_mul]
    refine Finset.sum_eq_zero (fun h _ => ?_)
    by_cases h0 : h = 0
    · subst h0
      rw [show F 3 * (A * F 0) * F 0 = (F 3 * A) * (F 0 * F 0) from by
        simp only [mul_assoc], h0idem, v10, smul_zero]
    · rw [show F 3 * (A * F h) * F 0 = (F 3 * A) * (F h * F 0) from by
        simp only [mul_assoc], hF h 0, if_neg h0, mul_zero, smul_zero]
  have e8 : F 3 * (Astar * A) * F 0 = 0 := by
    rw [hAs]
    simp only [Finset.mul_sum, Finset.sum_mul, Matrix.mul_smul, Matrix.smul_mul]
    refine Finset.sum_eq_zero (fun h _ => ?_)
    by_cases h3 : h = 3
    · subst h3
      rw [show F 3 * (F 3 * A) * F 0 = F 3 * A * F 0 from by
        rw [← mul_assoc, h3idem], v10, smul_zero]
    · rw [show F 3 * (F h * A) * F 0 = (F 3 * F h) * (A * F 0) from by
        simp only [mul_assoc], hF 3 h, if_neg (Ne.symm h3), zero_mul, smul_zero]
  calc F 3 * (A ^ 3 * Astar - Astar * A ^ 3
        - (β + 1) • (A ^ 2 * Astar * A - A * Astar * A ^ 2)
        - γ • (A ^ 2 * Astar - Astar * A ^ 2)
        - δ • (A * Astar - Astar * A)) * F 0
      = θs 0 • (F 3 * A ^ 3 * F 0) - θs 3 • (F 3 * A ^ 3 * F 0)
          - (β + 1) • (θs 1 • (F 3 * A ^ 3 * F 0) - θs 2 • (F 3 * A ^ 3 * F 0)) := by
        rw [tp_block_sub, tp_block_sub, tp_block_sub, tp_block_sub,
          tp_block_smul, tp_block_smul, tp_block_smul,
          tp_block_sub (X := A ^ 2 * Astar * A) (Y := A * Astar * A ^ 2),
          tp_block_sub (X := A ^ 2 * Astar) (Y := Astar * A ^ 2),
          tp_block_sub (X := A * Astar) (Y := Astar * A),
          e1, e2, e3, e4, e5, e6, e7, e8]
        simp only [sub_self, smul_zero, sub_zero]
    _ = (θs 0 - θs 3) • (F 3 * A ^ 3 * F 0)
          - (β + 1) • (θs 1 • (F 3 * A ^ 3 * F 0) - θs 2 • (F 3 * A ^ 3 * F 0)) := by
        rw [show θs 0 • (F 3 * A ^ 3 * F 0) - θs 3 • (F 3 * A ^ 3 * F 0)
          = (θs 0 - θs 3) • (F 3 * A ^ 3 * F 0) from (sub_smul _ _ _).symm]
    _ = (θs 0 - θs 3) • (F 3 * A ^ 3 * F 0)
          - ((β + 1) * (θs 1 - θs 2)) • (F 3 * A ^ 3 * F 0) := by
        rw [smul_sub, smul_smul, smul_smul, ← sub_smul ((β + 1) * θs 1) ((β + 1) * θs 2),
          ← mul_sub]
    _ = ((θs 0 - θs 3) - (β + 1) * (θs 1 - θs 2)) • (F 3 * A ^ 3 * F 0) := by
        rw [← sub_smul]

set_option maxHeartbeats 400000 in
/-- **The forced value of `β`.** -/
theorem tp_beta_forced
    (hF : ∀ i j, F i * F j = if i = j then F i else 0)
    (hFs : ∑ i, F i = (1 : Matrix (Fin n) (Fin n) 𝕜))
    (hAs : Astar = ∑ i, θs i • F i)
    (h2 : ∀ (h i j : Fin 4), (h : ℕ) < Int.natAbs ((i : ℕ) - (j : ℕ)) →
      F i * A ^ (h : ℕ) * F j = 0)
    (β γ δ : 𝕜)
    (hrel : A ^ 3 * Astar - Astar * A ^ 3
        - (β + 1) • (A ^ 2 * Astar * A - A * Astar * A ^ 2)
        - γ • (A ^ 2 * Astar - Astar * A ^ 2)
        - δ • (A * Astar - Astar * A) = 0)
    (h2' : F 3 * A ^ 3 * F 0 ≠ 0) :
    β * (θs 1 - θs 2) = θs 0 - θs 1 + θs 2 - θs 3 := by
  have h0 : F 3 * (A ^ 3 * Astar - Astar * A ^ 3
      - (β + 1) • (A ^ 2 * Astar * A - A * Astar * A ^ 2)
      - γ • (A ^ 2 * Astar - Astar * A ^ 2)
      - δ • (A * Astar - Astar * A)) * F 0 = 0 := by
    rw [hrel, mul_zero, zero_mul]
  rw [tp_F_sandwich hF hFs hAs h2 β γ δ] at h0
  rcases smul_eq_zero.mp h0 with hc | hx
  · have hc' : θs 0 - θs 3 = (β + 1) * (θs 1 - θs 2) := sub_eq_zero.mp hc
    calc β * (θs 1 - θs 2) = (β + 1) * (θs 1 - θs 2) - (θs 1 - θs 2) := by ring
      _ = θs 0 - θs 1 + θs 2 - θs 3 := by rw [← hc']; ring
  · exact absurd hx h2'

end TridiagonalPair

/-- **Theorem 29.1 (tridiagonal pair)** — AUDITED AND RESTATED (fix 8).

The draft quantified only the orthogonal-idempotent decompositions `E`, `F`; nothing tied them
to `A`, `A*`, so the statement was false (4×4 counterexample: `.ultramath/smvtxsupz/m6/audit-r3h.md`).
As restated the hypotheses are those of the notes: `A = ∑ θᵢ • Eᵢ` and `A* = ∑ θ*ᵢ • Fᵢ` give the
two orderings of primitive idempotents, `θ`, `θ*` are injective (distinct eigenvalues), the
vanishing conditions `Eᵢ A*^h Eⱼ = 0`, `Fᵢ A^h Fⱼ = 0` for `h < |i-j|` are (i) and (ii), and the
non-vanishing instance `F₃A³F₀ ≠ 0` of (e*e*) is needed to divide by `F₃A³F₀` in the notes'
Claim 5 (without it the parameter `β` is not pinned and the relation degenerates).

There exist `β, γ, γ*, δ, δ*` with
`A³A* - A*A³ = (β+1)(A²A*A - AA*A²) + γ(A²A* - A*A²) + δ(AA* - A*A)`
and the corresponding starred relation, with the **same** `β` in both — which is the content of
the notes' (iii): `β = (θᵢ-θᵢ₊₁+θᵢ₊₂-θᵢ₊₃)/(θᵢ₊₁-θᵢ₊₂)` for both spectra. -/
theorem tridiagonal_pair {𝕜 : Type*} [Field 𝕜] {n : ℕ}
    (A Astar : Matrix (Fin n) (Fin n) 𝕜)
    (E F : Fin 4 → Matrix (Fin n) (Fin n) 𝕜)
    (θ θs : Fin 4 → 𝕜)
    (hA : A = ∑ i, θ i • E i) (hAs : Astar = ∑ i, θs i • F i)
    (hθ : Function.Injective θ) (hθs : Function.Injective θs)
    (hE : ∀ i j, E i * E j = if i = j then E i else 0) (hEs : ∑ i, E i = 1)
    (hF : ∀ i j, F i * F j = if i = j then F i else 0) (hFs : ∑ i, F i = 1)
    (h1 : ∀ (h i j : Fin 4), (h : ℕ) < Int.natAbs ((i : ℕ) - (j : ℕ)) →
      E i * Astar ^ (h : ℕ) * E j = 0)
    (h2 : ∀ (h i j : Fin 4), (h : ℕ) < Int.natAbs ((i : ℕ) - (j : ℕ)) →
      F i * A ^ (h : ℕ) * F j = 0)
    (h2' : F 3 * A ^ 3 * F 0 ≠ 0) :
    ∃ β γ γs δ δs : 𝕜,
      (0 : Matrix (Fin n) (Fin n) 𝕜)
          = A ^ 3 * Astar - Astar * A ^ 3
            - (β + 1) • (A ^ 2 * Astar * A - A * Astar * A ^ 2)
            - γ • (A ^ 2 * Astar - Astar * A ^ 2) - δ • (A * Astar - Astar * A) ∧
      (0 : Matrix (Fin n) (Fin n) 𝕜)
          = Astar ^ 3 * A - A * Astar ^ 3
            - (β + 1) • (Astar ^ 2 * A * Astar - Astar * A * Astar ^ 2)
            - γs • (Astar ^ 2 * A - A * Astar ^ 2) - δs • (Astar * A - A * Astar) := by
  obtain ⟨β, γ, δ, hβ, hγ, hδ⟩ := tp_exists_coeffs (θ := θ) hθ
  obtain ⟨βs, γs, δs, hβs, hγs, hδs⟩ := tp_exists_coeffs (θ := θs) hθs
  have hrel1 := tp_relation_of_banded (A := A) (Astar := Astar) (E := E) (θ := θ) hE hEs hA h1
    β γ δ hβ hγ hδ
  have hforced := tp_beta_forced (A := A) (Astar := Astar) (F := F) (θs := θs) hF hFs hAs h2
    β γ δ hrel1 h2'
  have h12 : θs 1 - θs 2 ≠ 0 := by
    intro h
    exact absurd (hθs (sub_eq_zero.mp h)) (by decide)
  have hβeq : βs = β := by
    have h2eq : βs * (θs 1 - θs 2) = β * (θs 1 - θs 2) := by rw [hβs, hforced]
    exact mul_right_cancel₀ h12 h2eq
  have hrel2 := tp_relation_of_banded (A := Astar) (Astar := A) (E := F) (θ := θs) hF hFs hAs h2
    βs γs δs hβs hγs hδs
  rw [hβeq] at hrel2
  exact ⟨β, γ, γs, δ, δs, hrel1.symm, hrel2.symm⟩

/-! ## Chapter 30: the `R, F, L` relations -/

/-! **Theorem 30.1 (ii) — DRAFT STATEMENT REMOVED (audit, wave 2 W-k).**

Three defects; the draft read `∃ h, h = (θ*_{i-1}-θ*_i)/(θ*_i-θ*_{i+1}) ∧
F(RL - h·LR) = (RL - h·LR)F` with no hypothesis.

* (a) `DRGData.thetaStar` is an *unconstrained* field: nothing ties it to the
  graph, so the draft asserts the identity for every sequence `θ*`.  Instantiating
  at the identically-zero sequence gives `h = 0/0 = 0`, hence `F·R·L = R·L·F`
  for *every* `DRGData` of diameter `≥ 3` (machine checked:
  `flat_commutator_rl_draft_implies_comm` below).  That fails: for the
  dodecahedron (`D = 5`, vertex-transitive, so any base vertex; exact integer
  computation) `‖[F,RL]‖ = ‖[F,LR]‖ = 1` while the icosahedron, `H(3,2)`,
  `H(3,3)`, `J(6,3)`, the Heawood, Möbius–Kantor and Desargues graphs give `0`.
  So the draft needs the `Q`-polynomial hypothesis, which `DRGData` does not
  carry.
* (b) The notes assert the identity only *after* multiplying on the right by
  `E*_i` (`= subconst G x i`): the full-matrix identity would force
  `[F,RL]E*_j = h·[F,LR]E*_j` for all `j` with a single `h`, whereas the notes'
  coefficient `h_i` depends on `i`.
* (c) With the notes' bracket convention `[X,Y] = XY - YX` and the draft's
  left-hand side `RL - h·LR`, the coefficient has to be *inverted*: the notes'
  `h_i = (θ*_{i-1}-θ*_i)/(θ*_i-θ*_{i+1})` satisfies `RL - h_i·LR =
  -h_i·(LR - h_i⁻¹·RL)`, so the draft should read `RL - h_i⁻¹·LR`.

The content of the theorem is the squeezed form `E*_i(A²A* - AA*A²)E*_i = 0`
(equivalently `(θ*_{i-1}-θ*_i)[F,RL]E*_i = (θ*_i-θ*_{i+1})[F,LR]E*_i`), which
is what the cubic relation of Theorem 29.1 gives after squeezing.  That form is
stated with the hypothesis made explicit in `flat_commutator_rl_restated`
(below, in the Chapter 30 section at the end of the file). -/

/-- **The draft of Theorem 30.1 (ii) forces `F` to commute with `RL`.**  The
draft quantified `h` as a function of the (free) field `thetaStar`; taking that
field to be identically zero makes `h = 0/0 = 0`. -/
theorem flat_commutator_rl_draft_implies_comm {G : SimpleGraph X} {x : X} {D : ℕ}
    (hdraft : ∀ (i : ℕ), (hi1 : 1 ≤ i) → (hi2 : i + 1 ≤ D) → ∀ (Y : DRGData G x D),
      ∃ h : ℂ,
        h = ((Y.thetaStar ⟨i - 1, Nat.lt_succ_iff.mpr (le_trans (Nat.sub_le i 1)
              (Nat.le_of_succ_le hi2))⟩ - Y.thetaStar ⟨i, Nat.lt_succ_iff.mpr
              (Nat.le_of_succ_le hi2)⟩ : ℝ) : ℂ)
          / ((Y.thetaStar ⟨i, Nat.lt_succ_iff.mpr (Nat.le_of_succ_le hi2)⟩
              - Y.thetaStar ⟨i + 1, Nat.lt_succ_iff.mpr hi2⟩ : ℝ) : ℂ) ∧
        flat (𝕜 := ℂ) G x D *
            (raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
              - h • (lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D))
          = (raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
              - h • (lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D)) *
            flat (𝕜 := ℂ) G x D)
    (Y₀ : DRGData G x D) (i : ℕ) (hi : 1 ≤ i) (hi' : i + 1 ≤ D) :
    flat (𝕜 := ℂ) G x D * (raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D)
      = (raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D) * flat (𝕜 := ℂ) G x D := by
  obtain ⟨h, hh, hmain⟩ := hdraft i hi hi' { Y₀ with thetaStar := fun _ => 0 }
  have hh0 : h = 0 := by rw [hh]; simp
  rw [hh0, zero_smul, sub_zero] at hmain
  exact hmain

/-! ## Chapter 32: modules of endpoint `i` -/

/-- **Lemma 32.1 (i)** — AUDITED AND RESTATED.

The draft in this file had no thinness hypothesis and no diameter hypothesis: it
quantified an arbitrary `d` and an arbitrary irreducible module `W` (not even
asked to be `T(x)`-stable).  As written that is false.  The draft ties `d` to
nothing: take `W` thin of endpoint `r` and true diameter `d₀ ≥ 1` (such a `W`
always exists — the trivial `T(x)`-module has endpoint `0` and diameter `D ≥ 3`),
set `d := d₀ + 1` and `i := d₀`, and pick `0 ≠ v ∈ E*_{r+d₀}(x)W`.  Then
`i < d`, so the conclusion demands `R⁻¹Rv = v ≠ 0`; but
`Rv ∈ E*_{r+d₀+1}(x)W = 0` by the true diameter, so `R⁻¹Rv = 0` for *every*
matrix `R⁻¹`.
The notes' lemma assumes `W` thin with endpoint `r` and diameter `d`; the correct
statement therefore carries `hthin : ThinModule` and `hdiam : IsDiameter`, plus
`hstable` (`IsIrreducible` alone does not assert that `W` is a `T(x)`-module) and
a bound `hD : ∀ y, ∂(x,y) ≤ D` (otherwise `R` is not the sum over `i < D` and the
claim `Rv = 0` at the endpoint `i = d` fails for trivial reasons; in the
`DRGData` framing `hD` is `Y.diam`).

`R⁻¹Rv = v` for `v ∈ E*_{r+i}W` with `i < d`, and `R⁻¹Rv = 0` for `i = d`. -/
theorem raising_inverse_action {W : Submodule ℂ (X → ℂ)} {r d i : ℕ}
    (hD : ∀ y, G.dist x y ≤ D)
    (hstable : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hW : IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hthin : ThinModule G x W)
    (hend : IsEndpoint G x W r) (hdiam : IsDiameter G x W r d) (hi : i ≤ d) {v : X → ℂ}
    (hv : v ∈ subconstImage (𝕜 := ℂ) G x (r + i) W) :
    ∃ Rinv : Matrix X X ℂ,
      (∀ u : X → ℂ, lowering (𝕜 := ℂ) G x D *ᵥ u = 0 → Rinv *ᵥ u = 0) ∧
      Rinv *ᵥ (raising (𝕜 := ℂ) G x D *ᵥ v) = if i < d then v else 0 := by
  obtain ⟨Rinv, ⟨hia, hib⟩, -⟩ :=
    existsUnique_raising_inverse (𝕜 := ℂ) (G := G) (x := x) (D := D)
  refine ⟨Rinv, hia, ?_⟩
  by_cases hid : i < d
  · -- `R⁻¹Rv = v`: `v` lies in the image of `L`, and `R⁻¹RL = L`
    rw [if_pos hid]
    obtain ⟨u, hu⟩ := exists_lowering_eq_of_thin (W := W) (r := r) (d := d) hD
      hstable hW hthin hend hdiam hid hv
    calc Rinv *ᵥ (raising (𝕜 := ℂ) G x D *ᵥ v)
        = Rinv *ᵥ (raising (𝕜 := ℂ) G x D
            *ᵥ (lowering (𝕜 := ℂ) G x D *ᵥ u)) := by rw [← hu]
      _ = lowering (𝕜 := ℂ) G x D *ᵥ u := hib u
      _ = v := hu
  · -- `i = d`: `Rv = 0` because `E*_{r+d+1}(x)W = 0`
    rw [if_neg hid]
    have hie : i = d := by omega
    rw [hie] at hv
    have hvw : v ∈ W := mem_of_mem_subconstImage hstable hv
    have hRv : raising (𝕜 := ℂ) G x D *ᵥ v = 0 := by
      have h1 : raising (𝕜 := ℂ) G x D *ᵥ v
          = subconst (𝕜 := ℂ) G x (r + d + 1) *ᵥ (adj (𝕜 := ℂ) G *ᵥ v) :=
        raising_mulVec_eq hD (subconst_mulVec_self hv)
      rw [h1]
      have hmem : subconst (𝕜 := ℂ) G x (r + d + 1) *ᵥ (adj (𝕜 := ℂ) G *ᵥ v)
          ∈ subconstImage (𝕜 := ℂ) G x (r + d + 1) W :=
        mem_matImage.2 ⟨adj (𝕜 := ℂ) G *ᵥ v,
          hstable _ (adj_mem_subconstituentAlgebra G x) v hvw, rfl⟩
      have hbot : subconstImage (𝕜 := ℂ) G x (r + d + 1) W = ⊥ := by
        by_contra hne
        have := (hdiam.2 (r + d + 1) hne).2
        omega
      rw [hbot] at hmem
      simpa using hmem
    rw [hRv, Matrix.mulVec_zero]

/-- `V` is the orthogonal direct sum of the `Vᵢ` (Definition 32.2).

Formalised here is the spanning half, `⨆ i, Vᵢ = ⊤`.  The notes' proof that the
`Vᵢ` are pairwise orthogonal (distinct irreducible `T(x)`-modules are orthogonal
with respect to `⟨u,v⟩ = ∑ conj(u v) v`) is *not* part of this statement and is
not proved here.  The statement is correct as it stands: `E*_k = 0` for `k`
beyond the eccentricity of `x`, so `Vᵢ = ⊥` there and the `iSup` over `ℕ` is
effectively finite. -/
theorem iSup_endpointSpace : ⨆ i : ℕ, Y.endpointSpace i = ⊤ := by
  -- the irreducible `T(x)`-submodules span the standard module (Lemma 1.8 (iii))
  have htop : irredSpan G x = ⊤ := by
    refine top_unique ?_
    have h := le_irredSpan_of_isStable (G := G) (x := x) (Module.finrank ℂ (X → ℂ)) ⊤
      (by simp) (isStable_top _)
    exact h
  -- each stable irreducible module is sitting in the `endpointSpace` of its endpoint
  have hle : irredSpan G x ≤ ⨆ i : ℕ, Y.endpointSpace i := by
    rw [irredSpan]
    refine Submodule.span_le.mpr ?_
    rintro w ⟨U, hirr, _, hwU⟩
    obtain ⟨r, hend⟩ := exists_isEndpoint_of_irreducible hirr
    exact Submodule.mem_iSup_of_mem r (Submodule.subset_span ⟨U, hirr, hend, hwU⟩)
  refine le_antisymm le_top ?_
  exact htop ▸ hle

/-! ## Chapter 33: the algebra on the first subconstituent -/

/-- **Lemma 33.4 (iii).**  `E*₁TE*₁ = Span(J̃, E*₁, Ã, Ã², …)`. -/
theorem e1star_te1star_span :
    (∀ a ∈ (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra,
      subconst (𝕜 := ℂ) G x 1 * a * subconst (𝕜 := ℂ) G x 1 ∈
        Submodule.span ℂ ((fun n : ℕ => (Y.tildeA) ^ n) '' Set.univ
          ∪ ({Y.tildeJ, subconst (𝕜 := ℂ) G x 1} : Set (Matrix X X ℂ)))) := by
  sorry


/-! ### Lemma 33.3: the identities used in the proof of 33.4 (iii)

The notes derive Lemma 33.4 (iii) from (ii) by observing that `Span{J̃}` is a
two-sided ideal in the algebra generated by `J̃`, `E*₁` and `Ã`.  The three
identities that make this work are collected here; they are the reusable last
step of the Chapter 33 proof (the missing part is the ideal-theoretic steps
(i)/(ii), which need the primitive idempotent `E₁` and the Q-polynomial
vanishing condition — see `AUDIT-R3eg.md`). -/

/-- Sum of the indicator of a predicate, as a cardinality. -/
theorem sum_ite_one_eq_card (p : X → Prop) [DecidablePred p] :
    (∑ z : X, (if p z then (1 : ℂ) else 0)) = ((Finset.univ.filter p).card : ℂ) := by
  rw [Finset.sum_ite]
  simp

/-- Sum of a product of two indicators, as a cardinality. -/
theorem sum_ite_mul_ite (p q : X → Prop) [DecidablePred p] [DecidablePred q] :
    (∑ z : X, (if p z then (1 : ℂ) else 0) * (if q z then 1 else 0))
      = ((Finset.univ.filter fun z => p z ∧ q z).card : ℂ) := by
  rw [← sum_ite_one_eq_card (fun z => p z ∧ q z)]
  refine Finset.sum_congr rfl (fun z _ => ?_)
  by_cases h1 : p z <;> by_cases h2 : q z <;> simp [h1, h2]

/-- The cardinality of the first sphere is the valency. -/
theorem card_sphere_one (G : SimpleGraph X) (x : X) :
    (sphere G x 1).card = valency G x := by
  have h : sphere G x 1 = G.neighborFinset x := by
    ext z
    rw [mem_sphere_iff, SimpleGraph.mem_neighborFinset, SimpleGraph.dist_eq_one_iff_adj]
  rw [h, valency]

/-- Entrywise description of `J̃ = E*₁(x)J E*₁(x)`. -/
theorem tildeJ_apply (Y : DRGData G x D) (u v : X) :
    Y.tildeJ u v
      = (if G.dist x u = 1 then (1 : ℂ) else 0) * (if G.dist x v = 1 then 1 else 0) := by
  rw [tildeJ, Matrix.mul_apply, Finset.sum_eq_single v]
  · rw [Matrix.mul_apply, Finset.sum_eq_single u]
    · simp [subconst_apply, allOnes_apply]
    · intro b _ hb
      simp [subconst_apply, Ne.symm hb]
    · intro h
      exact absurd (Finset.mem_univ u) h
  · intro k _ hk
    simp [subconst_apply, hk]
  · intro h
    exact absurd (Finset.mem_univ v) h

/-- Entrywise description of `Ã = E*₁(x)A E*₁(x)`. -/
theorem tildeA_apply (Y : DRGData G x D) (u v : X) :
    Y.tildeA u v
      = (if G.dist x u = 1 then (1 : ℂ) else 0) * (if G.dist x v = 1 then 1 else 0)
        * (if G.Adj u v then 1 else 0) := by
  rw [tildeA, Matrix.mul_apply, Finset.sum_eq_single v]
  · rw [Matrix.mul_apply, Finset.sum_eq_single u]
    · by_cases huv : G.Adj u v <;> by_cases hxu : G.Adj x u <;> by_cases hxv : G.Adj x v <;>
        simp [subconst_apply, adj_apply, huv, hxu, hxv]
    · intro b _ hb
      simp [subconst_apply, Ne.symm hb]
    · intro h
      exact absurd (Finset.mem_univ u) h
  · intro k _ hk
    simp [subconst_apply, hk]
  · intro h
    exact absurd (Finset.mem_univ v) h

/-- **Lemma 33.3 (i).**  `J̃² = k J̃`, where `k` is the valency of `Γ`. -/
theorem tildeJ_mul_tildeJ (Y : DRGData G x D) :
    Y.tildeJ * Y.tildeJ = (valency G x : ℂ) • Y.tildeJ := by
  ext u v
  rw [Matrix.mul_apply, Matrix.smul_apply, tildeJ_apply Y u v, smul_eq_mul]
  have hterm : ∀ k : X, Y.tildeJ u k * Y.tildeJ k v
      = (if G.dist x u = 1 then (1 : ℂ) else 0) * (if G.dist x v = 1 then 1 else 0)
        * (if G.dist x k = 1 then (1 : ℂ) else 0) := by
    intro k
    rw [tildeJ_apply Y u k, tildeJ_apply Y k v]
    by_cases hk : G.dist x k = 1 <;> simp [hk] <;> ring
  rw [Finset.sum_congr rfl (fun k _ => hterm k), ← Finset.mul_sum]
  by_cases hu : G.dist x u = 1
  · by_cases hv : G.dist x v = 1
    · have hcard : (∑ k : X, (if G.dist x k = 1 then (1 : ℂ) else 0))
          = (valency G x : ℂ) := by
        rw [sum_ite_one_eq_card (fun k => G.dist x k = 1)]
        show ((sphere G x 1).card : ℂ) = (valency G x : ℂ)
        rw [card_sphere_one]
      rw [hcard]; simp [hu, hv]
    · simp [hu, hv]
  · simp [hu]

/-- **Lemma 33.3 (ii), first half.**  `J̃Ã = a₁ J̃`, where `a₁ = anum G x y 1` is the
intersection number `a₁` (independent of the vertex `y` at distance `1` from `x` by
distance-regularity). -/
theorem tildeJ_mul_tildeA (Y : DRGData G x D) {y : X} (hy : G.Adj x y) :
    Y.tildeJ * Y.tildeA = (anum G x y 1 : ℂ) • Y.tildeJ := by
  have hd : G.dist x y = 1 := SimpleGraph.dist_eq_one_iff_adj.mpr hy
  ext u v
  rw [Matrix.mul_apply, Matrix.smul_apply, tildeJ_apply Y u v, smul_eq_mul]
  have hterm : ∀ k : X, Y.tildeJ u k * Y.tildeA k v
      = (if G.dist x u = 1 then (1 : ℂ) else 0) * (if G.dist x v = 1 then 1 else 0)
        * ((if G.dist x k = 1 then 1 else 0) * (if G.Adj k v then 1 else 0)) := by
    intro k
    rw [tildeJ_apply Y u k, tildeA_apply Y k v]
    by_cases hk : G.dist x k = 1 <;> simp [hk] <;> ring
  rw [Finset.sum_congr rfl (fun k _ => hterm k), ← Finset.mul_sum]
  by_cases hu : G.dist x u = 1
  · by_cases hv : G.dist x v = 1
    · have hcard : (∑ k : X, (if G.dist x k = 1 then (1 : ℂ) else 0)
          * (if G.Adj k v then 1 else 0)) = (anum G x v 1 : ℂ) := by
        rw [sum_ite_mul_ite (fun k => G.dist x k = 1) (fun k => G.Adj k v)]
        have hfil : (Finset.univ.filter fun k => G.dist x k = 1 ∧ G.Adj k v)
            = (Finset.univ.filter fun k => G.dist x k = 1 ∧ G.Adj v k) := by
          apply Finset.filter_congr
          intro k _
          exact ⟨fun h => ⟨h.1, h.2.symm⟩, fun h => ⟨h.1, h.2.symm⟩⟩
        rw [hfil]
        rfl
      rw [hcard]
      have hconst : anum G x v 1 = anum G x y 1 := by
        have h1 := sphereConst_anum (Y.drg x) hv
        have h2 := sphereConst_anum (Y.drg x) hd
        rw [h2] at h1
        exact h1.symm
      rw [hconst]; simp [hu, hv]
    · simp [hv]
  · simp [hu]

/-- **Lemma 33.3 (ii), second half.**  `ÃJ̃ = a₁ J̃`. -/
theorem tildeA_mul_tildeJ (Y : DRGData G x D) {y : X} (hy : G.Adj x y) :
    Y.tildeA * Y.tildeJ = (anum G x y 1 : ℂ) • Y.tildeJ := by
  have hd : G.dist x y = 1 := SimpleGraph.dist_eq_one_iff_adj.mpr hy
  ext u v
  rw [Matrix.mul_apply, Matrix.smul_apply, tildeJ_apply Y u v, smul_eq_mul]
  have hterm : ∀ k : X, Y.tildeA u k * Y.tildeJ k v
      = (if G.dist x u = 1 then (1 : ℂ) else 0) * (if G.dist x v = 1 then 1 else 0)
        * ((if G.dist x k = 1 then 1 else 0) * (if G.Adj u k then 1 else 0)) := by
    intro k
    rw [tildeA_apply Y u k, tildeJ_apply Y k v]
    by_cases hk : G.dist x k = 1 <;> simp only [hk, if_true, if_false] <;> split_ifs <;> ring
  rw [Finset.sum_congr rfl (fun k _ => hterm k), ← Finset.mul_sum]
  by_cases hu : G.dist x u = 1
  · by_cases hv : G.dist x v = 1
    · have hcard : (∑ k : X, (if G.dist x k = 1 then (1 : ℂ) else 0)
          * (if G.Adj u k then 1 else 0)) = (anum G x u 1 : ℂ) := by
        rw [sum_ite_mul_ite (fun k => G.dist x k = 1) (fun k => G.Adj u k)]
        rfl
      rw [hcard]
      have hconst : anum G x u 1 = anum G x y 1 := by
        have h1 := sphereConst_anum (Y.drg x) hu
        have h2 := sphereConst_anum (Y.drg x) hd
        rw [h2] at h1
        exact h1.symm
      rw [hconst]; simp [hu, hv]
    · simp [hv]
  · simp [hu]

/-- `E*₁Ã = Ã = ÃE*₁`. -/
theorem tildeA_mul_e1star (Y : DRGData G x D) :
    Y.tildeA * subconst (𝕜 := ℂ) G x 1 = Y.tildeA ∧
      subconst (𝕜 := ℂ) G x 1 * Y.tildeA = Y.tildeA := by
  constructor
  · rw [tildeA, mul_assoc, subconst_mul_self]
  · rw [tildeA, ← mul_assoc, ← mul_assoc, subconst_mul_self]

/-- `J̃E*₁ = J̃ = E*₁J̃`. -/
theorem tildeJ_mul_e1star (Y : DRGData G x D) :
    Y.tildeJ * subconst (𝕜 := ℂ) G x 1 = Y.tildeJ ∧
      subconst (𝕜 := ℂ) G x 1 * Y.tildeJ = Y.tildeJ := by
  constructor
  · rw [tildeJ, mul_assoc, subconst_mul_self]
  · rw [tildeJ, ← mul_assoc, ← mul_assoc, subconst_mul_self]

/-- `Ãⁱ⁺¹ E*₁ = Ãⁱ⁺¹`.  (For `i = 0` the corresponding identity `E*₁ = 1` is false,
so the identities involving `E*₁` are stated one step up.) -/
theorem tildeA_pow_succ_mul_e1star (Y : DRGData G x D) (i : ℕ) :
    Y.tildeA ^ (i + 1) * subconst (𝕜 := ℂ) G x 1 = Y.tildeA ^ (i + 1) := by
  rw [pow_succ, mul_assoc, (tildeA_mul_e1star Y).1]

/-- `E*₁ Ãⁱ⁺¹ = Ãⁱ⁺¹`. -/
theorem e1star_mul_tildeA_pow_succ (Y : DRGData G x D) (i : ℕ) :
    subconst (𝕜 := ℂ) G x 1 * Y.tildeA ^ (i + 1) = Y.tildeA ^ (i + 1) := by
  induction i with
  | zero => rw [pow_one, (tildeA_mul_e1star Y).2]
  | succ n ih => rw [pow_succ, ← mul_assoc, ih]

/-- `Ãⁱ J̃ = a₁ⁱ J̃`. -/
theorem tildeA_pow_mul_tildeJ (Y : DRGData G x D) {y : X} (hy : G.Adj x y) (i : ℕ) :
    Y.tildeA ^ i * Y.tildeJ = ((anum G x y 1 : ℂ) ^ i) • Y.tildeJ := by
  induction i with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, mul_assoc, tildeA_mul_tildeJ Y hy, Matrix.mul_smul, ih, smul_smul,
      mul_comm, ← pow_succ]

/-- `J̃ Ãⁱ = a₁ⁱ J̃`. -/
theorem tildeJ_mul_tildeA_pow (Y : DRGData G x D) {y : X} (hy : G.Adj x y) (i : ℕ) :
    Y.tildeJ * Y.tildeA ^ i = ((anum G x y 1 : ℂ) ^ i) • Y.tildeJ := by
  induction i with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, ← mul_assoc, ih, smul_mul_assoc, tildeJ_mul_tildeA Y hy,
      smul_smul, ← pow_succ]

/-- The spanning set of Lemma 33.4 (iii). -/
def e1starSpan (Y : DRGData G x D) : Submodule ℂ (Matrix X X ℂ) :=
  Submodule.span ℂ ((fun n : ℕ => Y.tildeA ^ n) '' Set.univ
    ∪ ({Y.tildeJ, subconst (𝕜 := ℂ) G x 1} : Set (Matrix X X ℂ)))

/-- **The last step of the proof of Lemma 33.4 (iii).**  The ℂ-algebra generated by
`J̃`, `E*₁` and `Ã` is contained in `Span{Ãⁿ : n} ∪ {J̃, E*₁}`: `Span{J̃}` is a
two-sided ideal (`J̃² = kJ̃`, `J̃Ãⁱ = ÃⁱJ̃ = a₁ⁱJ̃`) and `E*₁` is the identity of the
algebra generated by `Ã` (`ÃⁱE*₁ = E*₁Ãⁱ = Ãⁱ`).  Consequently the notes' steps
(i)+(ii) of lecture 33 (the ideal-theoretic part, needing the primitive idempotent
`E₁`) give `e1star_te1star_span` by pure algebra. -/
theorem adjoin_tildeJ_tildeA_e1star_le_e1starSpan {y : X} (hy : G.Adj x y) :
    (Algebra.adjoin ℂ
        ({Y.tildeJ, subconst (𝕜 := ℂ) G x 1, Y.tildeA} : Set (Matrix X X ℂ))
      : Set (Matrix X X ℂ)) ⊆ (e1starSpan Y : Set (Matrix X X ℂ)) := by
  set S : Set (Matrix X X ℂ) := (fun n : ℕ => Y.tildeA ^ n) '' Set.univ
    ∪ ({Y.tildeJ, subconst (𝕜 := ℂ) G x 1} : Set (Matrix X X ℂ)) with hS
  have hgen : ∀ a' ∈ S, ∀ b' ∈ S, a' * b' ∈ e1starSpan Y := by
    intro a' ha' b' hb'
    simp only [hS, Set.mem_union, Set.mem_image, Set.mem_univ, true_and,
      Set.mem_insert_iff, Set.mem_singleton_iff] at ha' hb'
    have hmem : ∀ n : ℕ, Y.tildeA ^ n ∈ e1starSpan Y := fun n =>
      Submodule.subset_span (Or.inl ⟨n, Set.mem_univ n, rfl⟩)
    have hJ : Y.tildeJ ∈ e1starSpan Y :=
      Submodule.subset_span (Or.inr (Or.inl rfl))
    have hE : subconst (𝕜 := ℂ) G x 1 ∈ e1starSpan Y :=
      Submodule.subset_span (Or.inr (Or.inr rfl))
    rcases ha' with ⟨i, rfl⟩ | rfl | rfl <;> rcases hb' with ⟨j, rfl⟩ | rfl | rfl
    · rw [← pow_add]; exact hmem _
    · rw [tildeA_pow_mul_tildeJ Y hy i]
      exact Submodule.smul_mem _ _ hJ
    · rcases i with _ | i
      · simpa using hE
      · rw [tildeA_pow_succ_mul_e1star Y i]; exact hmem _
    · rw [tildeJ_mul_tildeA_pow Y hy j]
      exact Submodule.smul_mem _ _ hJ
    · rw [tildeJ_mul_tildeJ Y]; exact Submodule.smul_mem _ _ hJ
    · rw [(tildeJ_mul_e1star Y).1]; exact hJ
    · rcases j with _ | j
      · simpa using hE
      · rw [e1star_mul_tildeA_pow_succ Y j]; exact hmem _
    · rw [(tildeJ_mul_e1star Y).2]; exact hJ
    · rw [subconst_mul_self]; exact hE
  have hclos : ∀ a b : Matrix X X ℂ, a ∈ e1starSpan Y → b ∈ e1starSpan Y →
      a * b ∈ e1starSpan Y := by
    intro a b ha hb
    induction ha using Submodule.span_induction with
    | mem x hx =>
      induction hb using Submodule.span_induction with
      | mem z hz => exact hgen x hx z hz
      | add u v _ _ hu hv => rw [mul_add]; exact Submodule.add_mem _ hu hv
      | zero => rw [mul_zero]; exact Submodule.zero_mem _
      | smul c u _ hu => rw [Matrix.mul_smul]; exact Submodule.smul_mem _ _ hu
    | add u v _ _ hu hv => rw [add_mul]; exact Submodule.add_mem _ hu hv
    | zero => rw [zero_mul]; exact Submodule.zero_mem _
    | smul c u _ hu => rw [Matrix.smul_mul]; exact Submodule.smul_mem _ _ hu
  intro a ha
  induction ha using Algebra.adjoin_induction with
  | mem z hz =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl
    · exact Submodule.subset_span (Or.inr (by simp))
    · exact Submodule.subset_span (Or.inr (by simp))
    · exact Submodule.subset_span (Or.inl ⟨1, Set.mem_univ 1, by simp⟩)
  | algebraMap r =>
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ _
      (Submodule.subset_span (Or.inl ⟨0, Set.mem_univ 0, by simp⟩))
  | add z w _ _ hz hw => exact Submodule.add_mem _ hz hw
  | mul z w _ _ hz hw => exact hclos z w hz hw

/-- **Lemma 33.4 (iii) reduced to the Chapter 33 ideal-theoretic step (ii).**  This is
the statement recorded in this file with the single remaining input `h`, which is what
lecture 33's Lemmas 33.1/33.2 (requiring the primitive idempotent `E₁` and the
Q-polynomial vanishing condition) provide. -/
theorem e1star_te1star_span_of_adjoin {y : X} (hy : G.Adj x y)
    (h : ∀ a ∈ (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra,
      subconst (𝕜 := ℂ) G x 1 * a * subconst (𝕜 := ℂ) G x 1 ∈
        Algebra.adjoin ℂ ({Y.tildeJ, subconst (𝕜 := ℂ) G x 1, Y.tildeA} : Set (Matrix X X ℂ))) :
    (∀ a ∈ (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra,
      subconst (𝕜 := ℂ) G x 1 * a * subconst (𝕜 := ℂ) G x 1 ∈
        Submodule.span ℂ ((fun n : ℕ => (Y.tildeA) ^ n) '' Set.univ
          ∪ ({Y.tildeJ, subconst (𝕜 := ℂ) G x 1} : Set (Matrix X X ℂ)))) :=
  fun a ha => adjoin_tildeJ_tildeA_e1star_le_e1starSpan Y hy (h a ha)
/-! ## Chapter 34: modules of endpoint one -/

/-- **Lemma 34.2.**  For `0 ≠ v ∈ (E*₁V)_new` an eigenvector of `Ã`, the module
`Tv` is irreducible, has `dim E*₁Tv = 1` and `dim E*_iTv ≤ 2` for
`2 ≤ i ≤ D - 1`. -/
theorem module_of_endpoint_one {v : X → ℂ} (hv : v ≠ 0)
    (hvnew : v ∈ Y.newSubconst 1) (a : ℂ) (hva : Y.tildeA *ᵥ v = a • v) :
    ∃ W : Submodule ℂ (X → ℂ),
      IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W ∧ v ∈ W ∧
      Module.finrank ℂ (subconstImage (𝕜 := ℂ) G x 1 W) = 1 ∧
      ∀ i : ℕ, 2 ≤ i → i ≤ D - 1 →
        Module.finrank ℂ (subconstImage (𝕜 := ℂ) G x i W) ≤ 2 := by
  sorry

/-! ## Chapter 35: `dim E*₁TE*₁ ≤ 5` -/

/-! ### Chapter 35, Claim 1: `E*₁ M E*₁ = Span(J̃, E*₁, Ã)`

The notes' proof of Theorem 35.1 starts by computing the `E*₁`-compression of the
Bose–Mesner algebra `M`: every `E*₁A_hE*₁` is a combination of `E*₁ = E*₁A₀E*₁`,
`Ã = E*₁A₁E*₁` and `E*₁A₂E*₁ = J̃ - E*₁ - Ã` (there are no pairs in the first
subconstituent at distance `≥ 3`).  That is the content of the lemmas below; the
remaining step of 35.1 — at most four thin irreducible `T`-modules of endpoint `1`,
hence `dim E*₁TE*₁ ≤ 5` — is *not* proved here. -/

/-- Entry formula for the compression `E*₁ M E*₁`. -/
theorem subconst_one_mul_mul_subconst_one_apply {G : SimpleGraph X} {x : X}
    (M : Matrix X X ℂ) (u v : X) :
    (subconst (𝕜 := ℂ) G x 1 * M * subconst (𝕜 := ℂ) G x 1) u v
      = (if G.dist x u = 1 then (1 : ℂ) else 0) * M u v
        * (if G.dist x v = 1 then (1 : ℂ) else 0) := by
  simp only [subconst]
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul]

/-- Entry formula for `E*₁ A_h E*₁`. -/
theorem subconst_one_mul_distMatrix_mul_subconst_one_apply {G : SimpleGraph X} {x : X}
    (h : ℕ) (u v : X) :
    (subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G h * subconst (𝕜 := ℂ) G x 1) u v
      = (if G.dist x u = 1 then (1 : ℂ) else 0) * (if G.dist u v = h then (1 : ℂ) else 0)
        * (if G.dist x v = 1 then (1 : ℂ) else 0) := by
  rw [subconst_one_mul_mul_subconst_one_apply, distMatrix_apply]

/-- `E*₁ A_h E*₁ = 0` for `h ≥ 3`: two vertices of the first subconstituent are at
distance at most `2`. -/
theorem subconst_one_mul_distMatrix_mul_subconst_one_eq_zero {G : SimpleGraph X} {x : X}
    (hG : G.Connected) {h : ℕ} (hh : 3 ≤ h) :
    subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G h * subconst (𝕜 := ℂ) G x 1 = 0 := by
  ext u v
  rw [subconst_one_mul_distMatrix_mul_subconst_one_apply, Matrix.zero_apply]
  have htri : G.dist u v ≤ G.dist x u + G.dist x v := by
    have h := hG.dist_triangle (u := u) (v := x) (w := v)
    rwa [SimpleGraph.dist_comm (u := u) (v := x)] at h
  by_cases hu : G.dist x u = 1
  · by_cases hv : G.dist x v = 1
    · rw [if_pos hu, if_pos hv, if_neg (by omega)]
      simp
    · rw [if_neg hv, mul_zero]
  · rw [if_neg hu, zero_mul, zero_mul]

/-- **Chapter 35, Claim 1 (the relation).**  `E*₁ (J - 1 - A) E*₁ = E*₁ A₂ E*₁`, because
inside the first subconstituent every two vertices are at distance `0`, `1` or `2`. -/
theorem subconst_one_mul_sub_eq_distMatrix_two {G : SimpleGraph X} {x : X} (hG : G.Connected) :
    subconst (𝕜 := ℂ) G x 1 * (allOnes (𝕜 := ℂ) - 1 - adj (𝕜 := ℂ) G)
        * subconst (𝕜 := ℂ) G x 1
      = subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1 := by
  ext u v
  rw [subconst_one_mul_mul_subconst_one_apply, Matrix.sub_apply, Matrix.sub_apply,
    Matrix.one_apply, allOnes_apply, adj_apply,
    subconst_one_mul_distMatrix_mul_subconst_one_apply]
  have htri : G.dist u v ≤ G.dist x u + G.dist x v := by
    have h := hG.dist_triangle (u := u) (v := x) (w := v)
    rwa [SimpleGraph.dist_comm (u := u) (v := x)] at h
  have hz : G.dist u v = 0 ↔ u = v := by
    rw [SimpleGraph.dist_eq_zero_iff_eq_or_not_reachable]
    exact ⟨fun h => h.resolve_right (fun hr => hr (hG u v)), fun h => Or.inl h⟩
  have hadj : (if G.Adj u v then (1 : ℂ) else 0) = (if G.dist u v = 1 then (1 : ℂ) else 0) := by
    by_cases h : G.Adj u v
    · rw [if_pos h, if_pos (SimpleGraph.dist_eq_one_iff_adj.mpr h)]
    · rw [if_neg h, if_neg (fun hd => h (SimpleGraph.dist_eq_one_iff_adj.mp hd))]
  rw [hadj]
  by_cases hu : G.dist x u = 1
  · by_cases hv : G.dist x v = 1
    · rw [if_pos hu, if_pos hv]
      have hcases : G.dist u v = 0 ∨ G.dist u v = 1 ∨ G.dist u v = 2 := by omega
      rcases hcases with h0 | h1 | h2
      · have huv : u = v := hz.mp h0
        rw [if_pos huv, if_neg (by omega), if_neg (by omega)]
        simp
      · have huv : u ≠ v := by
          intro h
          have hself : G.dist u u = 0 := by
            rw [SimpleGraph.dist_eq_zero_iff_eq_or_not_reachable]
            exact Or.inl rfl
          have h1' : G.dist u u = 1 := h ▸ h1
          rw [hself] at h1'
          exact absurd h1' (by decide)
        rw [if_neg huv, if_pos h1, if_neg (by omega)]
        simp
      · have huv : u ≠ v := by
          intro h
          have hself : G.dist u u = 0 := by
            rw [SimpleGraph.dist_eq_zero_iff_eq_or_not_reachable]
            exact Or.inl rfl
          have h2' : G.dist u u = 2 := h ▸ h2
          rw [hself] at h2'
          exact absurd h2' (by decide)
        rw [if_neg huv, if_neg (by omega), if_pos h2]
        simp
    · rw [if_neg hv]
      simp
  · rw [if_neg hu]
    simp

/-- `E*₁ (J - 1 - A) E*₁ = J̃ - E*₁ - Ã`. -/
theorem subconst_one_mul_sub_eq :
    subconst (𝕜 := ℂ) G x 1 * (allOnes (𝕜 := ℂ) - 1 - adj (𝕜 := ℂ) G)
        * subconst (𝕜 := ℂ) G x 1
      = Y.tildeJ - subconst (𝕜 := ℂ) G x 1 - Y.tildeA := by
  rw [show Y.tildeJ = subconst (𝕜 := ℂ) G x 1 * allOnes * subconst (𝕜 := ℂ) G x 1 from rfl,
    show Y.tildeA = subconst (𝕜 := ℂ) G x 1 * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x 1 from rfl,
    mul_sub, mul_sub, sub_mul, sub_mul, mul_one, subconst_mul_subconst, if_pos rfl]

/-- **Chapter 35, Claim 1 (final form).**  `J̃ = E*₁ + Ã + E*₁A₂E*₁`; combined with
`E*₁A_hE*₁ = 0` for `h ≥ 3` this says that the compression of the Bose–Mesner algebra is
spanned by `J̃`, `E*₁` and `Ã`. -/
theorem tildeJ_eq (hG : G.Connected) :
    Y.tildeJ = subconst (𝕜 := ℂ) G x 1 + Y.tildeA
      + subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1 := by
  have h1 := subconst_one_mul_sub_eq_distMatrix_two (G := G) (x := x) hG
  have h2 := subconst_one_mul_sub_eq (G := G) (x := x) (Y := Y)
  rw [h1] at h2
  rw [h2]
  abel


/-- `E*₁ A₂ E*₁ = J̃ - E*₁ - Ã`. -/
theorem subconst_one_mul_distMatrix_two_eq (hG : G.Connected) :
    subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1
      = Y.tildeJ - subconst (𝕜 := ℂ) G x 1 - Y.tildeA := by
  have h1 := subconst_one_mul_sub_eq_distMatrix_two (G := G) (x := x) hG
  have h2 := subconst_one_mul_sub_eq (G := G) (x := x) (Y := Y)
  rw [h1] at h2
  exact h2

/-- **Chapter 35, Claim 1 (membership form).**  Every `E*₁ A_h E*₁` lies in
`Span(J̃, E*₁, Ã)`. -/
theorem subconst_one_mul_distMatrix_mul_subconst_one_mem (hG : G.Connected) (h : ℕ) :
    subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G h * subconst (𝕜 := ℂ) G x 1
      ∈ Submodule.span ℂ ({Y.tildeJ, subconst (𝕜 := ℂ) G x 1, Y.tildeA} :
          Set (Matrix X X ℂ)) := by
  by_cases h0 : h = 0
  · subst h0
    rw [distMatrix_zero (𝕜 := ℂ) G hG, mul_one, subconst_mul_subconst, if_pos rfl]
    exact Submodule.subset_span (by simp)
  by_cases h1 : h = 1
  · subst h1
    rw [distMatrix_one (𝕜 := ℂ) G]
    exact Submodule.subset_span (by simp [DRGData.tildeA])
  by_cases h2 : h = 2
  · subst h2
    rw [subconst_one_mul_distMatrix_two_eq (G := G) (x := x) (Y := Y) hG]
    exact Submodule.sub_mem _ (Submodule.sub_mem _
      (Submodule.subset_span (by simp)) (Submodule.subset_span (by simp)))
      (Submodule.subset_span (by simp))
  · rw [subconst_one_mul_distMatrix_mul_subconst_one_eq_zero (G := G) (x := x) hG
      (h := h) (by omega)]
    exact Submodule.zero_mem _

/-- **Chapter 35, Claim 1** (the notes' equality `E*₁ M E*₁ = Span(J̃, E*₁, Ã)`). -/
theorem subconst_one_boseMesner_span_eq (hG : G.Connected) :
    Submodule.span ℂ (Set.range fun h : ℕ =>
        subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G h * subconst (𝕜 := ℂ) G x 1)
      = Submodule.span ℂ ({Y.tildeJ, subconst (𝕜 := ℂ) G x 1, Y.tildeA} :
          Set (Matrix X X ℂ)) := by
  classical
  set Fr : Set (Matrix X X ℂ) := Set.range fun h : ℕ =>
    subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G h * subconst (𝕜 := ℂ) G x 1 with hFr
  have key : ∀ h : ℕ, subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G h
      * subconst (𝕜 := ℂ) G x 1 ∈ Submodule.span ℂ Fr := by
    intro h
    refine Submodule.subset_span ?_
    rw [hFr]
    exact Set.mem_range_self h
  have h0 : subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G 0 * subconst (𝕜 := ℂ) G x 1
      = subconst (𝕜 := ℂ) G x 1 := by
    rw [distMatrix_zero (𝕜 := ℂ) G hG, mul_one, subconst_mul_subconst, if_pos rfl]
  have h1 : subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G 1 * subconst (𝕜 := ℂ) G x 1
      = Y.tildeA := by
    rw [distMatrix_one (𝕜 := ℂ) G]
    rfl
  refine le_antisymm ?_ ?_
  · rw [hFr]
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨h, rfl⟩
    exact subconst_one_mul_distMatrix_mul_subconst_one_mem (G := G) (x := x) (Y := Y) hG h
  · refine Submodule.span_le.mpr ?_
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    have m0 : subconst (𝕜 := ℂ) G x 1 ∈ Submodule.span ℂ Fr := by
      rw [← h0]; exact key 0
    have m1 : Y.tildeA ∈ Submodule.span ℂ Fr := by
      rw [← h1]; exact key 1
    have hJ : Y.tildeJ = subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G 0
          * subconst (𝕜 := ℂ) G x 1
        + subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G 1 * subconst (𝕜 := ℂ) G x 1
        + subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1 := by
      rw [tildeJ_eq (G := G) (x := x) (Y := Y) hG, h0, h1]
    have mJ : Y.tildeJ ∈ Submodule.span ℂ Fr := by
      rw [hJ]
      exact Submodule.add_mem _ (Submodule.add_mem _ (key 0) (key 1)) (key 2)
    rcases ha with rfl | rfl | rfl
    · exact mJ
    · exact m0
    · exact m1

/-! ### Products of distance matrices (the intersection-number calculus)

`AᵢAⱼ` lies in the Bose–Mesner algebra and hence is a `ℂ`-combination of the distance
matrices: the intersection numbers `p^h_{ij}` exist (`distMatrix_mul_mem_boseMesner`,
`distMatrix_mul_mem_span`), and consequently the entries of `AᵢAⱼ` depend only on the
distance of the pair (`distMatrix_mul_apply_eq_of_dist`).  This is the input the Chapter 33
and Chapter 35 entry counts (three-point counts `|Γ_{i-1}(y) ∩ Γ_i(x) ∩ Γ_{i-1}(z)|`) take
for granted. -/

/-- **Products of distance matrices stay in the Bose–Mesner algebra** — the first step of the
intersection-number calculus `AᵢAⱼ = ∑ₕ p^h_{ij}Aₕ`.  Both factors are polynomials in `A`
(`distMatrix_eq_polynomial`), and the Bose–Mesner algebra is closed under multiplication. -/
theorem distMatrix_mul_mem_boseMesner {G : SimpleGraph X} {x : X} (hG : G.Connected)
    (hdr : IsDistanceRegular G) (hbi : IntersectionNumbersIndependent G) (i j : ℕ) :
    distMatrix (𝕜 := ℂ) G i * distMatrix (𝕜 := ℂ) G j ∈ boseMesner (𝕜 := ℂ) G :=
  mul_mem (distMatrix_mem_boseMesner (x := x) hG hdr hbi i)
    (distMatrix_mem_boseMesner (x := x) hG hdr hbi j)

/-- **Products of distance matrices are `ℂ`-combinations of distance matrices**, i.e. the
intersection numbers `p^h_{ij}` exist (`AᵢAⱼ = ∑ₕ p^h_{ij}Aₕ` for some coefficients). -/
theorem distMatrix_mul_mem_span {G : SimpleGraph X} {x : X} (hG : G.Connected)
    (hdr : IsDistanceRegular G) (hbi : IntersectionNumbersIndependent G) {D : ℕ}
    (hD1 : 1 ≤ D) (hD : ∀ a b : X, G.dist a b ≤ D) (i j : ℕ) :
    distMatrix (𝕜 := ℂ) G i * distMatrix (𝕜 := ℂ) G j ∈
      Submodule.span ℂ (Set.range fun h : Fin (D + 1) => distMatrix (𝕜 := ℂ) G h) := by
  rw [← boseMesner_eq_span_distMatrix (x := x) hG hdr hbi D hD1 hD]
  exact distMatrix_mul_mem_boseMesner (x := x) hG hdr hbi i j

/-- **Elements of the span of the distance matrices are constant on distance classes.**  This
is the general form of `distMatrix_mul_apply_eq_of_dist`: every `M ∈ Span{A₀,…,A_D}`, in
particular every matrix of the Bose–Mesner algebra, has `M_{ab}` depending only on `∂(a,b)`. -/
theorem mem_span_distMatrix_apply_eq_of_dist {G : SimpleGraph X} {D : ℕ}
    {M : Matrix X X ℂ}
    (hM : M ∈ Submodule.span ℂ (Set.range fun h : Fin (D + 1) => distMatrix (𝕜 := ℂ) G h)) :
    ∀ a b a' b' : X, G.dist a b = G.dist a' b' → M a b = M a' b' := by
  induction hM using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨h, rfl⟩ := hy
    intro a b a' b' hd
    show distMatrix (𝕜 := ℂ) G (h : ℕ) a b = distMatrix (𝕜 := ℂ) G (h : ℕ) a' b'
    rw [distMatrix_apply, distMatrix_apply, hd]
  | zero => intro a b a' b' _; rw [Matrix.zero_apply, Matrix.zero_apply]
  | add u v _ _ hu hv =>
    intro a b a' b' hd
    rw [Matrix.add_apply, Matrix.add_apply, hu a b a' b' hd, hv a b a' b' hd]
  | smul c u _ hu =>
    intro a b a' b' hd
    rw [Matrix.smul_apply, Matrix.smul_apply, hu a b a' b' hd]

/-- **The `p^h_{ij}` are constant on distance classes**: the entries of a product of two
distance matrices depend only on the distance of the pair. -/
theorem distMatrix_mul_apply_eq_of_dist {G : SimpleGraph X} {x : X} (hG : G.Connected)
    (hdr : IsDistanceRegular G) (hbi : IntersectionNumbersIndependent G) {D : ℕ}
    (hD1 : 1 ≤ D) (hD : ∀ a b : X, G.dist a b ≤ D) {i j : ℕ} :
    ∀ a b a' b' : X, G.dist a b = G.dist a' b' →
      (distMatrix (𝕜 := ℂ) G i * distMatrix (𝕜 := ℂ) G j) a b
        = (distMatrix (𝕜 := ℂ) G i * distMatrix (𝕜 := ℂ) G j) a' b' := by
  have hP : ∀ M ∈ Submodule.span ℂ (Set.range fun h : Fin (D + 1) => distMatrix (𝕜 := ℂ) G h),
      ∀ a b a' b' : X, G.dist a b = G.dist a' b' → M a b = M a' b' := by
    intro M hM
    induction hM using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨h, rfl⟩ := hy
      intro a b a' b' hd
      show distMatrix (𝕜 := ℂ) G (h : ℕ) a b = distMatrix (𝕜 := ℂ) G (h : ℕ) a' b'
      rw [distMatrix_apply, distMatrix_apply, hd]
    | zero => intro a b a' b' _; rw [Matrix.zero_apply, Matrix.zero_apply]
    | add u v _ _ hu hv =>
      intro a b a' b' hd
      rw [Matrix.add_apply, Matrix.add_apply, hu a b a' b' hd, hv a b a' b' hd]
    | smul c u _ hu =>
      intro a b a' b' hd
      rw [Matrix.smul_apply, Matrix.smul_apply, hu a b a' b' hd]
  exact hP _ (distMatrix_mul_mem_span (x := x) hG hdr hbi hD1 hD i j)

/-! ### Chapter 35, the dimension bookkeeping of Theorem 35.1 (ii)

The notes derive `dim E*₁TE*₁ ≤ 5` from two inputs:

1. **Theorem 35.1 (i)** (lecture 35, Claims 3–5): for each thin irreducible `T`-module `W` of
   endpoint `1` with `0 ≠ v ∈ E*₁W` and `λ = a₀(W)`, thinness forces the two vectors
   `v⁺ᵢ = E*_iA_{i-1}v` and `v⁻ᵢ = E*_iA_{i+1}v` to be linearly dependent (Lemma 34 `tv` (ii)),
   so the Gram determinant `Φᵢ(λ) = p⁺⁺(λ)p⁻⁻(λ) - (p²_{i-1,i+1})²(λ+1)²` vanishes.  The
   coefficients `p⁺⁺, p⁻⁻, p⁺⁻` are read off from the entries of `E*₁A_{i-1}E*_iA_{i±1}E*₁`
   (a three-point count with the DRG intersection numbers), so `λ` is a root of one fixed
   quartic `Φᵢ` and there are at most four such `W` up to isomorphism.
2. **Lemma 34 `tv` (iv)** — the module decomposition `E*₁V = ⊕_W E*₁W` with each `E*₁W` a line
   (thinness) on which `Ã = E*₁AE*₁` acts by the scalar `a₀(W)`.

This file's Chapter 35 goal is the compressed form of `(ii)`, namely
`dim Span{Ãⁿ : n} ∪ {J̃, E*₁} ≤ 5` (`e1starSpan`).  What is proved below is the *linear algebra
of the reduction*: a nonzero polynomial of degree `d` annihilating `Ã` (only on `E*₁V`, which
is enough, since `p(Ã)` is `E*₁`-sandwiched when `p(0) = 0`) bounds the dimension by `d`, and
`J̃`, `E*₁` contribute at most one dimension each unless they are themselves polynomials in
`Ã`.  Consequently `dim E*₁Span ≤ 5` follows from a degree-`5` annihilator of `Ã` together
with `J̃, E*₁ ∈ ℂ[Ã]` (`e1starSpan_le_five_of_quartic_on_e1star`).  Neither input is formalised
here; see the gap note on `dim_e1star_te1star_le_five` for what remains and why.

Note that the notes' quartic route uses the `Q`-polynomial expression `E₁ = |X|⁻¹∑θ*_iA_i`
(via Lemma 33.2 `eonemmstar`, Chapter 33); `DRGData` carries `θ*` as a bare function without
the `Q`-polynomial relations, so this is where a `Q`-polynomial hypothesis would have to
enter a completed proof. -/

/-- **Polynomial-annihilator engine.**  If a matrix satisfies a nonzero polynomial of
degree `d`, then the span of its nonnegative powers is at most `d`-dimensional (the
powers from `d` on are linear combinations of `1, M, …, M^{d-1}`). -/
theorem pow_mem_span_of_aeval_eq_zero {M : Matrix X X ℂ} {p : Polynomial ℂ} (hp : p ≠ 0)
    (hann : Polynomial.aeval M p = 0) (n : ℕ) :
    M ^ n ∈ Submodule.span ℂ (Set.range fun i : Fin p.natDegree => M ^ (i : ℕ)) := by
  classical
  set d := p.natDegree with hd
  have hc : p.coeff d ≠ 0 := by
    rw [hd, Polynomial.coeff_natDegree]
    exact Polynomial.leadingCoeff_ne_zero.mpr hp
  have hsum : ∑ i ∈ Finset.range (d + 1), p.coeff i • M ^ i = 0 := by
    rw [← hann, Polynomial.aeval_eq_sum_range]
  have hsum' : (∑ i ∈ Finset.range d, p.coeff i • M ^ i) + p.coeff d • M ^ d = 0 := by
    rw [← hsum, Finset.sum_range_succ]
  have hstep : p.coeff d • M ^ d = -(∑ i ∈ Finset.range d, p.coeff i • M ^ i) := by
    rw [eq_neg_iff_add_eq_zero, add_comm]
    exact hsum'
  have hdmem : M ^ d ∈ Submodule.span ℂ (Set.range fun i : Fin d => M ^ (i : ℕ)) := by
    have h1 : M ^ d = (p.coeff d)⁻¹ • (p.coeff d • M ^ d) := by
      rw [smul_smul, inv_mul_cancel₀ hc, one_smul]
    rw [h1, hstep]
    refine Submodule.smul_mem _ _ (Submodule.neg_mem _ (Submodule.sum_mem _ ?_))
    intro i hi
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨⟨i, Finset.mem_range.mp hi⟩, rfl⟩)
  have hclos : ∀ x ∈ Submodule.span ℂ (Set.range fun i : Fin d => M ^ (i : ℕ)),
      x * M ∈ Submodule.span ℂ (Set.range fun i : Fin d => M ^ (i : ℕ)) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨i, rfl⟩ := hy
      show M ^ (i : ℕ) * M ∈ Submodule.span ℂ (Set.range fun i : Fin d => M ^ (i : ℕ))
      rw [← pow_succ]
      rcases Nat.lt_or_eq_of_le (Nat.succ_le_of_lt i.isLt) with h | h
      · exact Submodule.subset_span ⟨⟨(i : ℕ) + 1, h⟩, rfl⟩
      · rw [show (i : ℕ) + 1 = d by omega]; exact hdmem
    | zero => rw [zero_mul]; exact Submodule.zero_mem _
    | add u v _ _ hu hv => rw [add_mul]; exact Submodule.add_mem _ hu hv
    | smul c u _ hu => rw [Matrix.smul_mul]; exact Submodule.smul_mem _ _ hu
  rcases Nat.lt_or_ge n d with hn | hn
  · exact Submodule.subset_span ⟨⟨n, hn⟩, rfl⟩
  · obtain ⟨k, rfl⟩ : ∃ k, n = d + k := ⟨n - d, by omega⟩
    clear hn
    induction k with
    | zero => simpa using hdmem
    | succ k ihk =>
      rw [show d + (k + 1) = (d + k) + 1 by omega, pow_succ]
      exact hclos _ ihk

/-- **Theorem 35.1 (ii), engine form.**  A nonzero polynomial of degree `d` annihilating a
matrix bounds the dimension of the span of its powers by `d`. -/
theorem finrank_span_powers_le_of_aeval_eq_zero {M : Matrix X X ℂ} {p : Polynomial ℂ}
    (hp : p ≠ 0) (hann : Polynomial.aeval M p = 0) :
    Module.finrank ℂ (Submodule.span ℂ (Set.range fun n : ℕ => M ^ n)) ≤ p.natDegree := by
  classical
  set T : Submodule ℂ (Matrix X X ℂ) :=
    Submodule.span ℂ (Set.range fun i : Fin p.natDegree => M ^ (i : ℕ)) with hT
  have hle : Submodule.span ℂ (Set.range fun n : ℕ => M ^ n) ≤ T := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨n, rfl⟩
    exact pow_mem_span_of_aeval_eq_zero hp hann n
  have hfin : Module.finrank ℂ T ≤ p.natDegree := by
    have h := finrank_span_le_card (R := ℂ) (M := Matrix X X ℂ)
      (s := Set.range fun i : Fin p.natDegree => M ^ (i : ℕ))
    have hcard : (Set.range fun i : Fin p.natDegree => M ^ (i : ℕ)).toFinset.card
        ≤ p.natDegree := by
      rw [Set.toFinset_range]
      calc (Finset.image (fun i : Fin p.natDegree => M ^ (i : ℕ)) Finset.univ).card
          ≤ (Finset.univ : Finset (Fin p.natDegree)).card := Finset.card_image_le
        _ = p.natDegree := by simp
    exact le_trans h hcard
  exact le_trans (Submodule.finrank_mono hle) hfin


/-- **The three pieces of `E*₁Span`**, cf. Lemma 33.4 (iii): `E*₁Span = ℂ[Ã] + ℂJ̃ + ℂE*₁`. -/
theorem e1starSpan_eq_sup (Y : DRGData G x D) :
    Y.e1starSpan = Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n)
      ⊔ Submodule.span ℂ ({Y.tildeJ} : Set (Matrix X X ℂ))
      ⊔ Submodule.span ℂ ({subconst (𝕜 := ℂ) G x 1} : Set (Matrix X X ℂ)) := by
  rw [DRGData.e1starSpan, Set.image_univ, Submodule.span_union, Submodule.span_insert,
    sup_assoc]

/-- **Theorem 35.1 (ii), reduction to an annihilating polynomial.**  `E*₁Span` is the span
of `{Ãⁿ : n} ∪ {J̃, E*₁}`; the `Ã`-powers contribute at most `deg p` dimensions and the two
remaining generators at most one each. -/
theorem finrank_e1starSpan_le_of_annihilator (Y : DRGData G x D) {p : Polynomial ℂ}
    (hp : p ≠ 0) (hann : Polynomial.aeval Y.tildeA p = 0) :
    Module.finrank ℂ Y.e1starSpan ≤ p.natDegree + 2 := by
  classical
  rw [e1starSpan_eq_sup]
  have h1 : Module.finrank ℂ ↥(Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n)
        ⊔ Submodule.span ℂ ({Y.tildeJ} : Set (Matrix X X ℂ))
        ⊔ Submodule.span ℂ ({subconst (𝕜 := ℂ) G x 1} : Set (Matrix X X ℂ)))
      ≤ Module.finrank ℂ ↥(Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n)
          ⊔ Submodule.span ℂ ({Y.tildeJ} : Set (Matrix X X ℂ)))
        + Module.finrank ℂ ↥(Submodule.span ℂ ({subconst (𝕜 := ℂ) G x 1} :
            Set (Matrix X X ℂ))) :=
    Submodule.finrank_add_le_finrank_add_finrank _ _
  have h2 : Module.finrank ℂ ↥(Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n)
        ⊔ Submodule.span ℂ ({Y.tildeJ} : Set (Matrix X X ℂ)))
      ≤ Module.finrank ℂ ↥(Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n))
        + Module.finrank ℂ ↥(Submodule.span ℂ ({Y.tildeJ} : Set (Matrix X X ℂ))) :=
    Submodule.finrank_add_le_finrank_add_finrank _ _
  have h3 : Module.finrank ℂ ↥(Submodule.span ℂ ({Y.tildeJ} : Set (Matrix X X ℂ))) ≤ 1 := by
    have h := finrank_span_le_card (R := ℂ) (M := Matrix X X ℂ)
      (s := ({Y.tildeJ} : Set (Matrix X X ℂ)))
    simpa using h
  have h4 : Module.finrank ℂ ↥(Submodule.span ℂ ({subconst (𝕜 := ℂ) G x 1} :
      Set (Matrix X X ℂ))) ≤ 1 := by
    have h := finrank_span_le_card (R := ℂ) (M := Matrix X X ℂ)
      (s := ({subconst (𝕜 := ℂ) G x 1} : Set (Matrix X X ℂ)))
    simpa using h
  have h5 : Module.finrank ℂ ↥(Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n))
      ≤ p.natDegree := finrank_span_powers_le_of_aeval_eq_zero hp hann
  omega

/-- **Theorem 35.1 (ii), reduction when `J̃` and `E*₁` are polynomials in `Ã`.** -/
theorem finrank_e1starSpan_le_of_annihilator_of_mem (Y : DRGData G x D) {p : Polynomial ℂ}
    (hp : p ≠ 0) (hann : Polynomial.aeval Y.tildeA p = 0)
    (hJ : Y.tildeJ ∈ Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n))
    (hE : subconst (𝕜 := ℂ) G x 1 ∈ Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n)) :
    Module.finrank ℂ Y.e1starSpan ≤ p.natDegree := by
  classical
  set S₀ : Submodule ℂ (Matrix X X ℂ) :=
    Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n) with hS₀
  have hsub : Y.e1starSpan ≤ S₀ := by
    rw [e1starSpan_eq_sup]
    refine sup_le ?_ ?_
    · refine sup_le ?_ ?_
      · exact le_of_eq hS₀.symm
      · exact Submodule.span_le.mpr (by rintro _ rfl; exact hJ)
    · exact Submodule.span_le.mpr (by rintro _ rfl; exact hE)
  have h := finrank_span_powers_le_of_aeval_eq_zero (M := Y.tildeA) hp hann
  have hfin : Module.finrank ℂ S₀ ≤ p.natDegree := by rw [hS₀]; exact h
  exact le_trans (Submodule.finrank_mono hsub) hfin

/-- **The reduced endgame of 35.1 (ii).**  A degree-`5` annihilator of `Ã` (in the notes:
`x·Φᵢ`, the quartic `Φᵢ` of Claim 5 times the eigenvalue `0` of the orthogonal complement of
`E*₁V`) together with `J̃, E*₁ ∈ ℂ[Ã]` gives `dim E*₁Span ≤ 5`. -/
theorem e1starSpan_le_five_of_quartic (Y : DRGData G x D) {p : Polynomial ℂ}
    (hp : p ≠ 0) (hdeg : p.natDegree ≤ 5) (hann : Polynomial.aeval Y.tildeA p = 0)
    (hJ : Y.tildeJ ∈ Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n))
    (hE : subconst (𝕜 := ℂ) G x 1 ∈ Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n)) :
    Module.finrank ℂ Y.e1starSpan ≤ 5 :=
  le_trans (finrank_e1starSpan_le_of_annihilator_of_mem Y hp hann hJ hE) hdeg

/-- `Ã^i` is `E*₁`-sandwiched for `i ≥ 1`. -/
theorem e1star_sandwich_tildeA_pow (Y : DRGData G x D) {i : ℕ} (hi : 1 ≤ i) :
    subconst (𝕜 := ℂ) G x 1 * Y.tildeA ^ i * subconst (𝕜 := ℂ) G x 1 = Y.tildeA ^ i := by
  obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by omega⟩
  rw [Y.e1star_mul_tildeA_pow_succ k, Y.tildeA_pow_succ_mul_e1star k]

/-- If `p` has zero constant term then `p(Ã)` is `E*₁`-sandwiched: `p(Ã) = E*₁p(Ã)E*₁`.
Consequently `p(Ã)` is determined by its restriction to `E*₁V`. -/
theorem aeval_tildeA_eq_sandwich (Y : DRGData G x D) {p : Polynomial ℂ} (h0 : p.coeff 0 = 0) :
    Polynomial.aeval Y.tildeA p
      = subconst (𝕜 := ℂ) G x 1 * Polynomial.aeval Y.tildeA p * subconst (𝕜 := ℂ) G x 1 := by
  classical
  rw [Polynomial.aeval_eq_sum_range, Finset.sum_range_succ', h0, zero_smul, add_zero,
    Finset.mul_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl ?_
  intro i _
  rw [Matrix.mul_smul, Matrix.smul_mul, e1star_sandwich_tildeA_pow Y (i := i + 1) (by omega)]

/-- **Theorem 35.1 (ii): the quartic only needs to annihilate `E*₁V`.**  A polynomial with
zero constant term that annihilates `Ã` on `E*₁V` annihilates `Ã` on the whole space. -/
theorem aeval_tildeA_eq_zero_of_kills_e1star (Y : DRGData G x D) {p : Polynomial ℂ}
    (h0 : p.coeff 0 = 0)
    (hk : ∀ v : X → ℂ, subconst (𝕜 := ℂ) G x 1 *ᵥ v = v →
      Polynomial.aeval Y.tildeA p *ᵥ v = 0) :
    Polynomial.aeval Y.tildeA p = 0 := by
  have hsw := aeval_tildeA_eq_sandwich Y h0
  have hpt : ∀ w : X → ℂ, Polynomial.aeval Y.tildeA p *ᵥ w = 0 := by
    intro w
    rw [hsw, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
    have hv : subconst (𝕜 := ℂ) G x 1 *ᵥ (subconst (𝕜 := ℂ) G x 1 *ᵥ w)
        = subconst (𝕜 := ℂ) G x 1 *ᵥ w := by
      rw [Matrix.mulVec_mulVec, subconst_mul_self]
    rw [hk _ hv, Matrix.mulVec_zero]
  ext i j
  have h := congrFun (hpt (Pi.single j 1)) i
  simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using h

/-- **Theorem 35.1 (ii), sharp form of the reduction.** -/
theorem e1starSpan_le_five_of_quartic_on_e1star (Y : DRGData G x D) {p : Polynomial ℂ}
    (hp : p ≠ 0) (h0 : p.coeff 0 = 0) (hdeg : p.natDegree ≤ 5)
    (hk : ∀ v : X → ℂ, subconst (𝕜 := ℂ) G x 1 *ᵥ v = v →
      Polynomial.aeval Y.tildeA p *ᵥ v = 0)
    (hJ : Y.tildeJ ∈ Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n))
    (hE : subconst (𝕜 := ℂ) G x 1 ∈ Submodule.span ℂ (Set.range fun n : ℕ => Y.tildeA ^ n)) :
    Module.finrank ℂ Y.e1starSpan ≤ 5 :=
  e1starSpan_le_five_of_quartic Y hp hdeg
    (aeval_tildeA_eq_zero_of_kills_e1star Y h0 hk) hJ hE

/-- **Theorem 35.1 (ii).**  If `Γ` is thin with respect to `x` then `dim E*₁TE*₁ ≤ 5`,
here in the equivalent compressed form `dim Span{Ãⁿ : n} ∪ {J̃, E*₁} ≤ 5`.

