/-- **Lemma 33.2 (i)** (the notes' `eonemmstar`), generator form:
`E*_1 m E*_h ∈ Rspan` for `m ∈ M`. -/
theorem eonemmstar {Y : DRGData G x D} (hG : G.Connected)
    (hbi : IntersectionNumbersIndependent G) (hθ : Function.Injective Y.thetaStar)
    (hDall : ∀ a b : X, G.dist a b ≤ D) {m : Matrix X X ℂ}
    (hm : m ∈ MbSub G) (h : ℕ) :
    Y.Fe * m * subconst (𝕜 := ℂ) G x h ∈ Rspan Y := by
  set R : Submodule ℂ (Matrix X X ℂ) := Rspan Y with hR
  have hspaneq := boseMesner_eq_span_distMatrix (x := x) hG Y.drg hbi D (by have := Y.hD; omega) hDall
  have hs : m ∈ Submodule.span ℂ (Set.range fun i : Fin (D + 1) => distMatrix (𝕜 := ℂ) G i) := by
    rw [← hspaneq]
    exact hm
  clear hm
  induction hs using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨i, rfl⟩ := hz
      exact hR ▸ Fe_A_estar_mem hG hbi hθ hDall i h
  | zero => simp only [zero_mul, Matrix.mul_zero]; exact Submodule.zero_mem R
  | add u v _ _ hu hv =>
      rw [mul_add, add_mul]
      exact Submodule.add_mem _ hu hv
  | smul c u _ hu =>
      rw [Matrix.mul_smul, Matrix.smul_mul]
      exact Submodule.smul_mem _ _ hu

