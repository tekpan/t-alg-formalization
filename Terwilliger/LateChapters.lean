/-! ### Chapter 40, supporting calculus for `zi_independent`

Lecture 40 proves 40.4 by identifying `zᵢ(x,y,z)` with the `(z,x)`-entry of the matrix
`Δ = E*_{i-1}(y)A_{i-1}E*_1(y)AE*_1(y)` (`ziDelta` below) and then reading off that this entry
is determined by the intersection numbers together with `Ψ(x,y)`.  The first half — the
entry-vs-count identification — is a purely combinatorial matrix-entry computation and is
carried out here in full (`ziDelta_apply`).  The second half needs the `δ^±`/`Ψ` machinery of
lectures 38–39 and is not available in this library yet; see the gap note on `zi_independent`.

`zi_count_split` is the other half of the combinatorial picture: in the configuration of 40.4
every common neighbour of `x` and `y` is at distance `i - 1` or `i` from `z`, so `zᵢ` is
`a₁ = |{w ∼ x, w ∼ y}|` minus the common neighbours at distance `i`.  This shows exactly where
the Q-polynomial hypothesis has to enter: the `2 × 3` table of the neighbours of `y` classified
by `(∂(x,·), ∂(z,·))` has both row and column sums given by intersection numbers and one forced
zero entry, which leaves a single free parameter — the distance-`i` count.  Distance-regularity
alone does not determine it; `Ψ` does. -/

/-- The Chapter 40 matrix `Δ = E*_{i-1}(y)A_{i-1}E*_1(y)AE*_1(y)`. -/
def ziDelta (G : SimpleGraph X) (y : X) (i : ℕ) : Matrix X X ℂ :=
  subconst (𝕜 := ℂ) G y (i - 1) * distMatrix (𝕜 := ℂ) G (i - 1)
    * subconst (𝕜 := ℂ) G y 1 * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G y 1

/-- **Chapter 40, the entry-vs-count identification.**  For adjacent vertices `x, y` and a
vertex `z` with `∂(y,z) = i - 1`, the `(z,x)`-entry of `Δ` counts the vertices `w` adjacent to
both `x` and `y` with `∂(z,w) = i - 1` — that is, `zᵢ(x,y,z)`. -/
theorem ziDelta_apply {G : SimpleGraph X} {x y z : X} {i : ℕ}
    (hxy : G.Adj x y) (hyz : G.dist y z = i - 1) :
    ziDelta G y i z x
      = ((Finset.univ.filter fun w => G.Adj x w ∧ G.Adj y w ∧ G.dist z w = i - 1).card : ℂ) := by
  have hchain : ziDelta G y i = subconst (𝕜 := ℂ) G y (i - 1)
      * (distMatrix (𝕜 := ℂ) G (i - 1)
        * (subconst (𝕜 := ℂ) G y 1 * (adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G y 1))) := by
    simp only [ziDelta, Matrix.mul_assoc]
  rw [hchain, subconst_mul_apply, Matrix.mul_apply]
  simp only [distMatrix_apply, subconst_mul_apply, mul_subconst_apply, adj_apply]
  have hdist : G.dist y x = 1 := by
    rw [SimpleGraph.dist_comm]; exact SimpleGraph.dist_eq_one_iff_adj.mpr hxy
  rw [if_pos hyz, one_mul, if_pos hdist]
  simp only [mul_one]
  have hterm : ∀ u : X,
      (if G.dist z u = i - 1 then (1 : ℂ) else 0)
        * ((if G.dist y u = 1 then (1 : ℂ) else 0) * (if G.Adj u x then (1 : ℂ) else 0))
      = if (G.Adj u x ∧ G.dist y u = 1 ∧ G.dist z u = i - 1) then 1 else 0 := by
    intro u
    by_cases h1 : G.dist z u = i - 1 <;> by_cases h2 : G.dist y u = 1 <;>
      by_cases h3 : G.Adj u x <;> simp [h1, h2, h3]
  calc (∑ u, (if G.dist z u = i - 1 then (1 : ℂ) else 0)
        * ((if G.dist y u = 1 then (1 : ℂ) else 0) * (if G.Adj u x then (1 : ℂ) else 0)))
      = ∑ u, (if (G.Adj u x ∧ G.dist y u = 1 ∧ G.dist z u = i - 1) then (1 : ℂ) else 0) :=
        Finset.sum_congr rfl fun u _ => hterm u
    _ = ((Finset.univ.filter fun u =>
          G.Adj u x ∧ G.dist y u = 1 ∧ G.dist z u = i - 1).card : ℂ) := Finset.sum_boole _ _
    _ = ((Finset.univ.filter fun w => G.Adj x w ∧ G.Adj y w ∧ G.dist z w = i - 1).card : ℂ) := by
        have hf : (Finset.univ.filter fun u =>
              G.Adj u x ∧ G.dist y u = 1 ∧ G.dist z u = i - 1)
            = (Finset.univ.filter fun w => G.Adj x w ∧ G.Adj y w ∧ G.dist z w = i - 1) := by
          apply Finset.filter_congr
          intro u _
          rw [SimpleGraph.adj_comm, SimpleGraph.dist_eq_one_iff_adj]
        rw [hf]

/-- **Chapter 40, the level dichotomy.**  In the configuration of 40.4 every common neighbour
`w` of `x` and `y` satisfies `∂(z,w) ∈ {i-1, i}`. -/
theorem zi_dist_dichotomy {G : SimpleGraph X} (hG : G.Connected) {x y z w : X} {i : ℕ}
    (hi : 2 ≤ i) (hxy : G.Adj x y) (hxw : G.Adj x w) (hyw : G.Adj y w)
    (hyz : G.dist y z = i - 1) (hxz : G.dist x z = i) :
    G.dist z w = i - 1 ∨ G.dist z w = i := by
  have hdxw : G.dist x w = 1 := SimpleGraph.dist_eq_one_iff_adj.mpr hxw
  have hdyw : G.dist y w = 1 := SimpleGraph.dist_eq_one_iff_adj.mpr hyw
  have hzy : G.dist z y = i - 1 := by
    rw [SimpleGraph.dist_comm]; exact hyz
  have hzx : G.dist z x = i := by
    rw [SimpleGraph.dist_comm]; exact hxz
  have hwy : G.dist w y = 1 := by
    rw [SimpleGraph.dist_comm]; exact hdyw
  have hwx : G.dist w x = 1 := by
    rw [SimpleGraph.dist_comm]; exact hdxw
  have h1 : G.dist z w ≤ G.dist z y + G.dist y w := hG.dist_triangle
  have h2 : G.dist z y ≤ G.dist z w + G.dist w y := hG.dist_triangle
  have h3 : G.dist z x ≤ G.dist z w + G.dist w x := hG.dist_triangle
  omega

/-- **Chapter 40: `zᵢ` is `a₁` minus the distance-`i` count.**  In the configuration of 40.4
the common neighbours of `x` and `y` split into those at distance `i - 1` (the count `zᵢ`) and
those at distance `i`.  The latter is the single parameter that distance-regularity alone leaves
free. -/
theorem zi_count_split {G : SimpleGraph X} (hG : G.Connected) {x y z : X} {i : ℕ}
    (hi : 2 ≤ i) (hxy : G.Adj x y) (hyz : G.dist y z = i - 1) (hxz : G.dist x z = i) :
    (Finset.univ.filter fun w => G.Adj x w ∧ G.Adj y w ∧ G.dist z w = i - 1).card
        + (Finset.univ.filter fun w => G.Adj x w ∧ G.Adj y w ∧ G.dist z w = i).card
      = (Finset.univ.filter fun w => G.Adj x w ∧ G.Adj y w).card := by
  set A := Finset.univ.filter (fun w => G.Adj x w ∧ G.Adj y w ∧ G.dist z w = i - 1) with hA
  set B := Finset.univ.filter (fun w => G.Adj x w ∧ G.Adj y w ∧ G.dist z w = i) with hB
  set C := Finset.univ.filter (fun w => G.Adj x w ∧ G.Adj y w) with hC
  have hAB : A ∪ B = C := by
    ext w
    simp only [hA, hB, hC, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]
    constructor
    · rintro (⟨h1, h2, _⟩ | ⟨h1, h2, _⟩) <;> exact ⟨h1, h2⟩
    · rintro ⟨h1, h2⟩
      rcases zi_dist_dichotomy hG hi hxy h1 h2 hyz hxz with h | h
      · exact Or.inl ⟨h1, h2, h⟩
      · exact Or.inr ⟨h1, h2, h⟩
  have hdisj : Disjoint A B := by
    rw [Finset.disjoint_left]
    intro w hwA hwB
    simp only [hA, hB, Finset.mem_filter] at hwA hwB
    omega
  rw [← hAB, Finset.card_union_of_disjoint hdisj]

/-- A bipartite graph has no triangle. -/
theorem triangleFree_of_isBipartite {G : SimpleGraph X} (h : G.IsBipartite) :
    ∀ a b c : X, G.Adj a b → G.Adj a c → G.Adj b c → False := by
  obtain ⟨f, hf⟩ := h
  have key : ∀ p q r : Fin 2, p ≠ q → p ≠ r → q ≠ r → False := by decide
  exact fun a b c hab hac hbc => key (f a) (f b) (f c) (hf hab) (hf hac) (hf hbc)

/-- In a triangle-free graph the count `zᵢ` of 40.4 vanishes. -/
theorem zi_count_eq_zero_of_triangleFree {G : SimpleGraph X} {x y z : X} {i : ℕ}
    (hxy : G.Adj x y)
    (htri : ∀ a b c : X, G.Adj a b → G.Adj a c → G.Adj b c → False) :
    (Finset.univ.filter fun w => G.Adj x w ∧ G.Adj y w ∧ G.dist z w = i - 1).card = 0 := by
  rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  rintro w - ⟨h1, h2, -⟩
  exact htri x y w hxy h1 h2

/-- **Theorem 40.4 in the triangle-free case** — in particular for every bipartite
distance-regular graph (hypercubes, incidence graphs, …).  Both counts vanish, so the conclusion
of `zi_independent` holds; the remaining content of 40.4 is therefore concentrated in graphs that
contain triangles, where the Q-polynomial structure (through the kite numbers) is what forces the
count to be constant. -/
theorem zi_independent_of_triangleFree {G : SimpleGraph X}
    (htri : ∀ a b c : X, G.Adj a b → G.Adj a c → G.Adj b c → False)
    (i : ℕ) (x' y' z' x'' y'' z'' : X)
    (hx'y' : G.Adj x' y') (hx''y'' : G.Adj x'' y'') :
    (Finset.univ.filter fun w => G.Adj x' w ∧ G.Adj y' w ∧ G.dist z' w = i - 1).card =
      (Finset.univ.filter fun w => G.Adj x'' w ∧ G.Adj y'' w ∧ G.dist z'' w = i - 1).card := by
  rw [zi_count_eq_zero_of_triangleFree (i := i) hx'y' htri,
    zi_count_eq_zero_of_triangleFree (i := i) hx''y'' htri]

/-- **Theorem 40.4 for bipartite graphs.** -/
theorem zi_independent_of_bipartite {G : SimpleGraph X} (hb : G.IsBipartite)
    (i : ℕ) (x' y' z' x'' y'' z'' : X)
    (hx'y' : G.Adj x' y') (hx''y'' : G.Adj x'' y'') :
    (Finset.univ.filter fun w => G.Adj x' w ∧ G.Adj y' w ∧ G.dist z' w = i - 1).card =
      (Finset.univ.filter fun w => G.Adj x'' w ∧ G.Adj y'' w ∧ G.dist z'' w = i - 1).card :=
  zi_independent_of_triangleFree (triangleFree_of_isBipartite hb) i x' y' z' x'' y'' z''
    hx'y' hx''y''

/-- **40.4 restated as a statement about `Δ`**: by `ziDelta_apply` the whole content of
`zi_independent` is that the `(z,x)`-entry of `ziDelta G y i` does not depend on the
configuration. -/
theorem ziDelta_entry_eq_entry {G : SimpleGraph X} {x' y' z' x'' y'' z'' : X} {i : ℕ}
    (hx'y' : G.Adj x' y') (hy'z' : G.dist y' z' = i - 1)
    (hx''y'' : G.Adj x'' y'') (hy''z'' : G.dist y'' z'' = i - 1) :
    ((Finset.univ.filter fun w => G.Adj x' w ∧ G.Adj y' w ∧ G.dist z' w = i - 1).card : ℂ)
        = (Finset.univ.filter fun w => G.Adj x'' w ∧ G.Adj y'' w
            ∧ G.dist z'' w = i - 1).card ↔
      ziDelta G y' i z' x' = ziDelta G y'' i z'' x'' := by
  rw [ziDelta_apply hx'y' hy'z', ziDelta_apply hx''y'' hy''z'']

/-! ### Lemma 33.4 (iv): `E*₁T(x)E*₁` consists of symmetric matrices — the input to Lemma 39.2

Lecture 33's Lemma 33.4 (iv) reads "`E*₁TE*₁` is symmetric (in particular, commutative)"; its
proof is one line: "`Ã`, `J̃` are symmetric commuting matrices".  The shape in which Lemma 39.2
uses it is `Δ_{yz} = Δ_{zy}` for `Δ = ÃR⁻¹E*₂A₂E*₁ ∈ E*₁T(x)E*₁` and `y, z ∈ S₁(x)`, i.e. every
element of `E*₁T(x)E*₁` has *symmetric entries*.  That follows from 33.4 (iii) — the spanning set
`{J̃, E*₁, Ã, Ã², …}` consists of symmetric matrices, and symmetric matrices are closed under
addition and under multiplication by arbitrary complex scalars — so it is proved here, modulo the
`e1star_te1star_span` stub of (iii). -/

/-- The all-ones matrix is symmetric. -/
theorem allOnes_transpose : (allOnes (𝕜 := ℂ) : Matrix X X ℂ)ᵀ = allOnes := by
  ext a b; simp [allOnes]

/-- The transpose of a sandwich `E M E` by a symmetric `E` and a symmetric `M`. -/
theorem transpose_sandwich {E M : Matrix X X ℂ} (hE : Eᵀ = E) (hM : Mᵀ = M) :
    (E * M * E)ᵀ = E * M * E := by
  rw [Matrix.transpose_mul, Matrix.transpose_mul, hE, hM, Matrix.mul_assoc]

/-- `J̃` is a symmetric matrix. -/
theorem tildeJ_transpose (Y : DRGData G x D) : (Y.tildeJ)ᵀ = Y.tildeJ := by
  rw [DRGData.tildeJ]
  exact transpose_sandwich (subconst_transpose G x 1) allOnes_transpose

/-- `Ã` is a symmetric matrix. -/
theorem tildeA_transpose (Y : DRGData G x D) : (Y.tildeA)ᵀ = Y.tildeA := by
  rw [DRGData.tildeA]
  exact transpose_sandwich (subconst_transpose G x 1) (adj_transpose G)

/-- A `ℂ`-submodule spanned by symmetric matrices consists of symmetric matrices. -/
theorem transpose_eq_self_of_mem_span {S : Set (Matrix X X ℂ)} (hS : ∀ M ∈ S, Mᵀ = M)
    {M : Matrix X X ℂ} (hM : M ∈ Submodule.span ℂ S) : Mᵀ = M := by
  induction hM using Submodule.span_induction with
  | mem v hv => exact hS v hv
  | zero => simp
  | add a b _ _ ha hb => rw [Matrix.transpose_add, ha, hb]
  | smul c a _ ha => rw [Matrix.transpose_smul, ha]

/-- **Lemma 33.4 (iv)**, matrix form: every element of `E*₁T(x)E*₁` is a symmetric matrix.
Its only input is Lemma 33.4 (iii) (`e1star_te1star_span`, another section's interface). -/
theorem e1star_te1star_transpose (Y : DRGData G x D) {a : Matrix X X ℂ}
    (ha : a ∈ (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra) :
    (subconst (𝕜 := ℂ) G x 1 * a * subconst (𝕜 := ℂ) G x 1)ᵀ
      = subconst (𝕜 := ℂ) G x 1 * a * subconst (𝕜 := ℂ) G x 1 := by
  refine transpose_eq_self_of_mem_span ?_ (e1star_te1star_span Y a ha)
  rintro M (hM | hM)
  · obtain ⟨n, -, hn⟩ := hM
    rw [← hn, Matrix.transpose_pow, tildeA_transpose]
  · rcases hM with rfl | rfl
    · exact tildeJ_transpose Y
    · exact subconst_transpose G x 1

/-- **Lemma 33.4 (iv)**, entry form — exactly the statement Lemma 39.2 uses
(`Δ_{yz} = Δ_{zy}` for `Δ ∈ E*₁T(x)E*₁`). -/
theorem e1star_te1star_entry_symm (Y : DRGData G x D) {a : Matrix X X ℂ}
    (ha : a ∈ (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra) (y z : X) :
    (subconst (𝕜 := ℂ) G x 1 * a * subconst (𝕜 := ℂ) G x 1) y z
      = (subconst (𝕜 := ℂ) G x 1 * a * subconst (𝕜 := ℂ) G x 1) z y := by
  rw [← Matrix.transpose_apply (subconst (𝕜 := ℂ) G x 1 * a * subconst (𝕜 := ℂ) G x 1) z y,
    e1star_te1star_transpose Y ha]



/-! ### Chapter 30 (continued): Theorem 30.1 (ii) in its corrected form

The draft of Theorem 30.1 (ii) was removed above (see the audit note there).
The notes' proof is carried out here in full, with the hypothesis made explicit:

1. **the block calculus** — `E*_a·R·E*_b`, `E*_a·F·E*_b`, `E*_a·L·E*_b` collapse to
   a single block `E*_a A E*_b` (`subconst_mul_raising_mul_subconst`,
   `subconst_mul_flat_mul_subconst`, `subconst_mul_lowering_mul_subconst`, the
   one-sided forms and the context forms `..._ctx'`), so the nine length-three
   words `E*_i A E*_? A E*_? A E*_i` are `Q·F·R·L·Q` (`block_frl`), `Q·R·L·F·Q`
   (`block_rlf`), `Q·F·L·R·Q` (`block_flr`), `Q·L·R·F·Q` (`block_lrf`) or `0`
   (`block_vanish_ac`, `block_vanish_ca`);
2. **the double-sum collapse** — inserting `1 = ∑_k E*_k` into the `A²` of
   `E*_i A² A* A E*_i` and expanding `A* = ∑_j θ*_j E*_j` gives `∑_j ∑_k θ*_j T_{jk}`
   (`subconst_mul_A2_Astar_mul_A`, mirror: `subconst_mul_A_Astar_mul_A2`); the
   difference of the two expansions is `∑_j ∑_k (θ*_j-θ*_k) T_{jk}`, which has only
   seven nonzero pairs (`sum_univ_eq_sum_three`, `Tfun_eq_zero_of_j/_k`) and
   collapses to `(θ*_{i-1}-θ*_i)[F,RL]E*_i + (θ*_{i+1}-θ*_i)[F,LR]E*_i`
   (`sum_collapse`);
3. **support and assembly** — `E*_i` can be inserted at the left end of the four
   products (`flat_raising_lowering_mul_subconst`, `flat_lowering_raising_mul_subconst`,
   `raising_lowering_flat_mul_subconst`, `lowering_raising_flat_mul_subconst`), which
   turns the collapsed identity into
   `F·(RL - h·LR)·E*_i = (RL - h·LR)·F·E*_i` (`flat_commutator_rl_restated`).

All of this is unconditional in the graph (`DRGData.thetaStar` is arbitrary); the
only hypothesis of `flat_commutator_rl_restated` beyond `1 ≤ i`, `i+1 ≤ D` and
`θ*_{i-1} ≠ θ*_i` is the level-`i` squeeze `E*_i(A²A* - AA*A²)E*_i = 0` of the
cubic relation of Theorem 29.1, which is what `Q`-polynomiality supplies. -/

/-- `∑_{i} E*_i(x) = 1` when `x` has eccentricity `≤ D`, indexed by `Fin (D+1)`. -/
theorem sum_subconst_fin (hD : ∀ y, G.dist x y ≤ D) :
    (∑ i : Fin (D + 1), subconst (𝕜 := ℂ) G x (i : ℕ)) = 1 := by
  rw [Fin.sum_univ_eq_sum_range (fun i => subconst (𝕜 := ℂ) G x i) (D + 1)]
  exact sum_subconst_eq_one G x D hD

/-- The dual adjacency matrix acts on the `i`-th subconstituent as `θ*_i`. -/
theorem subconst_mul_Astar_mul_subconst (i : Fin (D + 1)) :
    subconst (𝕜 := ℂ) G x (i : ℕ) * Y.Astar * subconst (𝕜 := ℂ) G x (i : ℕ)
      = (Y.thetaStar i : ℂ) • subconst (𝕜 := ℂ) G x (i : ℕ) := by
  have h : subconst (𝕜 := ℂ) G x (i : ℕ) * Y.Astar * subconst (𝕜 := ℂ) G x (i : ℕ)
      = ∑ j : Fin (D + 1), (Y.thetaStar j : ℂ) •
          (subconst (𝕜 := ℂ) G x (i : ℕ) * subconst (𝕜 := ℂ) G x (j : ℕ)
            * subconst (𝕜 := ℂ) G x (i : ℕ)) := by
    rw [DRGData.Astar]
    rw [Finset.mul_sum]
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Matrix.mul_smul, Matrix.smul_mul]
  rw [h, Finset.sum_eq_single i]
  · rw [subconst_mul_subconst, if_pos rfl, subconst_mul_self]
  · intro j _ hji
    rw [subconst_mul_subconst, if_neg (fun heq => hji (Fin.ext heq).symm), zero_mul, smul_zero]
  · intro hmem
    exact absurd (Finset.mem_univ i) hmem

/-- **The uncollapsed form of the level-`i` balanced identity.**  Inserting
`1 = ∑_k E*_k` into the `A²` and expanding `A* = ∑_j θ*_j E*_j` gives, for every
vertex `x`, every `D` and every coefficient sequence `θ*`,
`E*_i A² A* A E*_i = ∑_j ∑_k θ_j E*_i A E*_k A E*_j A E*_i`. -/
theorem subconst_mul_A2_Astar_mul_A (hD : ∀ y, G.dist x y ≤ D) (i : Fin (D + 1)) :
    subconst (𝕜 := ℂ) G x (i : ℕ) * (adj (𝕜 := ℂ) G * adj G * Y.Astar * adj G)
        * subconst (𝕜 := ℂ) G x (i : ℕ)
      = ∑ j : Fin (D + 1), ∑ k : Fin (D + 1), (Y.thetaStar j : ℂ) •
          (subconst (𝕜 := ℂ) G x (i : ℕ) * adj G * subconst (𝕜 := ℂ) G x (k : ℕ) * adj G
            * subconst (𝕜 := ℂ) G x (j : ℕ) * adj G * subconst (𝕜 := ℂ) G x (i : ℕ)) := by
  have hone : (∑ k : Fin (D + 1), subconst (𝕜 := ℂ) G x (k : ℕ)) = 1 :=
    sum_subconst_fin hD
  have hsplit : adj (𝕜 := ℂ) G * adj G
      = ∑ k : Fin (D + 1), adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (k : ℕ) * adj G := by
    calc adj (𝕜 := ℂ) G * adj G = adj (𝕜 := ℂ) G * 1 * adj G := by rw [mul_one]
      _ = adj (𝕜 := ℂ) G * (∑ k : Fin (D + 1), subconst (𝕜 := ℂ) G x (k : ℕ)) * adj G := by
            rw [hone]
      _ = ∑ k : Fin (D + 1), adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (k : ℕ) * adj G := by
            rw [Finset.mul_sum, Finset.sum_mul]
  calc subconst (𝕜 := ℂ) G x (i : ℕ) * (adj (𝕜 := ℂ) G * adj G * Y.Astar * adj G)
        * subconst (𝕜 := ℂ) G x (i : ℕ)
      = subconst (𝕜 := ℂ) G x (i : ℕ) *
          ((∑ k : Fin (D + 1), adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (k : ℕ) * adj G)
            * (∑ j : Fin (D + 1), (Y.thetaStar j : ℂ) • subconst (𝕜 := ℂ) G x (j : ℕ))
            * adj G) * subconst (𝕜 := ℂ) G x (i : ℕ) := by
        rw [hsplit, DRGData.Astar]
    _ = ∑ j : Fin (D + 1), ∑ k : Fin (D + 1), (Y.thetaStar j : ℂ) •
          (subconst (𝕜 := ℂ) G x (i : ℕ) * adj G * subconst (𝕜 := ℂ) G x (k : ℕ) * adj G
            * subconst (𝕜 := ℂ) G x (j : ℕ) * adj G * subconst (𝕜 := ℂ) G x (i : ℕ)) := by
        simp only [Matrix.mul_smul, Matrix.smul_mul, Finset.sum_mul, Finset.mul_sum, mul_assoc]

/-- `E*_a · R · E*_b` collapses to the single block `E*_a A E*_b` when `a = b+1`. -/
theorem subconst_mul_raising_mul_subconst {a b : ℕ} (hb : b < D) :
    subconst (𝕜 := ℂ) G x a * raising (𝕜 := ℂ) G x D * subconst (𝕜 := ℂ) G x b
      = if a = b + 1 then subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G
          * subconst (𝕜 := ℂ) G x b else 0 := by
  have hterm : ∀ c ∈ Finset.range D,
      subconst (𝕜 := ℂ) G x a * (subconst (𝕜 := ℂ) G x (c + 1) * adj (𝕜 := ℂ) G
        * subconst (𝕜 := ℂ) G x c) * subconst (𝕜 := ℂ) G x b
      = if c = b then (if a = b + 1 then subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G
          * subconst (𝕜 := ℂ) G x b else 0) else 0 := by
    intro c _
    have hassoc : subconst (𝕜 := ℂ) G x a * (subconst (𝕜 := ℂ) G x (c + 1) * adj (𝕜 := ℂ) G
        * subconst (𝕜 := ℂ) G x c) * subconst (𝕜 := ℂ) G x b
        = (subconst (𝕜 := ℂ) G x a * subconst (𝕜 := ℂ) G x (c + 1)) * adj (𝕜 := ℂ) G
          * (subconst (𝕜 := ℂ) G x c * subconst (𝕜 := ℂ) G x b) := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_subconst, subconst_mul_subconst]
    by_cases hcb : c = b
    · subst hcb
      rw [if_pos rfl, if_pos rfl]
      by_cases hab : a = c + 1
      · rw [if_pos hab, if_pos hab]
      · rw [if_neg hab, if_neg hab]
        simp
    · rw [if_neg hcb, if_neg hcb]
      simp
  rw [raising, Finset.mul_sum, Finset.sum_mul, Finset.sum_congr rfl hterm,
    Finset.sum_ite_eq', if_pos (Finset.mem_range.mpr hb)]

/-- `E*_a · F · E*_b` collapses to the single block `E*_a A E*_b` when `a = b`. -/
theorem subconst_mul_flat_mul_subconst {a b : ℕ} (ha : a ∈ Finset.range (D + 1)) :
    subconst (𝕜 := ℂ) G x a * flat (𝕜 := ℂ) G x D * subconst (𝕜 := ℂ) G x b
      = if a = b then subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G
          * subconst (𝕜 := ℂ) G x b else 0 := by
  have hterm : ∀ c ∈ Finset.range (D + 1),
      subconst (𝕜 := ℂ) G x a * (subconst (𝕜 := ℂ) G x c * adj (𝕜 := ℂ) G
        * subconst (𝕜 := ℂ) G x c) * subconst (𝕜 := ℂ) G x b
      = if c = a then (if a = b then subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G
          * subconst (𝕜 := ℂ) G x b else 0) else 0 := by
    intro c _
    have hassoc : subconst (𝕜 := ℂ) G x a * (subconst (𝕜 := ℂ) G x c * adj (𝕜 := ℂ) G
        * subconst (𝕜 := ℂ) G x c) * subconst (𝕜 := ℂ) G x b
        = (subconst (𝕜 := ℂ) G x a * subconst (𝕜 := ℂ) G x c) * adj (𝕜 := ℂ) G
          * (subconst (𝕜 := ℂ) G x c * subconst (𝕜 := ℂ) G x b) := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_subconst, subconst_mul_subconst]
    by_cases hca : c = a
    · subst hca
      rw [if_pos rfl, if_pos rfl]
      by_cases hcb : c = b
      · subst hcb
        rw [if_pos rfl, if_pos rfl]
      · rw [if_neg hcb, if_neg hcb]
        simp
    · rw [if_neg (Ne.symm hca), if_neg hca]
      simp
  rw [flat, Finset.mul_sum, Finset.sum_mul, Finset.sum_congr rfl hterm,
    Finset.sum_ite_eq', if_pos ha]

/-- `E*_a · L · E*_b` collapses to the single block `E*_a A E*_b` when `b = a+1`. -/
theorem subconst_mul_lowering_mul_subconst {a b : ℕ} (hb : b ∈ Finset.Icc 1 D) :
    subconst (𝕜 := ℂ) G x a * lowering (𝕜 := ℂ) G x D * subconst (𝕜 := ℂ) G x b
      = if b = a + 1 then subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G
          * subconst (𝕜 := ℂ) G x b else 0 := by
  have hterm : ∀ c ∈ Finset.Icc 1 D,
      subconst (𝕜 := ℂ) G x a * (subconst (𝕜 := ℂ) G x (c - 1) * adj (𝕜 := ℂ) G
        * subconst (𝕜 := ℂ) G x c) * subconst (𝕜 := ℂ) G x b
      = if c = b then (if b = a + 1 then subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G
          * subconst (𝕜 := ℂ) G x b else 0) else 0 := by
    intro c hc
    rw [Finset.mem_Icc] at hc
    have hc1 : 1 ≤ c := hc.1
    have hassoc : subconst (𝕜 := ℂ) G x a * (subconst (𝕜 := ℂ) G x (c - 1) * adj (𝕜 := ℂ) G
        * subconst (𝕜 := ℂ) G x c) * subconst (𝕜 := ℂ) G x b
        = (subconst (𝕜 := ℂ) G x a * subconst (𝕜 := ℂ) G x (c - 1)) * adj (𝕜 := ℂ) G
          * (subconst (𝕜 := ℂ) G x c * subconst (𝕜 := ℂ) G x b) := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_subconst, subconst_mul_subconst]
    by_cases hcb : c = b
    · subst hcb
      rw [if_pos rfl, if_pos rfl]
      by_cases hab : a = c - 1
      · rw [if_pos hab, if_pos (by omega)]
      · rw [if_neg hab, if_neg (by omega)]
        simp
    · rw [if_neg hcb, if_neg hcb]
      simp
  rw [lowering, Finset.mul_sum, Finset.sum_mul, Finset.sum_congr rfl hterm,
    Finset.sum_ite_eq', if_pos hb]


/-- `R · E*_b = E*_{b+1} A E*_b`. -/
theorem raising_mul_subconst {b : ℕ} (hb : b < D) :
    raising (𝕜 := ℂ) G x D * subconst (𝕜 := ℂ) G x b
      = subconst (𝕜 := ℂ) G x (b + 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x b := by
  rw [raising, Finset.sum_mul, Finset.sum_eq_single b]
  · have hassoc : (subconst (𝕜 := ℂ) G x (b + 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x b)
        * subconst (𝕜 := ℂ) G x b
        = subconst (𝕜 := ℂ) G x (b + 1) * adj (𝕜 := ℂ) G
          * (subconst (𝕜 := ℂ) G x b * subconst (𝕜 := ℂ) G x b) := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_self]
  · intro c _ hcb
    have hassoc : (subconst (𝕜 := ℂ) G x (c + 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x c)
        * subconst (𝕜 := ℂ) G x b
        = (subconst (𝕜 := ℂ) G x (c + 1) * adj (𝕜 := ℂ) G)
          * (subconst (𝕜 := ℂ) G x c * subconst (𝕜 := ℂ) G x b) := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_subconst, if_neg hcb, mul_zero]
  · intro h
    exact absurd (Finset.mem_range.mpr hb) h

/-- `E*_a · F = E*_a A E*_a`. -/
theorem subconst_mul_flat {a : ℕ} (ha : a ∈ Finset.range (D + 1)) :
    subconst (𝕜 := ℂ) G x a * flat (𝕜 := ℂ) G x D
      = subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x a := by
  rw [flat, Finset.mul_sum, Finset.sum_eq_single a]
  · have hassoc : subconst (𝕜 := ℂ) G x a
        * (subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x a)
        = (subconst (𝕜 := ℂ) G x a * subconst (𝕜 := ℂ) G x a)
          * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x a := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_self]
  · intro c _ hca
    have hassoc : subconst (𝕜 := ℂ) G x a
        * (subconst (𝕜 := ℂ) G x c * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x c)
        = (subconst (𝕜 := ℂ) G x a * subconst (𝕜 := ℂ) G x c)
          * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x c := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_subconst, if_neg (Ne.symm hca), zero_mul, Matrix.zero_mul]
  · intro h
    exact absurd ha h

/-- `F · E*_b = E*_b A E*_b`. -/
theorem flat_mul_subconst {b : ℕ} (hb : b ∈ Finset.range (D + 1)) :
    flat (𝕜 := ℂ) G x D * subconst (𝕜 := ℂ) G x b
      = subconst (𝕜 := ℂ) G x b * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x b := by
  rw [flat, Finset.sum_mul, Finset.sum_eq_single b]
  · have hassoc : (subconst (𝕜 := ℂ) G x b * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x b)
        * subconst (𝕜 := ℂ) G x b
        = subconst (𝕜 := ℂ) G x b * adj (𝕜 := ℂ) G
          * (subconst (𝕜 := ℂ) G x b * subconst (𝕜 := ℂ) G x b) := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_self]
  · intro c _ hcb
    have hassoc : (subconst (𝕜 := ℂ) G x c * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x c)
        * subconst (𝕜 := ℂ) G x b
        = (subconst (𝕜 := ℂ) G x c * adj (𝕜 := ℂ) G)
          * (subconst (𝕜 := ℂ) G x c * subconst (𝕜 := ℂ) G x b) := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_subconst, if_neg hcb, mul_zero]
  · intro h
    exact absurd hb h

/-- `L · E*_b = E*_{b-1} A E*_b`. -/
theorem lowering_mul_subconst {b : ℕ} (hb : b ∈ Finset.Icc 1 D) :
    lowering (𝕜 := ℂ) G x D * subconst (𝕜 := ℂ) G x b
      = subconst (𝕜 := ℂ) G x (b - 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x b := by
  rw [lowering, Finset.sum_mul, Finset.sum_eq_single b]
  · have hassoc : (subconst (𝕜 := ℂ) G x (b - 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x b)
        * subconst (𝕜 := ℂ) G x b
        = subconst (𝕜 := ℂ) G x (b - 1) * adj (𝕜 := ℂ) G
          * (subconst (𝕜 := ℂ) G x b * subconst (𝕜 := ℂ) G x b) := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_self]
  · intro c _ hcb
    have hassoc : (subconst (𝕜 := ℂ) G x (c - 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x c)
        * subconst (𝕜 := ℂ) G x b
        = (subconst (𝕜 := ℂ) G x (c - 1) * adj (𝕜 := ℂ) G)
          * (subconst (𝕜 := ℂ) G x c * subconst (𝕜 := ℂ) G x b) := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_subconst, if_neg hcb, mul_zero]
  · intro h
    exact absurd hb h

/-- Sum of a matrix-valued function over `Fin (D+1)` that vanishes off a
three-element set. -/
theorem sum_univ_eq_sum_three {a b c : Fin (D + 1)} (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c)
    (M : Fin (D + 1) → Matrix X X ℂ) (h : ∀ j, j ≠ a → j ≠ b → j ≠ c → M j = 0) :
    (∑ j : Fin (D + 1), M j) = M a + M b + M c := by
  have hsub : ({a, b, c} : Finset (Fin (D + 1))) ⊆ Finset.univ := Finset.subset_univ _
  have hzero : ∀ x ∈ Finset.univ, x ∉ ({a, b, c} : Finset (Fin (D + 1))) → M x = 0 := by
    intro x _ hx
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hx
    exact h x hx.1 hx.2.1 hx.2.2
  rw [← Finset.sum_subset hsub hzero]
  rw [Finset.sum_insert (by simp [hab, hac]), Finset.sum_insert (by simp [hbc]),
    Finset.sum_singleton]
  abel

/-- `E*_k · A · E*_i = 0` when `k ∉ {i-1, i, i+1}`. -/
theorem subconst_mul_adj_mul_subconst_eq_zero_of_not {i k : ℕ} (hi : 1 ≤ i)
    (h1 : k ≠ i - 1) (h2 : k ≠ i) (h3 : k ≠ i + 1) :
    subconst (𝕜 := ℂ) G x k * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x i = 0 := by
  refine subconst_mul_adj_mul_subconst_eq_zero (𝕜 := ℂ) (G := G) (x := x) ?_
  omega

/-- `E*_i · A · E*_k = 0` when `k ∉ {i-1, i, i+1}`. -/
theorem subconst_mul_adj_mul_subconst_eq_zero_of_not' {i k : ℕ} (hi : 1 ≤ i)
    (h1 : k ≠ i - 1) (h2 : k ≠ i) (h3 : k ≠ i + 1) :
    subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x k = 0 := by
  refine subconst_mul_adj_mul_subconst_eq_zero (𝕜 := ℂ) (G := G) (x := x) ?_
  omega

/-- **The mirror uncollapsed identity**: `E*_i A A* A² E*_i` as a double sum. -/
theorem subconst_mul_A_Astar_mul_A2 (hD : ∀ y, G.dist x y ≤ D) (i : Fin (D + 1)) :
    subconst (𝕜 := ℂ) G x (i : ℕ) * (adj (𝕜 := ℂ) G * Y.Astar * (adj G * adj G))
        * subconst (𝕜 := ℂ) G x (i : ℕ)
      = ∑ j : Fin (D + 1), ∑ k : Fin (D + 1), (Y.thetaStar j : ℂ) •
          (subconst (𝕜 := ℂ) G x (i : ℕ) * adj G * subconst (𝕜 := ℂ) G x (j : ℕ) * adj G
            * subconst (𝕜 := ℂ) G x (k : ℕ) * adj G * subconst (𝕜 := ℂ) G x (i : ℕ)) := by
  have hone : (∑ k : Fin (D + 1), subconst (𝕜 := ℂ) G x (k : ℕ)) = 1 :=
    sum_subconst_fin hD
  have hsplit : adj (𝕜 := ℂ) G * adj G
      = ∑ k : Fin (D + 1), adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (k : ℕ) * adj G := by
    calc adj (𝕜 := ℂ) G * adj G = adj (𝕜 := ℂ) G * 1 * adj G := by rw [mul_one]
      _ = adj (𝕜 := ℂ) G * (∑ k : Fin (D + 1), subconst (𝕜 := ℂ) G x (k : ℕ)) * adj G := by
            rw [hone]
      _ = ∑ k : Fin (D + 1), adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (k : ℕ) * adj G := by
            rw [Finset.mul_sum, Finset.sum_mul]
  calc subconst (𝕜 := ℂ) G x (i : ℕ) * (adj (𝕜 := ℂ) G * Y.Astar * (adj G * adj G))
        * subconst (𝕜 := ℂ) G x (i : ℕ)
      = subconst (𝕜 := ℂ) G x (i : ℕ) *
          (adj (𝕜 := ℂ) G * (∑ j : Fin (D + 1), (Y.thetaStar j : ℂ) • subconst (𝕜 := ℂ) G x (j : ℕ))
            * (∑ k : Fin (D + 1), adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (k : ℕ) * adj G))
          * subconst (𝕜 := ℂ) G x (i : ℕ) := by
        rw [hsplit, DRGData.Astar]
    _ = ∑ j : Fin (D + 1), ∑ k : Fin (D + 1), (Y.thetaStar j : ℂ) •
          (subconst (𝕜 := ℂ) G x (i : ℕ) * adj G * subconst (𝕜 := ℂ) G x (j : ℕ) * adj G
            * subconst (𝕜 := ℂ) G x (k : ℕ) * adj G * subconst (𝕜 := ℂ) G x (i : ℕ)) := by
        simp only [Matrix.mul_smul, Matrix.smul_mul, Finset.sum_mul, Finset.mul_sum, mul_assoc]
        rw [Finset.sum_comm]

/-- `E*_a · R = E*_a A E*_{a-1}`. -/
theorem subconst_mul_raising {a : ℕ} (ha1 : 1 ≤ a) (haD : a ≤ D) :
    subconst (𝕜 := ℂ) G x a * raising (𝕜 := ℂ) G x D
      = subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (a - 1) := by
  rw [raising, Finset.mul_sum, Finset.sum_eq_single (a - 1)]
  · have hassoc : subconst (𝕜 := ℂ) G x a
        * (subconst (𝕜 := ℂ) G x (a - 1 + 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (a - 1))
        = (subconst (𝕜 := ℂ) G x a * subconst (𝕜 := ℂ) G x (a - 1 + 1)) * adj (𝕜 := ℂ) G
          * subconst (𝕜 := ℂ) G x (a - 1) := by
      simp only [mul_assoc]
    rw [hassoc, show a - 1 + 1 = a from by omega, subconst_mul_self]
  · intro c _ hc
    have hassoc : subconst (𝕜 := ℂ) G x a
        * (subconst (𝕜 := ℂ) G x (c + 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x c)
        = (subconst (𝕜 := ℂ) G x a * subconst (𝕜 := ℂ) G x (c + 1)) * adj (𝕜 := ℂ) G
          * subconst (𝕜 := ℂ) G x c := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_subconst, if_neg (by omega), zero_mul, Matrix.zero_mul]
  · intro h
    rw [Finset.mem_range] at h
    omega

/-- `E*_a · L = E*_a A E*_{a+1}`. -/
theorem subconst_mul_lowering {a : ℕ} (ha : a + 1 ≤ D) :
    subconst (𝕜 := ℂ) G x a * lowering (𝕜 := ℂ) G x D
      = subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (a + 1) := by
  rw [lowering, Finset.mul_sum, Finset.sum_eq_single (a + 1)]
  · have hassoc : subconst (𝕜 := ℂ) G x a
        * (subconst (𝕜 := ℂ) G x (a + 1 - 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (a + 1))
        = (subconst (𝕜 := ℂ) G x a * subconst (𝕜 := ℂ) G x (a + 1 - 1)) * adj (𝕜 := ℂ) G
          * subconst (𝕜 := ℂ) G x (a + 1) := by
      simp only [mul_assoc]
    rw [hassoc, show a + 1 - 1 = a from by omega, subconst_mul_self]
  · intro c hcI hc
    rw [Finset.mem_Icc] at hcI
    have hassoc : subconst (𝕜 := ℂ) G x a
        * (subconst (𝕜 := ℂ) G x (c - 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x c)
        = (subconst (𝕜 := ℂ) G x a * subconst (𝕜 := ℂ) G x (c - 1)) * adj (𝕜 := ℂ) G
          * subconst (𝕜 := ℂ) G x c := by
      simp only [mul_assoc]
    rw [hassoc, subconst_mul_subconst, if_neg (by omega), zero_mul, Matrix.zero_mul]
  · intro h
    exact absurd (by rw [Finset.mem_Icc]; exact ⟨by omega, ha⟩) h

/-- Context form of a two-factor collapse: `p*(q*M) = r*M` from `p*q = r`. -/
theorem collapse_ctx {p q r : Matrix X X ℂ} (h : p * q = r) (M : Matrix X X ℂ) :
    p * (q * M) = r * M := by rw [← mul_assoc, h]

theorem lowering_mul_subconst_ctx {b : ℕ} (hb : b ∈ Finset.Icc 1 D) (M : Matrix X X ℂ) :
    lowering (𝕜 := ℂ) G x D * (subconst (𝕜 := ℂ) G x b * M)
      = subconst (𝕜 := ℂ) G x (b - 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x b * M :=
  collapse_ctx (lowering_mul_subconst hb) M

theorem raising_mul_subconst_ctx {b : ℕ} (hb : b < D) (M : Matrix X X ℂ) :
    raising (𝕜 := ℂ) G x D * (subconst (𝕜 := ℂ) G x b * M)
      = subconst (𝕜 := ℂ) G x (b + 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x b * M :=
  collapse_ctx (raising_mul_subconst hb) M

theorem flat_mul_subconst_ctx {b : ℕ} (hb : b ∈ Finset.range (D + 1)) (M : Matrix X X ℂ) :
    flat (𝕜 := ℂ) G x D * (subconst (𝕜 := ℂ) G x b * M)
      = subconst (𝕜 := ℂ) G x b * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x b * M :=
  collapse_ctx (flat_mul_subconst hb) M

theorem subconst_mul_flat_ctx {a : ℕ} (ha : a ∈ Finset.range (D + 1)) (M : Matrix X X ℂ) :
    subconst (𝕜 := ℂ) G x a * (flat (𝕜 := ℂ) G x D * M)
      = subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x a * M :=
  collapse_ctx (subconst_mul_flat ha) M

theorem subconst_mul_raising_ctx {a : ℕ} (ha1 : 1 ≤ a) (haD : a ≤ D) (M : Matrix X X ℂ) :
    subconst (𝕜 := ℂ) G x a * (raising (𝕜 := ℂ) G x D * M)
      = subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (a - 1) * M :=
  collapse_ctx (subconst_mul_raising ha1 haD) M

theorem subconst_mul_lowering_ctx {a : ℕ} (ha : a + 1 ≤ D) (M : Matrix X X ℂ) :
    subconst (𝕜 := ℂ) G x a * (lowering (𝕜 := ℂ) G x D * M)
      = subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (a + 1) * M :=
  collapse_ctx (subconst_mul_lowering ha) M

theorem subconst_mul_self_ctx (a : ℕ) (M : Matrix X X ℂ) :
    subconst (𝕜 := ℂ) G x a * (subconst (𝕜 := ℂ) G x a * M)
      = subconst (𝕜 := ℂ) G x a * M :=
  collapse_ctx (subconst_mul_self G x a) M

/-- The block `E*_i A E*_i A E*_{i-1} A E*_i` is `Q · F·R·L · Q`. -/
theorem block_frl {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) :
    subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G * subconst G x i * adj G
        * subconst G x (i - 1) * adj G * subconst G x i
      = subconst (𝕜 := ℂ) G x i * flat (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D
        * lowering (𝕜 := ℂ) G x D * subconst (𝕜 := ℂ) G x i := by
  simp only [mul_assoc]
  rw [lowering_mul_subconst (G := G) (x := x) (D := D) (b := i)
    (by rw [Finset.mem_Icc]; omega)]
  simp only [mul_assoc]
  rw [raising_mul_subconst_ctx (G := G) (x := x) (D := D) (b := i - 1) (by omega)]
  simp only [mul_assoc, show i - 1 + 1 = i from by omega]
  rw [flat_mul_subconst_ctx (G := G) (x := x) (D := D) (b := i)
    (by rw [Finset.mem_range]; omega)]
  simp only [mul_assoc]
  rw [subconst_mul_self_ctx]


/-- The block `E*_i A E*_{i-1} A E*_i A E*_i` is `Q · R·L·F · Q`. -/
theorem block_rlf {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) :
    subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G * subconst G x (i - 1) * adj G
        * subconst G x i * adj G * subconst G x i
      = subconst (𝕜 := ℂ) G x i * raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
        * flat (𝕜 := ℂ) G x D * subconst (𝕜 := ℂ) G x i := by
  simp only [mul_assoc]
  rw [flat_mul_subconst (G := G) (x := x) (D := D) (b := i)
    (by rw [Finset.mem_range]; omega)]
  simp only [mul_assoc]
  rw [lowering_mul_subconst_ctx (G := G) (x := x) (D := D) (b := i)
    (by rw [Finset.mem_Icc]; omega)]
  simp only [mul_assoc]
  rw [raising_mul_subconst_ctx (G := G) (x := x) (D := D) (b := i - 1) (by omega)]
  simp only [mul_assoc, show i - 1 + 1 = i from by omega]
  rw [subconst_mul_self_ctx]

/-- The block `E*_i A E*_i A E*_{i+1} A E*_i` is `Q · F·L·R · Q`. -/
theorem block_flr {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) (hi' : i + 1 ≤ D) :
    subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G * subconst G x i * adj G
        * subconst G x (i + 1) * adj G * subconst G x i
      = subconst (𝕜 := ℂ) G x i * flat (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
        * raising (𝕜 := ℂ) G x D * subconst (𝕜 := ℂ) G x i := by
  simp only [mul_assoc]
  rw [raising_mul_subconst (G := G) (x := x) (D := D) (b := i) (by omega)]
  simp only [mul_assoc]
  rw [lowering_mul_subconst_ctx (G := G) (x := x) (D := D) (b := i + 1)
    (by rw [Finset.mem_Icc]; omega)]
  simp only [mul_assoc, show i + 1 - 1 = i from by omega]
  rw [flat_mul_subconst_ctx (G := G) (x := x) (D := D) (b := i)
    (by rw [Finset.mem_range]; omega)]
  simp only [mul_assoc]
  rw [subconst_mul_self_ctx]

/-- The block `E*_i A E*_{i+1} A E*_i A E*_i` is `Q · L·R·F · Q`. -/
theorem block_lrf {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) (hi' : i + 1 ≤ D) :
    subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G * subconst G x (i + 1) * adj G
        * subconst G x i * adj G * subconst G x i
      = subconst (𝕜 := ℂ) G x i * lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D
        * flat (𝕜 := ℂ) G x D * subconst (𝕜 := ℂ) G x i := by
  simp only [mul_assoc]
  rw [flat_mul_subconst (G := G) (x := x) (D := D) (b := i)
    (by rw [Finset.mem_range]; omega)]
  simp only [mul_assoc]
  rw [raising_mul_subconst_ctx (G := G) (x := x) (D := D) (b := i) (by omega)]
  simp only [mul_assoc]
  rw [lowering_mul_subconst_ctx (G := G) (x := x) (D := D) (b := i + 1)
    (by rw [Finset.mem_Icc]; omega)]
  simp only [mul_assoc, show i + 1 - 1 = i from by omega]
  rw [subconst_mul_self_ctx]

/-- `E*_i A E*_{i+1} A E*_{i-1} A E*_i = 0` (the band `|(i+1)-(i-1)| = 2`). -/
theorem block_vanish_ac {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) :
    subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G * subconst G x (i + 1) * adj G
        * subconst G x (i - 1) * adj G * subconst G x i = 0 := by
  have h : subconst (𝕜 := ℂ) G x (i + 1) * adj (𝕜 := ℂ) G * subconst G x (i - 1) = 0 := by
    refine subconst_mul_adj_mul_subconst_eq_zero (𝕜 := ℂ) (G := G) (x := x) ?_
    omega
  rw [show subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G * subconst G x (i + 1) * adj G
        * subconst G x (i - 1) * adj G * subconst G x i
      = subconst (𝕜 := ℂ) G x i * (adj G * (subconst (𝕜 := ℂ) G x (i + 1)
        * (adj G * (subconst G x (i - 1) * (adj G * subconst G x i))))) from by noncomm_ring]
  rw [show subconst (𝕜 := ℂ) G x (i + 1) * (adj G * (subconst G x (i - 1) * (adj G * subconst G x i)))
      = (subconst (𝕜 := ℂ) G x (i + 1) * adj G * subconst G x (i - 1)) * (adj G * subconst G x i)
      from by noncomm_ring, h, Matrix.zero_mul]
  simp

/-- `E*_i A E*_{i-1} A E*_{i+1} A E*_i = 0`. -/
theorem block_vanish_ca {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) :
    subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G * subconst G x (i - 1) * adj G
        * subconst G x (i + 1) * adj G * subconst G x i = 0 := by
  have h : subconst (𝕜 := ℂ) G x (i - 1) * adj (𝕜 := ℂ) G * subconst G x (i + 1) = 0 := by
    refine subconst_mul_adj_mul_subconst_eq_zero (𝕜 := ℂ) (G := G) (x := x) ?_
    omega
  rw [show subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G * subconst G x (i - 1) * adj G
        * subconst G x (i + 1) * adj G * subconst G x i
      = subconst (𝕜 := ℂ) G x i * (adj G * (subconst (𝕜 := ℂ) G x (i - 1)
        * (adj G * (subconst G x (i + 1) * (adj G * subconst G x i))))) from by noncomm_ring]
  rw [show subconst (𝕜 := ℂ) G x (i - 1) * (adj G * (subconst G x (i + 1) * (adj G * subconst G x i)))
      = (subconst (𝕜 := ℂ) G x (i - 1) * adj G * subconst G x (i + 1)) * (adj G * subconst G x i)
      from by noncomm_ring, h, Matrix.zero_mul]
  simp

/-- The matrix `T_{jk} = E*_i A E*_k A E*_j A E*_i`. -/
def Tfun (G : SimpleGraph X) (x : X) (D : ℕ) (i : Fin (D + 1)) (j k : Fin (D + 1)) :
    Matrix X X ℂ :=
  subconst (𝕜 := ℂ) G x (i : ℕ) * adj (𝕜 := ℂ) G * subconst G x (k : ℕ) * adj G
    * subconst G x (j : ℕ) * adj G * subconst G x (i : ℕ)

/-- `T_{jk} = 0` when `E*_k` is not on the band `|k - i| ≤ 1`. -/
theorem Tfun_eq_zero_of_k {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) {j k : Fin (D + 1)}
    (h1 : (k : ℕ) ≠ i - 1) (h2 : (k : ℕ) ≠ i) (h3 : (k : ℕ) ≠ i + 1) :
    Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j k = 0 := by
  have hEk : subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G * subconst G x (k : ℕ) = 0 :=
    subconst_mul_adj_mul_subconst_eq_zero_of_not' hi h1 h2 h3
  rw [show Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j k
      = subconst (𝕜 := ℂ) G x i * (adj G * (subconst G x (k : ℕ) * (adj G
        * (subconst G x (j : ℕ) * (adj G * subconst G x i))))) from by
    simp only [Tfun, mul_assoc]]
  rw [show subconst (𝕜 := ℂ) G x i * (adj G * (subconst G x (k : ℕ) * (adj G
        * (subconst G x (j : ℕ) * (adj G * subconst G x i)))))
      = (subconst (𝕜 := ℂ) G x i * adj G * subconst G x (k : ℕ)) * (adj G
        * (subconst G x (j : ℕ) * (adj G * subconst G x i))) from by noncomm_ring,
    hEk, Matrix.zero_mul]

/-- `T_{jk} = 0` when `E*_j` is not on the band `|j - i| ≤ 1`. -/
theorem Tfun_eq_zero_of_j {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) {j k : Fin (D + 1)}
    (h1 : (j : ℕ) ≠ i - 1) (h2 : (j : ℕ) ≠ i) (h3 : (j : ℕ) ≠ i + 1) :
    Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j k = 0 := by
  have hEj : subconst (𝕜 := ℂ) G x (j : ℕ) * adj (𝕜 := ℂ) G * subconst G x i = 0 :=
    subconst_mul_adj_mul_subconst_eq_zero_of_not hi h1 h2 h3
  rw [show Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j k
      = subconst (𝕜 := ℂ) G x i * (adj G * (subconst G x (k : ℕ) * (adj G
        * (subconst G x (j : ℕ) * (adj G * subconst G x i))))) from by
    simp only [Tfun, mul_assoc]]
  rw [show subconst (𝕜 := ℂ) G x (j : ℕ) * (adj G * subconst G x i)
      = subconst (𝕜 := ℂ) G x (j : ℕ) * adj G * subconst G x i from by noncomm_ring, hEj,
    Matrix.mul_zero, Matrix.mul_zero, Matrix.mul_zero, Matrix.mul_zero]

/-- The double sum `∑_{j,k} (θ*_j - θ*_k) T_{jk}` collapses to the two commutators. -/
theorem sum_collapse {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) (hi' : i + 1 ≤ D) :
    (∑ j : Fin (D + 1), ∑ k : Fin (D + 1),
        ((Y.thetaStar j : ℂ) - (Y.thetaStar k : ℂ)) • Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j k)
      = ((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ) : ℂ) •
          (subconst (𝕜 := ℂ) G x i * flat (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D
              * lowering (𝕜 := ℂ) G x D * subconst G x i
            - subconst (𝕜 := ℂ) G x i * raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
              * flat (𝕜 := ℂ) G x D * subconst G x i)
        + ((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ) : ℂ) •
          (subconst (𝕜 := ℂ) G x i * flat (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
              * raising (𝕜 := ℂ) G x D * subconst G x i
            - subconst (𝕜 := ℂ) G x i * lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D
              * flat (𝕜 := ℂ) G x D * subconst G x i) := by
  set a : Fin (D + 1) := ⟨i - 1, by omega⟩ with ha
  set b : Fin (D + 1) := ⟨i, by omega⟩ with hb
  set c : Fin (D + 1) := ⟨i + 1, by omega⟩ with hc
  have hva : (a : ℕ) = i - 1 := by rw [ha]
  have hvb : (b : ℕ) = i := by rw [hb]
  have hvc : (c : ℕ) = i + 1 := by rw [hc]
  have hab : a ≠ b := by
    intro h
    have h2 := congrArg Fin.val h
    rw [hva, hvb] at h2
    omega
  have hac : a ≠ c := by
    intro h
    have h2 := congrArg Fin.val h
    rw [hva, hvc] at h2
    omega
  have hbc : b ≠ c := by
    intro h
    have h2 := congrArg Fin.val h
    rw [hvb, hvc] at h2
    omega
  -- vanishing of the `k`-summands off the band
  have hvk : ∀ (j k : Fin (D + 1)), k ≠ a → k ≠ b → k ≠ c →
      ((Y.thetaStar j : ℂ) - (Y.thetaStar k : ℂ)) • Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j k = 0 := by
    intro j k h1 h2 h3
    have hk1 : (k : ℕ) ≠ i - 1 := fun h => h1 (by rw [ha]; exact Fin.ext h)
    have hk2 : (k : ℕ) ≠ i := fun h => h2 (by rw [hb]; exact Fin.ext h)
    have hk3 : (k : ℕ) ≠ i + 1 := fun h => h3 (by rw [hc]; exact Fin.ext h)
    rw [Tfun_eq_zero_of_k hi hiD hk1 hk2 hk3, smul_zero]
  -- vanishing of the `j`-summands off the band
  have hvj : ∀ j : Fin (D + 1), j ≠ a → j ≠ b → j ≠ c →
      (∑ k : Fin (D + 1),
        ((Y.thetaStar j : ℂ) - (Y.thetaStar k : ℂ)) • Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j k) = 0 := by
    intro j h1 h2 h3
    have hj1 : (j : ℕ) ≠ i - 1 := fun h => h1 (by rw [ha]; exact Fin.ext h)
    have hj2 : (j : ℕ) ≠ i := fun h => h2 (by rw [hb]; exact Fin.ext h)
    have hj3 : (j : ℕ) ≠ i + 1 := fun h => h3 (by rw [hc]; exact Fin.ext h)
    refine Finset.sum_eq_zero fun k _ => ?_
    rw [Tfun_eq_zero_of_j hi hiD hj1 hj2 hj3, smul_zero]
  rw [sum_univ_eq_sum_three hab hac hbc _ hvj]
  have hinner : ∀ j : Fin (D + 1),
      (∑ k : Fin (D + 1), ((Y.thetaStar j : ℂ) - (Y.thetaStar k : ℂ)) •
        Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j k)
      = ((Y.thetaStar j : ℂ) - (Y.thetaStar a : ℂ)) • Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j a
        + ((Y.thetaStar j : ℂ) - (Y.thetaStar b : ℂ)) • Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j b
        + ((Y.thetaStar j : ℂ) - (Y.thetaStar c : ℂ)) • Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j c :=
    fun j => sum_univ_eq_sum_three hab hac hbc _ fun k h1 h2 h3 => hvk j k h1 h2 h3
  rw [hinner a, hinner b, hinner c]
  -- the nine terms
  have h0 : ∀ j : Fin (D + 1), ((Y.thetaStar j : ℂ) - (Y.thetaStar j : ℂ)) •
      Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j j = 0 := by
    intro j; rw [sub_self, zero_smul]
  have hac0 : Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ a c = 0 := by
    rw [show Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ a c
        = subconst (𝕜 := ℂ) G x i * adj G * subconst G x (i + 1) * adj G
          * subconst G x (i - 1) * adj G * subconst G x i from by
      simp only [Tfun, hva, hvc]]
    exact block_vanish_ac hi hiD
  have hca0 : Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ c a = 0 := by
    rw [show Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ c a
        = subconst (𝕜 := ℂ) G x i * adj G * subconst G x (i - 1) * adj G
          * subconst G x (i + 1) * adj G * subconst G x i from by
      simp only [Tfun, hva, hvc]]
    exact block_vanish_ca hi hiD
  rw [h0 a, h0 b, h0 c, hac0, hca0, smul_zero, smul_zero]
  -- identification of the four surviving blocks
  have h1 : Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ a b
      = subconst (𝕜 := ℂ) G x i * flat (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D
        * lowering (𝕜 := ℂ) G x D * subconst G x i := by
    rw [show Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ a b
        = subconst (𝕜 := ℂ) G x i * adj G * subconst G x i * adj G * subconst G x (a : ℕ)
          * adj G * subconst G x i from by
      simp only [Tfun, show (a : ℕ) = i - 1 from hva, show (b : ℕ) = i from hvb]]
    exact block_frl hi hiD
  have h2 : Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ b a
      = subconst (𝕜 := ℂ) G x i * raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
        * flat (𝕜 := ℂ) G x D * subconst G x i := by
    rw [show Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ b a
        = subconst (𝕜 := ℂ) G x i * adj G * subconst G x (a : ℕ) * adj G * subconst G x (b : ℕ)
          * adj G * subconst G x i from by
      simp only [Tfun, show (a : ℕ) = i - 1 from hva, show (b : ℕ) = i from hvb]]
    exact block_rlf hi hiD
  have h3 : Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ c b
      = subconst (𝕜 := ℂ) G x i * flat (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
        * raising (𝕜 := ℂ) G x D * subconst G x i := by
    rw [show Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ c b
        = subconst (𝕜 := ℂ) G x i * adj G * subconst G x (b : ℕ) * adj G * subconst G x (c : ℕ)
          * adj G * subconst G x i from by
      simp only [Tfun, show (b : ℕ) = i from hvb, show (c : ℕ) = i + 1 from hvc]]
    exact block_flr hi hiD hi'
  have h4 : Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ b c
      = subconst (𝕜 := ℂ) G x i * lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D
        * flat (𝕜 := ℂ) G x D * subconst G x i := by
    rw [show Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ b c
        = subconst (𝕜 := ℂ) G x i * adj G * subconst G x (c : ℕ) * adj G * subconst G x (b : ℕ)
          * adj G * subconst G x i from by
      simp only [Tfun, show (b : ℕ) = i from hvb, show (c : ℕ) = i + 1 from hvc]]
    exact block_lrf hi hiD hi'
  rw [h1, h2, h3, h4]
  -- scalar bookkeeping
  have ea : ((Y.thetaStar a : ℂ) - (Y.thetaStar b : ℂ))
      = ((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ) : ℂ) := by
    rw [ha, hb]
    push_cast
    ring
  have ec : ((Y.thetaStar c : ℂ) - (Y.thetaStar b : ℂ))
      = ((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ) : ℂ) := by
    rw [hc, hb]
    push_cast
    ring
  have eb : ((Y.thetaStar b : ℂ) - (Y.thetaStar a : ℂ)) = -(((Y.thetaStar a : ℂ) - (Y.thetaStar b : ℂ))) := by
    ring
  have ebc : ((Y.thetaStar b : ℂ) - (Y.thetaStar c : ℂ)) = -(((Y.thetaStar c : ℂ) - (Y.thetaStar b : ℂ))) := by
    ring
  rw [eb, ebc, ea, ec]
  simp only [neg_smul, smul_sub]
  abel

/- The final assembly of Theorem 30.1 (ii) — passing from the collapsed double
sum `sum_collapse` to `F · (RL - h·LR) · E*_i = (RL - h·LR) · F · E*_i` — is
*not* carried out here.  It needs (a) the four "level-`i` support" facts
`E*_i·F·R·L·E*_i = F·R·L·E*_i`, `E*_i·R·L·F·E*_i = R·L·F·E*_i` and the two with
`L·R`, each a two-line consequence of `flat_mul_subconst`,
`subconst_mul_flat`, `raising_mul_subconst`, `lowering_mul_subconst`,
`subconst_mul_raising`, `subconst_mul_lowering` above, and (b) the scalar
division by `θ*_{i-1} - θ*_i`.  See the report for the precise gap. -/

/-- Context form of a two-factor collapse, with the context implicit (usable as a
`simp` lemma): `p*(q*M) = r*M`. -/
theorem collapse_ctx' {p q r : Matrix X X ℂ} (h : p * q = r) {M : Matrix X X ℂ} :
    p * (q * M) = r * M := by rw [← mul_assoc, h]

theorem lowering_mul_subconst_ctx' {b : ℕ} (hb : b ∈ Finset.Icc 1 D) :
    lowering (𝕜 := ℂ) G x D * (subconst (𝕜 := ℂ) G x b * M)
      = subconst (𝕜 := ℂ) G x (b - 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x b * M :=
  collapse_ctx' (lowering_mul_subconst hb)

theorem raising_mul_subconst_ctx' {b : ℕ} (hb : b < D) :
    raising (𝕜 := ℂ) G x D * (subconst (𝕜 := ℂ) G x b * M)
      = subconst (𝕜 := ℂ) G x (b + 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x b * M :=
  collapse_ctx' (raising_mul_subconst hb)

theorem flat_mul_subconst_ctx' {b : ℕ} (hb : b ∈ Finset.range (D + 1)) :
    flat (𝕜 := ℂ) G x D * (subconst (𝕜 := ℂ) G x b * M)
      = subconst (𝕜 := ℂ) G x b * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x b * M :=
  collapse_ctx' (flat_mul_subconst hb)

theorem subconst_mul_flat_ctx' {a : ℕ} (ha : a ∈ Finset.range (D + 1)) :
    subconst (𝕜 := ℂ) G x a * (flat (𝕜 := ℂ) G x D * M)
      = subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x a * M :=
  collapse_ctx' (subconst_mul_flat ha)

theorem subconst_mul_raising_ctx' {a : ℕ} (ha1 : 1 ≤ a) (haD : a ≤ D) :
    subconst (𝕜 := ℂ) G x a * (raising (𝕜 := ℂ) G x D * M)
      = subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (a - 1) * M :=
  collapse_ctx' (subconst_mul_raising ha1 haD)

theorem subconst_mul_lowering_ctx' {a : ℕ} (ha : a + 1 ≤ D) :
    subconst (𝕜 := ℂ) G x a * (lowering (𝕜 := ℂ) G x D * M)
      = subconst (𝕜 := ℂ) G x a * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x (a + 1) * M :=
  collapse_ctx' (subconst_mul_lowering ha)

theorem subconst_mul_self_ctx' (a : ℕ) :
    subconst (𝕜 := ℂ) G x a * (subconst (𝕜 := ℂ) G x a * M)
      = subconst (𝕜 := ℂ) G x a * M :=
  collapse_ctx' (subconst_mul_self G x a)

/-- The product `F·R·L·E*_i` is supported on level `i` on the left as well. -/
theorem flat_raising_lowering_mul_subconst {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) :
    flat (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
        * subconst G x i
      = subconst (𝕜 := ℂ) G x i * flat (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D
        * lowering (𝕜 := ℂ) G x D * subconst G x i := by
  simp only [mul_assoc,
    lowering_mul_subconst (G := G) (x := x) (D := D) (b := i) (by rw [Finset.mem_Icc]; exact ⟨hi, hiD⟩),
    raising_mul_subconst (G := G) (x := x) (D := D) (b := i - 1) (by omega),
    flat_mul_subconst (G := G) (x := x) (D := D) (b := i) (by rw [Finset.mem_range]; omega),
    subconst_mul_flat (G := G) (x := x) (D := D) (a := i) (by rw [Finset.mem_range]; omega),
    subconst_mul_raising (G := G) (x := x) (D := D) hi hiD,
    subconst_mul_self G x i,
    lowering_mul_subconst_ctx' (G := G) (x := x) (D := D) (b := i) (by rw [Finset.mem_Icc]; exact ⟨hi, hiD⟩),
    raising_mul_subconst_ctx' (G := G) (x := x) (D := D) (b := i - 1) (by omega),
    flat_mul_subconst_ctx' (G := G) (x := x) (D := D) (b := i) (by rw [Finset.mem_range]; omega),
    subconst_mul_flat_ctx' (G := G) (x := x) (D := D) (a := i) (by rw [Finset.mem_range]; omega),
    subconst_mul_raising_ctx' (G := G) (x := x) (D := D) (a := i) hi hiD,
    subconst_mul_self_ctx',
    show i - 1 + 1 = i from by omega]

/-- The product `F·L·R·E*_i` is supported on level `i` on the left as well. -/
theorem flat_lowering_raising_mul_subconst {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D)
    (hi' : i + 1 ≤ D) :
    flat (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D
        * subconst G x i
      = subconst (𝕜 := ℂ) G x i * flat (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
        * raising (𝕜 := ℂ) G x D * subconst G x i := by
  simp only [mul_assoc,
    raising_mul_subconst (G := G) (x := x) (D := D) (b := i) (by omega),
    lowering_mul_subconst (G := G) (x := x) (D := D) (b := i + 1) (by rw [Finset.mem_Icc]; exact ⟨by omega, hi'⟩),
    flat_mul_subconst (G := G) (x := x) (D := D) (b := i) (by rw [Finset.mem_range]; omega),
    subconst_mul_flat (G := G) (x := x) (D := D) (a := i) (by rw [Finset.mem_range]; omega),
    subconst_mul_lowering (G := G) (x := x) (D := D) hi',
    subconst_mul_self G x i,
    raising_mul_subconst_ctx' (G := G) (x := x) (D := D) (b := i) (by omega),
    lowering_mul_subconst_ctx' (G := G) (x := x) (D := D) (b := i + 1) (by rw [Finset.mem_Icc]; exact ⟨by omega, hi'⟩),
    flat_mul_subconst_ctx' (G := G) (x := x) (D := D) (b := i) (by rw [Finset.mem_range]; omega),
    subconst_mul_flat_ctx' (G := G) (x := x) (D := D) (a := i) (by rw [Finset.mem_range]; omega),
    subconst_mul_lowering_ctx' (G := G) (x := x) (D := D) (a := i) hi',
    subconst_mul_self_ctx',
    show i + 1 - 1 = i from by omega]

/-- The product `R·L·F·E*_i` is supported on level `i` on the left as well. -/
theorem raising_lowering_flat_mul_subconst {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) :
    raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D * flat (𝕜 := ℂ) G x D
        * subconst G x i
      = subconst (𝕜 := ℂ) G x i * raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
        * flat (𝕜 := ℂ) G x D * subconst G x i := by
  simp only [mul_assoc,
    lowering_mul_subconst (G := G) (x := x) (D := D) (b := i) (by rw [Finset.mem_Icc]; exact ⟨hi, hiD⟩),
    flat_mul_subconst (G := G) (x := x) (D := D) (b := i) (by rw [Finset.mem_range]; omega),
    raising_mul_subconst (G := G) (x := x) (D := D) (b := i - 1) (by omega),
    subconst_mul_raising (G := G) (x := x) (D := D) hi hiD,
    subconst_mul_self G x i,
    lowering_mul_subconst_ctx' (G := G) (x := x) (D := D) (b := i) (by rw [Finset.mem_Icc]; exact ⟨hi, hiD⟩),
    flat_mul_subconst_ctx' (G := G) (x := x) (D := D) (b := i) (by rw [Finset.mem_range]; omega),
    raising_mul_subconst_ctx' (G := G) (x := x) (D := D) (b := i - 1) (by omega),
    subconst_mul_raising_ctx' (G := G) (x := x) (D := D) (a := i) hi hiD,
    subconst_mul_self_ctx',
    show i - 1 + 1 = i from by omega]

/-- The product `L·R·F·E*_i` is supported on level `i` on the left as well. -/
theorem lowering_raising_flat_mul_subconst {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D)
    (hi' : i + 1 ≤ D) :
    lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D * flat (𝕜 := ℂ) G x D
        * subconst G x i
      = subconst (𝕜 := ℂ) G x i * lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D
        * flat (𝕜 := ℂ) G x D * subconst G x i := by
  simp only [mul_assoc,
    raising_mul_subconst (G := G) (x := x) (D := D) (b := i) (by omega),
    flat_mul_subconst (G := G) (x := x) (D := D) (b := i) (by rw [Finset.mem_range]; omega),
    lowering_mul_subconst (G := G) (x := x) (D := D) (b := i + 1) (by rw [Finset.mem_Icc]; exact ⟨by omega, hi'⟩),
    subconst_mul_lowering (G := G) (x := x) (D := D) hi',
    subconst_mul_self G x i,
    raising_mul_subconst_ctx' (G := G) (x := x) (D := D) (b := i) (by omega),
    flat_mul_subconst_ctx' (G := G) (x := x) (D := D) (b := i) (by rw [Finset.mem_range]; omega),
    lowering_mul_subconst_ctx' (G := G) (x := x) (D := D) (b := i + 1) (by rw [Finset.mem_Icc]; exact ⟨by omega, hi'⟩),
    subconst_mul_lowering_ctx' (G := G) (x := x) (D := D) (a := i) hi',
    subconst_mul_self_ctx',
    show i + 1 - 1 = i from by omega]

/-- **Theorem 30.1 (ii), corrected.**  For `1 ≤ i`, `i + 1 ≤ D`, if the level-`i`
squeeze of the cubic relation of Theorem 29.1 holds,
`E*_i(A²A* - AA*A²)E*_i = 0`, and `θ*_{i-1} ≠ θ*_i`, then `F` commutes with
`RL - h·LR` on `E*_iV`, where `h = (θ*_i - θ*_{i+1})/(θ*_{i-1} - θ*_i)`.

This is the notes' `[F, LR - h_i·RL]E*_i = O` with `h_i = (θ*_{i-1}-θ*_i)/(θ*_i-θ*_{i+1})`
= `h⁻¹`: the two forms differ by the factor `-h`, since `RL - h·LR = -h·(LR - h⁻¹·RL)`.
The draft in this file had `h` un-inverted, no `E*_i` squeeze, and no hypothesis
tying `θ*` to the graph (see the audit note in the Chapter 30 section above). -/
theorem flat_commutator_rl_restated {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) (hi' : i + 1 ≤ D)
    (hθ : Y.thetaStar ⟨i - 1, by omega⟩ ≠ Y.thetaStar ⟨i, by omega⟩)
    (hbal : subconst (𝕜 := ℂ) G x i * (adj G * adj G * Y.Astar * adj G
        - adj G * Y.Astar * (adj G * adj G)) * subconst G x i = 0) :
    ∃ h : ℂ, h = (((Y.thetaStar ⟨i, by omega⟩ - Y.thetaStar ⟨i + 1, by omega⟩ : ℝ)) : ℂ)
        / (((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ) ∧
      flat (𝕜 := ℂ) G x D *
          (raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
            - h • (lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D))
          * subconst (𝕜 := ℂ) G x i
        = (raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
            - h • (lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D))
          * flat (𝕜 := ℂ) G x D * subconst (𝕜 := ℂ) G x i := by
  have hFirst := subconst_mul_A2_Astar_mul_A (Y := Y) Y.diam ⟨i, Nat.lt_succ_of_le hiD⟩
  have hSecond := subconst_mul_A_Astar_mul_A2 (Y := Y) Y.diam ⟨i, Nat.lt_succ_of_le hiD⟩
  have hFirst' : subconst (𝕜 := ℂ) G x i * (adj G * adj G * Y.Astar * adj G)
        * subconst G x i
      = ∑ j : Fin (D + 1), ∑ k : Fin (D + 1),
        (Y.thetaStar j : ℂ) • Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j k := by
    rw [hFirst]; simp only [Tfun]
  have hSecond' : subconst (𝕜 := ℂ) G x i * (adj G * Y.Astar * (adj G * adj G))
        * subconst G x i
      = ∑ j : Fin (D + 1), ∑ k : Fin (D + 1),
        (Y.thetaStar j : ℂ) • Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ k j := by
    rw [hSecond]; simp only [Tfun]
  have hsplit : subconst (𝕜 := ℂ) G x i * (adj G * adj G * Y.Astar * adj G
        - adj G * Y.Astar * (adj G * adj G)) * subconst G x i
      = subconst (𝕜 := ℂ) G x i * (adj G * adj G * Y.Astar * adj G) * subconst G x i
        - subconst (𝕜 := ℂ) G x i * (adj G * Y.Astar * (adj G * adj G))
          * subconst G x i := by
    rw [mul_sub, sub_mul]
  have hdiff : (∑ j : Fin (D + 1), ∑ k : Fin (D + 1),
        (Y.thetaStar j : ℂ) • Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j k)
      - (∑ j : Fin (D + 1), ∑ k : Fin (D + 1),
        (Y.thetaStar j : ℂ) • Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ k j)
      = ∑ j : Fin (D + 1), ∑ k : Fin (D + 1),
        ((Y.thetaStar j : ℂ) - (Y.thetaStar k : ℂ)) •
          Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j k := by
    have hswap : (∑ j : Fin (D + 1), ∑ k : Fin (D + 1),
        (Y.thetaStar j : ℂ) • Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ k j)
        = ∑ j : Fin (D + 1), ∑ k : Fin (D + 1),
        (Y.thetaStar k : ℂ) • Tfun G x D ⟨i, Nat.lt_succ_of_le hiD⟩ j k := by
      rw [Finset.sum_comm]
    rw [hswap, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [← sub_smul]
  have hzero : ((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ) : ℂ) •
        (subconst (𝕜 := ℂ) G x i * flat (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D
            * lowering (𝕜 := ℂ) G x D * subconst G x i
          - subconst (𝕜 := ℂ) G x i * raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
            * flat (𝕜 := ℂ) G x D * subconst G x i)
      + ((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ) : ℂ) •
        (subconst (𝕜 := ℂ) G x i * flat (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
            * raising (𝕜 := ℂ) G x D * subconst G x i
          - subconst (𝕜 := ℂ) G x i * lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D
            * flat (𝕜 := ℂ) G x D * subconst G x i) = 0 := by
    rw [← sum_collapse (Y := Y) hi hiD hi', ← hdiff, ← hFirst', ← hSecond', ← hsplit]
    exact hbal
  -- abbreviations
  obtain ⟨A, B, C, E, hA, hB, hC, hE⟩ : ∃ A B C E : Matrix X X ℂ,
      A = subconst (𝕜 := ℂ) G x i * flat G x D * raising G x D * lowering G x D
          * subconst G x i ∧
      B = subconst (𝕜 := ℂ) G x i * raising G x D * lowering G x D * flat G x D
          * subconst G x i ∧
      C = subconst (𝕜 := ℂ) G x i * flat G x D * lowering G x D * raising G x D
          * subconst G x i ∧
      E = subconst (𝕜 := ℂ) G x i * lowering G x D * raising G x D * flat G x D
          * subconst G x i :=
    ⟨_, _, _, _, rfl, rfl, rfl, rfl⟩
  rw [← hA, ← hB, ← hC, ← hE] at hzero
  -- the scalar identity `A - B = h • (C - E)`
  have hne : ((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ) : ℂ) ≠ 0 := by
    have h1 : Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ ≠ 0 :=
      sub_ne_zero.mpr hθ
    exact_mod_cast h1
  have hAB : A - B
      = -((((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)
        / (((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)) •
        (C - E) := by
    have h2 : ((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ) : ℂ) •
          (A - B)
        = -((((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ) •
          (C - E)) := by
      rw [eq_neg_iff_add_eq_zero]
      exact hzero
    calc A - B = ((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ) : ℂ)⁻¹ •
          (((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ) : ℂ) • (A - B)) := by
          rw [smul_smul, inv_mul_cancel₀ hne, one_smul]
      _ = ((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ) : ℂ)⁻¹ •
          (-((((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ) •
            (C - E))) := by rw [h2]
      _ = -((((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)
          / (((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)) •
          (C - E) := by
          rw [smul_neg, smul_smul, div_eq_mul_inv, mul_comm, neg_smul]
  -- the two halves
  have hLHS : flat (𝕜 := ℂ) G x D *
        (raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
          - (-((((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)
            / (((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)))
            • (lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D)) * subconst (𝕜 := ℂ) G x i
      = A - (-((((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)
            / (((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ))) • C := by
    rw [mul_sub, Matrix.mul_smul, sub_mul, Matrix.smul_mul]
    rw [show flat (𝕜 := ℂ) G x D * (raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D)
          * subconst G x i
        = flat (𝕜 := ℂ) G x D * raising G x D * lowering G x D * subconst G x i from by
      noncomm_ring,
      show (flat (𝕜 := ℂ) G x D * (lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D))
          * subconst G x i
        = flat (𝕜 := ℂ) G x D * lowering G x D * raising G x D * subconst G x i from by
      noncomm_ring]
    rw [flat_raising_lowering_mul_subconst hi hiD,
      flat_lowering_raising_mul_subconst hi hiD hi', ← hA, ← hC]
  have hRHS : (raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D
          - (-((((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)
            / (((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)))
            • (lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D)) * flat (𝕜 := ℂ) G x D
          * subconst (𝕜 := ℂ) G x i
      = B - (-((((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)
            / (((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ))) • E := by
    rw [sub_mul, sub_mul, Matrix.smul_mul, Matrix.smul_mul]
    rw [show (raising (𝕜 := ℂ) G x D * lowering (𝕜 := ℂ) G x D) * flat (𝕜 := ℂ) G x D
          * subconst G x i
        = raising (𝕜 := ℂ) G x D * lowering G x D * flat G x D * subconst G x i from by
      noncomm_ring,
      show ((lowering (𝕜 := ℂ) G x D * raising (𝕜 := ℂ) G x D) * flat (𝕜 := ℂ) G x D)
          * subconst G x i
        = lowering (𝕜 := ℂ) G x D * raising G x D * flat G x D * subconst G x i from by
      noncomm_ring]
    rw [raising_lowering_flat_mul_subconst hi hiD,
      lowering_raising_flat_mul_subconst hi hiD hi', ← hB, ← hE]
  refine ⟨-((((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)
      / (((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)), ?_, ?_⟩
  · -- the coefficient is `(θ*_i - θ*_{i+1})/(θ*_{i-1} - θ*_i)`
    have : (((Y.thetaStar ⟨i, by omega⟩ - Y.thetaStar ⟨i + 1, by omega⟩ : ℝ)) : ℂ)
        = -((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ) : ℂ) := by
      push_cast
      ring
    rw [this, neg_div]
  · rw [hLHS, hRHS]
    have h2 : A - B = (-((((Y.thetaStar ⟨i + 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ)
        / (((Y.thetaStar ⟨i - 1, by omega⟩ - Y.thetaStar ⟨i, by omega⟩ : ℝ)) : ℂ))) • (C - E) := hAB
    rw [smul_sub] at h2
    rw [show A = (A - B) + B from by abel, h2]
    abel

end DRGData

/-! ## Chapter 28 (continued): Lemma 28.1 proved from the balanced conditions -/

/-! ### The draft refutation -/

/-- **The draft statement of Lemma 28.1 forces `|X| ≤ 1 + k(x) + ∑_{y ∼ x} k(y)`**:
take the arbitrary matrix `E` of the draft to be the identity. -/
theorem eigenspace_one_dim_draft_implies_card_le (G : SimpleGraph X) (x : X)
    (hdraft : ∀ E : Matrix X X ℂ, Module.finrank ℂ (LinearMap.range E.mulVecLin) ≤
      1 + valency G x + (∑ y ∈ sphere G x 1, valency G y)) :
    Fintype.card X ≤ 1 + valency G x + (∑ y ∈ sphere G x 1, valency G y) := by
  have h := hdraft 1
  have htop : LinearMap.range (1 : Matrix X X ℂ).mulVecLin = ⊤ := by
    refine LinearMap.range_eq_top.mpr fun v => ⟨v, ?_⟩
    rw [Matrix.mulVecLin_apply, Matrix.one_mulVec]
  rw [htop, finrank_top, Module.finrank_fintype_fun_eq_card] at h
  exact h

/-- `ρ(y) = E ŷ`, the `y`-th column of `E`. -/
def rho (E : Matrix X X ℂ) (y : X) : X → ℂ := E *ᵥ Pi.single y 1

theorem rho_def (E : Matrix X X ℂ) (y : X) : rho E y = E *ᵥ Pi.single y 1 := rfl

/-- **Theorem 24.2 (ic) + (ii), vector form.**  For every `w, y` at distance `h`
(`1 ≤ h ≤ D`) the alternating sum of the `ρ(z)` over the two `Δ`-configurations is
a nonzero multiple of `ρ(w) - ρ(y)`.  This is the "balanced" display used in the
proof of Lemma 28.1 (lecture 24, Claim 4, with the coefficient `r^h_{12} ≠ 0` of
part (ii)). -/
def BalancedVectors (G : SimpleGraph X) (D : ℕ) (E : Matrix X X ℂ) : Prop :=
  ∀ (w y : X) (h : ℕ), 1 ≤ h → h ≤ D → G.dist w y = h →
    ∃ r : ℂ, r ≠ 0 ∧
      (∑ z ∈ Finset.univ.filter (fun z => G.dist w z = 1 ∧ G.dist y z = 2), rho E z)
          - (∑ z ∈ Finset.univ.filter (fun z => G.dist w z = 2 ∧ G.dist y z = 1), rho E z)
        = r • (rho E w - rho E y)

/-- Splitting a shortest path: if `∂(u,v) = h` and `k ≤ h`, there is a vertex `z`
with `∂(u,z) = h - k` and `∂(z,v) = k`. -/
theorem exists_dist_split {G : SimpleGraph X} (hconn : G.Connected) {u v : X} {h : ℕ}
    (huv : G.dist u v = h) {k : ℕ} (hk : k ≤ h) :
    ∃ z : X, G.dist u z = h - k ∧ G.dist z v = k := by
  obtain ⟨p, hp⟩ := hconn.exists_walk_length_eq_dist u v
  have hp' : p.length = h := by rw [hp, huv]
  refine ⟨p.getVert (h - k), ?_, ?_⟩
  · have h1 : G.dist u (p.getVert (h - k)) ≤ h - k := by
      have hle := SimpleGraph.dist_le (p.take (h - k))
      rw [SimpleGraph.Walk.take_length, hp'] at hle
      simpa using hle
    have h2 : G.dist (p.getVert (h - k)) v ≤ k := by
      have hle := SimpleGraph.dist_le (p.drop (h - k))
      rw [SimpleGraph.Walk.drop_length, hp'] at hle
      omega
    have h3 := hconn.dist_triangle (u := u) (v := p.getVert (h - k)) (w := v)
    omega
  · have h1 : G.dist u (p.getVert (h - k)) ≤ h - k := by
      have hle := SimpleGraph.dist_le (p.take (h - k))
      rw [SimpleGraph.Walk.take_length, hp'] at hle
      simpa using hle
    have h2 : G.dist (p.getVert (h - k)) v ≤ k := by
      have hle := SimpleGraph.dist_le (p.drop (h - k))
      rw [SimpleGraph.Walk.drop_length, hp'] at hle
      omega
    have h3 := hconn.dist_triangle (u := u) (v := p.getVert (h - k)) (w := v)
    omega

/-- The span of the `ρ(y)` with `∂(x,y) ≤ 2`. -/
def nearSpan (G : SimpleGraph X) (x : X) (E : Matrix X X ℂ) : Submodule ℂ (X → ℂ) :=
  Submodule.span ℂ ↑((Finset.univ.filter (fun z => G.dist x z ≤ 2)).image (fun z => rho E z))

theorem rho_mem_nearSpan {G : SimpleGraph X} {x : X} (E : Matrix X X ℂ) {y : X}
    (hy : G.dist x y ≤ 2) : rho E y ∈ nearSpan G x E :=
  Submodule.subset_span
    (Finset.mem_image.2 ⟨y, Finset.mem_filter.2 ⟨Finset.mem_univ y, hy⟩, rfl⟩)

/-- **Lemma 28.1, inductive step.**  `ρ(y) ∈ Span{ρ(z) | ∂(x,z) ≤ 2}` for every
`y` at distance `≤ n` from `x`. -/
theorem rho_mem_span_of_dist_le {G : SimpleGraph X} {x : X} {D : ℕ} (hconn : G.Connected)
    (hD : 3 ≤ D) (hdiam : ∀ y, G.dist x y ≤ D) (E : Matrix X X ℂ)
    (hbal : BalancedVectors G D E) :
    ∀ (n : ℕ) (y : X), G.dist x y ≤ n → rho E y ∈ nearSpan G x E := by
  intro n
  induction n with
  | zero =>
    intro y hy
    have h0 : G.dist x y = 0 := by omega
    have hyx : y = x := ((hconn.dist_eq_zero_iff (u := x) (v := y)).mp h0).symm
    subst hyx
    exact rho_mem_nearSpan E (by simp)
  | succ n ih =>
    intro y hy
    by_cases hsmall : G.dist x y ≤ 2
    · exact rho_mem_nearSpan E hsmall
    have hsmall' : 2 < G.dist x y := not_le.mp hsmall
    set h : ℕ := G.dist x y with hh
    have h3 : 3 ≤ h := by omega
    have hD' : h ≤ D := by rw [hh]; exact hdiam y
    obtain ⟨x', hx'1, hx'2⟩ := exists_dist_split hconn (u := x) (v := y) (k := 3)
      (show G.dist x y = h from hh.symm) (by omega)
    obtain ⟨r, hr0, hr⟩ := hbal x' y 3 (by norm_num) hD hx'2
    have hr' : r⁻¹ • ((∑ z ∈ Finset.univ.filter (fun z => G.dist x' z = 1 ∧ G.dist y z = 2),
          rho E z) - (∑ z ∈ Finset.univ.filter (fun z => G.dist x' z = 2 ∧ G.dist y z = 1),
            rho E z)) = rho E x' - rho E y := by
      rw [hr, smul_smul, inv_mul_cancel₀ hr0, one_smul]
    have hsplit : rho E y = rho E x'
        - r⁻¹ • ((∑ z ∈ Finset.univ.filter (fun z => G.dist x' z = 1 ∧ G.dist y z = 2),
            rho E z) - (∑ z ∈ Finset.univ.filter (fun z => G.dist x' z = 2 ∧ G.dist y z = 1),
              rho E z)) := by
      rw [hr']
      abel
    rw [hsplit]
    refine Submodule.sub_mem _ (ih x' ?_) (Submodule.smul_mem _ _ (Submodule.sub_mem _ ?_ ?_))
    · omega
    · -- vertices at distance 1 from `x'` (hence `h - 2` from `x`)
      refine Submodule.sum_mem _ fun z hz => ?_
      rw [Finset.mem_filter] at hz
      obtain ⟨-, hz1, hz2⟩ := hz
      refine ih z ?_
      have htri := hconn.dist_triangle (u := x) (v := x') (w := z)
      omega
    · refine Submodule.sum_mem _ fun z hz => ?_
      rw [Finset.mem_filter] at hz
      obtain ⟨-, hz1, hz2⟩ := hz
      refine ih z ?_
      have htri := hconn.dist_triangle (u := x) (v := x') (w := z)
      omega

/-- The `ρ(y)` with `∂(x,y) ≤ 2` all lie in the image of `E`. -/
theorem nearSpan_le_range (G : SimpleGraph X) (x : X) (E : Matrix X X ℂ) :
    nearSpan G x E ≤ LinearMap.range E.mulVecLin := by
  rw [nearSpan, Submodule.span_le]
  intro v hv
  simp only [SetLike.mem_coe, Finset.mem_image] at hv
  obtain ⟨y, -, rfl⟩ := hv
  exact ⟨Pi.single y 1, by rw [Matrix.mulVecLin_apply]; rfl⟩

/-- Every column of `E` lies in the span of the columns over the ball of radius
two. -/
theorem range_le_nearSpan {G : SimpleGraph X} {x : X} {D : ℕ} (hconn : G.Connected)
    (hD : 3 ≤ D) (hdiam : ∀ y, G.dist x y ≤ D) (E : Matrix X X ℂ)
    (hbal : BalancedVectors G D E) : LinearMap.range E.mulVecLin ≤ nearSpan G x E := by
  rintro v ⟨w, rfl⟩
  rw [Matrix.mulVecLin_apply]
  have hw : w = ∑ z, w z • Pi.single z (1 : ℂ) := by
    ext j
    simp [Finset.sum_apply, Pi.single_apply]
  have hcalc : E *ᵥ w = ∑ z, w z • rho E z := by
    conv_lhs => rw [hw]
    rw [Matrix.mulVec_sum]
    exact Finset.sum_congr rfl fun z _ => by rw [Matrix.mulVec_smul]; rfl
  rw [hcalc]
  exact Submodule.sum_mem _ fun z _ =>
    Submodule.smul_mem _ _ (rho_mem_span_of_dist_le hconn hD hdiam E hbal D z (hdiam z))

/-- **Lemma 28.1 (EV), dimension bound.**  Let `Γ` be a graph, `x` a vertex, `D`
with `3 ≤ D`; suppose the columns `ρ(y) = Eŷ` satisfy the balanced vector
identity of Theorem 24.2 with nonzero coefficients.  Then
`dim EV ≤ 1 + k₁ + k₂` where `kᵢ = |{y | ∂(x,y) = i}|`.

(The matrix `E` is the primitive idempotent `E₁` of the scheme; the balanced
identity is the input that makes `E₁` the *first* idempotent of a `Q`-polynomial
ordering.  Lecture 28, Lemma `EV`.) -/
theorem eigenspace_one_dim {G : SimpleGraph X} {x : X} {D : ℕ} (hconn : G.Connected)
    (hD : 3 ≤ D) (hdiam : ∀ y, G.dist x y ≤ D) (E : Matrix X X ℂ)
    (hbal : BalancedVectors G D E) :
    Module.finrank ℂ (LinearMap.range E.mulVecLin) ≤
      1 + (sphere G x 1).card + (sphere G x 2).card := by
  have hEq : LinearMap.range E.mulVecLin = nearSpan G x E :=
    le_antisymm (range_le_nearSpan hconn hD hdiam E hbal) (nearSpan_le_range G x E)
  rw [hEq, nearSpan]
  have hstep : Module.finrank ℂ ↥(Submodule.span ℂ
      ((Finset.image (fun z => rho E z) (Finset.univ.filter (fun z => G.dist x z ≤ 2))) :
        Set (X → ℂ))) ≤ (Finset.univ.filter (fun z => G.dist x z ≤ 2)).card := by
    refine le_trans (finrank_span_finset_le_card (R := ℂ) (M := X → ℂ) _)
      Finset.card_image_le
  refine hstep.trans (le_of_eq ?_)
  have hset : Finset.univ.filter (fun z => G.dist x z ≤ 2)
      = sphere G x 0 ∪ sphere G x 1 ∪ sphere G x 2 := by
    ext z
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, mem_sphere_iff, Finset.mem_union]
    omega
  have hd01 : Disjoint (sphere G x 0) (sphere G x 1) := by
    rw [Finset.disjoint_left]
    intro z hz0 hz1
    rw [mem_sphere_iff] at hz0 hz1
    omega
  have hd02 : Disjoint (sphere G x 0) (sphere G x 2) := by
    rw [Finset.disjoint_left]
    intro z hz0 hz2
    rw [mem_sphere_iff] at hz0 hz2
    omega
  have hd12 : Disjoint (sphere G x 1) (sphere G x 2) := by
    rw [Finset.disjoint_left]
    intro z hz1 hz2
    rw [mem_sphere_iff] at hz1 hz2
    omega
  rw [hset, Finset.card_union_of_disjoint (Finset.disjoint_union_left.2 ⟨hd02, hd12⟩),
    Finset.card_union_of_disjoint hd01, sphere_zero G hconn x, Finset.card_singleton]

theorem fin_one_val {D : ℕ} : ((1 : Fin (D + 1)) : ℕ) = 1 % (D + 1) := rfl

theorem fin_two_val {D : ℕ} : ((2 : Fin (D + 1)) : ℕ) = 2 % (D + 1) := rfl

/-- **Lemma 28.1 (EV)**, in scheme language: `dim E₁V ≤ 1 + k₁ + k₂`. -/
theorem eigenspace_one_dim_scheme {G : SimpleGraph X} {x : X} {D : ℕ} (Y : SchemeData X D)
    (hconn : G.Connected) (hD : 3 ≤ D)
    (hrel : ∀ (i : Fin (D + 1)) (u v : X), Y.scheme.rel i u v ↔ G.dist u v = (i : ℕ))
    (hdiam : ∀ y, G.dist x y ≤ D)
    (hbal : BalancedVectors G D (Y.E 1)) :
    Module.finrank ℂ (LinearMap.range (Y.E 1).mulVecLin) ≤ 1 + Y.kval 1 + Y.kval 2 := by
  have hmain := eigenspace_one_dim hconn hD hdiam (Y.E 1) hbal
  have h1 : (sphere G x 1).card = Y.kval 1 := by
    rw [← Y.card_rel_row (1 : Fin (D + 1)) x]
    congr 1
    refine Finset.ext fun z => ?_
    rw [mem_sphere_iff, Finset.mem_filter]
    constructor
    · intro h
      exact ⟨Finset.mem_univ z,
        (hrel 1 x z).mpr (by rw [fin_one_val, Nat.mod_eq_of_lt (by omega)]; exact h)⟩
    · rintro ⟨-, h⟩
      rw [hrel 1 x z] at h
      rwa [fin_one_val, Nat.mod_eq_of_lt (by omega)] at h
  have h2 : (sphere G x 2).card = Y.kval 2 := by
    rw [← Y.card_rel_row (2 : Fin (D + 1)) x]
    congr 1
    refine Finset.ext fun z => ?_
    rw [mem_sphere_iff, Finset.mem_filter]
    constructor
    · intro h
      exact ⟨Finset.mem_univ z,
        (hrel 2 x z).mpr (by rw [fin_two_val, Nat.mod_eq_of_lt (by omega)]; exact h)⟩
    · rintro ⟨-, h⟩
      rw [hrel 2 x z] at h
      rwa [fin_two_val, Nat.mod_eq_of_lt (by omega)] at h
  omega

/-- `k₂ ≤ ∑_{y ∼ x} k(y)`: every vertex at distance two from `x` is a neighbour of
a vertex at distance one.  (Pure counting; no distance-regularity needed.) -/
theorem sphere_two_card_le_sum_valency {G : SimpleGraph X} {x : X} (hconn : G.Connected) :
    (sphere G x 2).card ≤ ∑ y ∈ sphere G x 1, valency G y := by
  have hsub : sphere G x 2 ⊆ (sphere G x 1).biUnion (fun y => G.neighborFinset y) := by
    intro z hz
    rw [mem_sphere_iff] at hz
    obtain ⟨y, hy1, hy2⟩ := exists_dist_split hconn (u := x) (v := z) hz (k := 1) (by norm_num)
    rw [Finset.mem_biUnion]
    refine ⟨y, ?_, ?_⟩
    · rw [mem_sphere_iff]; omega
    · rw [SimpleGraph.mem_neighborFinset]; exact SimpleGraph.dist_eq_one_iff_adj.mp hy2
  calc (sphere G x 2).card ≤ ((sphere G x 1).biUnion (fun y => G.neighborFinset y)).card :=
        Finset.card_le_card hsub
    _ ≤ ∑ y ∈ sphere G x 1, (G.neighborFinset y).card := Finset.card_biUnion_le
    _ = ∑ y ∈ sphere G x 1, valency G y := rfl

/-- **Lemma 28.1 (EV)** in the shape of the removed draft: with the balanced
identity as hypothesis, `dim E₁V ≤ 1 + k(x) + ∑_{y ∼ x} k(y)`. -/
theorem eigenspace_one_dim_draft_shape {G : SimpleGraph X} {x : X} {D : ℕ}
    (hconn : G.Connected) (hD : 3 ≤ D) (hdiam : ∀ y, G.dist x y ≤ D)
    (E : Matrix X X ℂ) (hbal : BalancedVectors G D E) :
    Module.finrank ℂ (LinearMap.range E.mulVecLin) ≤
      1 + valency G x + (∑ y ∈ sphere G x 1, valency G y) := by
  have h := eigenspace_one_dim hconn hD hdiam E hbal
  have h1 : (sphere G x 1).card = valency G x := by
    rw [valency]
    congr 1
    ext y
    rw [mem_sphere_iff, SimpleGraph.mem_neighborFinset, SimpleGraph.dist_eq_one_iff_adj]
  have h2 := sphere_two_card_le_sum_valency (G := G) (x := x) hconn
  omega


section QAPrimitiveIdempotents

variable {G : SimpleGraph X}


/-- A vertex at distance exactly `D` forces a vertex at every distance `i ≤ D`
(namely the `i`-th vertex of a geodesic). -/
theorem exists_dist_eq_of_dist_eq {a b : X} {D : ℕ} (hG : G.Connected) (hab : G.dist a b = D)
    {i : ℕ} (hi : i ≤ D) : ∃ y, G.dist a y = i := by
  obtain ⟨p, hp⟩ := hG.exists_walk_length_eq_dist a b
  have hlen : p.length = D := by rw [hp, hab]
  refine ⟨p.getVert i, le_antisymm ?_ ?_⟩
  · calc G.dist a (p.getVert i) ≤ (p.take i).length := SimpleGraph.dist_le _
      _ = min i p.length := SimpleGraph.Walk.take_length p i
      _ ≤ i := min_le_left _ _
  · have h1 : G.dist a b ≤ G.dist a (p.getVert i) + G.dist (p.getVert i) b := hG.dist_triangle
    have h2 : G.dist (p.getVert i) b ≤ (p.drop i).length := SimpleGraph.dist_le _
    rw [SimpleGraph.Walk.drop_length, hlen] at h2
    omega

/-- **Independence of the distance matrices** `A₀, …, A_D` when `D` is the diameter
(realised by some pair).  Row `a` of `Aᵢ` is the indicator of the `i`-th sphere
around `a`, and every such sphere is non-empty. -/
theorem linearIndependent_distMatrix {D : ℕ} (hG : G.Connected) {a b : X}
    (hab : G.dist a b = D) :
    LinearIndependent ℂ (fun i : Fin (D + 1) => distMatrix (𝕜 := ℂ) G (i : ℕ)) := by
  rw [Fintype.linearIndependent_iff]
  intro g hg i
  obtain ⟨y, hy⟩ := exists_dist_eq_of_dist_eq hG hab (i := (i : ℕ)) (by omega)
  have h1 : (∑ j : Fin (D + 1), g j • distMatrix (𝕜 := ℂ) G (j : ℕ)) = 0 := hg
  have h2 := congrFun (congrFun h1 y) a
  rw [Matrix.zero_apply] at h2
  have hterm : ∀ j : Fin (D + 1),
      (g j • distMatrix (𝕜 := ℂ) G (j : ℕ)) y a = if j = i then g i else 0 := by
    intro j
    rw [Matrix.smul_apply, smul_eq_mul, distMatrix_apply, SimpleGraph.dist_comm (u := y) (v := a), hy]
    by_cases hji : j = i
    · subst hji; simp
    · rw [if_neg, if_neg hji, mul_zero]
      intro h
      exact hji (Fin.ext h.symm)
  have hsum : (∑ j : Fin (D + 1), (g j • distMatrix (𝕜 := ℂ) G (j : ℕ)) y a) = g i := by
    rw [Finset.sum_congr rfl (fun j (_ : j ∈ Finset.univ) => hterm j)]
    rw [Finset.sum_eq_single i]
    · simp
    · intro j _ hji; simp [hji]
    · intro h; exact absurd (Finset.mem_univ i) h
  rw [Matrix.sum_apply, hsum] at h2
  exact h2

/-- **Dimension of the Bose–Mesner algebra**: `dim M = D + 1` for a DRG of diameter
`D` (`D` realised). -/
theorem finrank_boseMesner (hG : G.Connected) (hdr : IsDistanceRegular G)
    (hbi : IntersectionNumbersIndependent G) {D : ℕ} (hD1 : 1 ≤ D)
    (hDall : ∀ a b : X, G.dist a b ≤ D) (hDex : ∃ a b : X, G.dist a b = D) :
    Module.finrank ℂ (boseMesner (𝕜 := ℂ) G).toSubmodule = D + 1 := by
  obtain ⟨a, b, hab⟩ := hDex
  rw [boseMesner_eq_span_distMatrix (x := a) hG hdr hbi D hD1 hDall]
  rw [finrank_span_eq_card (linearIndependent_distMatrix hG hab)]
  simp

/-! ### The spectral-projection form of the primitive idempotents -/

/-- `p(A) = ∑_{θ ∈ spec A} p(θ) • E_θ`. -/
theorem aeval_eq_sum_smul_spectralProj {A : Matrix X X ℂ} (hA : star A = A) (p : Polynomial ℂ) :
    (Polynomial.aeval A) p = ∑ θ ∈ eigFinset A, (p.eval θ) • spectralProj A θ := by
  conv_lhs => rw [← mul_one ((Polynomial.aeval A) p), ← sum_spectralProj (X := X) hA]
  rw [Matrix.mul_sum]
  exact Finset.sum_congr rfl fun θ hθ => aeval_mul_spectralProj hA p hθ

/-- A spectral projection of an eigenvalue is nonzero. -/
theorem spectralProj_ne_zero {A : Matrix X X ℂ} (hA : star A = A) {θ : ℂ}
    (hθ : θ ∈ eigFinset A) : spectralProj A θ ≠ 0 := by
  obtain ⟨v, hv, hAv⟩ := (isEigenvalue_iff_mem_eigFinset hA).mpr hθ
  intro h0
  have h1 := spectralProj_mulVec_eigenvector hA hθ hv hAv
  rw [h0, Matrix.zero_mulVec] at h1
  exact hv h1.symm

/-- The spectral projections are linearly independent: they are nonzero and pairwise
orthogonal idempotents. -/
theorem linearIndependent_spectralProj {A : Matrix X X ℂ} (hA : star A = A) :
    LinearIndependent ℂ (fun θ : ↥(eigFinset A) => spectralProj A θ.1) := by
  rw [Fintype.linearIndependent_iff]
  intro g hg θ0
  have h1 : (∑ θ : ↥(eigFinset A), g θ • spectralProj A θ.1) * spectralProj A θ0.1 = 0 := by
    rw [hg, Matrix.zero_mul]
  rw [Finset.sum_mul] at h1
  simp only [Matrix.smul_mul] at h1
  rw [Finset.sum_eq_single θ0] at h1
  · rw [spectralProj_mul_self hA θ0.2] at h1
    exact (smul_eq_zero.mp h1).resolve_right (spectralProj_ne_zero hA θ0.2)
  · intro θ _ hne
    rw [spectralProj_mul_of_ne hA (fun h => hne (Subtype.ext h)), smul_zero]
  · intro h
    exact absurd (Finset.mem_univ θ0) h

/-! ### The valency as an eigenvalue -/

/-- The row sum of the adjacency matrix is the `0`-th `b`-number, independent of the
vertex: `Γ` is regular. -/
theorem sum_adj_eq_bval (hG : G.Connected) (hdr : IsDistanceRegular G)
    (hbi : IntersectionNumbersIndependent G) (a u : X) :
    ∑ z, adj (𝕜 := ℂ) G u z = (bval G a 0 : ℂ) := by
  have h1 : adj (𝕜 := ℂ) G * distMatrix (𝕜 := ℂ) G 1
      = (bval G a 0 : ℂ) • distMatrix (𝕜 := ℂ) G 0
        + (aval G a 1 : ℂ) • distMatrix (𝕜 := ℂ) G 1
        + (cval G a 2 : ℂ) • distMatrix (𝕜 := ℂ) G 2 :=
    adj_mul_distMatrix hG hdr hbi (x := a) (i := 1) le_rfl
  have h2 := congrFun (congrFun h1 u) u
  have hlhs : (adj (𝕜 := ℂ) G * distMatrix (𝕜 := ℂ) G 1) u u
      = ∑ z, adj (𝕜 := ℂ) G u z := by
    rw [Matrix.mul_apply]
    refine Finset.sum_congr rfl fun z _ => ?_
    rw [distMatrix_apply]
    by_cases hz : G.Adj u z
    · rw [if_pos (by rw [SimpleGraph.dist_comm (u := z) (v := u)]; exact SimpleGraph.dist_eq_one_iff_adj.mpr hz),
        mul_one, adj_apply, if_pos hz]
    · rw [if_neg, mul_zero, adj_apply, if_neg hz]
      intro hd
      exact hz (SimpleGraph.dist_eq_one_iff_adj.mp hd).symm
  have hrhs : ((bval G a 0 : ℂ) • distMatrix (𝕜 := ℂ) G 0
      + (aval G a 1 : ℂ) • distMatrix (𝕜 := ℂ) G 1
      + (cval G a 2 : ℂ) • distMatrix (𝕜 := ℂ) G 2) u u = (bval G a 0 : ℂ) := by
    rw [Matrix.add_apply, Matrix.add_apply, Matrix.smul_apply, Matrix.smul_apply,
      Matrix.smul_apply, smul_eq_mul, smul_eq_mul, smul_eq_mul, distMatrix_apply,
      distMatrix_apply, distMatrix_apply, SimpleGraph.dist_self]
    simp
  rw [hlhs, hrhs] at h2
  exact h2

/-- The constant vector is an eigenvector of `A` for the eigenvalue `k = bval G a 0`. -/
theorem adj_mulVec_one (hG : G.Connected) (hdr : IsDistanceRegular G)
    (hbi : IntersectionNumbersIndependent G) (a : X) :
    adj (𝕜 := ℂ) G *ᵥ (fun _ => (1 : ℂ)) = (bval G a 0 : ℂ) • (fun _ => (1 : ℂ)) := by
  funext u
  rw [Matrix.mulVec, dotProduct, Pi.smul_apply, smul_eq_mul, mul_one]
  simpa using sum_adj_eq_bval hG hdr hbi a u

/-- The valency is an eigenvalue. -/
theorem isEigenvalue_valency (hG : G.Connected) (hdr : IsDistanceRegular G)
    (hbi : IntersectionNumbersIndependent G) (a : X) [Nonempty X] :
    IsEigenvalue (adj (𝕜 := ℂ) G) (bval G a 0 : ℂ) := by
  refine ⟨fun _ => (1 : ℂ), ?_, adj_mulVec_one hG hdr hbi a⟩
  intro h
  have h1 := congrFun h a
  simp at h1

/-! ### The number of distinct eigenvalues -/

/-- The adjacency matrix of a DRG of diameter `D` (`D` realised) has exactly `D+1`
distinct eigenvalues. -/
theorem card_eigFinset_adj (hG : G.Connected) (hdr : IsDistanceRegular G)
    (hbi : IntersectionNumbersIndependent G) {D : ℕ} (hD1 : 1 ≤ D)
    (hDall : ∀ a b : X, G.dist a b ≤ D) (hDex : ∃ a b : X, G.dist a b = D) :
    (eigFinset (adj (𝕜 := ℂ) G)).card = D + 1 := by
  obtain ⟨a, b, hab⟩ := hDex
  have hne : Nonempty X := ⟨a⟩
  set A := adj (𝕜 := ℂ) G with hAdef
  have hA : star A = A := star_adj G
  have hfin := finrank_boseMesner hG hdr hbi hD1 hDall ⟨a, b, hab⟩
  have hmem : ∀ θ : ↥(eigFinset A),
      spectralProj A θ.1 ∈ (boseMesner (𝕜 := ℂ) G).toSubmodule := by
    intro θ
    exact spectralProj_mem_span (X := X) hA θ.1
  have hLI : LinearIndependent ℂ
      (fun θ : ↥(eigFinset A) =>
        (⟨spectralProj A θ.1, hmem θ⟩ : ↥((boseMesner (𝕜 := ℂ) G).toSubmodule))) := by
    rw [Fintype.linearIndependent_iff] at ⊢
    intro g hg θ0
    refine (Fintype.linearIndependent_iff.mp (linearIndependent_spectralProj hA)) g ?_ θ0
    have h1 := congrArg (fun m : ↥((boseMesner (𝕜 := ℂ) G).toSubmodule) => (m : Matrix X X ℂ)) hg
    simpa using h1
  have hupper : (eigFinset A).card ≤ D + 1 := by
    have h1 := hLI.fintype_card_le_finrank
    rw [hfin] at h1
    simpa using h1
  have hlower : D + 1 ≤ (eigFinset A).card := by
    have hspan : ((boseMesner (𝕜 := ℂ) G).toSubmodule)
        ≤ Submodule.span ℂ (Set.range (fun θ : ↥(eigFinset A) => spectralProj A θ.1)) := by
      intro m hm
      rw [boseMesner, Algebra.adjoin_singleton_eq_range_aeval] at hm
      obtain ⟨p, hp⟩ := hm
      have hp' : (Polynomial.aeval A) p = m := hp
      rw [← hp', aeval_eq_sum_smul_spectralProj hA p]
      refine Submodule.sum_mem _ ?_
      rintro θ hθ
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨⟨θ, hθ⟩, rfl⟩)
    calc D + 1 = Module.finrank ℂ ↥((boseMesner (𝕜 := ℂ) G).toSubmodule) := hfin.symm
      _ ≤ Module.finrank ℂ
            ↥(Submodule.span ℂ (Set.range (fun θ : ↥(eigFinset A) => spectralProj A θ.1))) :=
          Submodule.finrank_mono hspan
      _ ≤ (Set.range (fun θ : ↥(eigFinset A) => spectralProj A θ.1)).toFinset.card :=
          finrank_span_le_card _
      _ = Fintype.card ↥(Set.range (fun θ : ↥(eigFinset A) => spectralProj A θ.1)) :=
          Set.toFinset_card _
      _ ≤ Fintype.card ↥(eigFinset A) := by
          refine Fintype.card_le_of_surjective
            (fun θ : ↥(eigFinset A) =>
              (⟨spectralProj A θ.1, ⟨θ, rfl⟩⟩ :
                ↥(Set.range (fun θ : ↥(eigFinset A) => spectralProj A θ.1)))) ?_
          rintro ⟨m, θ, rfl⟩
          exact ⟨θ, rfl⟩
      _ = (eigFinset A).card := Fintype.card_coe _
  omega

/-! ### The all-ones matrix -/

/-- `A * J = k • J`: the row sums of `A` are the valency. -/
theorem adj_mul_allOnes (hG : G.Connected) (hdr : IsDistanceRegular G)
    (hbi : IntersectionNumbersIndependent G) (a : X) :
    adj (𝕜 := ℂ) G * (allOnes : Matrix X X ℂ)
      = (bval G a 0 : ℂ) • (allOnes : Matrix X X ℂ) := by
  ext u v
  rw [Matrix.mul_apply]
  simp only [allOnes_apply, mul_one, Matrix.smul_apply, smul_eq_mul, mul_one]
  exact sum_adj_eq_bval hG hdr hbi a u

/-- `J * J = |X| • J`. -/
theorem allOnes_mul_allOnes :
    (allOnes : Matrix X X ℂ) * (allOnes : Matrix X X ℂ)
      = (Fintype.card X : ℂ) • (allOnes : Matrix X X ℂ) := by
  ext u v
  rw [Matrix.mul_apply, Matrix.smul_apply, smul_eq_mul]
  simp [allOnes]

/-- `J ≠ 0` (for a non-empty vertex set). -/
theorem allOnes_ne_zero [Nonempty X] : (allOnes : Matrix X X ℂ) ≠ 0 := by
  intro h
  obtain ⟨a⟩ := (inferInstance : Nonempty X)
  have h1 : (allOnes : Matrix X X ℂ) a a = (0 : Matrix X X ℂ) a a := by rw [h]
  simp at h1

/-- `(1/|X|)J` is the spectral projection of the valency eigenvalue. -/
theorem smul_allOnes_eq_spectralProj (hG : G.Connected) (hdr : IsDistanceRegular G)
    (hbi : IntersectionNumbersIndependent G) (a : X) {D : ℕ}
    (hDall : ∀ x y : X, G.dist x y ≤ D) :
    (1 / (Fintype.card X : ℂ)) • (allOnes : Matrix X X ℂ)
      = spectralProj (adj (𝕜 := ℂ) G) (bval G a 0 : ℂ) := by
  haveI : Nonempty X := ⟨a⟩
  set A := adj (𝕜 := ℂ) G with hAdef
  have hA : star A = A := star_adj G
  set k : ℂ := (bval G a 0 : ℂ) with hkdef
  have hNne : (Fintype.card X : ℂ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero (α := X)
  have hkmem : k ∈ eigFinset A := by
    refine isEigenvalue_iff_mem_eigFinset'.mp ?_
    rw [hkdef, hAdef]
    exact isEigenvalue_valency hG hdr hbi a
  set P : Matrix X X ℂ := (1 / (Fintype.card X : ℂ)) • (allOnes : Matrix X X ℂ) with hPdef
  have hPmul : P * P = P := by
    rw [hPdef, Matrix.smul_mul, Matrix.mul_smul, allOnes_mul_allOnes, smul_smul, smul_smul]
    rw [show (1 / (Fintype.card X : ℂ)) * (1 / (Fintype.card X : ℂ)) * (Fintype.card X : ℂ)
        = 1 / (Fintype.card X : ℂ) from by field_simp]
  have hAP : A * P = k • P := by
    rw [hPdef, hkdef, Matrix.mul_smul, hAdef, adj_mul_allOnes hG hdr hbi a, smul_smul,
      smul_smul]
    congr 1
    ring
  have hPmem : P ∈ (boseMesner (𝕜 := ℂ) G).toSubmodule := by
    rw [hPdef]
    refine Submodule.smul_mem _ _ ?_
    rw [← sum_distMatrix (𝕜 := ℂ) G D hDall]
    refine Submodule.sum_mem _ ?_
    intro i _
    exact distMatrix_mem_boseMesner (x := a) hG hdr hbi i
  have hPmem2 := hPmem
  rw [boseMesner, Algebra.adjoin_singleton_eq_range_aeval] at hPmem2
  obtain ⟨p, hp⟩ := hPmem2
  have hp' : (Polynomial.aeval A) p = P := hp
  have hPsum : P = ∑ θ : ↥(eigFinset A), (p.eval θ.1) • spectralProj A θ.1 := by
    rw [← hp', aeval_eq_sum_smul_spectralProj hA p,
      ← Finset.sum_coe_sort (eigFinset A) (fun θ : ℂ => p.eval θ • spectralProj A θ)]
  have hAPsum : A * P = ∑ θ : ↥(eigFinset A), (p.eval θ.1 * θ.1) • spectralProj A θ.1 := by
    rw [hPsum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun θ _ => ?_
    rw [Matrix.mul_smul, adj_mul_spectralProj hA θ.2, smul_smul]
  have hkPsum : k • P = ∑ θ : ↥(eigFinset A), (k * p.eval θ.1) • spectralProj A θ.1 := by
    rw [hPsum, Finset.smul_sum]
    exact Finset.sum_congr rfl fun θ _ => smul_smul k (p.eval θ.1) (spectralProj A θ.1)
  have hzero : (∑ θ : ↥(eigFinset A), (p.eval θ.1 * (θ.1 - k)) • spectralProj A θ.1) = 0 := by
    have h1 : (∑ θ : ↥(eigFinset A), (p.eval θ.1 * θ.1) • spectralProj A θ.1)
        - (∑ θ : ↥(eigFinset A), (k * p.eval θ.1) • spectralProj A θ.1) = 0 := by
      rw [← hAPsum, ← hkPsum, hAP, sub_self]
    rw [← Finset.sum_sub_distrib] at h1
    rw [← h1]
    refine Finset.sum_congr rfl fun θ _ => ?_
    rw [← sub_smul]
    congr 1
    ring
  have hcoef : ∀ θ : ↥(eigFinset A), θ.1 ≠ k → p.eval θ.1 = 0 := by
    intro θ hθ
    have h2 := Fintype.linearIndependent_iff.mp (linearIndependent_spectralProj hA)
      (fun θ : ↥(eigFinset A) => p.eval θ.1 * (θ.1 - k)) hzero θ
    rcases mul_eq_zero.mp h2 with h | h
    · exact h
    · exact absurd (sub_eq_zero.mp h) hθ
  have hPk : P = (p.eval k) • spectralProj A k := by
    rw [hPsum]
    have hsum := Finset.sum_eq_single (s := (Finset.univ : Finset ↥(eigFinset A)))
      (f := fun θ : ↥(eigFinset A) => (p.eval θ.1) • spectralProj A θ.1) ⟨k, hkmem⟩ ?_ ?_
    · rw [hsum]
    · intro θ _ hne
      rw [hcoef θ (fun h => hne (Subtype.ext h)), zero_smul]
    · intro h
      exact absurd (Finset.mem_univ _) h
  have hEkne : spectralProj A k ≠ 0 := spectralProj_ne_zero hA hkmem
  have hPne : P ≠ 0 := by
    intro h0
    rw [hPdef] at h0
    have h2 : (allOnes : Matrix X X ℂ) = 0 := by
      rcases smul_eq_zero.mp h0 with h | h
      · rw [one_div] at h
        exact absurd h (inv_ne_zero hNne)
      · exact h
    exact allOnes_ne_zero h2
  have hcc : p.eval k = 1 := by
    have h1 : (p.eval k • spectralProj A k) * (p.eval k • spectralProj A k)
        = p.eval k • spectralProj A k := by
      rw [← hPk]; exact hPmul
    rw [Matrix.smul_mul, Matrix.mul_smul, spectralProj_mul_self hA hkmem, smul_smul] at h1
    have h2 : (p.eval k * p.eval k - p.eval k) • spectralProj A k = 0 := by
      rw [sub_smul, h1, sub_self]
    have h3 : p.eval k * p.eval k - p.eval k = 0 := by
      rcases smul_eq_zero.mp h2 with h | h
      · exact h
      · exact absurd h hEkne
    have hcne : p.eval k ≠ 0 := by
      intro h0
      exact hPne (by rw [hPk, h0, zero_smul])
    have h4 : p.eval k * (p.eval k - 1) = 0 := by linear_combination h3
    rcases mul_eq_zero.mp h4 with h | h
    · exact absurd h hcne
    · linear_combination h
  have hfin : (1 / (Fintype.card X : ℂ)) • (allOnes : Matrix X X ℂ) = spectralProj A k := by
    rw [← hPdef]
    rw [hPk]
    rw [hcc]
    rw [one_smul]
  exact hfin

/-- **QA, strengthened form.**  As `drg_idempotent_basis`, with the additional
conjunct `∀ i, E i ∈ M` (`M = boseMesner G` the Bose–Mesner algebra): this is what a
consumer needs to conclude `E i W ⊆ W` for a `T(x)`-module `W`, since `M ⊆ T(x)`. -/
theorem drg_idempotent_basis_strong {G : SimpleGraph X} (hG : G.Connected)
    (hdr : IsDistanceRegular G) (hbi : IntersectionNumbersIndependent G) {D : ℕ}
    (hD1 : 1 ≤ D) (hDall : ∀ a b : X, G.dist a b ≤ D) (hDex : ∃ a b : X, G.dist a b = D) :
    ∃ (E : Fin (D + 1) → Matrix X X ℂ) (θ : Fin (D + 1) → ℝ),
      (∀ i, E i ∈ (boseMesner (𝕜 := ℂ) G).toSubmodule) ∧
      (∀ i j, E i * E j = if i = j then E i else 0) ∧
      (∑ i, E i = 1) ∧
      (∀ i, star (E i) = E i) ∧
      (∀ i, E i ≠ 0) ∧
      (∀ i, adj (𝕜 := ℂ) G * E i = ((θ i : ℂ)) • E i) ∧
      Function.Injective θ ∧
      E 0 = (1 / (Fintype.card X : ℂ)) • (allOnes : Matrix X X ℂ) ∧
      adj (𝕜 := ℂ) G = ∑ i, ((θ i : ℂ)) • E i := by
  obtain ⟨a, b, hab⟩ := hDex
  haveI : Nonempty X := ⟨a⟩
  set A := adj (𝕜 := ℂ) G with hAdef
  have hA : star A = A := star_adj G
  set k : ℂ := (bval G a 0 : ℂ) with hkdef
  have hcard : (eigFinset A).card = D + 1 := card_eigFinset_adj hG hdr hbi hD1 hDall ⟨a, b, hab⟩
  have hkmem : k ∈ eigFinset A := by
    refine isEigenvalue_iff_mem_eigFinset'.mp ?_
    rw [hkdef, hAdef]
    exact isEigenvalue_valency hG hdr hbi a
  set T : Finset ℂ := (eigFinset A).erase k with hTdef
  have hTcard : T.card = D := by
    rw [hTdef, Finset.card_erase_of_mem hkmem, hcard]
    omega
  set e : ↥T ≃ Fin D := Finset.equivFinOfCardEq hTcard with hedef
  set idx : Fin (D + 1) → ℂ :=
    fun i => Fin.cases k (fun n : Fin D => ((e.symm n : ↥T) : ℂ)) i with hidxdef
  have hidx0 : idx 0 = k := by simp [hidxdef]
  have hidxsucc : ∀ n : Fin D, idx n.succ = ((e.symm n : ↥T) : ℂ) := by
    intro n; simp [hidxdef]
  have hidxmem : ∀ i : Fin (D + 1), idx i ∈ eigFinset A := by
    intro i
    rcases Fin.eq_zero_or_eq_succ i with h | ⟨n, rfl⟩
    · rw [h, hidx0]; exact hkmem
    · rw [hidxsucc n]
      exact Finset.mem_of_mem_erase (e.symm n).2
  have hidxinj : Function.Injective idx := by
    intro i j hij
    rcases Fin.eq_zero_or_eq_succ i with hi | ⟨n, rfl⟩
    · rcases Fin.eq_zero_or_eq_succ j with hj | ⟨m, rfl⟩
      · rw [hi, hj]
      · rw [hi, hidx0, hidxsucc m] at hij
        exact absurd hij.symm (Finset.ne_of_mem_erase (e.symm m).2)
    · rcases Fin.eq_zero_or_eq_succ j with hj | ⟨m, rfl⟩
      · rw [hj, hidx0, hidxsucc n] at hij
        exact absurd hij (Finset.ne_of_mem_erase (e.symm n).2)
      · rw [hidxsucc n, hidxsucc m] at hij
        exact congrArg Fin.succ (e.symm.injective (Subtype.ext hij))
  have hθex : ∀ i : Fin (D + 1), ∃ t : ℝ, idx i = ((t : ℝ) : ℂ) := by
    intro i
    exact eigenvalue_of_real hA (hidxmem i)
  choose θ hθ using hθex
  refine ⟨fun i => spectralProj A (idx i), θ, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    exact spectralProj_mem_span (X := X) hA (idx i)
  · intro i j
    by_cases hij : i = j
    · subst hij
      rw [if_pos rfl]
      exact spectralProj_mul_self hA (hidxmem i)
    · rw [if_neg hij]
      exact spectralProj_mul_of_ne hA (fun h => hij (hidxinj h))
  · have hTsum : (∑ n : Fin D, spectralProj A ((e.symm n : ↥T) : ℂ))
        = ∑ θ ∈ T, spectralProj A θ := by
      rw [← Finset.sum_coe_sort T (fun θ : ℂ => spectralProj A θ)]
      rw [← Equiv.sum_comp e.symm (fun θ : ↥T => spectralProj A ((θ : ℂ)))]
    rw [Fin.sum_univ_succ]
    simp only [hidx0, hidxsucc]
    rw [hTsum, ← sum_spectralProj (X := X) hA, ← Finset.insert_erase hkmem]
    rw [Finset.sum_insert (Finset.notMem_erase k (eigFinset A))]
  · intro i
    exact star_spectralProj hA (hidxmem i)
  · intro i
    exact spectralProj_ne_zero hA (hidxmem i)
  · intro i
    show A * spectralProj A (idx i) = ((θ i : ℂ)) • spectralProj A (idx i)
    rw [← hθ i]
    exact adj_mul_spectralProj hA (hidxmem i)
  · intro i j hij
    apply hidxinj
    rw [hθ i, hθ j, hij]
  · show spectralProj A (idx 0) = (1 / (Fintype.card X : ℂ)) • (allOnes : Matrix X X ℂ)
    rw [hidx0, ← smul_allOnes_eq_spectralProj hG hdr hbi a hDall]
  · have hbij : Function.Bijective
        (fun i : Fin (D + 1) => (⟨idx i, hidxmem i⟩ : ↥(eigFinset A))) := by
      refine (Fintype.bijective_iff_injective_and_card _).mpr ⟨?_, ?_⟩
      · intro i j h
        exact hidxinj (Subtype.ext_iff.mp h)
      · rw [Fintype.card_coe, hcard]
        simp
    have h := spectral_theorem (X := X) hA
    rw [← Finset.sum_coe_sort (eigFinset A) (fun θ : ℂ => θ • spectralProj A θ)] at h
    rw [← Equiv.sum_comp (Equiv.ofBijective _ hbij)
      (fun θ : ↥(eigFinset A) => ((θ : ℂ)) • spectralProj A ((θ : ℂ)))] at h
    simpa only [Equiv.ofBijective_apply, hθ] using h

/-! ### The constraint on `D` implied by such a basis (why `hDex` is needed) -/

/-- The number of distinct eigenvalues of a self-adjoint matrix on `X` is at most `|X|`. -/
theorem card_eigFinset_le_card {A : Matrix X X ℂ} (hA : star A = A) :
    (eigFinset A).card ≤ Fintype.card X := by
  have hAh : A.IsHermitian := Matrix.isHermitian_iff_isSelfAdjoint.mpr hA
  have h1 : eigFinset A = Finset.univ.image (fun i => ((hAh.eigenvalues i : ℝ) : ℂ)) := by
    rw [eigFinset, hAh.roots_charpoly_eq_eigenvalues, Multiset.toFinset_map, Finset.val_toFinset]
    rfl
  rw [h1]
  calc (Finset.univ.image (fun i => ((hAh.eigenvalues i : ℝ) : ℂ))).card ≤ Finset.univ.card :=
        Finset.card_image_le
    _ = Fintype.card X := Finset.card_univ

/-- **The `D` of a spectral idempotent basis is forced.**  If `A` has `D+1` nonzero
orthogonal-type idempotents `E i` (idempotent, nonzero, `A E i = θ i • E i` with `θ`
injective), then `A` has at least `D+1` distinct eigenvalues — hence `D+1 ≤ |X|`.
This is the reason the fixed stub needs `D` to be the true diameter. -/
theorem card_le_eigFinset_of_idempotent_basis {A : Matrix X X ℂ} {D : ℕ}
    {E : Fin (D + 1) → Matrix X X ℂ} {θ : Fin (D + 1) → ℝ}
    (hidem : ∀ i, E i * E i = E i) (hne : ∀ i, E i ≠ 0)
    (heig : ∀ i, A * E i = ((θ i : ℂ)) • E i) (hinj : Function.Injective θ) :
    D + 1 ≤ (eigFinset A).card := by
  have hsub : (Finset.univ.image (fun i : Fin (D + 1) => (θ i : ℂ))) ⊆ eigFinset A := by
    intro z hz
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hz
    refine isEigenvalue_iff_mem_eigFinset'.mp ?_
    have hex : ∃ u w : X, E i u w ≠ 0 := by
      by_contra h
      apply hne i
      ext u w
      by_contra huw
      exact h ⟨u, w, huw⟩
    obtain ⟨u, w, huw⟩ := hex
    refine ⟨E i *ᵥ (Pi.single w (1 : ℂ)), ?_, ?_⟩
    · intro h0
      have h1 : (E i *ᵥ (Pi.single w (1 : ℂ))) u = (0 : X → ℂ) u := by rw [h0]
      rw [Matrix.mulVec, dotProduct, Finset.sum_eq_single w] at h1
      · simp only [Pi.single_eq_same, mul_one, Pi.zero_apply] at h1
        exact huw h1
      · intro b _ hb
        simp [Pi.single_eq_of_ne hb]
      · intro h
        exact absurd (Finset.mem_univ w) h
    · rw [Matrix.mulVec_mulVec, heig i, Matrix.smul_mulVec]
  calc D + 1 = (Finset.univ.image (fun i : Fin (D + 1) => (θ i : ℂ))).card := by
        rw [Finset.card_image_of_injective]
        · simp
        · intro a b h
          exact hinj (Complex.ofReal_injective h)
    _ ≤ (eigFinset A).card := Finset.card_le_card hsub

/-- **The defect of the fixed stub, in the sharpest form.**  If `|X| ≤ D` then there is
no family of `D+1` idempotents as in the conclusion of `drg_idempotent_basis` — so the
stub's hypotheses `1 ≤ D`, `∀ a b, G.dist a b ≤ D` cannot replace `D` = diameter
(`X = Fin 2`, `G = K₂`, `D = 2` satisfies them, and `|X| = 2 ≤ 2`). -/
theorem not_idempotent_basis_of_card_le {A : Matrix X X ℂ} (hA : star A = A) {D : ℕ}
    (h : Fintype.card X ≤ D) :
    ¬ ∃ (E : Fin (D + 1) → Matrix X X ℂ) (θ : Fin (D + 1) → ℝ),
      (∀ i, E i * E i = E i) ∧ (∀ i, E i ≠ 0) ∧
      (∀ i, A * E i = ((θ i : ℂ)) • E i) ∧ Function.Injective θ := by
  rintro ⟨E, θ, hidem, hne, heig, hinj⟩
  have h1 := card_le_eigFinset_of_idempotent_basis (A := A) hidem hne heig hinj
  have h2 := card_eigFinset_le_card hA
  omega

/-- **QA (Lemma 19.1 for a DRG), the stub's shape.**  The primitive idempotents of the
Bose–Mesner algebra of a distance-regular graph of diameter `D`: `D+1` pairwise
orthogonal, self-adjoint, nonzero idempotents summing to the identity, each an
eigenmatrix of `A` with distinct real eigenvalues `θ i`, the `0`-th one being `|X|⁻¹J`. -/
theorem drg_idempotent_basis {G : SimpleGraph X} (hG : G.Connected) (hdr : IsDistanceRegular G)
    (hbi : IntersectionNumbersIndependent G) {D : ℕ} (hD1 : 1 ≤ D)
    (hDall : ∀ a b : X, G.dist a b ≤ D) (hDex : ∃ a b : X, G.dist a b = D) :
    ∃ (E : Fin (D + 1) → Matrix X X ℂ) (θ : Fin (D + 1) → ℝ),
      (∀ i j, E i * E j = if i = j then E i else 0) ∧
      (∑ i, E i = 1) ∧
      (∀ i, star (E i) = E i) ∧
      (∀ i, E i ≠ 0) ∧
      (∀ i, adj (𝕜 := ℂ) G * E i = ((θ i : ℂ)) • E i) ∧
      Function.Injective θ ∧
      E 0 = (1 / (Fintype.card X : ℂ)) • (allOnes : Matrix X X ℂ) := by
  obtain ⟨E, θ, -, h1, h2, h3, h4, h5, h6, h7, h8⟩ :=
    drg_idempotent_basis_strong hG hdr hbi hD1 hDall hDex
  exact ⟨E, θ, h1, h2, h3, h4, h5, h6, h7⟩


end QAPrimitiveIdempotents

namespace DRGData

variable {X : Type*} [Fintype X] [DecidableEq X]
variable {G : SimpleGraph X} {x : X} {D : ℕ}

/-- **Lemma 34.2, the first structural fact.**  Every vector of `(E*₁V)_new` is fixed
by `E*₁(x)`. -/
theorem qe_subconst_one_mulVec_of_mem_newSubconst (Y : DRGData G x D) {v : X → ℂ}
    (hv : v ∈ Y.newSubconst 1) :
    subconst (𝕜 := ℂ) G x 1 *ᵥ v = v := by
  induction hv using Submodule.span_induction with
  | mem u hu =>
    obtain ⟨W, -, -, huW⟩ := hu
    obtain ⟨w, -, rfl⟩ := mem_matImage.1 huW
    rw [Matrix.mulVec_mulVec, subconst_mul_self]
  | zero => rw [Matrix.mulVec_zero]
  | add u u' _ _ hu hu' => rw [Matrix.mulVec_add, hu, hu']
  | smul c u _ hu => rw [Matrix.mulVec_smul, hu]

/-- **Lemma 34.2, the second structural fact.**  `E*₀(x)` kills `(E*₁V)_new`. -/
theorem qe_subconst_zero_mulVec_of_mem_newSubconst (Y : DRGData G x D) {v : X → ℂ}
    (hv : v ∈ Y.newSubconst 1) :
    subconst (𝕜 := ℂ) G x 0 *ᵥ v = 0 := by
  induction hv using Submodule.span_induction with
  | mem u hu =>
    obtain ⟨W, -, -, huW⟩ := hu
    obtain ⟨w, -, rfl⟩ := mem_matImage.1 huW
    rw [Matrix.mulVec_mulVec, subconst_mul_subconst]
    simp
  | zero => rw [Matrix.mulVec_zero]
  | add u u' _ _ hu hu' => rw [Matrix.mulVec_add, hu, hu', add_zero]
  | smul c u _ hu => rw [Matrix.mulVec_smul, hu, smul_zero]

/-- **The `E*₁`-component argument.**  If a `T(x)`-stable subspace `S` contains a vector
`v` fixed by `E*₁(x)` and `dim E*₁(x)S ≤ 1`, then some irreducible `T(x)`-submodule
`W ≤ S` (in fact an irreducible summand of `S`) already contains `v`.  (Lecture 34: the
orthogonal decomposition of `Tv` has at most one summand meeting `E*₁`.) -/
theorem qe_exists_irreducible_mem_of_finrank_le_one {S : Submodule ℂ (X → ℂ)}
    (hstab : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra S)
    {v : X → ℂ} (hvS : v ∈ S) (hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v) (hvne : v ≠ 0)
    (hfr : Module.finrank ℂ (subconstImage (𝕜 := ℂ) G x 1 S) ≤ 1) :
    ∃ W : Submodule ℂ (X → ℂ), W ≤ S ∧ v ∈ W ∧
      IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W ∧
      IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W := by
  classical
  obtain ⟨ι, inst, U, hUstab, hUirr, hUorth, hSsup, hexp⟩ :=
    exists_orthogonal_irreducible_decomposition_full
      (fun a ha => StarMemClass.star_mem (s := subconstituentAlgebra (𝕜 := ℂ) G x) ha) S hstab
  letI : Fintype ι := inst
  have hE1mem : subconst (𝕜 := ℂ) G x 1 ∈
      (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra :=
    subconst_mem_subconstituentAlgebra G x 1
  obtain ⟨w, hwU, hwv⟩ := hexp v hvS
  -- `E*₁` applied to each summand vector stays in the subconstituent image of `S`
  have hmem : ∀ i, subconst (𝕜 := ℂ) G x 1 *ᵥ w i ∈ subconstImage (𝕜 := ℂ) G x 1 S := by
    intro i
    refine mem_matImage.2 ⟨w i, ?_, rfl⟩
    rw [hSsup]
    exact Submodule.mem_iSup_of_mem i (hwU i)
  -- and the family `E*₁ w i` is pairwise orthogonal
  have horth : ∀ i j, i ≠ j →
      star (subconst (𝕜 := ℂ) G x 1 *ᵥ w i) ⬝ᵥ (subconst (𝕜 := ℂ) G x 1 *ᵥ w j) = 0 := by
    intro i j hij
    rw [selfAdj_star_dotProduct (star_subconst G x 1) (w i)
      (subconst (𝕜 := ℂ) G x 1 *ᵥ w j), Matrix.mulVec_mulVec, subconst_mul_self]
    exact hUorth i j hij (w i) (hwU i) (subconst (𝕜 := ℂ) G x 1 *ᵥ w j)
      (hUstab j (subconst (𝕜 := ℂ) G x 1) hE1mem (w j) (hwU j))
  have hex : ∃ i, subconst (𝕜 := ℂ) G x 1 *ᵥ w i ≠ 0 := by
    by_contra h
    push Not at h
    refine hvne ?_
    rw [← hv1, hwv, Matrix.mulVec_sum]
    exact Finset.sum_eq_zero (fun i _ => h i)
  obtain ⟨i₀, hi₀⟩ := hex
  -- every other member vanishes: it is a multiple of `E*₁ w i₀` and orthogonal to it
  have hother : ∀ j, j ≠ i₀ → subconst (𝕜 := ℂ) G x 1 *ᵥ w j = 0 := by
    intro j hj
    obtain ⟨c, hc⟩ := exists_smul_of_finrank_le_one_complex hfr (hmem i₀) (hmem j) hi₀
    have h1 : star (subconst (𝕜 := ℂ) G x 1 *ᵥ w j)
        ⬝ᵥ (subconst (𝕜 := ℂ) G x 1 *ᵥ w i₀) = 0 := horth j i₀ hj
    rw [hc] at h1
    have h1' : (star c) * (star (subconst (𝕜 := ℂ) G x 1 *ᵥ w i₀)
        ⬝ᵥ (subconst (𝕜 := ℂ) G x 1 *ᵥ w i₀)) = 0 := by
      have h2 : star (c • (subconst (𝕜 := ℂ) G x 1 *ᵥ w i₀))
          ⬝ᵥ (subconst (𝕜 := ℂ) G x 1 *ᵥ w i₀)
          = (star c) * (star (subconst (𝕜 := ℂ) G x 1 *ᵥ w i₀)
            ⬝ᵥ (subconst (𝕜 := ℂ) G x 1 *ᵥ w i₀)) := by
        rw [dotProduct, dotProduct, Finset.mul_sum]
        refine Finset.sum_congr rfl fun z _ => ?_
        simp only [Pi.star_apply, Pi.smul_apply, smul_eq_mul]
        rw [star_mul]
        ring
      rw [← h2]
      exact h1
    have hpos : star (subconst (𝕜 := ℂ) G x 1 *ᵥ w i₀)
        ⬝ᵥ (subconst (𝕜 := ℂ) G x 1 *ᵥ w i₀) ≠ 0 :=
      fun hz => hi₀ (star_dotProduct_self_eq_zero hz)
    have h2 : star c = 0 := by
      rcases mul_eq_zero.1 h1' with h3 | h3
      · exact h3
      · exact absurd h3 hpos
    have h2' : c = 0 := by rw [← star_star c, h2, star_zero]
    rw [hc, h2', zero_smul]
  refine ⟨U i₀, ?_, ?_, hUstab i₀, hUirr i₀⟩
  · rw [hSsup]; exact le_iSup U i₀
  · rw [← hv1, hwv, Matrix.mulVec_sum,
      Finset.sum_eq_single i₀ (fun j _ hj => hother j hj) (by simp)]
    exact hUstab i₀ (subconst (𝕜 := ℂ) G x 1) hE1mem (w i₀) (hwU i₀)

end DRGData

namespace DRGData

variable {X : Type*} [Fintype X] [DecidableEq X]
variable {G : SimpleGraph X} {x : X} {D : ℕ}


/-- Pointwise form of `E*_i *ᵥ u` (complex case). -/
theorem qe_subconst_mulVec_apply (i : ℕ) (u : X → ℂ) (z : X) :
    (subconst (𝕜 := ℂ) G x i *ᵥ u) z = (if G.dist x z = i then (1 : ℂ) else 0) * u z := by
  rw [subconst, Matrix.mulVec, dotProduct, Finset.sum_eq_single z]
  · rw [diagonal_apply_eq]
  · intro b _ hb
    rw [diagonal_apply_ne _ (Ne.symm hb), zero_mul]
  · intro h
    exact absurd (Finset.mem_univ z) h

/-- Pointwise form of `A_m *ᵥ u`. -/
theorem qe_distMatrix_mulVec_apply (m : ℕ) (u : X → ℂ) (z : X) :
    (distMatrix (𝕜 := ℂ) G m *ᵥ u) z
      = ∑ w, (if G.dist z w = m then (1 : ℂ) else 0) * u w := by
  rw [Matrix.mulVec, dotProduct]
  exact Finset.sum_congr rfl fun w _ => by rw [distMatrix_apply]

/-- Pointwise form of the cumulative distance matrix `Ã_h = A_0 + ⋯ + A_h`. -/
theorem qe_sum_distMatrix_mulVec_apply (h : ℕ) (u : X → ℂ) (z : X) :
    ((∑ j ∈ Finset.range (h + 1), distMatrix (𝕜 := ℂ) G j) *ᵥ u) z
      = ∑ w, (if G.dist z w ≤ h then (1 : ℂ) else 0) * u w := by
  rw [Matrix.sum_mulVec, Finset.sum_apply]
  have hterm : ∀ j ∈ Finset.range (h + 1),
      ((distMatrix (𝕜 := ℂ) G j) *ᵥ u) z
        = ∑ w, (if G.dist z w = j then (1 : ℂ) else 0) * u w :=
    fun j _ => qe_distMatrix_mulVec_apply j u z
  rw [Finset.sum_congr rfl hterm, Finset.sum_comm]
  refine Finset.sum_congr rfl fun w _ => ?_
  rw [← Finset.sum_mul]
  congr 1
  by_cases hzw : G.dist z w ≤ h
  · rw [if_pos hzw, Finset.sum_eq_single (G.dist z w)]
    · simp
    · intro b _ hb
      simp [Ne.symm hb]
    · intro hmem
      exact absurd (Finset.mem_range.mpr (Nat.lt_succ_of_le hzw)) hmem
  · rw [if_neg hzw, Finset.sum_eq_zero]
    intro j hj
    rw [Finset.mem_range] at hj
    have hne : G.dist z w ≠ j := fun he => hzw (he ▸ Nat.lt_succ_iff.mp hj)
    simp [hne]

/-- A vector fixed by `E*₁(x)` is supported on the first sphere. -/
theorem qe_support_of_fixed_by_e1star {v : X → ℂ}
    (hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v) {u : X} (hu : G.dist x u ≠ 1) : v u = 0 := by
  have h := congrFun hv1 u
  rw [qe_subconst_mulVec_apply, if_neg hu] at h
  simpa using h.symm

/-- Sums against a vector supported on the first sphere may be restricted to it. -/
theorem qe_sum_ite_sphere {v : X → ℂ}
    (hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v) (F : X → ℂ) :
    ∑ u, (if G.dist x u = 1 then F u else 0) * v u = ∑ u, F u * v u := by
  refine Finset.sum_congr rfl fun u _ => ?_
  by_cases hu : G.dist x u = 1
  · rw [if_pos hu]
  · rw [if_neg hu, zero_mul, qe_support_of_fixed_by_e1star hv1 hu, mul_zero]


/-- The arithmetic core of Lemma 34.2 (i): for integers with `|m - d| ≤ 1`,
`[m ≤ h] = [d = h+1][m = h] - [d = h][m = h+1] + [d ≤ h]`. -/
theorem qe_key_nat (d m h : ℕ) (hb1 : m ≤ d + 1) (hb2 : d ≤ m + 1) :
    (if m ≤ h then (1 : ℂ) else 0)
      = (if d = h + 1 then (if m = h then (1 : ℂ) else 0) else 0)
        - (if d = h then (if m = h + 1 then (1 : ℂ) else 0) else 0)
        + (if d ≤ h then (1 : ℂ) else 0) := by
  split_ifs with h1 h2 h3 h4 h5 <;> norm_num <;> omega

/-- **Lemma 34.2 (i)** (`mvplusmstarvstar` (i)).  For a vector fixed by `E*₁(x)` and
orthogonal to the all-ones vector,
`Ã_h v = E*_{h+1}A_h v - E*_h A_{h+1} v`.  (Lecture 34 writes
`Ã_h = A_0 + ⋯ + A_h`; no diameter hypothesis is needed.) -/
theorem qe_tildeAcum_mulVec_eq (hG : G.Connected) {v : X → ℂ}
    (hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v) (horth : ∑ z, v z = 0) (h : ℕ) :
    (∑ j ∈ Finset.range (h + 1), distMatrix (𝕜 := ℂ) G j) *ᵥ v
      = subconst (𝕜 := ℂ) G x (h + 1) *ᵥ (distMatrix (𝕜 := ℂ) G h *ᵥ v)
        - subconst (𝕜 := ℂ) G x h *ᵥ (distMatrix (𝕜 := ℂ) G (h + 1) *ᵥ v) := by
  ext z
  rw [Pi.sub_apply, qe_sum_distMatrix_mulVec_apply, qe_subconst_mulVec_apply,
    qe_subconst_mulVec_apply, qe_distMatrix_mulVec_apply, qe_distMatrix_mulVec_apply]
  -- the pointwise identity, valid on the first sphere
  have hkey : ∀ u : X, G.dist x u = 1 →
      (if G.dist z u ≤ h then (1 : ℂ) else 0)
        = (if G.dist x z = h + 1 then (if G.dist z u = h then (1 : ℂ) else 0) else 0)
          - (if G.dist x z = h then (if G.dist z u = h + 1 then (1 : ℂ) else 0) else 0)
          + (if G.dist x z ≤ h then (1 : ℂ) else 0) := by
    intro u hu
    have hb1 : G.dist z u ≤ G.dist x z + 1 := by
      have h := hG.dist_triangle (u := z) (v := x) (w := u)
      rw [SimpleGraph.dist_comm (u := z) (v := x), hu] at h
      omega
    have hb2 : G.dist x z ≤ G.dist z u + 1 := by
      have h := hG.dist_triangle (u := x) (v := u) (w := z)
      rw [hu, SimpleGraph.dist_comm (u := u) (v := z)] at h
      omega
    exact qe_key_nat (G.dist x z) (G.dist z u) h hb1 hb2
  have hstep : (∑ u, (if G.dist z u ≤ h then (1 : ℂ) else 0) * v u)
      = (∑ u, (if G.dist x z = h + 1 then (if G.dist z u = h then (1 : ℂ) else 0) else 0)
            * v u)
        - (∑ u, (if G.dist x z = h then (if G.dist z u = h + 1 then (1 : ℂ) else 0) else 0)
            * v u)
        + (if G.dist x z ≤ h then (1 : ℂ) else 0) * (∑ u, v u) := by
    rw [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun u _ => ?_
    by_cases hu : G.dist x u = 1
    · rw [hkey u hu]; ring
    · rw [qe_support_of_fixed_by_e1star hv1 hu]; ring
  have hA : (∑ u, (if G.dist x z = h + 1 then (if G.dist z u = h then (1 : ℂ) else 0) else 0)
        * v u)
      = (if G.dist x z = h + 1 then ∑ w, (if G.dist z w = h then (1 : ℂ) else 0) * v w
        else 0) := by
    by_cases hc : G.dist x z = h + 1
    · simp only [if_pos hc]
    · rw [if_neg hc]
      exact Finset.sum_eq_zero (fun u _ => by rw [if_neg hc, zero_mul])
  have hB : (∑ u, (if G.dist x z = h then (if G.dist z u = h + 1 then (1 : ℂ) else 0) else 0)
        * v u)
      = (if G.dist x z = h then ∑ w, (if G.dist z w = h + 1 then (1 : ℂ) else 0) * v w
        else 0) := by
    by_cases hc : G.dist x z = h
    · simp only [if_pos hc]
    · rw [if_neg hc]
      exact Finset.sum_eq_zero (fun u _ => by rw [if_neg hc, zero_mul])
  rw [hstep, horth, mul_zero, add_zero, hA, hB]
  simp

end DRGData

namespace DRGData

variable {X : Type*} [Fintype X] [DecidableEq X]
variable {G : SimpleGraph X} {x : X} {D : ℕ}

/-- The module generated by a vector is `T(x)`-stable. -/
theorem qe_isStable_cyclicModule (v : X → ℂ) :
    IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra (cyclicModule G x v) := by
  intro a ha w hw
  induction hw using Submodule.span_induction with
  | mem u hu =>
    obtain ⟨b, hb, rfl⟩ := hu
    rw [Matrix.mulVec_mulVec]
    exact Submodule.subset_span ⟨a * b, mul_mem ha hb, rfl⟩
  | zero => rw [Matrix.mulVec_zero]; exact Submodule.zero_mem _
  | add u u' _ _ hu hu' => rw [Matrix.mulVec_add]; exact Submodule.add_mem _ hu hu'
  | smul c u _ hu => rw [Matrix.mulVec_smul]; exact Submodule.smul_mem _ _ hu

/-- The generator `v` lies in its cyclic module. -/
theorem qe_mem_cyclicModule (v : X → ℂ) : v ∈ cyclicModule G x v := by
  refine Submodule.subset_span ⟨1, Subalgebra.one_mem _, ?_⟩
  show (1 : Matrix X X ℂ) *ᵥ v = v
  rw [Matrix.one_mulVec]

/-- `v⁺ᵢ = E*ᵢ A_{i-1} v` (Lemma 34.2 (ii)). -/
def qe_vplus (v : X → ℂ) (i : ℕ) : X → ℂ :=
  subconst (𝕜 := ℂ) G x i *ᵥ (distMatrix (𝕜 := ℂ) G (i - 1) *ᵥ v)

/-- `v⁻ᵢ = E*ᵢ A_{i+1} v` (Lemma 34.2 (ii)). -/
def qe_vminus (v : X → ℂ) (i : ℕ) : X → ℂ :=
  subconst (𝕜 := ℂ) G x i *ᵥ (distMatrix (𝕜 := ℂ) G (i + 1) *ᵥ v)

/-- The spanning subspace of Lemma 34.2 (ii):
`Span{v⁺₁, …, v⁺_D, v⁻₂, …, v⁻_{D-1}}` (indexed by all of `ℕ`; the vectors outside
the range are zero or harmless at the levels that matter). -/
def qe_span (v : X → ℂ) : Submodule ℂ (X → ℂ) :=
  Submodule.span ℂ {w : X → ℂ |
    (∃ i : ℕ, w = qe_vplus (G := G) (x := x) v i) ∨
      (∃ i : ℕ, 2 ≤ i ∧ w = qe_vminus (G := G) (x := x) v i)}

/-- `v⁺₁ = E*₁ A₀ v = v` for a vector fixed by `E*₁`. -/
theorem qe_vplus_one (hG : G.Connected) {v : X → ℂ}
    (hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v) :
    qe_vplus (G := G) (x := x) v 1 = v := by
  rw [qe_vplus, show (1 : ℕ) - 1 = 0 from rfl, distMatrix_zero G hG, Matrix.one_mulVec, hv1]

/-- `v ∈ Span{v⁺₁, …}`. -/
theorem qe_mem_qe_span (hG : G.Connected) {v : X → ℂ}
    (hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v) :
    v ∈ qe_span (G := G) (x := x) v := by
  refine Submodule.subset_span (Or.inl ⟨1, ?_⟩)
  exact (qe_vplus_one hG hv1).symm

/-- `E*_j` fixes `v⁺_i` when `j = i` and kills it otherwise. -/
theorem qe_subconst_mulVec_vplus (v : X → ℂ) (j i : ℕ) :
    subconst (𝕜 := ℂ) G x j *ᵥ (qe_vplus (G := G) (x := x) v i)
      = if j = i then qe_vplus (G := G) (x := x) v i else 0 := by
  rw [qe_vplus, Matrix.mulVec_mulVec, subconst_mul_subconst]
  by_cases h : j = i
  · subst h
    rw [if_pos rfl, if_pos rfl]
  · rw [if_neg h, if_neg h, Matrix.zero_mulVec]

/-- `E*_j` fixes `v⁻_i` when `j = i` and kills it otherwise. -/
theorem qe_subconst_mulVec_vminus (v : X → ℂ) (j i : ℕ) :
    subconst (𝕜 := ℂ) G x j *ᵥ (qe_vminus (G := G) (x := x) v i)
      = if j = i then qe_vminus (G := G) (x := x) v i else 0 := by
  rw [qe_vminus, Matrix.mulVec_mulVec, subconst_mul_subconst]
  by_cases h : j = i
  · subst h
    rw [if_pos rfl, if_pos rfl]
  · rw [if_neg h, if_neg h, Matrix.zero_mulVec]

/-- A subconstituent image of a span is contained in a subspace as soon as the images
of the generators are. -/
theorem qe_subconstImage_span_le {j : ℕ} {s : Set (X → ℂ)} {S : Submodule ℂ (X → ℂ)}
    (h : ∀ w ∈ s, subconst (𝕜 := ℂ) G x j *ᵥ w ∈ S) :
    subconstImage (𝕜 := ℂ) G x j (Submodule.span ℂ s) ≤ S := by
  rw [subconstImage, matImage, Submodule.map_span]
  exact Submodule.span_le.mpr (Set.image_subset_iff.mpr h)

/-- `dim E*₁(Span{v⁺, v⁻}) ≤ 1`. -/
theorem qe_subconstImage_one_qe_span_le (hG : G.Connected) {v : X → ℂ}
    (hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v) :
    subconstImage (𝕜 := ℂ) G x 1 (qe_span (G := G) (x := x) v)
      ≤ Submodule.span ℂ ({v} : Set (X → ℂ)) := by
  refine qe_subconstImage_span_le ?_
  rintro w (⟨i, rfl⟩ | ⟨i, hi, rfl⟩)
  · by_cases h : (1 : ℕ) = i
    · subst h
      rw [qe_subconst_mulVec_vplus, if_pos rfl, qe_vplus_one hG hv1]
      exact Submodule.subset_span rfl
    · rw [qe_subconst_mulVec_vplus, if_neg h]
      exact Submodule.zero_mem _
  · have h : ¬ ((1 : ℕ) = i) := by omega
    rw [qe_subconst_mulVec_vminus, if_neg h]
    exact Submodule.zero_mem _

/-- `dim E*_j(Span{v⁺, v⁻}) ≤ 2` for `j ≥ 2`. -/
theorem qe_subconstImage_qe_span_le {v : X → ℂ} {j : ℕ} (hj : 2 ≤ j) :
    subconstImage (𝕜 := ℂ) G x j (qe_span (G := G) (x := x) v)
      ≤ Submodule.span ℂ ({qe_vplus (G := G) (x := x) v j,
          qe_vminus (G := G) (x := x) v j} : Set (X → ℂ)) := by
  refine qe_subconstImage_span_le ?_
  rintro w (⟨i, rfl⟩ | ⟨i, hi, rfl⟩)
  · by_cases h : j = i
    · subst h
      rw [qe_subconst_mulVec_vplus, if_pos rfl]
      exact Submodule.subset_span (Set.mem_insert _ _)
    · rw [qe_subconst_mulVec_vplus, if_neg h]
      exact Submodule.zero_mem _
  · by_cases h : j = i
    · subst h
      rw [qe_subconst_mulVec_vminus, if_pos rfl]
      exact Submodule.subset_span (Set.mem_insert_of_mem _ rfl)
    · rw [qe_subconst_mulVec_vminus, if_neg h]
      exact Submodule.zero_mem _

/-- A span of two vectors has dimension at most two. -/
theorem qe_finrank_span_pair_le_two (a b : X → ℂ) :
    Module.finrank ℂ ↥(Submodule.span ℂ ({a, b} : Set (X → ℂ))) ≤ 2 := by
  set L : (Fin 2 → ℂ) →ₗ[ℂ] (X → ℂ) :=
    { toFun := fun c => c 0 • a + c 1 • b
      map_add' := by
        intro u w
        simp only [Pi.add_apply, add_smul]
        abel
      map_smul' := by
        intro r u
        simp only [Pi.smul_apply, smul_add, smul_smul, smul_eq_mul, RingHom.id_apply] }
      with hL
  have hspan : Submodule.span ℂ ({a, b} : Set (X → ℂ)) ≤ LinearMap.range L := by
    rw [Submodule.span_le]
    intro w hw
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
    rcases hw with rfl | rfl
    · exact ⟨fun i => if i = (0 : Fin 2) then 1 else 0, by
        simp only [hL, LinearMap.coe_mk, AddHom.coe_mk]
        norm_num⟩
    · exact ⟨fun i => if i = (1 : Fin 2) then 1 else 0, by
        simp only [hL, LinearMap.coe_mk, AddHom.coe_mk]
        norm_num⟩
  calc Module.finrank ℂ ↥(Submodule.span ℂ ({a, b} : Set (X → ℂ)))
      ≤ Module.finrank ℂ ↥(LinearMap.range L) := Submodule.finrank_mono hspan
    _ ≤ Module.finrank ℂ (Fin 2 → ℂ) := LinearMap.finrank_range_le L
    _ = 2 := by simp

/-- A span of one vector has dimension at most one. -/
theorem qe_finrank_span_singleton_le_one (a : X → ℂ) :
    Module.finrank ℂ ↥(Submodule.span ℂ ({a} : Set (X → ℂ))) ≤ 1 := by
  rcases eq_or_ne a 0 with rfl | ha
  · rw [Submodule.span_singleton_eq_bot.mpr rfl, finrank_bot]
    omega
  · rw [finrank_span_singleton (K := ℂ) (V := X → ℂ) ha]

/-- **Lemma 34.2, the reduction step.**  If the cyclic module of `v` is contained in
`Span{v⁺ᵢ, v⁻ᵢ}` (this is Lemma 34.2 (i)+(ii), i.e. `Tv = Mv + M*v*`), then `v` lies in
an irreducible module with `dim E*₁ = 1` and `dim E*ᵢ ≤ 2` for `2 ≤ i ≤ D - 1`: exactly
the conclusion of `module_of_endpoint_one`. -/
theorem qe_module_of_endpoint_one_of_cyclic_le (Y : DRGData G x D) {v : X → ℂ}
    (hvne : v ≠ 0) (hvnew : v ∈ Y.newSubconst 1)
    (hTv : cyclicModule G x v ≤ qe_span (G := G) (x := x) v) :
    ∃ W : Submodule ℂ (X → ℂ),
      IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W ∧ v ∈ W ∧
      Module.finrank ℂ (subconstImage (𝕜 := ℂ) G x 1 W) = 1 ∧
      ∀ i : ℕ, 2 ≤ i → i ≤ D - 1 →
        Module.finrank ℂ (subconstImage (𝕜 := ℂ) G x i W) ≤ 2 := by
  have hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v := qe_subconst_one_mulVec_of_mem_newSubconst Y hvnew
  have hstabT : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra
      (cyclicModule G x v) := qe_isStable_cyclicModule v
  have hfr1 : Module.finrank ℂ (subconstImage (𝕜 := ℂ) G x 1 (cyclicModule G x v)) ≤ 1 :=
    le_trans (Submodule.finrank_mono (Submodule.map_mono hTv))
      (le_trans (Submodule.finrank_mono (qe_subconstImage_one_qe_span_le (G := G) (x := x) Y.connected hv1))
        (qe_finrank_span_singleton_le_one v))
  obtain ⟨W, hWT, hvW, hWstab, hWirr⟩ :=
    qe_exists_irreducible_mem_of_finrank_le_one hstabT (qe_mem_cyclicModule (G := G) (x := x) v) hv1 hvne hfr1
  have hle1 : Module.finrank ℂ (subconstImage (𝕜 := ℂ) G x 1 W) ≤ 1 :=
    le_trans (Submodule.finrank_mono (Submodule.map_mono (hWT.trans hTv)))
      (le_trans (Submodule.finrank_mono (qe_subconstImage_one_qe_span_le (G := G) (x := x) Y.connected hv1))
        (qe_finrank_span_singleton_le_one v))
  have hvmem : v ∈ subconstImage (𝕜 := ℂ) G x 1 W := mem_matImage.2 ⟨v, hvW, hv1⟩
  have hpos : 1 ≤ Module.finrank ℂ ↥(subconstImage (𝕜 := ℂ) G x 1 W) := by
    have hle : Submodule.span ℂ ({v} : Set (X → ℂ)) ≤ subconstImage (𝕜 := ℂ) G x 1 W := by
      rw [Submodule.span_le]
      simpa using hvmem
    calc 1 = Module.finrank ℂ ↥(Submodule.span ℂ ({v} : Set (X → ℂ))) :=
          (finrank_span_singleton (K := ℂ) (V := X → ℂ) hvne).symm
      _ ≤ Module.finrank ℂ ↥(subconstImage (𝕜 := ℂ) G x 1 W) := Submodule.finrank_mono hle
  refine ⟨W, hWirr, hvW, by omega, ?_⟩
  intro i hi2 hiD
  exact le_trans (Submodule.finrank_mono (Submodule.map_mono (hWT.trans hTv)))
    (le_trans (Submodule.finrank_mono (qe_subconstImage_qe_span_le (G := G) (x := x) hi2))
      (qe_finrank_span_pair_le_two _ _))

/-- The cyclic module is contained in any stable subspace containing `v`. -/
theorem qe_cyclicModule_le_of_isStable {v : X → ℂ} {S : Submodule ℂ (X → ℂ)}
    (hstab : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra S) (hvS : v ∈ S) :
    cyclicModule G x v ≤ S := by
  rw [cyclicModule, Submodule.span_le]
  rintro w ⟨a, ha, rfl⟩
  exact hstab a ha v hvS

/-- **Lemma 34.2, the reduction step (stability form).**  If the spanning subspace
`Span{v⁺ᵢ, v⁻ᵢ}` is `T(x)`-stable — this is exactly what lecture 34's Lemma 34.2 (i)+(v)
(`Tv = Mv + M*v*`, from Lemma 33.2) gives — then `v` lies in an irreducible module with
`dim E*₁ = 1` and `dim E*ᵢ ≤ 2` for `2 ≤ i ≤ D - 1`, i.e. the conclusion of
`module_of_endpoint_one`. -/
theorem qe_module_of_endpoint_one_of_stable (Y : DRGData G x D) {v : X → ℂ}
    (hvne : v ≠ 0) (hvnew : v ∈ Y.newSubconst 1)
    (hstab : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra
      (qe_span (G := G) (x := x) v)) :
    ∃ W : Submodule ℂ (X → ℂ),
      IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W ∧ v ∈ W ∧
      Module.finrank ℂ (subconstImage (𝕜 := ℂ) G x 1 W) = 1 ∧
      ∀ i : ℕ, 2 ≤ i → i ≤ D - 1 →
        Module.finrank ℂ (subconstImage (𝕜 := ℂ) G x i W) ≤ 2 := by
  have hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v := qe_subconst_one_mulVec_of_mem_newSubconst Y hvnew
  refine Y.qe_module_of_endpoint_one_of_cyclic_le hvne hvnew ?_
  exact qe_cyclicModule_le_of_isStable hstab (qe_mem_qe_span Y.connected hv1)


end DRGData

namespace DRGData

variable {X : Type*} [Fintype X] [DecidableEq X]
variable {G : SimpleGraph X} {x : X} {D : ℕ}

/-- `J v = 0` for a vector whose coordinates sum to zero. -/
theorem qe_allOnes_mulVec_eq_zero {v : X → ℂ} (horth : ∑ z, v z = 0) :
    allOnes (𝕜 := ℂ) *ᵥ v = 0 := by
  funext z
  rw [Matrix.mulVec, dotProduct]
  simp only [allOnes_apply, one_mul]
  exact horth

/-- `J̃ v = E*₁ J E*₁ v = 0` for `E*₁v = v` and `∑_z v z = 0`. -/
theorem qe_tildeJ_mulVec_eq_zero (Y : DRGData G x D) {v : X → ℂ}
    (hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v) (horth : ∑ z, v z = 0) :
    Y.tildeJ *ᵥ v = 0 := by
  rw [DRGData.tildeJ, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hv1,
    qe_allOnes_mulVec_eq_zero horth, Matrix.mulVec_zero]

end DRGData

namespace DRGData

variable {X : Type*} [Fintype X] [DecidableEq X]
variable {G : SimpleGraph X} {x : X} {D : ℕ}

/-- Every distance is at most `2D`, so the distance matrices up to `2D` sum to `J`. -/
theorem qe_sum_distMatrix_two_mul (Y : DRGData G x D) :
    (∑ i ∈ Finset.range (2 * D + 1), distMatrix (𝕜 := ℂ) G i) = allOnes (𝕜 := ℂ) := by
  refine sum_distMatrix G (2 * D) ?_
  intro a b
  have h := Y.connected.dist_triangle (u := a) (v := x) (w := b)
  rw [SimpleGraph.dist_comm (u := a) (v := x)] at h
  have ha := Y.diam a
  have hb := Y.diam b
  omega

/-- **Lemma 34.2, the `v⁻₁` relation.**  For `E*₁v = v`, `∑_z v z = 0` and
`Ãv = av`, one has `v⁻₁ = E*₁A₂v = -(1+a)v`, i.e. `v⁻₁ ∈ Span{v⁺₁}`.  (Lecture 34:
`0 = J̃v = v + av + v⁻₁`.) -/
theorem qe_vminus_one_eq (Y : DRGData G x D) {v : X → ℂ}
    (hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v) (horth : ∑ z, v z = 0) (a : ℂ)
    (hva : Y.tildeA *ᵥ v = a • v) :
    qe_vminus (G := G) (x := x) v 1 = -(1 + a) • v := by
  have hG : G.Connected := Y.connected
  have hJ : Y.tildeJ *ᵥ v = 0 := qe_tildeJ_mulVec_eq_zero Y hv1 horth
  have hexp : Y.tildeJ *ᵥ v = v + a • v + qe_vminus (G := G) (x := x) v 1 := by
    rw [DRGData.tildeJ, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hv1,
      ← qe_sum_distMatrix_two_mul Y, Matrix.sum_mulVec, Matrix.mulVec_sum]
    -- the terms with `i ≥ 3` vanish; reduce to `range 3`
    have hzero : ∀ i ∈ Finset.range (2 * D + 1), i ∉ Finset.range 3 →
        subconst (𝕜 := ℂ) G x 1 *ᵥ (distMatrix (𝕜 := ℂ) G i *ᵥ v) = 0 := by
      intro i hi hi3
      rw [Finset.mem_range] at hi hi3
      have h3 : 3 ≤ i := by omega
      rw [← hv1, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
        subconst_one_mul_distMatrix_mul_subconst_one_eq_zero hG h3, Matrix.zero_mulVec]
    have h3D : 3 ≤ 2 * D + 1 := by have := Y.hD; omega
    rw [← Finset.sum_subset (Finset.range_subset_range.mpr h3D) hzero]
    rw [Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_one]
    have h0 : subconst (𝕜 := ℂ) G x 1 *ᵥ (distMatrix (𝕜 := ℂ) G 0 *ᵥ v) = v := by
      rw [distMatrix_zero G hG, Matrix.one_mulVec, hv1]
    have h1 : subconst (𝕜 := ℂ) G x 1 *ᵥ (distMatrix (𝕜 := ℂ) G 1 *ᵥ v) = a • v := by
      have hA : subconst (𝕜 := ℂ) G x 1 *ᵥ (adj (𝕜 := ℂ) G *ᵥ v)
          = (subconst (𝕜 := ℂ) G x 1 * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x 1) *ᵥ v := by
        rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hv1]
      rw [distMatrix_one, hA]
      exact hva
    have h2 : subconst (𝕜 := ℂ) G x 1 *ᵥ (distMatrix (𝕜 := ℂ) G 2 *ᵥ v)
        = qe_vminus (G := G) (x := x) v 1 := rfl
    rw [h0, h1, h2]
  have hzero : v + a • v + qe_vminus (G := G) (x := x) v 1 = 0 := by
    rw [← hexp]; exact hJ
  have hq : qe_vminus (G := G) (x := x) v 1 = -(v + a • v) := by
    rw [eq_neg_iff_add_eq_zero, add_comm]
    exact hzero
  have h1a : (1 + a) • v = v + a • v := by rw [add_smul, one_smul]
  rw [hq, neg_smul, h1a]

end DRGData

namespace DRGData

variable {X : Type*} [Fintype X] [DecidableEq X]
variable {G : SimpleGraph X} {x : X} {D : ℕ}

/-- `v⁻₀ = E*₀A₁v = 0`: this is Lemma 34.2 (i) at `h = 0`. -/
theorem qe_vminus_zero_eq (hG : G.Connected) {v : X → ℂ}
    (hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v) (horth : ∑ z, v z = 0) :
    qe_vminus (G := G) (x := x) v 0 = 0 := by
  have h := qe_tildeAcum_mulVec_eq (G := G) (x := x) hG hv1 horth 0
  simp only [show (0 : ℕ) + 1 = 1 from rfl, Finset.range_one, Finset.sum_singleton] at h
  rw [distMatrix_zero G hG, Matrix.one_mulVec] at h
  rw [hv1] at h
  have hq : qe_vminus (G := G) (x := x) v 0
      = subconst (𝕜 := ℂ) G x 0 *ᵥ (distMatrix (𝕜 := ℂ) G 1 *ᵥ v) := rfl
  rw [hq]
  have h0 : v - subconst (𝕜 := ℂ) G x 0 *ᵥ (distMatrix (𝕜 := ℂ) G 1 *ᵥ v) = v - 0 := by
    rw [← h, sub_zero]
  exact sub_right_injective h0

/-- **The `M`-half of Lemma 34.2 (v).**  `A_hv ∈ Span{v⁺ᵢ, v⁻ᵢ}` for every `h`
(lecture 34: `A_hv = (v⁺_{h+1} − v⁺_h) − (v⁻_h − v⁻_{h−1})`, from Lemma (i)). -/
theorem qe_distMatrix_mulVec_mem_qe_span (Y : DRGData G x D) {v : X → ℂ}
    (hv1 : subconst (𝕜 := ℂ) G x 1 *ᵥ v = v) (horth : ∑ z, v z = 0) (a : ℂ)
    (hva : Y.tildeA *ᵥ v = a • v) (h : ℕ) :
    distMatrix (𝕜 := ℂ) G h *ᵥ v ∈ qe_span (G := G) (x := x) v := by
  have hG : G.Connected := Y.connected
  have hvspan : v ∈ qe_span (G := G) (x := x) v := qe_mem_qe_span hG hv1
  -- the generators are in the span
  have hmem : ∀ i : ℕ, 2 ≤ i → qe_vminus (G := G) (x := x) v i ∈ qe_span (G := G) (x := x) v :=
    fun i hi => Submodule.subset_span (Or.inr ⟨i, hi, rfl⟩)
  have hplus : ∀ i : ℕ, qe_vplus (G := G) (x := x) v i ∈ qe_span (G := G) (x := x) v :=
    fun i => Submodule.subset_span (Or.inl ⟨i, rfl⟩)
  have hvm1 : qe_vminus (G := G) (x := x) v 1 ∈ qe_span (G := G) (x := x) v := by
    rw [qe_vminus_one_eq Y hv1 horth a hva]
    exact Submodule.smul_mem _ _ hvspan
  have hmem1 : ∀ i : ℕ, 1 ≤ i →
      qe_vminus (G := G) (x := x) v i ∈ qe_span (G := G) (x := x) v := by
    intro i hi
    rcases Nat.eq_or_lt_of_le hi with h1 | h2
    · rw [← h1]; exact hvm1
    · exact hmem i (by omega)
  have hvm0 : qe_vminus (G := G) (x := x) v 0 ∈ qe_span (G := G) (x := x) v := by
    rw [qe_vminus_zero_eq hG hv1 horth]
    exact Submodule.zero_mem _
  rcases Nat.eq_zero_or_pos h with h0 | hpos
  · rw [h0, distMatrix_zero G hG, Matrix.one_mulVec]
    exact hvspan
  · have h1 := qe_tildeAcum_mulVec_eq (G := G) (x := x) hG hv1 horth h
    have h2 := qe_tildeAcum_mulVec_eq (G := G) (x := x) hG hv1 horth (h - 1)
    rw [show h - 1 + 1 = h from by omega] at h2
    have hdiff : distMatrix (𝕜 := ℂ) G h *ᵥ v
        = (∑ j ∈ Finset.range (h + 1), distMatrix (𝕜 := ℂ) G j) *ᵥ v
          - (∑ j ∈ Finset.range h, distMatrix (𝕜 := ℂ) G j) *ᵥ v := by
      rw [← Matrix.sub_mulVec, Finset.sum_range_succ, add_sub_cancel_left]
    rw [hdiff, h1, h2]
    have hA : subconst (𝕜 := ℂ) G x (h + 1) *ᵥ (distMatrix (𝕜 := ℂ) G h *ᵥ v)
        = qe_vplus (G := G) (x := x) v (h + 1) := rfl
    have hB : subconst (𝕜 := ℂ) G x h *ᵥ (distMatrix (𝕜 := ℂ) G (h + 1) *ᵥ v)
        = qe_vminus (G := G) (x := x) v h := rfl
    have hC : subconst (𝕜 := ℂ) G x h *ᵥ (distMatrix (𝕜 := ℂ) G (h - 1) *ᵥ v)
        = qe_vplus (G := G) (x := x) v h := rfl
    have hD : subconst (𝕜 := ℂ) G x (h - 1) *ᵥ (distMatrix (𝕜 := ℂ) G h *ᵥ v)
        = qe_vminus (G := G) (x := x) v (h - 1) := by
      show subconst (𝕜 := ℂ) G x (h - 1) *ᵥ (distMatrix (𝕜 := ℂ) G h *ᵥ v)
        = subconst (𝕜 := ℂ) G x (h - 1) *ᵥ (distMatrix (𝕜 := ℂ) G ((h - 1) + 1) *ᵥ v)
      rw [Nat.sub_add_cancel hpos]
    rw [hA, hB, hC, hD]
    rcases Nat.eq_or_lt_of_le hpos with hone | hgt
    · rw [← hone]
      exact Submodule.sub_mem _ (Submodule.sub_mem _ (hplus 2) hvm1)
        (Submodule.sub_mem _ (hplus 1) hvm0)
    · have h2le : 2 ≤ h := by omega
      exact Submodule.sub_mem _ (Submodule.sub_mem _ (hplus (h + 1)) (hmem h h2le))
        (Submodule.sub_mem _ (hplus h) (hmem1 (h - 1) (by omega)))

end DRGData

/-! ## Chapter 33: the compression `E*_1 M M*` — Lemma 33.2 (i) and the reduction of 33.4 (iii)

New material (all sorry-free):

* the triangle vanishing `E*_i A_m E*_j = 0` when the indices violate `|i-j| ≤ m ≤ i+j`,
  and the specialisation `E*_1 A_i E*_j = 0` for `|i - j| > 1`;
* the identity `A_m E*_0 A_j = E*_m J E*_j` (Lemma 33.1 (iv) at entry level);
* the collapse of `E*_1 A_i`, `E*_1 J E*_j` and `E*_1 (∑ θ*_h A_h) E*_j` to three consecutive
  terms (the triangle vanishing on the second index);
* `M*(x) = Span{E*_h}` and `T(x) ≤ Algebra.adjoin ℂ (A ∪ M*(x))`;
* **Lemma 33.2 (i)** (`eonemmstar`): `E*_1 m E*_h ∈ E*_1 M + E*_1 J M* + E*_1 E_1 M*`,
  by the notes' minimal-counterexample argument (`Fe_A_estar_mem`, `eonemmstar`);
* the closure of the right-ideal candidate `Rspan = E*_1 M + E*_1 J M* + E*_1 E_1 M*`
  under right multiplication by `E*_h` (`R_mul_Nb`) and the inclusion `Rspan * E*_1 ⊆ ⟨J̃,E*_1,Ã⟩`
  (`R_mul_Fe`);
* the reduction `e1star_te1star_input_of_M`: the notes' input `h` of
  `e1star_te1star_span_of_adjoin` follows from the single remaining closure property
  `∀ m ∈ Rspan, m * A ∈ Rspan`.

The remaining gap is documented in the report: `Rspan` is *not yet* proved closed under right
multiplication by `A`; the only missing case is `E*_1 E_1 E*_h A_i ∈ Rspan`.
-/


/-! ### Entry computations and the triangle vanishing -/

theorem subconst_mul_mul_subconst_apply2 {G : SimpleGraph X} {x : X}
    (M : Matrix X X ℂ) (i j : ℕ) (u v : X) :
    (subconst (𝕜 := ℂ) G x i * M * subconst (𝕜 := ℂ) G x j) u v
      = (if G.dist x u = i then (1 : ℂ) else 0) * M u v
        * (if G.dist x v = j then (1 : ℂ) else 0) := by
  simp only [subconst]
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul]

theorem subconst_mul_distMatrix_mul_subconst_eq_zero_tri {G : SimpleGraph X} (hG : G.Connected)
    {x : X} {i j m : ℕ} (hij : j + m < i ∨ i + m < j ∨ i + j < m) :
    subconst (𝕜 := ℂ) G x i * distMatrix (𝕜 := ℂ) G m * subconst (𝕜 := ℂ) G x j = 0 := by
  ext u v
  rw [Matrix.zero_apply, subconst_mul_mul_subconst_apply2, distMatrix_apply]
  have htri1 : G.dist x u ≤ G.dist x v + G.dist u v := by
    have hh := hG.dist_triangle (u := x) (v := v) (w := u)
    rwa [SimpleGraph.dist_comm (u := v) (v := u)] at hh
  have htri2 : G.dist x v ≤ G.dist x u + G.dist u v :=
    hG.dist_triangle (u := x) (v := u) (w := v)
  have htri3 : G.dist u v ≤ G.dist x u + G.dist x v := by
    have hh := hG.dist_triangle (u := u) (v := x) (w := v)
    rwa [SimpleGraph.dist_comm (u := u) (v := x)] at hh
  rcases hij with h | h | h
  · by_cases hu : G.dist x u = i
    · by_cases hv : G.dist x v = j
      · by_cases hd : G.dist u v = m
        · rw [if_pos hu, if_pos hv, if_pos hd]; omega
        · rw [if_pos hu, if_pos hv, if_neg hd]; ring
      · rw [if_pos hu, if_neg hv]; ring
    · rw [if_neg hu]; ring
  · by_cases hu : G.dist x u = i
    · by_cases hv : G.dist x v = j
      · by_cases hd : G.dist u v = m
        · rw [if_pos hu, if_pos hv, if_pos hd]; omega
        · rw [if_pos hu, if_pos hv, if_neg hd]; ring
      · rw [if_pos hu, if_neg hv]; ring
    · rw [if_neg hu]; ring
  · by_cases hu : G.dist x u = i
    · by_cases hv : G.dist x v = j
      · by_cases hd : G.dist u v = m
        · rw [if_pos hu, if_pos hv, if_pos hd]; omega
        · rw [if_pos hu, if_pos hv, if_neg hd]; ring
      · rw [if_pos hu, if_neg hv]; ring
    · rw [if_neg hu]; ring

theorem subconst_one_mul_distMatrix_mul_subconst_eq_zero_band {G : SimpleGraph X}
    (hG : G.Connected) {x : X} {i j : ℕ} (h : j + 1 < i ∨ i + 1 < j) :
    subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x j = 0 := by
  refine subconst_mul_distMatrix_mul_subconst_eq_zero_tri (G := G) (x := x) hG ?_
  rcases h with h | h
  · exact Or.inr (Or.inr (by omega))
  · exact Or.inr (Or.inl (by omega))

theorem subconst_zero_eq_diagonal_single {G : SimpleGraph X} (hG : G.Connected) (x : X) :
    subconst (𝕜 := ℂ) G x 0 = diagonal (Pi.single x (1 : ℂ)) := by
  ext y z
  rw [subconst, Matrix.diagonal_apply, Matrix.diagonal_apply, Pi.single_apply]
  by_cases hyz : y = z
  · subst hyz
    have h0 : G.dist x y = 0 ↔ y = x := by
      constructor
      · intro h
        rcases (SimpleGraph.dist_eq_zero_iff_eq_or_not_reachable).mp h with h' | h'
        · exact h'.symm
        · exact absurd (h' (hG x y)) (by simp)
      · rintro rfl
        rw [SimpleGraph.dist_eq_zero_iff_eq_or_not_reachable]
        exact Or.inl rfl
    by_cases hyx : y = x <;> simp [h0, hyx]
  · simp [hyz]

theorem distMatrix_mul_subconst_zero_mul_distMatrix {G : SimpleGraph X} (hG : G.Connected)
    (x : X) (m j : ℕ) :
    distMatrix (𝕜 := ℂ) G m * subconst (𝕜 := ℂ) G x 0 * distMatrix (𝕜 := ℂ) G j
      = subconst (𝕜 := ℂ) G x m * allOnes * subconst (𝕜 := ℂ) G x j := by
  ext u v
  rw [subconst_mul_mul_subconst_apply2, subconst_zero_eq_diagonal_single hG]
  simp only [Matrix.mul_apply, Matrix.mul_diagonal, Matrix.diagonal_mul, Matrix.diagonal_apply,
    Pi.single_apply, distMatrix_apply, allOnes_apply, mul_one]
  rw [Finset.sum_eq_single x]
  · simp [SimpleGraph.dist_comm (u := u) (v := x)]
  · intro b _ hb
    simp [hb]
  · intro h
    exact absurd (Finset.mem_univ x) h

/-! ### Collapsing a sum over `range (D+1)` to three terms -/

theorem sum_range_collapse_three {M : Type*} [AddCommMonoid M] (f : ℕ → M) {D m : ℕ}
    (hm : 1 ≤ m) (hmD : m ≤ D) (fzero : ∀ j, D < j → f j = 0)
    (h : ∀ j, j ∈ Finset.range (D + 1) → j ≠ m - 1 → j ≠ m → j ≠ m + 1 → f j = 0) :
    ∑ j ∈ Finset.range (D + 1), f j = f (m - 1) + f m + f (m + 1) := by
  set t : Finset ℕ := {m - 1, m, m + 1} with ht
  have hzero' : ∀ x ∈ Finset.range (D + 1), x ∉ t ∩ Finset.range (D + 1) → f x = 0 := by
    intro y hy hyt
    refine h y hy ?_ ?_ ?_
    · intro hh; exact hyt (Finset.mem_inter.mpr ⟨by rw [ht]; simp [hh], hy⟩)
    · intro hh; exact hyt (Finset.mem_inter.mpr ⟨by rw [ht]; simp [hh], hy⟩)
    · intro hh; exact hyt (Finset.mem_inter.mpr ⟨by rw [ht]; simp [hh], hy⟩)
  have hzero'' : ∀ x ∈ t, x ∉ t ∩ Finset.range (D + 1) → f x = 0 := by
    intro y hy hyt
    have hyr : y ∉ Finset.range (D + 1) := fun hh => hyt (Finset.mem_inter.mpr ⟨hy, hh⟩)
    rw [Finset.mem_range, not_lt] at hyr
    rw [ht, Finset.mem_insert, Finset.mem_insert, Finset.mem_singleton] at hy
    rcases hy with rfl | rfl | rfl
    · omega
    · omega
    · exact fzero _ hyr
  have hA : ∑ x ∈ t ∩ Finset.range (D + 1), f x = ∑ x ∈ Finset.range (D + 1), f x :=
    Finset.sum_subset Finset.inter_subset_right hzero'
  have hB : ∑ x ∈ t ∩ Finset.range (D + 1), f x = ∑ x ∈ t, f x :=
    Finset.sum_subset Finset.inter_subset_left hzero''
  rw [← hA, hB, ht]
  rw [show ({m - 1, m, m + 1} : Finset ℕ) = insert (m - 1) (insert m {m + 1}) from rfl]
  rw [Finset.sum_insert (by
        simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
        omega),
      Finset.sum_insert (by
        simp only [Finset.mem_singleton]
        omega),
      Finset.sum_singleton]
  abel

/-! ### The Bose-Mesner algebra and its dual as submodules -/

def MbSub (G : SimpleGraph X) : Submodule ℂ (Matrix X X ℂ) :=
  (boseMesner (𝕜 := ℂ) G).toSubmodule

def NbSub (G : SimpleGraph X) (x : X) : Submodule ℂ (Matrix X X ℂ) :=
  (dualBoseMesner (𝕜 := ℂ) G x).toSubmodule

theorem mem_MbSub {G : SimpleGraph X} {m : Matrix X X ℂ} :
    m ∈ MbSub G ↔ m ∈ boseMesner (𝕜 := ℂ) G := Iff.rfl

theorem mem_NbSub {G : SimpleGraph X} {x : X} {m : Matrix X X ℂ} :
    m ∈ NbSub G x ↔ m ∈ dualBoseMesner (𝕜 := ℂ) G x := Iff.rfl

theorem adj_mem_MbSub (G : SimpleGraph X) : adj (𝕜 := ℂ) G ∈ MbSub G :=
  Algebra.self_mem_adjoin_singleton ℂ (adj (𝕜 := ℂ) G)

theorem subconst_mem_NbSub (G : SimpleGraph X) (x : X) (i : ℕ) :
    subconst (𝕜 := ℂ) G x i ∈ NbSub G x :=
  Algebra.subset_adjoin (Set.mem_range_self i)

theorem MbSub_mul {G : SimpleGraph X} {a b : Matrix X X ℂ} (ha : a ∈ MbSub G) (hb : b ∈ MbSub G) :
    a * b ∈ MbSub G := (boseMesner (𝕜 := ℂ) G).mul_mem ha hb

theorem NbSub_mul {G : SimpleGraph X} {x : X} {a b : Matrix X X ℂ}
    (ha : a ∈ NbSub G x) (hb : b ∈ NbSub G x) : a * b ∈ NbSub G x :=
  (dualBoseMesner (𝕜 := ℂ) G x).mul_mem ha hb

def leftMulSpan (A₀ : Matrix X X ℂ) (M₀ : Submodule ℂ (Matrix X X ℂ)) :
    Submodule ℂ (Matrix X X ℂ) :=
  Submodule.span ℂ {m : Matrix X X ℂ | ∃ b ∈ M₀, m = A₀ * b}

theorem leftMulSpan_mem {A₀ : Matrix X X ℂ} {M₀ : Submodule ℂ (Matrix X X ℂ)} {b : Matrix X X ℂ}
    (hb : b ∈ M₀) : A₀ * b ∈ leftMulSpan A₀ M₀ :=
  Submodule.subset_span ⟨b, hb, rfl⟩

theorem leftMulSpan_le {A₀ : Matrix X X ℂ} {M₀ : Submodule ℂ (Matrix X X ℂ)}
    {N₀ : Submodule ℂ (Matrix X X ℂ)} (h : ∀ b ∈ M₀, A₀ * b ∈ N₀) :
    leftMulSpan A₀ M₀ ≤ N₀ := by
  refine Submodule.span_le.mpr ?_
  rintro m ⟨b, hb, rfl⟩
  exact h b hb

/-- `{m | m * n ∈ R}` as a submodule. -/
def mulRightSub (R : Submodule ℂ (Matrix X X ℂ)) (n : Matrix X X ℂ) :
    Submodule ℂ (Matrix X X ℂ) where
  carrier := {m | m * n ∈ R}
  zero_mem' := by
    show (0 : Matrix X X ℂ) * n ∈ R
    rw [Matrix.zero_mul]
    exact Submodule.zero_mem R
  add_mem' := by
    intro a b ha hb
    show (a + b) * n ∈ R
    rw [Matrix.add_mul]
    exact Submodule.add_mem _ ha hb
  smul_mem' := by
    intro c a ha
    show (c • a) * n ∈ R
    rw [Matrix.smul_mul]
    exact Submodule.smul_mem _ _ ha

theorem mem_mulRightSub {R : Submodule ℂ (Matrix X X ℂ)} {n m : Matrix X X ℂ} :
    m ∈ mulRightSub R n ↔ m * n ∈ R := Iff.rfl

namespace DRGData

variable {G : SimpleGraph X} {x : X} {D : ℕ}

/-- `E*_1(x)`. -/
def Fe (Y : DRGData G x D) : Matrix X X ℂ := subconst (𝕜 := ℂ) G x 1

/-- `J = ∑_h A_h`. -/
def Jm (Y : DRGData G x D) : Matrix X X ℂ :=
  ∑ i ∈ Finset.range (D + 1), distMatrix (𝕜 := ℂ) G i

/-- `θ*` extended by zero beyond the diameter. -/
def thetaNat (Y : DRGData G x D) : ℕ → ℂ :=
  fun h => if hh : h ≤ D then (Y.thetaStar ⟨h, Nat.lt_succ_of_le hh⟩ : ℂ) else 0

theorem thetaNat_of_le {Y : DRGData G x D} {h : ℕ} (hh : h ≤ D) :
    Y.thetaNat h = (Y.thetaStar ⟨h, Nat.lt_succ_of_le hh⟩ : ℂ) := dif_pos hh

theorem thetaNat_of_gt {Y : DRGData G x D} {h : ℕ} (hh : D < h) : Y.thetaNat h = 0 :=
  dif_neg (by omega)

theorem thetaNat_injective {Y : DRGData G x D} (hθ : Function.Injective Y.thetaStar)
    {h h' : ℕ} (hh : h ≤ D) (hh' : h' ≤ D) (heq : Y.thetaNat h = Y.thetaNat h') : h = h' := by
  rw [thetaNat_of_le hh, thetaNat_of_le hh'] at heq
  have h2 : Y.thetaStar ⟨h, Nat.lt_succ_of_le hh⟩ = Y.thetaStar ⟨h', Nat.lt_succ_of_le hh'⟩ := by
    exact_mod_cast heq
  exact congrArg Fin.val (hθ h2)

/-- `|X| E_1 = ∑_h θ*_h A_h`. -/
def E1m (Y : DRGData G x D) : Matrix X X ℂ :=
  ∑ i ∈ Finset.range (D + 1), Y.thetaNat i • distMatrix (𝕜 := ℂ) G i

theorem Jm_eq_allOnes {Y : DRGData G x D} (hDall : ∀ a b : X, G.dist a b ≤ D) :
    Y.Jm = allOnes :=
  sum_distMatrix G D hDall

/-- `E*_1 A_i E*_j = 0` when `|i - j| > 1`. -/
theorem Fe_A_estar_eq_zero {Y : DRGData G x D} (hG : G.Connected) {i j : ℕ}
    (h : j + 1 < i ∨ i + 1 < j) :
    Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x j = 0 :=
  subconst_one_mul_distMatrix_mul_subconst_eq_zero_band hG h

/-- `E*_1 A_i E*_j = 0` when `j` exceeds the diameter. -/
theorem Fe_A_estar_eq_zero_right {Y : DRGData G x D} (hDx : ∀ y, G.dist x y ≤ D) {i j : ℕ}
    (hj : D < j) : Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x j = 0 := by
  rw [subconst_eq_zero_of_lt (x := x) hDx hj, mul_zero]

theorem Fe_mul_Jm_mul_Fe (Y : DRGData G x D) (j : ℕ) :
    Y.Fe * Y.Jm * subconst (𝕜 := ℂ) G x j
      = ∑ h ∈ Finset.range (D + 1),
          Y.Fe * distMatrix (𝕜 := ℂ) G h * subconst (𝕜 := ℂ) G x j := by
  rw [Jm, Finset.mul_sum, Finset.sum_mul]

theorem Fe_mul_E1m_mul_Fe (Y : DRGData G x D) (j : ℕ) :
    Y.Fe * Y.E1m * subconst (𝕜 := ℂ) G x j
      = ∑ h ∈ Finset.range (D + 1),
          Y.thetaNat h • (Y.Fe * distMatrix (𝕜 := ℂ) G h * subconst (𝕜 := ℂ) G x j) := by
  rw [E1m, Finset.mul_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [Matrix.mul_smul, Matrix.smul_mul, mul_assoc]

set_option maxHeartbeats 400000 in
theorem Fe_mul_A_eq_three {Y : DRGData G x D} (hG : G.Connected)
    (hDx : ∀ y, G.dist x y ≤ D) {i : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) :
    Y.Fe * distMatrix (𝕜 := ℂ) G i
      = Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x (i - 1)
        + Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x i
        + Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x (i + 1) := by
  have hsum : Y.Fe * distMatrix (𝕜 := ℂ) G i
      = ∑ h ∈ Finset.range (D + 1),
          Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x h := by
    rw [← Finset.mul_sum, sum_subconst_eq_one (𝕜 := ℂ) G x D hDx, mul_one]
  calc Y.Fe * distMatrix (𝕜 := ℂ) G i
      = ∑ h ∈ Finset.range (D + 1),
          Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x h := hsum
    _ = Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x (i - 1)
        + Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x i
        + Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x (i + 1) :=
      sum_range_collapse_three (M := Matrix X X ℂ)
        (f := fun h => Y.Fe * distMatrix (𝕜 := ℂ) G i * subconst (𝕜 := ℂ) G x h)
        (D := D) (m := i) hi hiD
        (fun j hj => Fe_A_estar_eq_zero_right (Y := Y) hDx (i := i) hj)
        (fun j _ hj1 hj2 hj3 => Fe_A_estar_eq_zero hG (by omega))

set_option maxHeartbeats 400000 in
theorem Fe_mul_Jm_eq_three {Y : DRGData G x D} (hG : G.Connected)
    (hDall : ∀ a b : X, G.dist a b ≤ D) {j : ℕ} (hj : 1 ≤ j) (hjD : j ≤ D) :
    Y.Fe * Y.Jm * subconst (𝕜 := ℂ) G x j
      = Y.Fe * distMatrix (𝕜 := ℂ) G (j - 1) * subconst (𝕜 := ℂ) G x j
        + Y.Fe * distMatrix (𝕜 := ℂ) G j * subconst (𝕜 := ℂ) G x j
        + Y.Fe * distMatrix (𝕜 := ℂ) G (j + 1) * subconst (𝕜 := ℂ) G x j := by
  rw [Fe_mul_Jm_mul_Fe]
  exact sum_range_collapse_three (M := Matrix X X ℂ)
    (f := fun h => Y.Fe * distMatrix (𝕜 := ℂ) G h * subconst (𝕜 := ℂ) G x j)
    (D := D) (m := j) hj hjD
    (fun h hh => by rw [distMatrix_eq_zero_of_lt hDall hh]; simp)
    (fun h _ hh1 hh2 hh3 => Fe_A_estar_eq_zero hG (by omega))

set_option maxHeartbeats 400000 in
theorem Fe_mul_E1m_eq_three {Y : DRGData G x D} (hG : G.Connected)
    (hDall : ∀ a b : X, G.dist a b ≤ D) {j : ℕ} (hj : 1 ≤ j) (hjD : j ≤ D) :
    Y.Fe * Y.E1m * subconst (𝕜 := ℂ) G x j
      = Y.thetaNat (j - 1) • (Y.Fe * distMatrix (𝕜 := ℂ) G (j - 1)
          * subconst (𝕜 := ℂ) G x j)
        + Y.thetaNat j • (Y.Fe * distMatrix (𝕜 := ℂ) G j * subconst (𝕜 := ℂ) G x j)
        + Y.thetaNat (j + 1) • (Y.Fe * distMatrix (𝕜 := ℂ) G (j + 1)
            * subconst (𝕜 := ℂ) G x j) := by
  rw [Fe_mul_E1m_mul_Fe]
  exact sum_range_collapse_three (M := Matrix X X ℂ)
    (f := fun h => Y.thetaNat h • (Y.Fe * distMatrix (𝕜 := ℂ) G h
      * subconst (𝕜 := ℂ) G x j)) (D := D) (m := j) hj hjD
    (fun h hh => by rw [thetaNat_of_gt hh, zero_smul])
    (fun h _ hh1 hh2 hh3 => by rw [Fe_A_estar_eq_zero hG (by omega), smul_zero])

/-- The right ideal candidate `E*_1 M + E*_1 J M* + E*_1 E_1 M*`. -/
def Rspan (Y : DRGData G x D) : Submodule ℂ (Matrix X X ℂ) :=
  leftMulSpan Y.Fe (MbSub G) + leftMulSpan (Y.Fe * Y.Jm) (NbSub G x)
    + leftMulSpan (Y.Fe * Y.E1m) (NbSub G x)

theorem le_Rspan_1 {Y : DRGData G x D} : leftMulSpan Y.Fe (MbSub G) ≤ Rspan Y :=
  le_trans le_sup_left le_sup_left

theorem le_Rspan_2 {Y : DRGData G x D} :
    leftMulSpan (Y.Fe * Y.Jm) (NbSub G x) ≤ Rspan Y :=
  le_trans le_sup_right le_sup_left

theorem le_Rspan_3 {Y : DRGData G x D} :
    leftMulSpan (Y.Fe * Y.E1m) (NbSub G x) ≤ Rspan Y := le_sup_right

