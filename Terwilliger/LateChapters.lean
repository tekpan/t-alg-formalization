/-- `Rspan` is closed under right multiplication by `E*_h`. -/
theorem R_mul_Nb {Y : DRGData G x D} (hG : G.Connected)
    (hbi : IntersectionNumbersIndependent G) (hθ : Function.Injective Y.thetaStar)
    (hDall : ∀ a b : X, G.dist a b ≤ D) (h : ℕ) :
    ∀ m ∈ Rspan Y, m * subconst (𝕜 := ℂ) G x h ∈ Rspan Y := by
  intro m hm
  have hle : Rspan Y ≤ mulRightSub (Rspan Y) (subconst (𝕜 := ℂ) G x h) := by
    refine sup_le ?_ ?_
    · refine sup_le ?_ ?_
      · refine leftMulSpan_le (fun b hb => ?_)
        exact eonemmstar hG hbi hθ hDall hb h
      · refine leftMulSpan_le (fun c hc => ?_)
        refine le_Rspan_2 ?_
        simpa [mul_assoc] using leftMulSpan_mem (A₀ := Y.Fe * Y.Jm)
          (NbSub_mul hc (subconst_mem_NbSub G x h))
    · refine leftMulSpan_le (fun c hc => ?_)
      refine le_Rspan_3 ?_
      simpa [mul_assoc] using leftMulSpan_mem (A₀ := Y.Fe * Y.E1m)
        (NbSub_mul hc (subconst_mem_NbSub G x h))
  exact hle hm

end DRGData
/-! ### `M*(x)` as the span of the `E*_h`, and `T(x)` versus the algebra generated by `A` and `M*` -/

theorem NbSub_eq_span {G : SimpleGraph X} {x : X} {D : ℕ} (hDx : ∀ y, G.dist x y ≤ D) :
    NbSub G x = Submodule.span ℂ (Set.range (subconst (𝕜 := ℂ) G x)) := by
  refine le_antisymm ?_ ?_
  · have hmul : ∀ a ∈ Submodule.span ℂ (Set.range (subconst (𝕜 := ℂ) G x)),
        ∀ b ∈ Submodule.span ℂ (Set.range (subconst (𝕜 := ℂ) G x)),
        a * b ∈ Submodule.span ℂ (Set.range (subconst (𝕜 := ℂ) G x)) := by
      intro a ha
      induction ha using Submodule.span_induction with
      | mem y hy =>
          intro b hb
          obtain ⟨i, rfl⟩ := hy
          induction hb using Submodule.span_induction with
          | mem z hz =>
              obtain ⟨j, rfl⟩ := hz
              rw [subconst_mul_subconst]
              split_ifs with hh
              · exact Submodule.subset_span ⟨i, rfl⟩
              · exact Submodule.zero_mem _
          | zero => rw [mul_zero]; exact Submodule.zero_mem _
          | add u v _ _ hu hv => rw [mul_add]; exact Submodule.add_mem _ hu hv
          | smul c u _ hu => rw [Matrix.mul_smul]; exact Submodule.smul_mem _ _ hu
      | zero =>
          intro b hb
          rw [zero_mul]
          exact Submodule.zero_mem _
      | add u v _ _ hu hv =>
          intro b hb
          rw [add_mul]
          exact Submodule.add_mem _ (hu b hb) (hv b hb)
      | smul c u _ hu =>
          intro b hb
          rw [Matrix.smul_mul]
          exact Submodule.smul_mem _ _ (hu b hb)
    have hone : (1 : Matrix X X ℂ) ∈ Submodule.span ℂ (Set.range (subconst (𝕜 := ℂ) G x)) := by
      rw [← sum_subconst_eq_one (𝕜 := ℂ) G x D hDx]
      exact Submodule.sum_mem _ (fun h _ => Submodule.subset_span ⟨h, rfl⟩)
    let S : Subalgebra ℂ (Matrix X X ℂ) :=
      { carrier := Submodule.span ℂ (Set.range (subconst (𝕜 := ℂ) G x))
        mul_mem' := fun ha hb => hmul _ ha _ hb
        one_mem' := hone
        add_mem' := fun ha hb => Submodule.add_mem _ ha hb
        zero_mem' := Submodule.zero_mem _
        algebraMap_mem' := by
          intro r
          rw [Algebra.algebraMap_eq_smul_one]
          exact Submodule.smul_mem _ _ hone }
    have hle : dualBoseMesner (𝕜 := ℂ) G x ≤ S := by
      rw [dualBoseMesner]
      refine Algebra.adjoin_le_iff.mpr ?_
      intro y hy
      exact Submodule.subset_span hy
    intro a ha
    exact hle ha
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    exact subconst_mem_NbSub G x i

theorem star_mem_adjoin_gen {G : SimpleGraph X} {x : X} {a : Matrix X X ℂ}
    (ha : a ∈ Algebra.adjoin ℂ ({adj (𝕜 := ℂ) G} ∪ Set.range (subconst (𝕜 := ℂ) G x))) :
    star a ∈ Algebra.adjoin ℂ ({adj (𝕜 := ℂ) G} ∪ Set.range (subconst (𝕜 := ℂ) G x)) := by
  induction ha using Algebra.adjoin_induction with
  | mem y hy =>
      rcases hy with rfl | ⟨i, rfl⟩
      · rw [star_adj]
        exact Algebra.subset_adjoin (Set.mem_union_left _ rfl)
      · rw [star_subconst]
        exact Algebra.subset_adjoin (Set.mem_union_right _ ⟨i, rfl⟩)
  | algebraMap r =>
      rw [Algebra.algebraMap_eq_smul_one, star_smul, star_one,
        ← Algebra.algebraMap_eq_smul_one (A := Matrix X X ℂ)]
      exact Subalgebra.algebraMap_mem _ (star r)
  | add y z _ _ hy hz =>
      rw [star_add]
      exact add_mem hy hz
  | mul y z _ _ hy hz =>
      rw [star_mul]
      exact mul_mem hz hy

/-- The algebra generated by `A` and `M*(x)`, as a `StarSubalgebra`. -/
def genAlgebra (G : SimpleGraph X) (x : X) : StarSubalgebra ℂ (Matrix X X ℂ) where
  toSubalgebra := Algebra.adjoin ℂ ({adj (𝕜 := ℂ) G} ∪ Set.range (subconst (𝕜 := ℂ) G x))
  star_mem' := fun ha => star_mem_adjoin_gen ha

theorem subconstituentAlgebra_toSubalgebra_le_adjoin (G : SimpleGraph X) (x : X) :
    (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra
      ≤ Algebra.adjoin ℂ ({adj (𝕜 := ℂ) G} ∪ Set.range (subconst (𝕜 := ℂ) G x)) := by
  have hle : subconstituentAlgebra (𝕜 := ℂ) G x ≤ genAlgebra G x := by
    refine StarAlgebra.adjoin_le ?_
    intro m hm
    rcases hm with rfl | ⟨i, rfl⟩
    · exact Algebra.subset_adjoin (Set.mem_union_left _ rfl)
    · exact Algebra.subset_adjoin (Set.mem_union_right _ ⟨i, rfl⟩)
  intro a ha
  exact hle ha

theorem subalgebra_smul_mem (S : Subalgebra ℂ (Matrix X X ℂ)) (c : ℂ) {u : Matrix X X ℂ}
    (hu : u ∈ S) : c • u ∈ S := by
  rw [show c • u = algebraMap ℂ (Matrix X X ℂ) c * u from by
    rw [Algebra.algebraMap_eq_smul_one, Matrix.smul_mul, one_mul]]
  exact mul_mem (Subalgebra.algebraMap_mem _ c) hu


theorem mem_adjoin_of_mem_span {s : Set (Matrix X X ℂ)} {m : Matrix X X ℂ}
    (h : m ∈ Submodule.span ℂ s) : m ∈ Algebra.adjoin ℂ s := by
  induction h using Submodule.span_induction with
  | mem y hy => exact Algebra.subset_adjoin hy
  | zero => exact Subalgebra.zero_mem _
  | add u v _ _ hu hv => exact Subalgebra.add_mem _ hu hv
  | smul c u _ hu => exact subalgebra_smul_mem _ c hu

namespace DRGData

variable {G : SimpleGraph X} {x : X} {D : ℕ}

/-- The target algebra `⟨J̃, E*_1, Ã⟩`. -/
def Sab (Y : DRGData G x D) : Subalgebra ℂ (Matrix X X ℂ) :=
  Algebra.adjoin ℂ ({Y.tildeJ, subconst (𝕜 := ℂ) G x 1, Y.tildeA} : Set (Matrix X X ℂ))

theorem mem_Sab {Y : DRGData G x D} {m : Matrix X X ℂ} :
    m ∈ Sab Y ↔ m ∈ Algebra.adjoin ℂ ({Y.tildeJ, subconst (𝕜 := ℂ) G x 1, Y.tildeA} :
      Set (Matrix X X ℂ)) := Iff.rfl

/-- `E*_1 A_h E*_1 ∈ ⟨J̃, E*_1, Ã⟩`. -/
theorem Fe_A_Fe_mem {Y : DRGData G x D} (hG : G.Connected) (h : ℕ) :
    Y.Fe * distMatrix (𝕜 := ℂ) G h * Y.Fe ∈ Sab Y := by
  have h1 : subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G h * subconst (𝕜 := ℂ) G x 1
      ∈ Submodule.span ℂ ({Y.tildeJ, subconst (𝕜 := ℂ) G x 1, Y.tildeA} : Set (Matrix X X ℂ)) :=
    subconst_one_mul_distMatrix_mul_subconst_one_mem (G := G) (x := x) (Y := Y) hG h
  have h2 := mem_adjoin_of_mem_span h1
  have h3 : Y.Fe * distMatrix (𝕜 := ℂ) G h * Y.Fe
      = subconst (𝕜 := ℂ) G x 1 * distMatrix (𝕜 := ℂ) G h * subconst (𝕜 := ℂ) G x 1 := rfl
  rw [h3]
  exact h2

/-- `E*_1 J E*_h E*_1 = δ_{h1} J̃`. -/
theorem Fe_mul_Jm_mul_estar_mul_Fe {Y : DRGData G x D}
    (hDall : ∀ a b : X, G.dist a b ≤ D) (h : ℕ) :
    Y.Fe * Y.Jm * subconst (𝕜 := ℂ) G x h * Y.Fe = if h = 1 then Y.tildeJ else 0 := by
  have h1 : subconst (𝕜 := ℂ) G x h * Y.Fe = if h = 1 then Y.Fe else 0 := by
    show subconst (𝕜 := ℂ) G x h * subconst (𝕜 := ℂ) G x 1
      = if h = 1 then subconst (𝕜 := ℂ) G x 1 else 0
    rw [subconst_mul_subconst]
    split_ifs with hh
    · rw [hh]
    · rfl
  have h2 : Y.Fe * Y.Jm * subconst (𝕜 := ℂ) G x h * Y.Fe
      = Y.Fe * Y.Jm * (subconst (𝕜 := ℂ) G x h * Y.Fe) := by
    rw [mul_assoc (Y.Fe * Y.Jm) (subconst (𝕜 := ℂ) G x h) Y.Fe]
  rw [h2, h1]
  split_ifs with hh
  · rw [Jm_eq_allOnes hDall]
    rfl
  · simp

/-- `E*_1 E_1 E*_h E*_1 ∈ ⟨J̃, E*_1, Ã⟩`. -/
theorem Fe_mul_E1m_mul_estar_mul_Fe {Y : DRGData G x D} (hG : G.Connected)
    (hDall : ∀ a b : X, G.dist a b ≤ D) (h : ℕ) :
    Y.Fe * Y.E1m * subconst (𝕜 := ℂ) G x h * Y.Fe ∈ Sab Y := by
  have h1 : subconst (𝕜 := ℂ) G x h * Y.Fe = if h = 1 then Y.Fe else 0 := by
    show subconst (𝕜 := ℂ) G x h * subconst (𝕜 := ℂ) G x 1
      = if h = 1 then subconst (𝕜 := ℂ) G x 1 else 0
    rw [subconst_mul_subconst]
    split_ifs with hh
    · rw [hh]
    · rfl
  have h2 : Y.Fe * Y.E1m * subconst (𝕜 := ℂ) G x h * Y.Fe
      = Y.Fe * Y.E1m * (subconst (𝕜 := ℂ) G x h * Y.Fe) := by
    rw [mul_assoc (Y.Fe * Y.E1m) (subconst (𝕜 := ℂ) G x h) Y.Fe]
  rw [h2, h1]
  split_ifs with hh
  · have h4 := Fe_mul_E1m_mul_Fe Y 1
    rw [show (subconst (𝕜 := ℂ) G x 1) = Y.Fe from rfl] at h4
    rw [h4]
    have h5 : ∀ i ∈ Finset.range (D + 1), Y.thetaNat i • (Y.Fe * distMatrix (𝕜 := ℂ) G i * Y.Fe)
        ∈ (Sab Y).toSubmodule := by
      intro i hi
      exact subalgebra_smul_mem (Sab Y) (Y.thetaNat i) (Fe_A_Fe_mem hG i)
    exact Submodule.sum_mem ((Sab Y).toSubmodule) h5
  · rw [mul_zero]
    exact Subalgebra.zero_mem _

set_option maxHeartbeats 400000 in
/-- `Rspan * E*_1 ⊆ ⟨J̃, E*_1, Ã⟩`. -/
theorem R_mul_Fe {Y : DRGData G x D} (hG : G.Connected)
    (hbi : IntersectionNumbersIndependent G) (hDall : ∀ a b : X, G.dist a b ≤ D) :
    ∀ m ∈ Rspan Y, m * Y.Fe ∈ Sab Y := by
  have hspaneq := boseMesner_eq_span_distMatrix (x := x) hG Y.drg hbi D (by have := Y.hD; omega) hDall
  have hspannb : NbSub G x = Submodule.span ℂ (Set.range (subconst (𝕜 := ℂ) G x)) :=
    NbSub_eq_span (G := G) (x := x) (D := D) Y.diam
  have hA : ∀ b ∈ MbSub G, Y.Fe * b * Y.Fe ∈ Sab Y := by
    intro b hb
    have hs : b ∈ Submodule.span ℂ (Set.range fun i : Fin (D + 1) => distMatrix (𝕜 := ℂ) G i) := by
      rw [← hspaneq]
      exact hb
    clear hb
    induction hs using Submodule.span_induction with
    | mem z hz =>
        obtain ⟨i, rfl⟩ := hz
        exact Fe_A_Fe_mem hG i
    | zero => simp
    | add u v _ _ hu hv =>
        rw [mul_add, add_mul]
        exact Subalgebra.add_mem _ hu hv
    | smul c u _ hu =>
        rw [Matrix.mul_smul, Matrix.smul_mul]
        exact subalgebra_smul_mem (Sab Y) c hu
  have hB : ∀ n ∈ NbSub G x, Y.Fe * Y.Jm * n * Y.Fe ∈ Sab Y := by
    intro n hn
    rw [hspannb] at hn
    induction hn using Submodule.span_induction with
    | mem z hz =>
        obtain ⟨h, rfl⟩ := hz
        rw [Fe_mul_Jm_mul_estar_mul_Fe hDall h]
        split_ifs
        · exact Algebra.subset_adjoin (Set.mem_insert_iff.mpr (Or.inl rfl))
        · exact Subalgebra.zero_mem _
    | zero => simp
    | add u v _ _ hu hv =>
        rw [mul_add, Matrix.add_mul]
        exact Subalgebra.add_mem _ hu hv
    | smul c u _ hu =>
        rw [Matrix.mul_smul, Matrix.smul_mul]
        exact subalgebra_smul_mem (Sab Y) c hu
  have hC : ∀ n ∈ NbSub G x, Y.Fe * Y.E1m * n * Y.Fe ∈ Sab Y := by
    intro n hn
    rw [hspannb] at hn
    induction hn using Submodule.span_induction with
    | mem z hz =>
        obtain ⟨h, rfl⟩ := hz
        exact Fe_mul_E1m_mul_estar_mul_Fe hG hDall h
    | zero => simp
    | add u v _ _ hu hv =>
        rw [mul_add, Matrix.add_mul]
        exact Subalgebra.add_mem _ hu hv
    | smul c u _ hu =>
        rw [Matrix.mul_smul, Matrix.smul_mul]
        exact subalgebra_smul_mem (Sab Y) c hu
  intro m hm
  have hle : Rspan Y ≤ mulRightSub ((Sab Y).toSubmodule) Y.Fe := by
    refine sup_le ?_ ?_
    · refine sup_le ?_ ?_
      · exact leftMulSpan_le (fun b hb => hA b hb)
      · exact leftMulSpan_le (fun n hn => hB n hn)
    · exact leftMulSpan_le (fun n hn => hC n hn)
  exact hle hm

set_option maxHeartbeats 400000 in
/-- **The reduction of `e1star_te1star_input` to the closure of `Rspan` under `M`.** -/
theorem e1star_te1star_input_of_M {Y : DRGData G x D} (hG : G.Connected)
    (hbi : IntersectionNumbersIndependent G) (hθ : Function.Injective Y.thetaStar)
    (hDall : ∀ a b : X, G.dist a b ≤ D)
    (hMA : ∀ m ∈ Rspan Y, m * adj (𝕜 := ℂ) G ∈ Rspan Y) :
    ∀ a ∈ (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra,
      Y.Fe * a * Y.Fe ∈ Sab Y := by
  intro a ha
  have hFe : Y.Fe ∈ Rspan Y :=
    le_Rspan_1 (show Y.Fe ∈ leftMulSpan Y.Fe (MbSub G) from by
      simpa using leftMulSpan_mem (A₀ := Y.Fe) (M₀ := MbSub G)
        (Subalgebra.one_mem (boseMesner (𝕜 := ℂ) G)))
  have key : ∀ a ∈ Algebra.adjoin ℂ
      ({adj (𝕜 := ℂ) G} ∪ Set.range (subconst (𝕜 := ℂ) G x)),
      ∀ m ∈ Rspan Y, m * a ∈ Rspan Y := by
    intro a ha'
    induction ha' using Algebra.adjoin_induction with
    | mem z hz =>
        rcases hz with rfl | ⟨h, rfl⟩
        · exact fun m hm => hMA m hm
        · exact fun m hm => R_mul_Nb hG hbi hθ hDall h m hm
    | algebraMap r =>
        intro m hm
        rw [Algebra.algebraMap_eq_smul_one, Matrix.mul_smul, mul_one]
        exact Submodule.smul_mem _ _ hm
    | add z w _ _ hz hw =>
        intro m hm
        rw [mul_add]
        exact Submodule.add_mem _ (hz m hm) (hw m hm)
    | mul z w _ _ hz hw =>
        intro m hm
        have h1 : m * (z * w) = m * z * w := by noncomm_ring
        rw [h1]
        exact hw (m * z) (hz m hm)
  have hT : a ∈ Algebra.adjoin ℂ ({adj (𝕜 := ℂ) G} ∪ Set.range (subconst (𝕜 := ℂ) G x)) :=
    subconstituentAlgebra_toSubalgebra_le_adjoin G x ha
  exact R_mul_Fe hG hbi hDall (Y.Fe * a) (key a hT Y.Fe hFe)

end DRGData
/-! ### Statement audit: why the `hDex` hypothesis is not a formality

The wave-3 notes fix the interface `drg_idempotent_basis` with `{D : ℕ} (hD1 : 1 ≤ D)
(hDall : ∀ a b : X, G.dist a b ≤ D)` and no hypothesis that `D` is *attained*.  That form is
refutable: instantiating `D := 5` on the cube `Q₃` (diameter 3) satisfies `hD1` and `hDall`,
while the conclusion demands `D + 1 = 6` distinct eigenvalues of the adjacency matrix (see below)
where the cube has only four (`3, 1, -1, -3`).  The same applies to `basic_data_diam_bound`
(QB's interface): on `Q₃` with `D := 5` and the trivial module (`r = 0`, `d = 3`) the conclusion
reads `5 ≤ 3`.

The lemma below is the formal core of the first half: any family of `D + 1` nonzero matrices on
which `A` acts by the *distinct* scalars `θ i` forces `D + 1 ≤ #(eigFinset A)`.  Together with
`hDex : ∃ a b : X, G.dist a b = D` (which pins `D` to the diameter, and is what QA's and QC's
files both add) the interfaces are consistent. -/

/-- If `A` acts on `D + 1` nonzero matrices by pairwise distinct scalars, then `A` has at least
`D + 1` distinct eigenvalues. -/
theorem card_le_eigFinset_of_scalar_action {G : SimpleGraph X} {D : ℕ}
    {E : Fin (D + 1) → Matrix X X ℂ} {θ : Fin (D + 1) → ℝ}
    (hne : ∀ i, E i ≠ 0) (hA : ∀ i, adj (𝕜 := ℂ) G * E i = ((θ i : ℂ)) • E i)
    (hθ : Function.Injective θ) :
    D + 1 ≤ (eigFinset (adj (𝕜 := ℂ) G)).card := by
  have hmem : ∀ i, ((θ i : ℂ)) ∈ eigFinset (adj (𝕜 := ℂ) G) := by
    intro i
    rw [← isEigenvalue_iff_mem_eigFinset']
    -- a nonzero column of `E i` gives an eigenvector
    obtain ⟨x, hx⟩ : ∃ x : X, E i *ᵥ (Pi.single x 1) ≠ 0 := by
      by_contra h
      push_neg at h
      exact hne i (by
        ext u v
        have hv := congrFun (h v) u
        rw [Matrix.mulVec_single] at hv
        simpa using hv)
    refine ⟨E i *ᵥ (Pi.single x 1), hx, ?_⟩
    rw [Matrix.mulVec_mulVec, hA i, Matrix.smul_mulVec]
  have hinj : Function.Injective fun i : Fin (D + 1) => ((θ i : ℂ)) := by
    intro i j hij
    exact hθ (Complex.ofReal_injective hij)
  calc D + 1 = Fintype.card (Fin (D + 1)) := by simp
    _ = (Finset.univ.image fun i : Fin (D + 1) => ((θ i : ℂ))).card := by
        rw [Finset.card_image_of_injective _ hinj]; simp
    _ ≤ (eigFinset (adj (𝕜 := ℂ) G)).card := by
        apply Finset.card_le_card
        intro y hy
        obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hy
        exact hmem i


/-! ## Chapter 14: Lemma 14.2 (iii) — the diameter bound `D ≤ 2r + d` (QB section)

The notes' route: from the primitive-idempotent basis `E₀,…,E_D` of the Bose–Mesner
algebra, every `E_i` is a Lagrange polynomial in `A`, hence lies in `T(x)` and has
*constant, nonvanishing* diagonal.  For a thin irreducible module `W` with endpoint `r`
and diameter `d` one proves `#{i | E_iW = 0} ≤ 2r` by projecting a vector
`0 ≠ w ∈ E*_r(x)W` onto the trivial module at a vertex `y` with `w y ≠ 0`: the projection
is `p(A)ŷ` with `natDegree p ≤ 2r`, and pairing the resulting identity with `E_i` shows
`E_i w = 0 ⇒ p(θ_i) = 0`.  Since `W = ⊕_j E*_j(x)W` with `d+1` nonzero one-dimensional
summands, `#{i | E_iW ≠ 0} ≤ d+1`, whence `D + 1 ≤ 2r + d + 1`.

`basic_data_diam_bound` below is the wave-3 *repaired* interface (finding f8: `D` must
be the attained diameter, hence the extra hypothesis `hDex : ∃ a b : X, G.dist a b = D`;
without it the statement is refuted by `H(2,2)` with `D := 3` and the trivial module),
proved from QA's `drg_idempotent_basis`.  The later lemmas
(`basic_data_diam_bound_of_eigFinset`, `qb_eigFinset_card_eq`,
`basic_data_diam_bound_of_diam`) reprove the same bound from `Spectral.lean`'s spectral
projections alone, with no input from QA's section.
-/


/-! # QB chunk 1: the primitive idempotents of the Bose–Mesner algebra
Given QA's interface `drg_idempotent_basis`, every idempotent `E i` is a polynomial in
`A` (Lagrange), hence lies in the Bose–Mesner algebra, in `T(x)`, and has constant
nonzero diagonal. -/

/-- `A^k = ∑ᵢ θᵢ^k Eᵢ` in the primitive-idempotent basis. -/
theorem qb_adj_pow_eq_sum {G : SimpleGraph X} {ι : Type*} [Fintype ι] [DecidableEq ι] {E : ι → Matrix X X ℂ}
    {θ : ι → ℂ}
    (hA : ∀ i, adj (𝕜 := ℂ) G * E i = (θ i) • E i)
    (hsum : ∑ i, E i = 1) (k : ℕ) :
    adj (𝕜 := ℂ) G ^ k = ∑ i, (θ i ^ k) • E i := by
  induction k with
  | zero =>
      rw [pow_zero]
      simp only [pow_zero, one_smul]
      exact hsum.symm
  | succ k ih =>
      rw [pow_succ', ih, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Matrix.mul_smul, hA i, smul_smul, pow_succ]

/-- `p(A) = ∑ᵢ p(θᵢ) Eᵢ`. -/
theorem qb_aeval_eq_sum {G : SimpleGraph X} {ι : Type*} [Fintype ι] [DecidableEq ι] {E : ι → Matrix X X ℂ}
    {θ : ι → ℂ}
    (hA : ∀ i, adj (𝕜 := ℂ) G * E i = (θ i) • E i)
    (hsum : ∑ i, E i = 1) (p : Polynomial ℂ) :
    (Polynomial.aeval (R := ℂ) (adj (𝕜 := ℂ) G)) p = ∑ i, (p.eval (θ i)) • E i := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      rw [map_add, hp, hq, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by rw [Polynomial.eval_add, add_smul]
  | monomial n a =>
      rw [Polynomial.aeval_monomial, Algebra.algebraMap_eq_smul_one, Matrix.smul_mul, one_mul,
        qb_adj_pow_eq_sum hA hsum n, Finset.smul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [smul_smul, Polynomial.eval_monomial]

/-- `p(A) v = ∑ᵢ p(θᵢ) • (Eᵢ v)`. -/
theorem qb_aeval_mulVec {G : SimpleGraph X} {ι : Type*} [Fintype ι] [DecidableEq ι] {E : ι → Matrix X X ℂ}
    {θ : ι → ℂ}
    (hA : ∀ i, adj (𝕜 := ℂ) G * E i = (θ i) • E i)
    (hsum : ∑ i, E i = 1) (p : Polynomial ℂ) (v : X → ℂ) :
    (Polynomial.aeval (R := ℂ) (adj (𝕜 := ℂ) G)) p *ᵥ v
      = ∑ i, (p.eval (θ i)) • (E i *ᵥ v) := by
  rw [qb_aeval_eq_sum hA hsum p]
  rw [Matrix.sum_mulVec]
  exact Finset.sum_congr rfl fun i _ => by rw [Matrix.smul_mulVec]

/-- The Lagrange factor `∏_{j ≠ i} (λ - θⱼ)` evaluated at `θᵢ` is the full product. -/
theorem qb_lagrange_eval_self {ι : Type*} [Fintype ι] [DecidableEq ι] {θ : ι → ℂ} (i : ι) :
    (∏ j ∈ Finset.univ.erase i,
        (Polynomial.X - Polynomial.C (θ j))).eval (θ i)
      = ∏ j ∈ Finset.univ.erase i, (θ i - θ j) := by
  rw [Polynomial.eval_prod]
  exact Finset.prod_congr rfl fun j _ => by
    rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]

/-- **Lagrange (matrix form).** `(∏_{j ≠ i}(A - θⱼ)) = (∏_{j ≠ i}(θᵢ - θⱼ)) • Eᵢ`. -/
theorem qb_lagrange_aeval {G : SimpleGraph X} {ι : Type*} [Fintype ι] [DecidableEq ι] {E : ι → Matrix X X ℂ}
    {θ : ι → ℂ}
    (hA : ∀ i, adj (𝕜 := ℂ) G * E i = (θ i) • E i)
    (hsum : ∑ i, E i = 1) (i : ι) :
    (Polynomial.aeval (R := ℂ) (adj (𝕜 := ℂ) G))
        (∏ j ∈ Finset.univ.erase i, (Polynomial.X - Polynomial.C (θ j)))
      = (∏ j ∈ Finset.univ.erase i, (θ i - θ j)) • E i := by
  rw [qb_aeval_eq_sum hA hsum, Finset.sum_eq_single i]
  · rw [qb_lagrange_eval_self]
  · intro k _ hki
    have hzero : (∏ j ∈ Finset.univ.erase i,
        (Polynomial.X - Polynomial.C (θ j))).eval ((θ k : ℂ)) = 0 := by
      rw [Polynomial.eval_prod,
        Finset.prod_eq_zero (Finset.mem_erase.mpr ⟨hki, Finset.mem_univ k⟩)]
      rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self]
    rw [hzero, zero_smul]
  · intro h
    exact absurd (Finset.mem_univ i) h

/-- **Lagrange**: each primitive idempotent is a polynomial in `A`. -/
theorem qb_E_eq_aeval {G : SimpleGraph X} {ι : Type*} [Fintype ι] [DecidableEq ι] {E : ι → Matrix X X ℂ}
    {θ : ι → ℂ}
    (hA : ∀ i, adj (𝕜 := ℂ) G * E i = (θ i) • E i)
    (hsum : ∑ i, E i = 1) (hθ : Function.Injective θ) (i : ι) :
    E i = (Polynomial.aeval (R := ℂ) (adj (𝕜 := ℂ) G))
      (Polynomial.C ((∏ j ∈ Finset.univ.erase i, (θ i - θ j))⁻¹) *
        ∏ j ∈ Finset.univ.erase i, (Polynomial.X - Polynomial.C (θ j))) := by
  have hPne : (∏ j ∈ Finset.univ.erase i, (θ i - θ j)) ≠ 0 := by
    refine Finset.prod_ne_zero_iff.mpr fun j hj => ?_
    simp only [Finset.mem_erase] at hj
    intro h
    exact hj.1 (hθ (sub_eq_zero.mp h)).symm
  rw [map_mul, Polynomial.aeval_C, Algebra.algebraMap_eq_smul_one,
    qb_lagrange_aeval hA hsum i, smul_mul_smul_comm, Matrix.one_mul,
    inv_mul_cancel₀ hPne, one_smul]

/-- Each primitive idempotent lies in the Bose–Mesner algebra `M = ℂ[A]`. -/
theorem qb_E_mem_boseMesner {G : SimpleGraph X} {ι : Type*} [Fintype ι] [DecidableEq ι] {E : ι → Matrix X X ℂ}
    {θ : ι → ℂ}
    (hA : ∀ i, adj (𝕜 := ℂ) G * E i = (θ i) • E i)
    (hsum : ∑ i, E i = 1) (hθ : Function.Injective θ) (i : ι) :
    E i ∈ boseMesner (𝕜 := ℂ) G := by
  rw [qb_E_eq_aeval hA hsum hθ i, boseMesner, Algebra.adjoin_singleton_eq_range_aeval]
  exact Set.mem_range_self _

/-- Each primitive idempotent lies in the subconstituent algebra `T(x)`. -/
theorem qb_E_mem_subconstituent {G : SimpleGraph X} {ι : Type*} [Fintype ι] [DecidableEq ι] {E : ι → Matrix X X ℂ}
    {θ : ι → ℂ} (x : X)
    (hA : ∀ i, adj (𝕜 := ℂ) G * E i = (θ i) • E i)
    (hsum : ∑ i, E i = 1) (hθ : Function.Injective θ) (i : ι) :
    E i ∈ (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra :=
  boseMesner_le_subconstituentAlgebra G x (qb_E_mem_boseMesner hA hsum hθ i)

/-! # QB chunk 2: constant and nonvanishing diagonal of the primitive idempotents -/

/-- `(M *ᵥ ŷ) z = M z y`. -/
theorem qb_mulVec_single_apply {E : Matrix X X ℂ} (y z : X) :
    (E *ᵥ Pi.single y 1) z = E z y := by
  rw [mulVec, dotProduct]
  rw [Finset.sum_eq_single y]
  · simp
  · intro b _ hb
    rw [Pi.single_eq_of_ne hb, mul_zero]
  · intro h
    exact absurd (Finset.mem_univ y) h

/-- The diagonal of an element of the Bose–Mesner algebra is constant. -/
theorem qb_diag_const {G : SimpleGraph X} (hG : G.Connected) (hdr : IsDistanceRegular G)
    (hbi : IntersectionNumbersIndependent G) {D : ℕ} (hD1 : 1 ≤ D)
    (hDall : ∀ a b : X, G.dist a b ≤ D) (z₀ : X) {a : Matrix X X ℂ}
    (ha : a ∈ boseMesner (𝕜 := ℂ) G) :
    ∃ c : ℂ, ∀ z : X, a z z = c := by
  have ha' : a ∈ (boseMesner (𝕜 := ℂ) G).toSubmodule := ha
  rw [boseMesner_eq_span_distMatrix (x := z₀) hG hdr hbi D hD1 hDall] at ha'
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).mp ha'
  refine ⟨c 0, fun z => ?_⟩
  rw [← hc]
  simp only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, distMatrix_apply,
    SimpleGraph.dist_self]
  rw [Finset.sum_eq_single (0 : Fin (D + 1))]
  · norm_num
  · intro j _ hj
    rw [if_neg (fun h => hj (Fin.ext h.symm)), mul_zero]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-- A self-adjoint idempotent has `P b b = ⟨column b, column b⟩`. -/
theorem qb_idem_diag_eq_dotProduct {P : Matrix X X ℂ} (hsq : P * P = P) (hst : star P = P)
    (b : X) : P b b = star (fun z => P z b) ⬝ᵥ (fun z => P z b) := by
  have hbj : ∀ j : X, P b j = star (P j b) := by
    intro j
    have h := Matrix.star_apply P b j
    rw [hst] at h
    exact h
  conv_lhs => rw [← hsq]
  rw [Matrix.mul_apply, dotProduct]
  exact Finset.sum_congr rfl fun j _ => by
    show P b j * P j b = star (P j b) * P j b
    rw [hbj j]

/-- A nonzero self-adjoint idempotent has a nonzero diagonal entry. -/
theorem qb_idem_diag_exists_ne_zero {P : Matrix X X ℂ} (hsq : P * P = P) (hst : star P = P)
    (hne : P ≠ 0) : ∃ b : X, P b b ≠ 0 := by
  by_contra hcon
  simp only [not_exists, not_not] at hcon
  have hex : ∃ a b, P a b ≠ 0 := by
    by_contra h'
    simp only [not_exists, not_not] at h'
    exact hne (funext fun a => funext fun b => h' a b)
  obtain ⟨a, b, hab⟩ := hex
  have hd : star (fun z => P z b) ⬝ᵥ (fun z => P z b) = 0 := by
    rw [← qb_idem_diag_eq_dotProduct hsq hst b]
    exact hcon b
  have hcol : (fun z => P z b) = 0 := cr_star_dotProduct_self_eq_zero hd
  exact hab (by simpa using congrFun hcol a)

/-- `⟨P ᵥ ŷ, ŷ⟩ = P y y`. -/
theorem qb_dotProduct_mulVec_single_self {P : Matrix X X ℂ} (hst : star P = P) (y : X) :
    star (P *ᵥ Pi.single y 1) ⬝ᵥ Pi.single y 1 = P y y := by
  have h : ∀ z : X, star (P *ᵥ Pi.single y 1) z = star (P z y) := by
    intro z
    rw [Pi.star_apply, qb_mulVec_single_apply]
  rw [dotProduct]
  rw [Finset.sum_eq_single y]
  · rw [h y]
    simp only [Pi.single_eq_same, mul_one]
    have h2 := Matrix.star_apply P y y
    rw [hst] at h2
    exact h2.symm
  · intro b _ hb
    rw [Pi.single_eq_of_ne hb, mul_zero]
  · intro h
    exact absurd (Finset.mem_univ y) h

/-- `⟨P a, P b⟩ = ⟨a, P b⟩` for a self-adjoint idempotent `P`. -/
theorem qb_pair_left {P : Matrix X X ℂ} (hP : star P = P) (hsq : P * P = P) (a b : X → ℂ) :
    star (P *ᵥ a) ⬝ᵥ (P *ᵥ b) = star a ⬝ᵥ (P *ᵥ b) := by
  rw [selfAdj_star_dotProduct hP, Matrix.mulVec_mulVec, hsq]

/-- `⟨P v, P v⟩ = ⟨P v, v⟩` for a self-adjoint idempotent `P`. -/
theorem qb_pair_idem_eq {P : Matrix X X ℂ} (hP : star P = P) (hsq : P * P = P) (v : X → ℂ) :
    star (P *ᵥ v) ⬝ᵥ (P *ᵥ v) = star (P *ᵥ v) ⬝ᵥ v := by
  rw [← selfAdj_star_dotProduct hP (P *ᵥ v) v, Matrix.mulVec_mulVec, hsq]

/-- `⟨P a, Q b⟩ = 0` when `P` is self-adjoint and `P * Q = 0`. -/
theorem qb_pair_orth {P Q : Matrix X X ℂ} (hP : star P = P) (hPQ : P * Q = 0)
    (a b : X → ℂ) : star (P *ᵥ a) ⬝ᵥ (Q *ᵥ b) = 0 := by
  rw [selfAdj_star_dotProduct hP, Matrix.mulVec_mulVec, hPQ, Matrix.zero_mulVec]
  simp

/-- `⟨P a, P b⟩ = ⟨P a, b⟩` for a self-adjoint idempotent `P`. -/
theorem qb_pair_right {P : Matrix X X ℂ} (hP : star P = P) (hsq : P * P = P) (a b : X → ℂ) :
    star (P *ᵥ a) ⬝ᵥ (P *ᵥ b) = star (P *ᵥ a) ⬝ᵥ b := by
  rw [selfAdj_star_dotProduct hP, Matrix.mulVec_mulVec, hsq, ← selfAdj_star_dotProduct hP]

/-! # QB chunk 3: sphere sums and the projection polynomial

For `w ∈ E*_r(x)V` supported on the sphere of radius `r` around `x` and a vertex `y` at
distance `r` from `x` with `w y ≠ 0`, the orthogonal projection of `w` onto the trivial
module at `y` is `p(A)ŷ` for a nonzero polynomial `p` of degree `≤ 2r`. -/

/-- `E*_i(x)` applied to `u`, entrywise. -/
theorem qb_subconst_mulVec_apply (G : SimpleGraph X) (x : X) (i : ℕ) (u : X → ℂ) (z : X) :
    (subconst (𝕜 := ℂ) G x i *ᵥ u) z = if G.dist x z = i then u z else 0 := by
  rw [mulVec, dotProduct, Finset.sum_eq_single z]
  · rw [subconst_apply, if_pos rfl]
    by_cases h : G.dist x z = i <;> simp [h]
  · intro b _ hb
    rw [subconst_apply, if_neg (Ne.symm hb), zero_mul]
  · intro h
    exact absurd (Finset.mem_univ z) h

/-- A vector in `E*_i(x)W` vanishes off the `i`-sphere around `x`. -/
theorem qb_subconstImage_apply_eq_zero {G : SimpleGraph X} {x : X} {i : ℕ}
    {W : Submodule ℂ (X → ℂ)} {w : X → ℂ}
    (hw : w ∈ subconstImage (𝕜 := ℂ) G x i W) {z : X} (hz : G.dist x z ≠ i) :
    w z = 0 := by
  obtain ⟨u, -, rfl⟩ := mem_matImage.mp hw
  rw [qb_subconst_mulVec_apply, if_neg hz]

/-- The sphere sums are pairwise orthogonal, with norm squared `|S_j|`. -/
theorem qb_sphereSum_dotProduct (G : SimpleGraph X) (y : X) (j k : ℕ) :
    star (sphereSum (𝕜 := ℂ) G y j) ⬝ᵥ (sphereSum (𝕜 := ℂ) G y k)
      = if j = k then ((sphere G y j).card : ℂ) else 0 := by
  have h : ∀ z : X, star (sphereSum (𝕜 := ℂ) G y j z) * sphereSum (𝕜 := ℂ) G y k z
      = if (G.dist y z = j ∧ G.dist y z = k) then (1 : ℂ) else 0 := by
    intro z
    rw [sphereSum_apply, sphereSum_apply]
    by_cases h1 : G.dist y z = j <;> by_cases h2 : G.dist y z = k <;> simp [h1, h2]
  rw [dotProduct]
  simp only [Pi.star_apply]
  rw [Finset.sum_congr rfl fun z _ => h z, Finset.sum_boole]
  by_cases hjk : j = k
  · subst hjk
    rw [if_pos rfl]
    congr 1
    rw [show (Finset.univ.filter fun z => G.dist y z = j ∧ G.dist y z = j)
        = Finset.univ.filter fun z => G.dist y z = j from by
      rw [Finset.filter_congr_decidable]
      exact Finset.filter_congr fun z _ => ⟨fun h => h.1, fun h => ⟨h, h⟩⟩]
    rfl
  · rw [if_neg hjk]
    have hempty : (Finset.univ.filter fun z => G.dist y z = j ∧ G.dist y z = k) = ∅ := by
      rw [Finset.filter_eq_empty_iff]
      intro z _ hz
      omega
    rw [hempty]
    simp

/-- `A_j ᵥ ŷ = S_j`. -/
theorem qb_distMatrix_mulVec_single (G : SimpleGraph X) (y : X) (j : ℕ) :
    distMatrix (𝕜 := ℂ) G j *ᵥ Pi.single y 1 = sphereSum (𝕜 := ℂ) G y j := by
  funext z
  rw [qb_mulVec_single_apply, distMatrix_apply, sphereSum_apply, SimpleGraph.dist_comm]

/-! # QB chunk 4: the projection polynomial `p` of degree `≤ 2r` -/

/-- **The projection onto the trivial module at `y`.**  Let `w ∈ E*_r(x)V` (so `w` is
supported on the sphere of radius `r` around `x`) and let `y` be a vertex at distance `r`
from `x` with `w y ≠ 0`.  Then the orthogonal projection of `w` onto the trivial
`T(y)`-module is `p(A)ŷ` for a nonzero polynomial `p` with `natDegree p ≤ 2r`. -/
theorem qb_exists_proj_poly {G : SimpleGraph X} (hG : G.Connected) (hdr : IsDistanceRegular G)
    (hbi : IntersectionNumbersIndependent G) {x y : X} {W : Submodule ℂ (X → ℂ)} {r : ℕ}
    {w : X → ℂ} (hw : w ∈ subconstImage (𝕜 := ℂ) G x r W) (hxy : G.dist x y = r)
    (hwy : w y ≠ 0) :
    ∃ p : Polynomial ℂ, p ≠ 0 ∧ p.natDegree ≤ 2 * r ∧
      (∀ u ∈ trivialModule (𝕜 := ℂ) G y,
        star u ⬝ᵥ (w - (Polynomial.aeval (R := ℂ) (adj (𝕜 := ℂ) G)) p *ᵥ Pi.single y 1) = 0) := by
  classical
  set S : ℕ → (X → ℂ) := fun j => sphereSum (𝕜 := ℂ) G y j with hSdef
  have hSorth : ∀ j k : ℕ, star (S j) ⬝ᵥ S k
      = if j = k then ((sphere G y j).card : ℂ) else 0 :=
    fun j k => qb_sphereSum_dotProduct G y j k
  have hS0 : S 0 = (Pi.single y (1 : ℂ) : X → ℂ) := by
    rw [hSdef]
    exact sphereSum_zero G hG y
  have h0val : star (S 0) ⬝ᵥ w = w y := by
    rw [hS0, dotProduct]
    rw [Finset.sum_eq_single y]
    · simp
    · intro b _ hb
      simp only [Pi.single_apply, if_neg hb, Pi.star_apply, star_zero, zero_mul]
    · intro h
      exact absurd (Finset.mem_univ y) h
  set β : ℕ → ℂ := fun j => if S j = 0 then 0 else (star (S j) ⬝ᵥ w) / (star (S j) ⬝ᵥ S j)
    with hβdef
  -- the defining property of `β`
  have hβkey : ∀ j : ℕ, β j * (star (S j) ⬝ᵥ S j) = star (S j) ⬝ᵥ w := by
    intro j
    by_cases h : S j = 0
    · rw [hβdef]
      simp only [h, if_true]
      simp
    · rw [hβdef]
      simp only [h, if_false]
      exact div_mul_cancel₀ _ (fun h0 => h (star_dotProduct_self_eq_zero h0))
  -- `w` is supported on the sphere of radius `r` around `x`
  have hsuppw : ∀ z : X, w z ≠ 0 → G.dist x z = r := by
    intro z hz
    by_contra hc
    exact hz (qb_subconstImage_apply_eq_zero hw hc)
  -- `⟨S_j, w⟩ = 0` for `j > 2r`
  have hsupp : ∀ j : ℕ, 2 * r < j → star (S j) ⬝ᵥ w = 0 := by
    intro j hj
    refine star_dotProduct_disjoint fun z => ?_
    by_cases h1 : S j z = 0
    · exact Or.inl h1
    · refine Or.inr ?_
      by_contra hwz
      have hz : G.dist y z = j := by
        by_contra hc
        refine h1 ?_
        rw [hSdef]
        exact if_neg hc
      have hzx : G.dist x z = r := hsuppw z hwz
      have htri : G.dist y z ≤ G.dist y x + G.dist x z := hG.dist_triangle
      rw [SimpleGraph.dist_comm (u := y) (v := x), hxy, hzx] at htri
      omega
  -- `p(A)ŷ = ∑_{j ≤ 2r} β_j S_j`
  have hπ : (Polynomial.aeval (R := ℂ) (adj (𝕜 := ℂ) G))
        (∑ j ∈ Finset.range (2 * r + 1), Polynomial.C (β j) * distPoly G y j) *ᵥ Pi.single y 1
      = ∑ j ∈ Finset.range (2 * r + 1), β j • S j := by
    rw [map_sum, Matrix.sum_mulVec]
    refine Finset.sum_congr rfl fun j _ => ?_
    have h1 : (Polynomial.aeval (R := ℂ) (adj (𝕜 := ℂ) G)) (Polynomial.C (β j) * distPoly G y j)
        = β j • distMatrix (𝕜 := ℂ) G j := by
      rw [map_mul, Polynomial.aeval_C, Algebra.algebraMap_eq_smul_one, Matrix.smul_mul, one_mul,
        distPoly_aeval hG hdr hbi j]
    rw [h1, Matrix.smul_mulVec]
    rw [show distMatrix (𝕜 := ℂ) G j *ᵥ Pi.single y 1 = S j from by
      rw [hSdef]
      exact qb_distMatrix_mulVec_single G y j]
  -- the pairing with the building block `S_j`
  have hkey : ∀ j : ℕ, star (S j) ⬝ᵥ (∑ k ∈ Finset.range (2 * r + 1), β k • S k)
      = star (S j) ⬝ᵥ w := by
    intro j
    rw [dotProduct_sum]
    by_cases hj : j ∈ Finset.range (2 * r + 1)
    · rw [Finset.sum_eq_single j]
      · rw [dotProduct_smul, smul_eq_mul]
        exact hβkey j
      · intro k _ hkj
        rw [dotProduct_smul, smul_eq_mul, hSorth j k, if_neg (fun h : j = k => hkj h.symm),
          mul_zero]
      · intro h
        exact absurd hj h
    · rw [Finset.sum_eq_zero]
      · exact (hsupp j (by simp only [Finset.mem_range, not_lt] at hj; omega)).symm
      · intro k hk
        have hjk : j ≠ k := by
          simp only [Finset.mem_range] at hk
          simp only [Finset.mem_range, not_lt] at hj
          omega
        rw [dotProduct_smul, smul_eq_mul, hSorth j k, if_neg hjk, mul_zero]
  have hpi_ne : (∑ j ∈ Finset.range (2 * r + 1), β j • S j) ≠ 0 := by
    intro h0
    have h := hkey 0
    rw [h0, h0val] at h
    simp at h
    exact hwy h.symm
  have hpne : (∑ j ∈ Finset.range (2 * r + 1), Polynomial.C (β j) * distPoly G y j) ≠ 0 := by
    intro h0
    refine hpi_ne ?_
    rw [← hπ, h0, map_zero, Matrix.zero_mulVec]
  have hpdeg : (∑ j ∈ Finset.range (2 * r + 1),
      Polynomial.C (β j) * distPoly G y j).natDegree ≤ 2 * r := by
    refine Polynomial.natDegree_sum_le_of_forall_le (s := Finset.range (2 * r + 1))
      (n := 2 * r) (f := fun j => Polynomial.C (β j) * distPoly G y j) fun j hj => ?_
    refine le_trans (Polynomial.natDegree_C_mul_le _ _) ?_
    rw [distPoly_natDegree]
    simp only [Finset.mem_range] at hj
    omega
  refine ⟨_, hpne, hpdeg, fun u hu => ?_⟩
  have hspan : ∀ u ∈ sphereSpan (𝕜 := ℂ) G y,
      star u ⬝ᵥ (w - (∑ j ∈ Finset.range (2 * r + 1), β j • S j)) = 0 := by
    intro u hu
    induction hu using Submodule.span_induction with
    | mem v hv =>
        obtain ⟨j, rfl⟩ := hv
        show star (S j) ⬝ᵥ (w - ∑ k ∈ Finset.range (2 * r + 1), β k • S k) = 0
        rw [dotProduct_sub, hkey j, sub_self]
    | zero => simp
    | add a b _ _ ha hb => rw [star_add, add_dotProduct, ha, hb, add_zero]
    | smul c a _ ha => rw [star_smul, smul_dotProduct, ha, smul_zero]
  rw [hπ]
  exact hspan u (trivialModule_le_sphereSpan (hdr y) hG hu)

/-! # QB chunk 5: the level decomposition of a thin module, and Lemma 14.2 (iii) -/

/-- In a space of dimension `≤ 1` any two vectors are proportional. -/
theorem qb_smul_of_finrank_le_one {p : Submodule ℂ (X → ℂ)}
    (hfr : Module.finrank ℂ ↥p ≤ 1) {u v : X → ℂ} (hu : u ∈ p) (hv : v ∈ p) (hu0 : u ≠ 0) :
    ∃ c : ℂ, v = c • u := by
  have hle : Submodule.span ℂ ({u} : Set (X → ℂ)) ≤ p := by
    rw [Submodule.span_le]
    simpa using hu
  have hfr1 : Module.finrank ℂ ↥(Submodule.span ℂ ({u} : Set (X → ℂ))) = 1 :=
    finrank_span_singleton hu0
  have heq : Submodule.span ℂ ({u} : Set (X → ℂ)) = p :=
    Submodule.eq_of_le_of_finrank_le hle (by rw [hfr1]; exact hfr)
  rw [← heq] at hv
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hv
  exact ⟨a, ha.symm⟩

/-- **Lemma 14.2 (iii), abstract form**: given any family `E : Fin (D+1) → Matrix` of
pairwise orthogonal self-adjoint nonzero idempotents summing to `1`, diagonalising `A`
with distinct real eigenvalues `θ`, the diameter bound `D ≤ 2r + d` holds for every thin
irreducible `T(x)`-module.  (This is the body of `basic_data_diam_bound`, factored out so
that the family can also be instantiated by the spectral projections.) -/
theorem qb_diam_bound_of_idem {G : SimpleGraph X} (hG : G.Connected)
    (hdr : IsDistanceRegular G) (hbi : IntersectionNumbersIndependent G)
    {D : ℕ} (hD1 : 1 ≤ D) (hDall : ∀ a b : X, G.dist a b ≤ D)
    {ι : Type*} [Fintype ι] [DecidableEq ι] (_hcardι : D + 1 ≤ Fintype.card ι)
    {E : ι → Matrix X X ℂ} {θ : ι → ℂ}
    (hmul : ∀ i j, E i * E j = if i = j then E i else 0)
    (hsum : ∑ i, E i = 1) (hstar : ∀ i, star (E i) = E i)
    (hne : ∀ i, E i ≠ 0) (hA : ∀ i, adj (𝕜 := ℂ) G * E i = (θ i) • E i)
    (hθ : Function.Injective θ)
    {x : X} {W : Submodule ℂ (X → ℂ)} {r d : ℕ}
    (hstable : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hirr : IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hthin : ThinModule (𝕜 := ℂ) G x W) (hend : IsEndpoint (𝕜 := ℂ) G x W r)
    (hdiam : IsDiameter (𝕜 := ℂ) G x W r d) :
    D ≤ 2 * r + d := by
  classical
  -- ## Part 0: a nonzero vector of `W` in the `r`-th subconstituent
  obtain ⟨w, hw, hwne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hend.1
  have hsuppw : ∀ z : X, w z ≠ 0 → G.dist x z = r := by
    intro z hz
    by_contra hc
    exact hz (qb_subconstImage_apply_eq_zero hw hc)
  obtain ⟨y, hy⟩ : ∃ y : X, w y ≠ 0 := by
    by_contra h
    simp only [not_exists, not_ne_iff] at h
    exact hwne (funext h)
  have hxy : G.dist x y = r := hsuppw y hy
  have hwW : w ∈ W := by
    obtain ⟨v, hv, rfl⟩ := mem_matImage.mp hw
    exact hstable _ (subconst_mem_subconstituentAlgebra G x r) v hv
  -- ## Part 1: the primitive idempotents lie in `T(x)`, preserve `W`, have constant
  -- and nonvanishing diagonal
  have hEmem : ∀ i, E i ∈ (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra :=
    fun i => qb_E_mem_subconstituent x hA hsum hθ i
  have hEW : ∀ i, ∀ v ∈ W, E i *ᵥ v ∈ W :=
    fun i v hv => hstable _ (hEmem i) v hv
  have hdiag : ∀ i, ∃ c : ℂ, ∀ z : X, E i z z = c := fun i =>
    qb_diag_const hG hdr hbi hD1 hDall y (qb_E_mem_boseMesner hA hsum hθ i)
  have hdiagne : ∀ i, E i y y ≠ 0 := by
    intro i
    obtain ⟨c, hc⟩ := hdiag i
    rw [hc y]
    refine fun h0 => ?_
    obtain ⟨b, hb⟩ := qb_idem_diag_exists_ne_zero (by simpa using hmul i i) (hstar i) (hne i)
    rw [hc b] at hb
    exact hb h0
  -- ## Part 2: the level decomposition of `W`
  have hrd : r + d ≤ D := by
    by_contra hc
    have h1 := hdiam.1 (r + d) (le_add_right le_rfl) (le_refl (r + d))
    obtain ⟨v, hv, hvne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot h1
    obtain ⟨t, -, rfl⟩ := mem_matImage.mp hv
    refine hvne (funext fun z => ?_)
    rw [qb_subconst_mulVec_apply, if_neg (by have := hDall x z; omega)]
    rfl
  have hWdecomp : ∀ v ∈ W, v = ∑ j ∈ Finset.Icc r (r + d),
      subconst (𝕜 := ℂ) G x j *ᵥ v := by
    intro v hv
    have h1 : v = ∑ j ∈ Finset.range (D + 1), subconst (𝕜 := ℂ) G x j *ᵥ v := by
      calc v = (1 : Matrix X X ℂ) *ᵥ v := (Matrix.one_mulVec v).symm
        _ = (∑ j ∈ Finset.range (D + 1), subconst (𝕜 := ℂ) G x j) *ᵥ v := by
            rw [sum_subconst_eq_one G x D (fun y => hDall x y)]
        _ = ∑ j ∈ Finset.range (D + 1), subconst (𝕜 := ℂ) G x j *ᵥ v :=
            Matrix.sum_mulVec (Finset.range (D + 1))
              (fun j => subconst (𝕜 := ℂ) G x j) v
    refine h1.trans ?_
    refine (Finset.sum_subset ?_ ?_).symm
    · intro j hj
      simp only [Finset.mem_Icc] at hj
      simp only [Finset.mem_range]
      omega
    · intro j hj1 hj2
      have hbot : subconstImage (𝕜 := ℂ) G x j W = ⊥ := by
        by_contra hcon
        obtain ⟨h1, h2⟩ := hdiam.2 j hcon
        exact hj2 (Finset.mem_Icc.mpr ⟨h1, h2⟩)
      have hmem : subconst (𝕜 := ℂ) G x j *ᵥ v ∈ subconstImage (𝕜 := ℂ) G x j W :=
        ⟨v, hv, rfl⟩
      rw [hbot] at hmem
      exact hmem
  -- the level submodules and a chosen nonzero vector on each level
  have hex : ∀ j : ℕ, j ∈ Finset.Icc r (r + d) →
      ∃ u : X → ℂ, u ∈ subconstImage (𝕜 := ℂ) G x j W ∧ u ≠ 0 := by
    intro j hj
    obtain ⟨h1, h2⟩ := Finset.mem_Icc.mp hj
    obtain ⟨u, hu, hu0⟩ :=
      Submodule.exists_mem_ne_zero_of_ne_bot (hdiam.1 j h1 h2)
    exact ⟨u, hu, hu0⟩
  set u : ℕ → (X → ℂ) := fun j =>
    if h : j ∈ Finset.Icc r (r + d) then Classical.choose (hex j h) else 0 with hudef
  have humem : ∀ j (hj : j ∈ Finset.Icc r (r + d)),
      u j ∈ subconstImage (𝕜 := ℂ) G x j W := by
    intro j hj
    rw [hudef]
    simp only [hj, dif_pos]
    exact (Classical.choose_spec (hex j hj)).1
  have hune : ∀ j (hj : j ∈ Finset.Icc r (r + d)), u j ≠ 0 := by
    intro j hj
    rw [hudef]
    simp only [hj, dif_pos]
    exact (Classical.choose_spec (hex j hj)).2
  have huorth : ∀ j k, j ∈ Finset.Icc r (r + d) → k ∈ Finset.Icc r (r + d) →
      j ≠ k → star (u j) ⬝ᵥ u k = 0 := by
    intro j k hj hk hjk
    exact star_dotProduct_subconstImage_zero hjk (humem j hj) (humem k hk)
  -- every element of `W` is a combination of the chosen level vectors
  have hspanu : ∀ v ∈ W, ∃ c : ℕ → ℂ,
      v = ∑ j ∈ Finset.Icc r (r + d), c j • u j := by
    intro v hv
    have hexc : ∀ j : ℕ, ∃ c : ℂ, j ∈ Finset.Icc r (r + d) →
        subconst (𝕜 := ℂ) G x j *ᵥ v = c • u j := by
      intro j
      by_cases hj : j ∈ Finset.Icc r (r + d)
      · obtain ⟨c, hc⟩ :=
          qb_smul_of_finrank_le_one (hthin j) (humem j hj) ⟨v, hv, rfl⟩ (hune j hj)
        exact ⟨c, fun _ => hc⟩
      · exact ⟨0, fun h => absurd h hj⟩
    choose cc hcc using hexc
    exact ⟨cc, by rw [hWdecomp v hv]; exact Finset.sum_congr rfl fun j hj => hcc j hj⟩
  -- ## Part 3: `W` is spanned by the level vectors, and a vector orthogonal to all
  -- of them vanishes
  have hWsuff : ∀ v ∈ W, (∀ j ∈ Finset.Icc r (r + d), star (u j) ⬝ᵥ v = 0) → v = 0 := by
    intro v hv h
    obtain ⟨c, hc⟩ := hspanu v hv
    have hz : star v ⬝ᵥ v = 0 := by
      rw [show star v ⬝ᵥ v = star v ⬝ᵥ (∑ j ∈ Finset.Icc r (r + d), c j • u j) from
        congrArg (fun z => star v ⬝ᵥ z) hc, dotProduct_sum]
      refine Finset.sum_eq_zero fun j hj => ?_
      rw [dotProduct_smul, smul_eq_mul]
      have h2 : star v ⬝ᵥ u j = 0 := by
        have h3 := h j hj
        rw [← star_dotProduct_symm v (u j)] at h3
        exact star_eq_zero.mp h3
      rw [h2, mul_zero]
    exact star_dotProduct_self_eq_zero hz
  -- ## Part 4: the upper bound `dim W ≤ d + 1`
  have hfin : Module.finrank ℂ ↥W ≤ d + 1 := by
    let Ψ : ↥W →ₗ[ℂ] (↥(Finset.Icc r (r + d)) → ℂ) :=
      { toFun := fun v j =>
          (star (u (j : ℕ)) ⬝ᵥ (v : X → ℂ)) / (star (u (j : ℕ)) ⬝ᵥ u (j : ℕ))
        map_add' := by
          intro a b
          funext j
          simp only [Submodule.coe_add, Pi.add_apply, dotProduct_add, add_div]
        map_smul' := by
          intro c a
          funext j
          simp only [Submodule.coe_smul, Pi.smul_apply, dotProduct_smul, smul_eq_mul,
            RingHom.id_apply, mul_div_assoc] }
    have hinj : Function.Injective Ψ := by
      intro v₁ v₂ h
      have hv : ((v₁ : X → ℂ) - (v₂ : X → ℂ)) ∈ W := Submodule.sub_mem W v₁.2 v₂.2
      have hz : ∀ j ∈ Finset.Icc r (r + d),
          star (u j) ⬝ᵥ ((v₁ : X → ℂ) - (v₂ : X → ℂ)) = 0 := by
        intro j hj
        have h1 : Ψ v₁ ⟨j, hj⟩ = Ψ v₂ ⟨j, hj⟩ := congrFun h ⟨j, hj⟩
        simp only [Ψ, LinearMap.coe_mk, AddHom.coe_mk] at h1
        have hne1 : (star (u j) ⬝ᵥ u j) ≠ 0 :=
          fun h0 => hune j hj (star_dotProduct_self_eq_zero h0)
        have h3 : star (u j) ⬝ᵥ (v₁ : X → ℂ) = star (u j) ⬝ᵥ (v₂ : X → ℂ) :=
          mul_right_cancel₀ (inv_ne_zero hne1) h1
        rw [dotProduct_sub, h3, sub_self]
      have hsub : ((v₁ : X → ℂ) - (v₂ : X → ℂ)) = 0 := hWsuff _ hv hz
      exact Subtype.ext (sub_eq_zero.mp hsub)
    have h1 := LinearMap.finrank_le_finrank_of_injective (f := Ψ) hinj
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_coe, Nat.card_Icc] at h1
    omega
  -- ## Part 5: the projection polynomial of `w` onto the trivial module at `y`
  obtain ⟨p, hpne, hpdeg, hproj⟩ := qb_exists_proj_poly hG hdr hbi hw hxy hy
  -- ## Part 6: the projection of `ŷ` onto `W`
  set c₀ : ℂ := (star w ⬝ᵥ (Pi.single y (1 : ℂ) : X → ℂ)) / (star w ⬝ᵥ w) with hc₀
  have hw0 : star w ⬝ᵥ ((Pi.single y (1 : ℂ) : X → ℂ) - c₀ • w) = 0 := by
    have h2 : star w ⬝ᵥ w ≠ 0 := fun h => hwne (star_dotProduct_self_eq_zero h)
    rw [dotProduct_sub, dotProduct_smul, smul_eq_mul, hc₀, div_mul_cancel₀ _ h2, sub_self]
  have hWproj : ∀ v ∈ W, star v ⬝ᵥ ((Pi.single y (1 : ℂ) : X → ℂ) - c₀ • w) = 0 := by
    have hb : ∀ j (hj : j ∈ Finset.Icc r (r + d)),
        star (u j) ⬝ᵥ ((Pi.single y (1 : ℂ) : X → ℂ) - c₀ • w) = 0 := by
      intro j hj
      by_cases hjr : j = r
      · -- the `r`-level contains `w`
        rw [hjr] at hj ⊢
        have hspan1 : u r ∈ subconstImage (𝕜 := ℂ) G x r W := humem r hj
        obtain ⟨cc, hcc⟩ := qb_smul_of_finrank_le_one (hthin r) hw hspan1 hwne
        calc star (u r) ⬝ᵥ ((Pi.single y (1 : ℂ) : X → ℂ) - c₀ • w)
            = star (cc • w) ⬝ᵥ ((Pi.single y (1 : ℂ) : X → ℂ) - c₀ • w) := by rw [hcc]
          _ = star cc • star w ⬝ᵥ ((Pi.single y (1 : ℂ) : X → ℂ) - c₀ • w) := by rw [star_smul]
          _ = star cc • (star w ⬝ᵥ ((Pi.single y (1 : ℂ) : X → ℂ) - c₀ • w)) := by
              rw [smul_dotProduct]
          _ = 0 := by rw [hw0, smul_zero]
      · -- higher levels vanish at `y`
        have hjy : u j y = 0 := by
          refine qb_subconstImage_apply_eq_zero (humem j hj) ?_
          have h1 := Finset.mem_Icc.mp hj
          omega
        have horth : star (u j) ⬝ᵥ w = 0 := by
          refine star_dotProduct_subconstImage_zero (W := W) (W' := W) (i := j) (j := r)
            (by omega) (humem j hj) hw
        rw [dotProduct_sub, dotProduct_smul, smul_eq_mul, horth, mul_zero, sub_zero,
          dotProduct, Finset.sum_eq_single y]
        · simp only [Pi.single_eq_same, mul_one, Pi.star_apply, hjy, star_zero, mul_zero]
        · intro b _ hb
          simp only [Pi.single_apply, if_neg hb, mul_zero]
        · intro h
          exact absurd (Finset.mem_univ y) h
    intro v hv
    obtain ⟨c, hc⟩ := hspanu v hv
    rw [hc, star_sum, sum_dotProduct]
    exact Finset.sum_eq_zero fun j hj => by
      rw [star_smul, smul_dotProduct, hb j hj, smul_zero]
  -- ## Part 7: the two-ways identity
  have hident : ∀ i,
      (star (p.eval (θ i))) * (E i y y) = c₀ * (star (E i *ᵥ w) ⬝ᵥ (E i *ᵥ w)) := by
    intro i
    have hPself : star (E i) = E i := hstar i
    have hPsq : E i * E i = E i := by simpa using hmul i i
    set u : X → ℂ := (Pi.single y (1 : ℂ) : X → ℂ) with hu
    have hu_triv : E i *ᵥ u ∈ trivialModule (𝕜 := ℂ) G y :=
      isStable_trivialModule G y (E i) (qb_E_mem_subconstituent y hA hsum hθ i)
        u (Submodule.subset_span ⟨1, Subalgebra.one_mem _, Matrix.one_mulVec u⟩)
    -- (a) the trivial-module side: `⟨E_i u, w⟩ = p(θ_i) ⟨E_i u, u⟩`
    have ha1 : star (E i *ᵥ u) ⬝ᵥ w = (p.eval (θ i)) * (star (E i *ᵥ u) ⬝ᵥ u) := by
      have h1 : star (E i *ᵥ u) ⬝ᵥ w
          = star (E i *ᵥ u) ⬝ᵥ ((Polynomial.aeval (R := ℂ) (adj (𝕜 := ℂ) G)) p *ᵥ u) := by
        have h := hproj (E i *ᵥ u) hu_triv
        rw [dotProduct_sub, sub_eq_zero] at h
        exact h
      rw [h1, qb_aeval_mulVec hA hsum p, dotProduct_sum, Finset.sum_eq_single i]
      · rw [dotProduct_smul, smul_eq_mul, qb_pair_idem_eq hPself hPsq u]
      · intro k _ hki
        rw [dotProduct_smul, smul_eq_mul,
          qb_pair_orth hPself (by rw [hmul i k, if_neg (fun h : i = k => hki h.symm)]) u u,
          mul_zero]
      · intro h
        exact absurd (Finset.mem_univ i) h
    -- (b) `⟨E_i w, E_i u⟩ = conj(p(θ_i)) (E_i)_{yy}`
    have ha2 : star (E i *ᵥ w) ⬝ᵥ (E i *ᵥ u) = (star (p.eval (θ i))) * (E i y y) := by
      have h4 : star (star (E i *ᵥ u) ⬝ᵥ u) = E i y y := by
        rw [hu, qb_dotProduct_mulVec_single_self hPself y]
        have h := Matrix.star_apply (E i) y y
        rw [hPself] at h
        exact h.symm
      rw [qb_pair_left hPself hPsq w u,
        ← star_dotProduct_symm (E i *ᵥ u) w, ha1, star_mul, h4, mul_comm]
    -- (c) the `W`-side
    have hb1 : star (E i *ᵥ w) ⬝ᵥ (E i *ᵥ u) = c₀ * (star (E i *ᵥ w) ⬝ᵥ (E i *ᵥ w)) := by
      have h1 : star (E i *ᵥ w) ⬝ᵥ u = c₀ * (star (E i *ᵥ w) ⬝ᵥ w) := by
        have h := hWproj (E i *ᵥ w) (hEW i w hwW)
        rw [dotProduct_sub, dotProduct_smul, smul_eq_mul, sub_eq_zero] at h
        exact h
      rw [qb_pair_right hPself hPsq w u, h1, qb_pair_idem_eq hPself hPsq w]
    exact ha2.symm.trans hb1
  -- ## Part 8: root counting and the final count
  have hzero : ∀ i, E i *ᵥ w = 0 → p.eval (θ i) = 0 := by
    intro i hi
    have h := hident i
    rw [hi] at h
    rw [dotProduct_zero, mul_zero] at h
    rcases mul_eq_zero.mp h with h1 | h1
    · exact star_eq_zero.mp h1
    · exact absurd h1 (hdiagne i)
  have hroots : (Finset.univ.filter fun i => p.eval (θ i) = 0).card ≤ 2 * r := by
    set Z := Finset.univ.filter (fun i => p.eval (θ i) = 0) with hZ
    have hsub : Z.image θ ⊆ p.roots.toFinset := by
      intro a ha
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp ha
      rw [hZ] at hi
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hpne, Polynomial.IsRoot.def]
      exact hi
    calc Z.card = (Z.image θ).card := (Finset.card_image_of_injective _ hθ).symm
      _ ≤ p.roots.toFinset.card := Finset.card_le_card hsub
      _ ≤ p.roots.card := Multiset.toFinset_card_le _
      _ ≤ p.natDegree := Polynomial.card_roots' p
      _ ≤ 2 * r := hpdeg
  -- the number of `i` with `E_i W ≠ ⊥` is at most `d + 1`
  set s : Finset ι := Finset.univ.filter (fun i => ∃ v ∈ W, E i *ᵥ v ≠ 0) with hs
  have hscard : s.card ≤ d + 1 := by
    have hex2 : ∀ i ∈ s, ∃ v ∈ W, E i *ᵥ v ≠ 0 := fun i hi =>
      (Finset.mem_filter.mp hi).2
    let vv : {i // i ∈ s} → ↥W := fun i =>
      ⟨E i.1 *ᵥ Classical.choose (hex2 i.1 i.2),
        hEW i.1 _ (Classical.choose_spec (hex2 i.1 i.2)).1⟩
    have hvvne : ∀ i : {i // i ∈ s}, (vv i : X → ℂ) ≠ 0 := fun i =>
      (Classical.choose_spec (hex2 i.1 i.2)).2
    have hvvorth : ∀ i j : {i // i ∈ s}, i ≠ j →
        star ((vv i : ↥W) : X → ℂ) ⬝ᵥ ((vv j : ↥W) : X → ℂ) = 0 := by
      intro i j hij
      have h1 : star (E (i.1) *ᵥ Classical.choose (hex2 i.1 i.2)) ⬝ᵥ
          (E (j.1) *ᵥ Classical.choose (hex2 j.1 j.2)) = 0 := by
        rw [selfAdj_star_dotProduct (hstar i.1), Matrix.mulVec_mulVec, hmul i.1 j.1,
          if_neg (fun h => hij (Subtype.ext h)), Matrix.zero_mulVec]
        simp
      exact h1
    have hLI : LinearIndependent ℂ vv := by
      rw [Fintype.linearIndependent_iff]
      intro g hg i
      have h0 : star ((vv i : ↥W) : X → ℂ) ⬝ᵥ
          ((∑ j, g j • vv j : ↥W) : X → ℂ) = 0 := by rw [hg]; simp
      rw [Submodule.coe_sum, dotProduct_sum] at h0
      rw [Finset.sum_congr rfl (fun j _ => by
        rw [Submodule.coe_smul, dotProduct_smul, smul_eq_mul]), Finset.sum_eq_single i] at h0
      · rcases mul_eq_zero.mp h0 with h1 | h1
        · exact h1
        · exact absurd h1 (fun h2 => hvvne i (star_dotProduct_self_eq_zero h2))
      · intro j _ hji
        rw [hvvorth i j (Ne.symm hji), mul_zero]
      · intro h
        exact absurd (Finset.mem_univ i) h
    have h3 := hLI.fintype_card_le_finrank
    rw [Fintype.card_coe] at h3
    exact le_trans h3 hfin
  -- the complement of `s` is contained in the root set
  have hcompl : (Finset.univ.filter fun i =>
        ¬ (∃ v ∈ W, E i *ᵥ v ≠ 0)).card
      ≤ (Finset.univ.filter fun i => p.eval (θ i) = 0).card := by
    apply Finset.card_le_card
    intro i hi
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi ⊢
    by_contra hcon
    exact hi ⟨w, hwW, fun h0 => hcon (hzero i h0)⟩
  have hsplit : (Finset.univ : Finset ι).card
      = s.card + (Finset.univ.filter fun i =>
          ¬ (∃ v ∈ W, E i *ᵥ v ≠ 0)).card := by
    have h1 := Finset.card_filter_add_card_filter_not
      (s := (Finset.univ : Finset ι))
      (p := fun i => ∃ v ∈ W, E i *ᵥ v ≠ 0)
    rw [← hs] at h1
    exact h1.symm
  have hfin2 : (Finset.univ : Finset ι).card = Fintype.card ι := Finset.card_univ
  omega

/-- **Lemma 14.2 (iii)**: `D ≤ 2r + d` for a thin irreducible `T(x)`-module of a
distance-regular graph, from the primitive-idempotent basis of the Bose–Mesner algebra.
Repaired in wave 3 (finding f8): `D` is pinned to the true diameter by `hDex`. -/
theorem basic_data_diam_bound {G : SimpleGraph X} (hG : G.Connected)
    (hdr : IsDistanceRegular G) (hbi : IntersectionNumbersIndependent G)
    {D : ℕ} (hD1 : 1 ≤ D) (hDall : ∀ a b : X, G.dist a b ≤ D)
    (hDex : ∃ a b : X, G.dist a b = D)
    {x : X} {W : Submodule ℂ (X → ℂ)} {r d : ℕ}
    (hstable : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hirr : IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hthin : ThinModule (𝕜 := ℂ) G x W) (hend : IsEndpoint (𝕜 := ℂ) G x W r)
    (hdiam : IsDiameter (𝕜 := ℂ) G x W r d) :
    D ≤ 2 * r + d := by
  classical
  obtain ⟨E, θ, hmul, hsum, hstar, hne, hA, hθ, -⟩ :=
    drg_idempotent_basis hG hdr hbi hD1 hDall hDex
  refine qb_diam_bound_of_idem hG hdr hbi hD1 hDall
    (ι := Fin (D + 1)) (by simp)
    (E := E) (θ := fun i => ((θ i : ℝ) : ℂ)) hmul hsum hstar hne
    hA
    (fun i j h => hθ (Complex.ofReal_inj.mp h)) hstable hirr hthin hend hdiam

/-! # QB chunk 6: the diameter bound from the spectral projections (no Bose–Mesner input)

`basic_data_diam_bound` consumes QA's primitive-idempotent basis `drg_idempotent_basis`.
The same argument runs with `Spectral.lean`'s spectral projections `spectralProj A θ`
of the eigenvalues of `A`, which the library already provides: the only extra input is
the DRG fact that the number of distinct eigenvalues is `D + 1` (the notes'
"dim-diameter" proposition), recorded here as the hypothesis `hEig`. -/

/-- `A^k = ∑_θ θ^k E_θ` for the spectral projections. -/
theorem qb_spec_pow_eq_sum {A : Matrix X X ℂ} (hA : star A = A) (k : ℕ) :
    A ^ k = ∑ θ ∈ eigFinset A, (θ ^ k) • spectralProj A θ := by
  induction k with
  | zero =>
      rw [pow_zero]
      simp only [pow_zero, one_smul]
      exact (sum_spectralProj hA).symm
  | succ k ih =>
      rw [pow_succ', ih, Finset.mul_sum]
      refine Finset.sum_congr rfl fun θ hθ => ?_
      rw [Matrix.mul_smul, adj_mul_spectralProj hA hθ, smul_smul, pow_succ]

/-- The spectral projection of a genuine eigenvalue is nonzero. -/
theorem qb_spectralProj_ne_zero {A : Matrix X X ℂ} (hA : star A = A) {θ : ℂ}
    (hθ : θ ∈ eigFinset A) : spectralProj A θ ≠ 0 := by
  intro h0
  obtain ⟨v, hvne, hAv⟩ := (isEigenvalue_iff_mem_eigFinset hA).mpr hθ
  have h1 := spectralProj_mulVec_eigenvector hA hθ hvne hAv
  rw [h0, Matrix.zero_mulVec] at h1
  exact hvne h1.symm

/-- **Lemma 14.2 (iii)**, from the spectral projections of `A`: no primitive-idempotent
basis is needed, but the number of distinct eigenvalues of `Γ` must be exactly `D + 1`
(the notes' "dim-diameter" proposition; true for a distance-regular graph whose
diameter is `D`). -/
theorem basic_data_diam_bound_of_eigFinset {G : SimpleGraph X} (hG : G.Connected)
    (hdr : IsDistanceRegular G) (hbi : IntersectionNumbersIndependent G)
    {D : ℕ} (hD1 : 1 ≤ D) (hDall : ∀ a b : X, G.dist a b ≤ D)
    (hEig : (eigFinset (adj (𝕜 := ℂ) G)).card = D + 1)
    {x : X} {W : Submodule ℂ (X → ℂ)} {r d : ℕ}
    (hstable : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hirr : IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hthin : ThinModule (𝕜 := ℂ) G x W) (hend : IsEndpoint (𝕜 := ℂ) G x W r)
    (hdiam : IsDiameter (𝕜 := ℂ) G x W r d) :
    D ≤ 2 * r + d := by
  have hAdj : star (adj (𝕜 := ℂ) G) = adj (𝕜 := ℂ) G := star_adj G
  refine qb_diam_bound_of_idem (G := G) hG hdr hbi hD1 hDall
    (ι := ↥(eigFinset (adj (𝕜 := ℂ) G)))
    (E := fun θ => spectralProj (adj (𝕜 := ℂ) G) (θ : ℂ))
    (θ := fun θ => ((θ : ℂ)))
    ?_ ?_ ?_ ?_ ?_ ?_ ?_ hstable hirr hthin hend hdiam
  · -- the index type has at least `D + 1` elements
    rw [Fintype.card_coe, hEig]
  · -- orthogonality
    intro i j
    by_cases h : i = j
    · subst h
      rw [if_pos rfl, spectralProj_mul_self hAdj i.2]
    · rw [if_neg h, spectralProj_mul_of_ne hAdj (fun hh => h (Subtype.ext hh))]
  · -- completeness
    rw [Finset.sum_coe_sort]
    exact sum_spectralProj hAdj
  · -- self-adjointness
    intro i
    exact star_spectralProj hAdj i.2
  · -- nonvanishing
    intro i
    exact qb_spectralProj_ne_zero hAdj i.2
  · -- eigenvector relation
    intro i
    exact adj_mul_spectralProj hAdj i.2
  · -- distinctness
    intro i j h
    exact Subtype.ext h

/-! # QB chunk 7: the number of distinct eigenvalues is `D + 1`

The notes' "dim-diameter" proposition for a distance-regular graph of diameter exactly
`D`: the Bose–Mesner algebra has dimension `D+1` (the distance matrices are linearly
independent, and they span it), and it is also the span of the spectral projections of
`A`, one per distinct eigenvalue.  This removes the need for any primitive-idempotent
*existence* input: `basic_data_diam_bound_of_diam` below is stub-free. -/

/-- `p(A) = ∑_θ p(θ) E_θ` for the spectral projections. -/
theorem qb_aeval_eq_sum_spec {A : Matrix X X ℂ} (hA : star A = A) (q : Polynomial ℂ) :
    (Polynomial.aeval (R := ℂ) A) q = ∑ θ ∈ eigFinset A, (q.eval θ) • spectralProj A θ := by
  induction q using Polynomial.induction_on' with
  | add p q hp hq =>
      rw [map_add, hp, hq, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by rw [Polynomial.eval_add, add_smul]
  | monomial n a =>
      rw [Polynomial.aeval_monomial, Algebra.algebraMap_eq_smul_one, Matrix.smul_mul, one_mul,
        qb_spec_pow_eq_sum hA n, Finset.smul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [smul_smul, Polynomial.eval_monomial]

/-- The distance matrices `A_0, …, A_D` are linearly independent when every radius
`≤ D` is realised around a fixed vertex. -/
theorem qb_distMatrix_linearIndependent {G : SimpleGraph X} {y : X} {D : ℕ}
    (hDex : ∀ i : ℕ, i ≤ D → ∃ z : X, G.dist y z = i) :
    LinearIndependent ℂ (fun i : Fin (D + 1) => distMatrix (𝕜 := ℂ) G (i : ℕ)) := by
  rw [Fintype.linearIndependent_iff]
  intro c hc i
  obtain ⟨z, hz⟩ := hDex (i : ℕ) (by have := i.2; omega)
  have h1 : (∑ j : Fin (D + 1), c j • distMatrix (𝕜 := ℂ) G (j : ℕ)) z y = 0 := by
    rw [hc]
    rfl
  rw [Matrix.sum_apply, Finset.sum_eq_single i] at h1
  · rw [Matrix.smul_apply, smul_eq_mul, distMatrix_apply,
      if_pos (by rw [SimpleGraph.dist_comm]; exact hz), mul_one] at h1
    exact h1
  · intro j _ hji
    rw [Matrix.smul_apply, smul_eq_mul, distMatrix_apply,
      if_neg (fun h => hji (Fin.ext (by rw [← hz, SimpleGraph.dist_comm, h]))), mul_zero]
  · intro h
    exact absurd (Finset.mem_univ i) h

/-- **dim-diameter**: for a distance-regular graph with `D + 1` distinct eigenvalues
counted against the exact diameter, the number of distinct eigenvalues is `D + 1`. -/
theorem qb_eigFinset_card_eq {G : SimpleGraph X} (hG : G.Connected)
    (hdr : IsDistanceRegular G) (hbi : IntersectionNumbersIndependent G)
    {D : ℕ} (hD1 : 1 ≤ D) (hDall : ∀ a b : X, G.dist a b ≤ D) {y : X}
    (hDex : ∀ i : ℕ, i ≤ D → ∃ z : X, G.dist y z = i) :
    (eigFinset (adj (𝕜 := ℂ) G)).card = D + 1 := by
  have hAdj : star (adj (𝕜 := ℂ) G) = adj (𝕜 := ℂ) G := star_adj G
  -- the distance matrices span the Bose–Mesner algebra, and are independent
  have hfr : Module.finrank ℂ ↥(boseMesner (𝕜 := ℂ) G).toSubmodule = D + 1 := by
    rw [boseMesner_eq_span_distMatrix (x := y) hG hdr hbi D hD1 hDall,
      finrank_span_eq_card (qb_distMatrix_linearIndependent hDex)]
    simp
  -- the spectral projections are independent
  have hLI : LinearIndependent ℂ (fun θ : ↥(eigFinset (adj (𝕜 := ℂ) G)) =>
      spectralProj (adj (𝕜 := ℂ) G) (θ : ℂ)) := by
    rw [Fintype.linearIndependent_iff]
    intro g hg i
    have h1 : (∑ j, g j • spectralProj (adj (𝕜 := ℂ) G) (j : ℂ))
        * spectralProj (adj (𝕜 := ℂ) G) (i : ℂ) = 0 := by
      rw [hg]
      simp
    rw [Finset.sum_mul, Finset.sum_eq_single i] at h1
    · have h2 : g i • spectralProj (adj (𝕜 := ℂ) G) (i : ℂ) = 0 := by
        rw [← h1, Matrix.smul_mul, spectralProj_mul_self hAdj i.2]
      by_contra hgi
      exact absurd h2 (smul_ne_zero hgi (qb_spectralProj_ne_zero hAdj i.2))
    · intro j _ hji
      rw [Matrix.smul_mul, spectralProj_mul_of_ne hAdj (fun h => hji (Subtype.ext h))]
      simp
    · intro h
      exact absurd (Finset.mem_univ i) h
  -- and they span it
  have hspan : Submodule.span ℂ (Set.range (fun θ : ↥(eigFinset (adj (𝕜 := ℂ) G)) =>
        spectralProj (adj (𝕜 := ℂ) G) (θ : ℂ)))
      = (boseMesner (𝕜 := ℂ) G).toSubmodule := by
    refine le_antisymm ?_ ?_
    · rw [Submodule.span_le]
      rintro _ ⟨θ, rfl⟩
      exact spectralProj_mem_span hAdj (θ : ℂ)
    · intro M hM
      rw [boseMesner, Algebra.adjoin_singleton_eq_range_aeval] at hM
      obtain ⟨q, hq⟩ := hM
      rw [← hq]
      change (Polynomial.aeval (R := ℂ) (adj (𝕜 := ℂ) G)) q ∈
        Submodule.span ℂ (Set.range fun θ : ↥(eigFinset (adj (𝕜 := ℂ) G)) =>
          spectralProj (adj (𝕜 := ℂ) G) (θ : ℂ))
      rw [qb_aeval_eq_sum_spec hAdj q]
      exact Submodule.sum_mem _ fun θ hθ =>
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨⟨θ, hθ⟩, rfl⟩)
  have h1 : Module.finrank ℂ ↥(Submodule.span ℂ (Set.range fun θ : ↥(eigFinset (adj (𝕜 := ℂ) G)) =>
        spectralProj (adj (𝕜 := ℂ) G) (θ : ℂ))) = (eigFinset (adj (𝕜 := ℂ) G)).card := by
    rw [finrank_span_eq_card hLI, Fintype.card_coe]
  rw [← hfr, ← hspan, h1]

/-- **Lemma 14.2 (iii)**, unconditional (stub-free): for a distance-regular graph of
diameter exactly `D` (every radius `≤ D` is realised from `x`), every thin irreducible
`T(x)`-module with endpoint `r` and diameter `d` satisfies `D ≤ 2r + d`. -/
theorem basic_data_diam_bound_of_diam {G : SimpleGraph X} (hG : G.Connected)
    (hdr : IsDistanceRegular G) (hbi : IntersectionNumbersIndependent G)
    {D : ℕ} (hD1 : 1 ≤ D) (hDall : ∀ a b : X, G.dist a b ≤ D)
    {x : X} {W : Submodule ℂ (X → ℂ)} {r d : ℕ}
    (hDex : ∀ i : ℕ, i ≤ D → ∃ z : X, G.dist x z = i)
    (hstable : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hirr : IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hthin : ThinModule (𝕜 := ℂ) G x W) (hend : IsEndpoint (𝕜 := ℂ) G x W r)
    (hdiam : IsDiameter (𝕜 := ℂ) G x W r d) :
    D ≤ 2 * r + d :=
  basic_data_diam_bound_of_eigFinset hG hdr hbi hD1 hDall
    (qb_eigFinset_card_eq hG hdr hbi hD1 hDall hDex) hstable hirr hthin hend hdiam


/-! ## Chapter 32 (QC): `E*₄(y) A³` is injective on `E*₁(y)V`

The proof of `raising_pow_three_injective_of_thin`.  Its only external input is the
basic-data inequality `D ≤ 2 r + d` of Chapter 14 (`basic_data_diam_bound`, QB's
section).  The engine is the `R R R` ladder on a thin irreducible module: the block
calculus `E*₄ A³ = E*₄ A E*₃ A E*₂ A` on `E*₁V`
(`subconst_four_adj_pow_three_eq`), contiguity of the levels of an irreducible module
(`exists_isDiameter_of_irreducible`), level non-vanishing
(`up_nonvanishing_of_level`), and an induction on `dim U` over all stable subspaces
(`e4_adj_pow_three_injective_aux`) in which a non-irreducible `U = U₁ ⊕ U₂` is split
orthogonally.
-/

/-- **Level non-vanishing, unbounded form.**  If the `j`-th level of an irreducible
`T(x)`-module `W` is nonzero and `W` also has a nonzero level `m > j`, then
`E*_{j+1} A` does not kill `E*_j W`.  (This is `up_nonvanishing` with the upper end
of the module's support supplied by an *existing* nonzero level instead of by
`IsDiameter`.) -/
theorem up_nonvanishing_of_level {G : SimpleGraph X} {x : X} {W : Submodule ℂ (X → ℂ)}
    (hstable : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hirr : IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    {D : ℕ} (hD : ∀ y, G.dist x y ≤ D) {j m : ℕ} (hjm : j < m)
    (hj : subconstImage (𝕜 := ℂ) G x j W ≠ ⊥)
    (hm : subconstImage (𝕜 := ℂ) G x m W ≠ ⊥) :
    ∃ v ∈ subconstImage (𝕜 := ℂ) G x j W,
      subconst (𝕜 := ℂ) G x (j + 1) *ᵥ (adj (𝕜 := ℂ) G *ᵥ v) ≠ 0 := by
  by_contra H
  push_neg at H
  set U : Submodule ℂ (X → ℂ) :=
    Finset.sup (Finset.range (j + 1)) (fun k => subconstImage (𝕜 := ℂ) G x k W) with hU
  have hUk : ∀ k ≤ j, subconstImage (𝕜 := ℂ) G x k W ≤ U := by
    intro k hk
    have h : subconstImage (𝕜 := ℂ) G x k W ≤
        Finset.sup (Finset.range (j + 1)) (fun k => subconstImage (𝕜 := ℂ) G x k W) :=
      Finset.le_sup (b := k) (f := fun k => subconstImage (𝕜 := ℂ) G x k W)
        (Finset.mem_range.2 (by omega))
    rwa [← hU] at h
  have hUW : U ≤ W := by
    rw [hU]
    refine Finset.sup_le (fun k hk v hv => ?_)
    obtain ⟨t, ht, rfl⟩ := mem_matImage.1 hv
    exact hstable _ (subconst_mem_subconstituentAlgebra G x k) t ht
  have hAU : ∀ v ∈ U, adj (𝕜 := ℂ) G *ᵥ v ∈ U := by
    have hKU : U ≤ Submodule.comap (adj (𝕜 := ℂ) G).mulVecLin U := by
      rw [hU]
      refine Finset.sup_le (fun k hk v hv => ?_)
      rw [Finset.mem_range] at hk
      rw [Submodule.mem_comap, Matrix.mulVecLin_apply]
      have hexp : adj (𝕜 := ℂ) G *ᵥ v
          = ∑ m ∈ Finset.range (D + 1), subconst (𝕜 := ℂ) G x m *ᵥ (adj (𝕜 := ℂ) G *ᵥ v) :=
        mulVec_eq_sum_subconst_mulVec hD _
      rw [hexp]
      refine Submodule.sum_mem _ (fun m hm => ?_)
      rw [Finset.mem_range] at hm
      by_cases hmj : m ≤ j
      · have hmem : subconst (𝕜 := ℂ) G x m *ᵥ (adj (𝕜 := ℂ) G *ᵥ v)
            ∈ subconstImage (𝕜 := ℂ) G x m W :=
          mem_matImage.2 ⟨_, hstable _ (adj_mem_subconstituentAlgebra G x) v (hUW (hUk k (by omega) hv)),
            rfl⟩
        exact hUk m hmj hmem
      · by_cases hmk : m = k + 1
        · subst hmk
          have hkj : k = j := by omega
          subst hkj
          rw [H v hv]
          exact Submodule.zero_mem _
        · obtain ⟨t, ht, rfl⟩ := mem_matImage.1 hv
          have hband : k + 1 < m ∨ m + 1 < k := by omega
          rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
            subconst_mul_adj_mul_subconst_eq_zero (x := x) (i := m) (j := k) hband,
            Matrix.zero_mulVec]
          exact Submodule.zero_mem _
    intro v hv
    exact hKU hv
  have hEU : ∀ (i : ℕ) (v : X → ℂ), v ∈ U → subconst (𝕜 := ℂ) G x i *ᵥ v ∈ U := by
    intro i
    have hKU : U ≤ Submodule.comap (subconst (𝕜 := ℂ) G x i).mulVecLin U := by
      rw [hU]
      refine Finset.sup_le (fun k hk v hv => ?_)
      rw [Finset.mem_range] at hk
      rw [Submodule.mem_comap, Matrix.mulVecLin_apply]
      obtain ⟨t, ht, rfl⟩ := mem_matImage.1 hv
      rw [Matrix.mulVec_mulVec, subconst_mul_subconst]
      by_cases hik : i = k
      · subst hik
        rw [if_pos rfl]
        exact hUk i (by omega) (mem_matImage.2 ⟨t, ht, rfl⟩)
      · rw [if_neg hik, Matrix.zero_mulVec]
        exact Submodule.zero_mem _
    intro v hv
    exact hKU hv
  have hUne : U ≠ ⊥ := by
    intro hbot
    have hle := hUk j le_rfl
    rw [hbot] at hle
    exact hj (le_bot_iff.1 hle)
  have hUeq : U = W := hirr.2 U hUW (isStable_of_generators hAU hEU) hUne
  have hUKer : U ≤ LinearMap.ker (subconst (𝕜 := ℂ) G x m).mulVecLin := by
    rw [hU]
    refine Finset.sup_le (fun k hk v hv => ?_)
    rw [Finset.mem_range] at hk
    obtain ⟨t, ht, rfl⟩ := mem_matImage.1 hv
    rw [LinearMap.mem_ker, Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, subconst_mul_subconst,
      if_neg (by omega), Matrix.zero_mulVec]
  have hex : ∃ v ∈ subconstImage (𝕜 := ℂ) G x m W, v ≠ 0 := by
    by_contra h
    apply hm
    rw [Submodule.eq_bot_iff]
    intro v hv
    by_contra hv0
    exact h ⟨v, hv, hv0⟩
  obtain ⟨v, hv, hv0⟩ := hex
  have hvW : v ∈ W := by
    obtain ⟨t, ht, rfl⟩ := mem_matImage.1 hv
    exact hstable _ (subconst_mem_subconstituentAlgebra G x m) t ht
  have h0 : subconst (𝕜 := ℂ) G x m *ᵥ v = 0 := hUKer (hUeq ▸ hvW)
  rw [subconst_mulVec_self hv] at h0
  exact hv0 h0

/-- **The levels of an irreducible `T(x)`-module are contiguous.**  An irreducible
`T(x)`-submodule of the standard module has an endpoint `r` and then every level
`r, r+1, …, m` up to its top level `m` is nonzero; hence it has a diameter
`d = m - r` in the sense of `IsDiameter`. -/
theorem exists_isDiameter_of_irreducible {G : SimpleGraph X} {x : X} {W : Submodule ℂ (X → ℂ)}
    (hstable : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hirr : IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    {r : ℕ} (hend : IsEndpoint (𝕜 := ℂ) G x W r) :
    ∃ d, IsDiameter (𝕜 := ℂ) G x W r d := by
  set D : ℕ := Finset.univ.sup (fun z : X => G.dist x z) with hDdef
  have hD : ∀ z, G.dist x z ≤ D := fun z => Finset.le_sup (Finset.mem_univ z)
  set s : Finset ℕ := (Finset.range (D + 1)).filter
    (fun k => subconstImage (𝕜 := ℂ) G x k W ≠ ⊥) with hs
  have hmem_s : ∀ k, subconstImage (𝕜 := ℂ) G x k W ≠ ⊥ → k ∈ s := by
    intro k hk
    rw [hs, Finset.mem_filter, Finset.mem_range]
    refine ⟨?_, hk⟩
    by_contra h
    push_neg at h
    have hz : subconst (𝕜 := ℂ) G x k = 0 := subconst_eq_zero_of_lt hD h
    apply hk
    rw [Submodule.eq_bot_iff]
    intro v hv
    obtain ⟨t, -, rfl⟩ := mem_matImage.1 hv
    rw [hz, Matrix.zero_mulVec]
  have hne : s.Nonempty := ⟨r, hmem_s r hend.1⟩
  have hrle : r ≤ s.max' hne := Finset.le_max' s r (hmem_s r hend.1)
  have hmax : s.max' hne ∈ s := Finset.max'_mem s hne
  have hEm : subconstImage (𝕜 := ℂ) G x (s.max' hne) W ≠ ⊥ := (Finset.mem_filter.1 hmax).2
  have hcontig : ∀ k, k ≤ s.max' hne - r →
      subconstImage (𝕜 := ℂ) G x (r + k) W ≠ ⊥ := by
    intro k
    induction k with
    | zero => intro _; simpa using hend.1
    | succ k ih =>
        intro hk
        have hk' : k ≤ s.max' hne - r := by omega
        have hlevel := ih hk'
        have hlt : r + k < s.max' hne := by omega
        obtain ⟨v, hv, hvne⟩ :=
          up_nonvanishing_of_level hstable hirr hD hlt hlevel hEm
        have hmem : subconst (𝕜 := ℂ) G x (r + k + 1) *ᵥ (adj (𝕜 := ℂ) G *ᵥ v)
            ∈ subconstImage (𝕜 := ℂ) G x (r + k + 1) W :=
          mem_matImage.2 ⟨adj (𝕜 := ℂ) G *ᵥ v,
            hstable _ (adj_mem_subconstituentAlgebra G x) v
              (mem_of_mem_subconstImage hstable hv), rfl⟩
        show subconstImage (𝕜 := ℂ) G x (r + k + 1) W ≠ ⊥
        intro hbot
        rw [hbot] at hmem
        exact hvne (by simpa using hmem)
  refine ⟨s.max' hne - r, ?_, ?_⟩
  · intro i hri him
    have hi : i = r + (i - r) := by omega
    rw [hi]
    exact hcontig (i - r) (by omega)
  · intro i hi
    refine ⟨?_, ?_⟩
    · by_contra h
      push_neg at h
      exact hi (hend.2 i h)
    · have := Finset.le_max' s i (hmem_s i hi)
      omega


/-- `E*_k E*_m v = if k = m then E*_k v else 0`. -/
theorem subconst_mul_subconst_mulVec {G : SimpleGraph X} {y : X} (k m : ℕ) (v : X → ℂ) :
    subconst (𝕜 := ℂ) G y k *ᵥ (subconst (𝕜 := ℂ) G y m *ᵥ v) =
      if k = m then subconst (𝕜 := ℂ) G y k *ᵥ v else 0 := by
  rw [Matrix.mulVec_mulVec, subconst_mul_subconst]
  split <;> simp

/-- If `v` vanishes in all levels `≥ K` then `A v` vanishes in all levels `> K`
(the band lemma: `E*_k A E*_m = 0` for `|k - m| > 1`, and the levels `≥ K` of `v`
are absent). -/
theorem subconst_adj_eq_zero_of_le {G : SimpleGraph X} {y : X} {D : ℕ}
    (hD : ∀ z, G.dist y z ≤ D) {K : ℕ} {v : X → ℂ}
    (hv : ∀ k, K ≤ k → subconst (𝕜 := ℂ) G y k *ᵥ v = 0) :
    ∀ k, K < k → subconst (𝕜 := ℂ) G y k *ᵥ (adj (𝕜 := ℂ) G *ᵥ v) = 0 := by
  intro k hk
  conv_lhs => rw [mulVec_eq_sum_subconst_mulVec hD v]
  simp only [Matrix.mulVec_sum]
  refine Finset.sum_eq_zero (fun m _ => ?_)
  by_cases hmK : m < K
  · rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
      subconst_mul_adj_mul_subconst_eq_zero (x := y) (i := k) (j := m) (by omega),
      Matrix.zero_mulVec]
  · rw [hv m (by omega), Matrix.mulVec_zero, Matrix.mulVec_zero]

/-- **The block calculus of `A³` on `E*₁V`.**  For a vector fixed by `E*₁(y)`, the
level-`4` part of `A³w` is computed by the word `R R R`: it is
`E*₄ A E*₃ A E*₂ A w`. -/
theorem subconst_four_adj_pow_three_eq {G : SimpleGraph X} {y : X} {D : ℕ}
    (hD : ∀ z, G.dist y z ≤ D) {w : X → ℂ}
    (hw : subconst (𝕜 := ℂ) G y 1 *ᵥ w = w) :
    subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ w)
      = subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G *ᵥ
          (subconst (𝕜 := ℂ) G y 3 *ᵥ (adj (𝕜 := ℂ) G *ᵥ
            (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ w))))) := by
  have hw2 : ∀ k, 2 ≤ k → subconst (𝕜 := ℂ) G y k *ᵥ w = 0 := by
    intro k hk
    rw [← hw, Matrix.mulVec_mulVec, subconst_mul_subconst, if_neg (by omega),
      Matrix.zero_mulVec]
  have hAw : ∀ k, 3 ≤ k → subconst (𝕜 := ℂ) G y k *ᵥ (adj (𝕜 := ℂ) G *ᵥ w) = 0 :=
    subconst_adj_eq_zero_of_le hD hw2
  have hA2w : ∀ k, 4 ≤ k →
      subconst (𝕜 := ℂ) G y k *ᵥ (adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)) = 0 :=
    subconst_adj_eq_zero_of_le hD hAw
  have hpow : adj (𝕜 := ℂ) G ^ 3 *ᵥ w
      = adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)) := by
    rw [show (3 : ℕ) = 2 + 1 from rfl, pow_succ, ← Matrix.mulVec_mulVec, pow_two,
      ← Matrix.mulVec_mulVec]
  have hstepB : subconst (𝕜 := ℂ) G y 4 *ᵥ
      (adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)))
      = subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G *ᵥ
          (subconst (𝕜 := ℂ) G y 3 *ᵥ (adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)))) := by
    have hu : ∀ k, 3 ≤ k → subconst (𝕜 := ℂ) G y k *ᵥ
        ((adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)) -
          subconst (𝕜 := ℂ) G y 3 *ᵥ (adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ w))) = 0 := by
      intro k hk
      rw [Matrix.mulVec_sub, subconst_mul_subconst_mulVec]
      by_cases hk3 : k = 3
      · rw [if_pos hk3, sub_self]
      · rw [if_neg hk3, hA2w k (by omega), sub_zero]
    have hz := subconst_adj_eq_zero_of_le (K := 3) hD hu (k := 4) (by omega)
    have hsplit : (adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ w))
        = subconst (𝕜 := ℂ) G y 3 *ᵥ (adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)) +
          ((adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)) -
            subconst (𝕜 := ℂ) G y 3 *ᵥ (adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ w))) := by abel
    conv_lhs => rw [hsplit]
    rw [Matrix.mulVec_add, Matrix.mulVec_add, hz, add_zero]
  have hstepA : subconst (𝕜 := ℂ) G y 3 *ᵥ (adj (𝕜 := ℂ) G *ᵥ (adj (𝕜 := ℂ) G *ᵥ w))
      = subconst (𝕜 := ℂ) G y 3 *ᵥ (adj (𝕜 := ℂ) G *ᵥ
          (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ w))) := by
    have hu : ∀ k, 2 ≤ k → subconst (𝕜 := ℂ) G y k *ᵥ
        ((adj (𝕜 := ℂ) G *ᵥ w) - subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)) = 0 := by
      intro k hk
      rw [Matrix.mulVec_sub, subconst_mul_subconst_mulVec]
      by_cases hk2 : k = 2
      · rw [if_pos hk2, sub_self]
      · rw [if_neg hk2, hAw k (by omega), sub_zero]
    have hz := subconst_adj_eq_zero_of_le (K := 2) hD hu (k := 3) (by omega)
    have hsplit : (adj (𝕜 := ℂ) G *ᵥ w)
        = subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ w) +
          ((adj (𝕜 := ℂ) G *ᵥ w) - subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)) := by abel
    conv_lhs => rw [hsplit]
    rw [Matrix.mulVec_add, Matrix.mulVec_add, hz, add_zero]
  rw [hpow, hstepB, hstepA]

/-- **The `R R R` ladder.**  For a thin irreducible `T(y)`-module `U` whose levels
reach level `4`, the map `A³` does not kill `E*₁U`.  This is the engine of
`raising_pow_three_injective_of_thin`: on a thin module every level is a line, so
the three connective maps `E*₂A`, `E*₃A`, `E*₄A` are injective on the levels below. -/
theorem e4_adj_pow_three_of_irreducible {G : SimpleGraph X} {y : X} {D : ℕ}
    (hD : ∀ z, G.dist y z ≤ D) {U : Submodule ℂ (X → ℂ)}
    (hstable : IsStable (subconstituentAlgebra (𝕜 := ℂ) G y).toSubalgebra U)
    (hirr : IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G y).toSubalgebra U)
    (hthinU : ThinModule (𝕜 := ℂ) G y U)
    (hE4 : subconstImage (𝕜 := ℂ) G y 4 U ≠ ⊥) :
    ∀ w ∈ subconstImage (𝕜 := ℂ) G y 1 U, w ≠ 0 →
      subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ w) ≠ 0 := by
  intro w hw1 hwne
  have hw : subconst (𝕜 := ℂ) G y 1 *ᵥ w = w := subconst_mulVec_self hw1
  -- the level-1 part is nonzero
  have hE1 : subconstImage (𝕜 := ℂ) G y 1 U ≠ ⊥ := by
    intro hbot
    rw [hbot] at hw1
    exact hwne (by simpa using hw1)
  -- level 2
  have hE2 : subconstImage (𝕜 := ℂ) G y 2 U ≠ ⊥ := by
    obtain ⟨v, hv, hvne⟩ :=
      up_nonvanishing_of_level hstable hirr hD (j := 1) (m := 4) (by omega) hE1 hE4
    have hmem : subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ v)
        ∈ subconstImage (𝕜 := ℂ) G y 2 U :=
      mem_matImage.2 ⟨adj (𝕜 := ℂ) G *ᵥ v,
        hstable _ (adj_mem_subconstituentAlgebra G y) v (mem_of_mem_subconstImage hstable hv), rfl⟩
    intro hbot
    rw [hbot] at hmem
    exact hvne (by simpa using hmem)
  -- level 3
  have hE3 : subconstImage (𝕜 := ℂ) G y 3 U ≠ ⊥ := by
    obtain ⟨v, hv, hvne⟩ :=
      up_nonvanishing_of_level hstable hirr hD (j := 2) (m := 4) (by omega) hE2 hE4
    have hmem : subconst (𝕜 := ℂ) G y 3 *ᵥ (adj (𝕜 := ℂ) G *ᵥ v)
        ∈ subconstImage (𝕜 := ℂ) G y 3 U :=
      mem_matImage.2 ⟨adj (𝕜 := ℂ) G *ᵥ v,
        hstable _ (adj_mem_subconstituentAlgebra G y) v (mem_of_mem_subconstImage hstable hv), rfl⟩
    intro hbot
    rw [hbot] at hmem
    exact hvne (by simpa using hmem)
  -- the three connective steps
  have step1 : subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ w) ≠ 0 := by
    intro h0
    obtain ⟨v, hv, hvne⟩ :=
      up_nonvanishing_of_level hstable hirr hD (j := 1) (m := 4) (by omega) hE1 hE4
    obtain ⟨c, hc⟩ :=
      exists_smul_of_mem_subconstImage (W := U) hthinU hw1 hv hwne
    rw [hc, Matrix.mulVec_smul, Matrix.mulVec_smul, h0, smul_zero] at hvne
    exact hvne rfl
  have step2 : subconst (𝕜 := ℂ) G y 3 *ᵥ (adj (𝕜 := ℂ) G *ᵥ
      (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ w))) ≠ 0 := by
    intro h0
    obtain ⟨v, hv, hvne⟩ :=
      up_nonvanishing_of_level hstable hirr hD (j := 2) (m := 4) (by omega) hE2 hE4
    have hu2 : subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)
        ∈ subconstImage (𝕜 := ℂ) G y 2 U :=
      mem_matImage.2 ⟨adj (𝕜 := ℂ) G *ᵥ w,
        hstable _ (adj_mem_subconstituentAlgebra G y) w (mem_of_mem_subconstImage hstable hw1), rfl⟩
    obtain ⟨c, hc⟩ := exists_smul_of_mem_subconstImage (W := U) hthinU hu2 hv step1
    rw [hc, Matrix.mulVec_smul, Matrix.mulVec_smul, h0, smul_zero] at hvne
    exact hvne rfl
  have step3 : subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G *ᵥ
      (subconst (𝕜 := ℂ) G y 3 *ᵥ (adj (𝕜 := ℂ) G *ᵥ
        (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ w))))) ≠ 0 := by
    intro h0
    obtain ⟨v, hv, hvne⟩ :=
      up_nonvanishing_of_level hstable hirr hD (j := 3) (m := 4) (by omega) hE3 hE4
    have hu2 : subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)
        ∈ subconstImage (𝕜 := ℂ) G y 2 U :=
      mem_matImage.2 ⟨adj (𝕜 := ℂ) G *ᵥ w,
        hstable _ (adj_mem_subconstituentAlgebra G y) w (mem_of_mem_subconstImage hstable hw1), rfl⟩
    have hu3 : subconst (𝕜 := ℂ) G y 3 *ᵥ (adj (𝕜 := ℂ) G *ᵥ
        (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)))
        ∈ subconstImage (𝕜 := ℂ) G y 3 U := by
      refine mem_matImage.2 ⟨adj (𝕜 := ℂ) G *ᵥ (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ w)),
        hstable _ (adj_mem_subconstituentAlgebra G y) _
          (mem_of_mem_subconstImage hstable hu2), rfl⟩
    obtain ⟨c, hc⟩ := exists_smul_of_mem_subconstImage (W := U) hthinU hu3 hv step2
    rw [hc, Matrix.mulVec_smul, Matrix.mulVec_smul, h0, smul_zero] at hvne
    exact hvne rfl
  rw [subconst_four_adj_pow_three_eq hD hw]
  exact step3

/-- **The induction.**  `E*₄ A³` is injective on `E*₁U` for every stable subspace `U`
of the standard module, by induction on `dim U`: if `U` is irreducible this is the
`R R R` ladder (`e4_adj_pow_three_of_irreducible`) together with the diameter bound
`D ≤ 2r + d` of the basic data; otherwise `U = U₁ ⊕ U₂` with `U₁ ⊥ U₂` and the two
images are orthogonal. -/
theorem e4_adj_pow_three_injective_aux {G : SimpleGraph X} {y : X} {D : ℕ}
    (hG : G.Connected) (hdr : IsDistanceRegular G) (hbi : IntersectionNumbersIndependent G)
    (hDall : ∀ a b : X, G.dist a b ≤ D) (hDex : ∃ a b : X, G.dist a b = D)
    (hD5 : 5 ≤ D)
    (hthin : ∀ W : Submodule ℂ (X → ℂ),
      IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G y).toSubalgebra W → ThinModule G y W) :
    ∀ (n : ℕ) (U : Submodule ℂ (X → ℂ)), Module.finrank ℂ ↥U ≤ n →
      IsStable (subconstituentAlgebra (𝕜 := ℂ) G y).toSubalgebra U →
      ∀ w ∈ subconstImage (𝕜 := ℂ) G y 1 U, w ≠ 0 →
        subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ w) ≠ 0 := by
  intro n
  induction n with
  | zero =>
    intro U hfin _ w hw hwne
    have hU : U = ⊥ := by
      rw [← Submodule.finrank_eq_zero]
      omega
    rw [hU, subconstImage, matImage, Submodule.map_bot, Submodule.mem_bot] at hw
    exact absurd hw hwne
  | succ n ih =>
    intro U hfin hst w hw hwne
    by_cases hirr : IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G y).toSubalgebra U
    · obtain ⟨r, hend⟩ := exists_isEndpoint_of_irreducible (G := G) (x := y) hirr
      obtain ⟨d, hdiam⟩ := exists_isDiameter_of_irreducible hst hirr hend
      have hE1 : subconstImage (𝕜 := ℂ) G y 1 U ≠ ⊥ := by
        intro hbot
        rw [hbot] at hw
        exact hwne (by simpa using hw)
      have hr1 : r ≤ 1 := by
        by_contra h
        push_neg at h
        exact hE1 (hend.2 1 h)
      have hbd : D ≤ 2 * r + d :=
        basic_data_diam_bound hG hdr hbi (by omega) hDall hDex hst hirr (hthin U hirr)
          hend hdiam
      have h4 : 4 ≤ r + d := by omega
      have hE4 : subconstImage (𝕜 := ℂ) G y 4 U ≠ ⊥ := hdiam.1 4 (by omega) h4
      exact e4_adj_pow_three_of_irreducible (D := D) (fun z => hDall y z) hst hirr
        (hthin U hirr) hE4 w hw hwne
    · have hUne : U ≠ ⊥ := by
        intro hbot
        rw [hbot, subconstImage, matImage, Submodule.map_bot, Submodule.mem_bot] at hw
        exact hwne hw
      obtain ⟨U₁, hU₁le, hU₁st, hU₁ne, hU₁ne'⟩ :
          ∃ U₁ : Submodule ℂ (X → ℂ), U₁ ≤ U ∧
            IsStable (subconstituentAlgebra (𝕜 := ℂ) G y).toSubalgebra U₁ ∧
            U₁ ≠ ⊥ ∧ U₁ ≠ U := by
        by_contra h
        exact hirr ⟨hUne, fun U₁ h1 h2 h3 => by
          by_contra h4
          exact h ⟨U₁, h1, h2, h3, h4⟩⟩
      set U₂ : Submodule ℂ (X → ℂ) := U ⊓ orthCompl U₁ with hU₂def
      have hU₂st : IsStable (subconstituentAlgebra (𝕜 := ℂ) G y).toSubalgebra U₂ :=
        isStable_inf' hst (isStable_orthCompl
          (fun a ha => StarMemClass.star_mem (s := subconstituentAlgebra (𝕜 := ℂ) G y) ha) hU₁st)
      have hU₂ne' : U₂ ≠ U := by
        obtain ⟨u, huU₁, hu0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hU₁ne
        intro hEq
        have huU₂ : u ∈ U₂ := hEq ▸ (hU₁le huU₁)
        have horth : u ∈ orthCompl U₁ := (Submodule.mem_inf.mp huU₂).2
        exact hu0 (star_dotProduct_self_eq_zero (mem_orthCompl.mp horth u huU₁))
      have hfin₁ : Module.finrank ℂ ↥U₁ ≤ n := by
        have hlt : Module.finrank ℂ ↥U₁ < Module.finrank ℂ ↥U :=
          Submodule.finrank_lt_finrank_of_lt (lt_of_le_of_ne hU₁le hU₁ne')
        exact Nat.lt_succ_iff.mp (lt_of_lt_of_le hlt hfin)
      have hfin₂ : Module.finrank ℂ ↥U₂ ≤ n := by
        have hlt : Module.finrank ℂ ↥U₂ < Module.finrank ℂ ↥U :=
          Submodule.finrank_lt_finrank_of_lt (lt_of_le_of_ne inf_le_left hU₂ne')
        exact Nat.lt_succ_iff.mp (lt_of_lt_of_le hlt hfin)
      obtain ⟨t, htU, ht⟩ := mem_matImage.1 hw
      obtain ⟨h, hhU₁, horth⟩ := exists_orthogonal_decomp (W := U₁) t
      set w₁ : X → ℂ := subconst (𝕜 := ℂ) G y 1 *ᵥ h with hw₁def
      set w₂ : X → ℂ := subconst (𝕜 := ℂ) G y 1 *ᵥ (t - h) with hw₂def
      have hw₁mem : w₁ ∈ subconstImage (𝕜 := ℂ) G y 1 U₁ := mem_matImage.2 ⟨h, hhU₁, rfl⟩
      have ht₂ : t - h ∈ U₂ :=
        Submodule.mem_inf.mpr ⟨Submodule.sub_mem _ htU (hU₁le hhU₁), fun u hu => horth u hu⟩
      have hw₂mem : w₂ ∈ subconstImage (𝕜 := ℂ) G y 1 U₂ := mem_matImage.2 ⟨t - h, ht₂, rfl⟩
      have hw_eq : w = w₁ + w₂ := by
        rw [← ht, hw₁def, hw₂def, ← Matrix.mulVec_add]
        congr 1
        abel
      have hA3mem₁ : ∀ v ∈ U₁, adj (𝕜 := ℂ) G ^ 3 *ᵥ v ∈ U₁ := fun v hv =>
        hU₁st _ (Subalgebra.pow_mem _ (adj_mem_subconstituentAlgebra G y) 3) v hv
      have hA3mem₂ : ∀ v ∈ U₂, adj (𝕜 := ℂ) G ^ 3 *ᵥ v ∈ U₂ := fun v hv =>
        hU₂st _ (Subalgebra.pow_mem _ (adj_mem_subconstituentAlgebra G y) 3) v hv
      set x₁ : X → ℂ := subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ w₁) with hx₁def
      set x₂ : X → ℂ := subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ w₂) with hx₂def
      have hx₁mem : x₁ ∈ U₁ :=
        mem_of_mem_subconstImage hU₁st
          (mem_matImage.2 ⟨_, hA3mem₁ w₁ (mem_of_mem_subconstImage hU₁st hw₁mem), rfl⟩)
      have hx₂mem : x₂ ∈ U₂ :=
        mem_of_mem_subconstImage hU₂st
          (mem_matImage.2 ⟨_, hA3mem₂ w₂ (mem_of_mem_subconstImage hU₂st hw₂mem), rfl⟩)
      intro h0
      have hsum : x₁ + x₂ = 0 := by
        have hsplit : subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ (w₁ + w₂))
            = x₁ + x₂ := by
          rw [Matrix.mulVec_add, Matrix.mulVec_add, hx₁def, hx₂def]
        rw [hw_eq, hsplit] at h0
        exact h0
      have hx₁zero : x₁ = 0 := by
        have h2 : x₁ = -x₂ := eq_neg_iff_add_eq_zero.mpr hsum
        have hx₁U₂ : x₁ ∈ U₂ := by
          rw [h2]
          exact Submodule.neg_mem _ hx₂mem
        exact star_dotProduct_self_eq_zero
          (mem_orthCompl.mp (Submodule.mem_inf.mp hx₁U₂).2 x₁ hx₁mem)
      have hx₂zero : x₂ = 0 := by
        have h2 : x₂ = -x₁ := eq_neg_iff_add_eq_zero.mpr (by rw [add_comm]; exact hsum)
        have hx₂U₁ : x₂ ∈ U₁ := by
          rw [h2]
          exact Submodule.neg_mem _ hx₁mem
        exact star_dotProduct_self_eq_zero
          (mem_orthCompl.mp (Submodule.mem_inf.mp hx₂mem).2 x₂ hx₂U₁)
      have hw₁zero : w₁ = 0 := by
        by_contra hne
        exact (ih U₁ hfin₁ hU₁st w₁ hw₁mem hne) hx₁zero
      have hw₂zero : w₂ = 0 := by
        by_contra hne
        exact (ih U₂ hfin₂ hU₂st w₂ hw₂mem hne) hx₂zero
      rw [hw_eq, hw₁zero, hw₂zero, add_zero] at hwne
      exact hwne rfl

/-- **Chapter 32 (Lemma 32.1 (ii)/(iii)), local form** (R3d's section): in a thin
distance-regular graph of diameter `D ≥ 5`, `R(y)³ = E*_4(y)A³` is injective on
`E*_1(y)V`.  Stated in the `A`-power form used in Chapter 38.

REPAIRED in wave 3 (finding f8): the original draft took `D` to be any upper
bound on the eccentricity of `y`, which is refuted by `Q₃` (diameter 3) with
`D := 5` — then `E*_4(y) = 0` and the conclusion fails for every nonzero
`w ∈ E*_1(y)V`.  `D` must be the diameter (`hDall` + `hDex`), and the proof
runs through `basic_data_diam_bound` (`D ≤ 2r + d`), which needs the global
intersection numbers. -/
theorem raising_pow_three_injective_of_thin {G : SimpleGraph X} {y : X} {D : ℕ}
    (hG : G.Connected) (hdr : IsDistanceRegular G)
    (hbi : IntersectionNumbersIndependent G)
    (hDall : ∀ a b : X, G.dist a b ≤ D) (hDex : ∃ a b : X, G.dist a b = D) (hD5 : 5 ≤ D)
    (hthin : ∀ W : Submodule ℂ (X → ℂ),
      IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G y).toSubalgebra W → ThinModule G y W) :
    ∀ w : X → ℂ, subconst (𝕜 := ℂ) G y 1 *ᵥ w = w → w ≠ 0 →
      subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ w) ≠ 0 := by

  intro w hw hwne
  have hmem : w ∈ subconstImage (𝕜 := ℂ) G y 1 (⊤ : Submodule ℂ (X → ℂ)) :=
    mem_matImage.2 ⟨w, Submodule.mem_top, by rw [hw]⟩
  exact e4_adj_pow_three_injective_aux hG hdr hbi hDall hDex hD5 hthin
    (Module.finrank ℂ ↥(⊤ : Submodule ℂ (X → ℂ))) ⊤ le_rfl (isStable_top _) w hmem hwne

/-! ## The draft statement is false

The draft of `raising_pow_three_injective_of_thin` carried no hypothesis bounding the
*actual* diameter of the graph, only the numeric bound `5 ≤ D` and `∀ z, ∂(y,z) ≤ D`.
A graph of diameter `≤ 1` refutes it: every `T(y)`-module is thin there (each
`E*_i(y)` has rank at most one), and `E*₄ = 0`. -/

theorem dist_eq_one_top_fin_two {y z : Fin 2} (h : z ≠ y) :
    (⊤ : SimpleGraph (Fin 2)).dist y z = 1 := by
  rw [SimpleGraph.dist_eq_one_iff_adj]
  simpa using Ne.symm h

theorem dist_le_one_top_fin_two (y z : Fin 2) : (⊤ : SimpleGraph (Fin 2)).dist y z ≤ 1 := by
  by_cases h : z = y
  · rw [h, SimpleGraph.dist_self]
    omega
  · rw [dist_eq_one_top_fin_two h]

/-- In the complete graph on two vertices every subconstituent image is contained in
the line spanned by the corresponding sphere sum. -/
theorem subconst_top_fin_two_smul_sphereSum (y : Fin 2) (i : ℕ) (w : Fin 2 → ℂ) :
    ∃ c : ℂ, subconst (𝕜 := ℂ) (⊤ : SimpleGraph (Fin 2)) y i *ᵥ w =
      c • sphereSum (𝕜 := ℂ) (⊤ : SimpleGraph (Fin 2)) y i := by
  by_cases hi0 : i = 0
  · subst hi0
    refine ⟨w y, ?_⟩
    funext z
    fin_cases y <;> fin_cases z <;>
      simp [subconst, Matrix.mulVec_diagonal, sphereSum_apply, SimpleGraph.dist_self]
  · by_cases hi1 : i = 1
    · subst hi1
      refine ⟨w (if y = 0 then 1 else 0), ?_⟩
      funext z
      fin_cases y <;> fin_cases z <;>
        simp [subconst, Matrix.mulVec_diagonal, sphereSum_apply, SimpleGraph.dist_self,
          dist_eq_one_top_fin_two (y := (0 : Fin 2)) (z := (1 : Fin 2)) (by decide),
          dist_eq_one_top_fin_two (y := (1 : Fin 2)) (z := (0 : Fin 2)) (by decide)]
    · refine ⟨0, ?_⟩
      funext z
      have h0 : (⊤ : SimpleGraph (Fin 2)).dist y z ≠ i := by
        have := dist_le_one_top_fin_two y z
        omega
      simp [subconst, Matrix.mulVec_diagonal, sphereSum_apply, h0]

/-- Every submodule of the standard module of the complete graph on two vertices is
thin: each `E*_i` has rank at most one. -/
theorem thinModule_top_fin_two (y : Fin 2) (W : Submodule ℂ (Fin 2 → ℂ)) :
    ThinModule (𝕜 := ℂ) (⊤ : SimpleGraph (Fin 2)) y W := by
  intro i
  have hle : subconstImage (𝕜 := ℂ) (⊤ : SimpleGraph (Fin 2)) y i W ≤
      Submodule.span ℂ
        ({sphereSum (𝕜 := ℂ) (⊤ : SimpleGraph (Fin 2)) y i} : Set (Fin 2 → ℂ)) := by
    intro v hv
    obtain ⟨t, -, rfl⟩ := mem_matImage.1 hv
    obtain ⟨c, hc⟩ := subconst_top_fin_two_smul_sphereSum y i t
    rw [hc]
    exact Submodule.smul_mem _ c (Submodule.subset_span rfl)
  refine le_trans (Submodule.finrank_mono hle) ?_
  by_cases h0 : sphereSum (𝕜 := ℂ) (⊤ : SimpleGraph (Fin 2)) y i = 0
  · rw [h0, Submodule.span_zero_singleton]
    simp
  · rw [finrank_span_singleton h0]

/-- **The draft of `raising_pow_three_injective_of_thin` is false.**  There is a graph
with `5 ≤ D` and `∀ z, ∂(y,z) ≤ D` all of whose irreducible `T(y)`-modules are thin,
carrying `0 ≠ w` with `E*₁(y) w = w` and `E*₄(y) A³ w = 0`: the complete graph on two
vertices, `D = 5`, `w = ê₁`.  The missing hypothesis in the draft is a bound of the
form `∀ a b, ∂(a,b) ≤ D` together with the distance-regular data — exactly the input of
`basic_data_diam_bound`, which is what the corrected statement uses. -/
theorem raising_pow_three_injective_of_thin_draft_false :
    ∃ (G : SimpleGraph (Fin 2)) (y : Fin 2) (D : ℕ) (w : Fin 2 → ℂ),
      5 ≤ D ∧ (∀ z, G.dist y z ≤ D) ∧
      (∀ W : Submodule ℂ (Fin 2 → ℂ),
        IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G y).toSubalgebra W →
          ThinModule G y W) ∧
      subconst (𝕜 := ℂ) G y 1 *ᵥ w = w ∧ w ≠ 0 ∧
      subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ w) = 0 := by
  refine ⟨⊤, 0, 5, Pi.single 1 1, by norm_num, ?_, ?_, ?_, ?_, ?_⟩
  · intro z
    have := dist_le_one_top_fin_two 0 z
    omega
  · intro W _
    exact thinModule_top_fin_two 0 W
  · funext z
    fin_cases z <;>
      simp [subconst, Matrix.mulVec_diagonal, SimpleGraph.dist_self,
        dist_eq_one_top_fin_two (y := (0 : Fin 2)) (z := (1 : Fin 2)) (by decide)]
  · intro h
    have := congrFun h 1
    simp at this
  · have hz : subconst (𝕜 := ℂ) (⊤ : SimpleGraph (Fin 2)) 0 4 = 0 :=
      subconst_eq_zero_of_lt (G := (⊤ : SimpleGraph (Fin 2))) (x := 0)
        (D := 1) (fun z => dist_le_one_top_fin_two 0 z) (by norm_num)
    rw [hz, Matrix.zero_mulVec]


namespace DRGData

variable {G : SimpleGraph X} {x : X} {D : ℕ}

/-! ## Chapter 38: the injection `E*₁₁V → E*₂₂V` and the constant `Ψ` -/

/-- **Lemma 38.1 (i)** — STATEMENT FIXED.  The draft in this file (kept below as the
contents of `e11_to_e22_draft_false`) quantified over the whole of `V` and imposed no
hypotheses; it is false for every graph and every vertex `x`, because the map
annihilates everything that `E*₁(x)E*₁(y)` kills (`x̂` in particular).

Faithful form (lecture 38, Lemma `e11star-to-e22star` (i)): `Γ` thin of diameter
`D ≥ 5`, `∂(x,y) = 1`; then `E*₂₂AE*₁₁ : E*₁₁V → E*₂₂V` is injective, where
`E*_{ij} = E*_i(x)E*_j(y)` and `E*₁₁V = matImage (subconstij G x y 1 1) ⊤`.

The two inputs from neighbouring chapters that this library does not yet contain are
hypotheses: `hthin` is thinness of `Γ` with respect to `y` (used only through Chapter
31/32's injectivity of `R(y)³` on `E*₁(y)V` — the `STUBS` entry
`raising_pow_three_injective_of_thin`), and `hRFL` is the `i = 3` case of the Chapter
30 `R, F, L` relations (Theorem 30.1 (i)), i.e. the three-term identity
`g₃⁻R²F + RFR + g₃⁺FR² - γR² = 0` on `E*₁V` transported to the two-vertex
projections (`eq:g3plus-minus-zero` of lecture 38).  Everything else is proved. -/
theorem e11_to_e22_injective (hG : G.Connected) (hdr : IsDistanceRegular G)
    (hbi : IntersectionNumbersIndependent G)
    (hDall : ∀ a b : X, G.dist a b ≤ D) (hDex : ∃ a b : X, G.dist a b = D)
    (h5 : 5 ≤ D) {y : X} (hy : G.Adj x y)
    (hthin : ∀ W : Submodule ℂ (X → ℂ),
      IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G y).toSubalgebra W → ThinModule G y W)
    (hRFL : RFLThreeTerm G x y) :
    Function.Injective fun v : ↥(matImage (subconstij G x y 1 1) ⊤) =>
      subconst (𝕜 := ℂ) G x 2 *ᵥ
        (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ (v : X → ℂ))) := by
  intro a b hab
  have hmem : ((a : X → ℂ) - (b : X → ℂ)) ∈ matImage (subconstij G x y 1 1) ⊤ :=
    Submodule.sub_mem _ a.2 b.2
  have hzraw : subconst (𝕜 := ℂ) G x 2
      *ᵥ (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ ((a : X → ℂ) - (b : X → ℂ)))) = 0 := by
    have h1 : subconst (𝕜 := ℂ) G x 2
        *ᵥ (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ (a : X → ℂ)))
        = subconst (𝕜 := ℂ) G x 2
          *ᵥ (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ (b : X → ℂ))) := hab
    rw [Matrix.mulVec_sub, Matrix.mulVec_sub, Matrix.mulVec_sub, h1, sub_self]
  have hz : subconstij G x y 2 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ ((a : X → ℂ) - (b : X → ℂ))) = 0 := by
    show (subconst (𝕜 := ℂ) G x 2 * subconst (𝕜 := ℂ) G y 2)
        *ᵥ (adj (𝕜 := ℂ) G *ᵥ ((a : X → ℂ) - (b : X → ℂ))) = 0
    rw [mulVec_three]
    exact hzraw
  by_contra hne
  have hne' : (a : X → ℂ) - (b : X → ℂ) ≠ 0 := by
    intro h
    exact hne (Subtype.ext (sub_eq_zero.mp h))
  -- the two chapter inputs, at the diameter `D`
  have hDx' : ∀ z, G.dist x z ≤ D := fun z => hDall x z
  have hDy' : ∀ z, G.dist y z ≤ D := fun z => hDall y z
  have hinj := raising_pow_three_injective_of_thin (G := G) (y := y) (D := D)
    hG hdr hbi hDall hDex h5 hthin
  exact e11_kernel (G := G) hG hy (D := D) h5 hDx' hDy' hinj hRFL
    hmem hz hne'

/-- Lemma 38.1 (i) in the `DRGData` framing: the base vertex data supplies the
connectivity and the diameter bound. -/
theorem e11_to_e22_injective' (Y' : DRGData G x D) (hbi : IntersectionNumbersIndependent G)
    (h5 : 5 ≤ D) {y : X} (hy : G.Adj x y)
    (hthin : ∀ W : Submodule ℂ (X → ℂ),
      IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G y).toSubalgebra W → ThinModule G y W)
    (hRFL : RFLThreeTerm G x y) :
    Function.Injective fun v : ↥(matImage (subconstij G x y 1 1) ⊤) =>
      subconst (𝕜 := ℂ) G x 2 *ᵥ
        (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ (v : X → ℂ))) :=
  e11_to_e22_injective Y'.connected Y'.drg hbi Y'.diamAll Y'.diamExact h5 hy hthin hRFL

/-! ### The draft statement is false -/

/-- `E*_i(z)` is diagonal, so it sends `ŵ` to a multiple of `ŵ`: pointwise,
`E*_i(z) *ᵥ ŵ = (if ∂(z,w) = i then c else 0) • ŵ`. -/
theorem subconst_mulVec_single (G : SimpleGraph X) (z w : X) (i : ℕ) (c : ℂ) :
    subconst (𝕜 := ℂ) G z i *ᵥ (Pi.single w c) =
      (if G.dist z w = i then c else 0) • (Pi.single w (1 : ℂ) : X → ℂ) := by
  funext u
  rw [mulVec, dotProduct, Finset.sum_eq_single w]
  · simp only [subconst_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul]
    by_cases h : u = w <;> simp [h]
  · intro b _ hb
    simp [subconst_apply, Pi.single_apply, Ne.symm hb]
  · exact fun h => absurd (Finset.mem_univ w) h

/-- **The draft statement of Lemma 38.1 (i) is false.**  The draft read
`Function.Injective fun v : X → ℂ => E*₂(x)(E*₂(y)(A(E*₁(x)(E*₁(y)v))))`
with no hypotheses and with all of `V` as the domain.  For *any* graph and any two
vertices `x, y` the vector `x̂` and the zero vector have the same image: `E*₁(y)` is
diagonal, so `E*₁(y)x̂` is a multiple of `x̂`, and `E*₁(x)x̂ = 0` because
`∂(x,x) = 0 ≠ 1`.  The domain therefore has to be cut down to `E*₁₁V`, as in
`e11_to_e22_injective`. -/
theorem e11_to_e22_draft_false {G : SimpleGraph X} (x y : X) :
    ¬ Function.Injective fun v : X → ℂ =>
      subconst (𝕜 := ℂ) G x 2 *ᵥ (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ
        (subconst (𝕜 := ℂ) G x 1 *ᵥ (subconst (𝕜 := ℂ) G y 1 *ᵥ v)))) := by
  intro hinj
  have hE1x : subconst (𝕜 := ℂ) G x 1 *ᵥ (Pi.single x (1 : ℂ) : X → ℂ) = 0 := by
    rw [subconst_mulVec_single, if_neg (by simp), zero_smul]
  have h1 : subconst (𝕜 := ℂ) G x 2 *ᵥ (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ
      (subconst (𝕜 := ℂ) G x 1 *ᵥ (subconst (𝕜 := ℂ) G y 1 *ᵥ
        (Pi.single x (1 : ℂ) : X → ℂ))))) = 0 := by
    rw [subconst_mulVec_single]
    by_cases hy : G.dist y x = 1
    · rw [if_pos hy, one_smul, hE1x, Matrix.mulVec_zero, Matrix.mulVec_zero,
        Matrix.mulVec_zero]
    · rw [if_neg hy, zero_smul, Matrix.mulVec_zero, Matrix.mulVec_zero, Matrix.mulVec_zero,
        Matrix.mulVec_zero]
  have h2 : subconst (𝕜 := ℂ) G x 2 *ᵥ (subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ
      (subconst (𝕜 := ℂ) G x 1 *ᵥ (subconst (𝕜 := ℂ) G y 1 *ᵥ (0 : X → ℂ))))) = 0 := by
    simp
  have key : (Pi.single x (1 : ℂ) : X → ℂ) = 0 := hinj (h1.trans h2.symm)
  have hfin := congrFun key x
  simp only [Pi.single_eq_same, Pi.zero_apply] at hfin
  exact one_ne_zero hfin

end DRGData


/-! ## Chapter 39 (QH section): the `E*₁`-support of `A⁺` and `A⁻`, and level calculus

Lecture 39 (`.scratch/t-algebra/39-lecture39.Rmd`) sets
`A⁺ = R⁻¹E*₂A₂E*₁ - ΨE*₁` and
`A⁻ = ÃA⁺ - (a₂/c₂ - Ψ)E*₁ + Ψ(J̃ - Ã - E*₁)`,
and Lemma `aplus-aminus` asserts that both are generalized adjacency matrices for
the subgraph induced on the first subconstituent `S₁(x)`, with zero diagonal.  In the
relativized form used by this file (`IsGeneralizedAdjacencyFirstSubconst`) the
conjuncts are

* `B ≠ 0`,
* `B u v ≠ 0 → u = v ∨ G.Adj u v`   (lecture 39: `A⁺ŷ = δ⁺₁₁ ∈ E*₁₁V`),
* `B u v ≠ 0 → ∂(x,u) = 1 ∧ ∂(x,v) = 1`,
* `B ∈ Algebra.adjoin ℂ {Ã, J̃}`.

This section proves the third conjunct for `A⁺` and `A⁻` (the second is the
Chapter-38 vector statement `A⁺ŷ = δ⁺₁₀ + δ⁺₁₁`, which needs the `δ^±` machinery), and
records the two-vertex level calculus of the raising operator that the lecture-37/38
arguments use. -/

/-- `E*₁(x) = ∑_j E*_{1,j}(x,y)`: the level-`1` projection relative to `x` decomposes
over the levels relative to `y`.  This is the orthogonal decomposition behind
`Δŷ = δ⁺₁₀ + δ⁺₁₁ + δ⁺₁₂` of lecture 37. -/
theorem subconst_one_eq_sum_subconstij {G : SimpleGraph X} (x y : X) {D : ℕ}
    (hdiam : ∀ z, G.dist y z ≤ D) :
    subconst (𝕜 := ℂ) G x 1 = ∑ j ∈ Finset.range (D + 1), subconstij G x y 1 j := by
  ext u v
  rw [Matrix.sum_apply, subconst_apply]
  simp only [subconstij_apply]
  by_cases huv : u = v
  · subst huv
    simp only [if_true]
    by_cases hx : G.dist x u = 1
    · rw [if_pos hx]
      rw [Finset.sum_eq_single (G.dist y u)]
      · simp
      · intro b _ hb; simp [Ne.symm hb]
      · intro h; exact absurd (Finset.mem_range.mpr (by have := hdiam u; omega)) h
    · rw [if_neg hx]
      simp [hx]
  · rw [if_neg huv]
    simp [huv]

/-- `E*_{ij} E*_m(x) = δ_{im} E*_{ij}`. -/
theorem subconstij_mul_subconst (G : SimpleGraph X) (x y : X) (i j m : ℕ) :
    subconstij G x y i j * subconst (𝕜 := ℂ) G x m
      = if i = m then subconstij G x y i j else 0 := by
  rw [subconstij, mul_assoc, subconst_mul_subconst_comm (G := G) y x j m, ← mul_assoc,
    subconst_mul_subconst]
  by_cases h : i = m <;> simp [h]

/-- `E*_m(x) E*_{ij} = δ_{im} E*_{ij}`. -/
theorem subconst_mul_subconstij (G : SimpleGraph X) (x y : X) (m i j : ℕ) :
    subconst (𝕜 := ℂ) G x m * subconstij G x y i j
      = if i = m then subconstij G x y i j else 0 := by
  rw [subconstij, ← mul_assoc, subconst_mul_subconst]
  by_cases h : m = i <;> simp [h, eq_comm]

/-- `E*_{ij} E*_l(y) = δ_{jl} E*_{ij}`. -/
theorem subconstij_mul_subconst_y (G : SimpleGraph X) (x y : X) (i j l : ℕ) :
    subconstij G x y i j * subconst (𝕜 := ℂ) G y l
      = if j = l then subconstij G x y i j else 0 := by
  rw [subconstij, mul_assoc, subconst_mul_subconst]
  by_cases h : j = l <;> simp [h]

/-- `E*_l(y) E*_{ij} = δ_{jl} E*_{ij}`. -/
theorem subconst_mul_subconstij_y (G : SimpleGraph X) (x y : X) (l i j : ℕ) :
    subconst (𝕜 := ℂ) G y l * subconstij G x y i j
      = if j = l then subconstij G x y i j else 0 := by
  rw [subconstij, ← mul_assoc, subconst_mul_subconst_comm (G := G) y x l i, mul_assoc,
    subconst_mul_subconst]
  by_cases h : l = j <;> simp [h, eq_comm]

/-- Action of `E*_{ij}` on a vector, entrywise. -/
theorem subconstij_mulVec_apply (G : SimpleGraph X) (x y : X) (i j : ℕ) (v : X → ℂ) (u : X) :
    (subconstij G x y i j *ᵥ v) u
      = ((if G.dist x u = i then (1 : ℂ) else 0) * (if G.dist y u = j then 1 else 0)) * v u := by
  rw [subconstij_eq_diagonal, Matrix.mulVec, dotProduct, Finset.sum_eq_single u]
  · simp
  · intro b _ hb; simp [Ne.symm hb]
  · intro h; exact absurd (Finset.mem_univ u) h

/-- `E*_{ij}` kills everything outside its level. -/
theorem subconstij_mulVec_apply_eq_zero (G : SimpleGraph X) (x y : X) (i j : ℕ) (v : X → ℂ)
    {u : X} (h : G.dist x u ≠ i ∨ G.dist y u ≠ j) :
    (subconstij G x y i j *ᵥ v) u = 0 := by
  rw [subconstij_mulVec_apply]
  rcases h with h | h <;> simp [h]

/-- Collapsing a two-vertex sandwich: `E*_{ik} (E*_m(x) M E*_l(x)) E*_{i'j'}` collapses
to `E*_{ik} M E*_{i'j'}` when `i = m` and `l = i'`, and vanishes otherwise. -/
theorem subconstij_sandwich_collapse (G : SimpleGraph X) (x y : X) (i k m l i' j' : ℕ)
    (M : Matrix X X ℂ) :
    subconstij G x y i k * (subconst (𝕜 := ℂ) G x m * M * subconst (𝕜 := ℂ) G x l)
        * subconstij G x y i' j'
      = if i = m then (if i' = l then subconstij G x y i k * M * subconstij G x y i' j'
          else 0) else 0 := by
  have h1 := subconstij_mul_subconst (G := G) x y i k m
  have h2 := subconst_mul_subconstij (G := G) x y l i' j'
  have hassoc : subconstij G x y i k
        * (subconst (𝕜 := ℂ) G x m * M * subconst (𝕜 := ℂ) G x l) * subconstij G x y i' j'
      = (subconstij G x y i k * subconst (𝕜 := ℂ) G x m) * M
        * (subconst (𝕜 := ℂ) G x l * subconstij G x y i' j') := by noncomm_ring
  rw [hassoc, h1, h2]
  by_cases hi : i = m <;> by_cases hl : i' = l <;> simp [hi, hl]

/-- **The level calculus of the raising operator.**  `R` raises the `x`-level by one
and changes the `y`-level by at most one: `E*_{ik} R E*_{i-1,j} = 0` unless
`|k - j| ≤ 1`.  This is the input to the lecture-37 argument
`R^{i-1}δ⁺₁₀ ∈ E*_{i,i-1}V`, `R^{i-1}δ⁺₁₁ ∈ E*_{i,i-1}V + E*_{i,i}V`. -/
theorem subconstij_mul_raising_mul_subconstij_eq_zero {G : SimpleGraph X} {x y : X}
    {D i j k : ℕ} (hi : 1 ≤ i) (hiD : i ≤ D) (h : k + 1 < j ∨ j + 1 < k) :
    subconstij G x y i k * raising (𝕜 := ℂ) G x D * subconstij G x y (i - 1) j = 0 := by
  have hik : i - 1 + 1 = i := by omega
  have hband : subconstij G x y i k * adj (𝕜 := ℂ) G * subconstij G x y (i - 1) j = 0 := by
    rcases h with h | h
    · exact subconstij_mul_adj_mul_subconstij_eq_zero (x := x) (y := y)
        (Or.inr (Or.inr (Or.inr h)))
    · exact subconstij_mul_adj_mul_subconstij_eq_zero (x := x) (y := y)
        (Or.inr (Or.inr (Or.inl h)))
  have hterm : ∀ m ∈ Finset.range D,
      subconstij G x y i k
          * (subconst (𝕜 := ℂ) G x (m + 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x m)
          * subconstij G x y (i - 1) j
        = if m = i - 1 then
            subconstij G x y i k * adj (𝕜 := ℂ) G * subconstij G x y (i - 1) j else 0 := by
    intro m _
    rw [subconstij_sandwich_collapse (G := G) x y i k (m + 1) m (i - 1) j
      (adj (𝕜 := ℂ) G)]
    by_cases hm : m = i - 1
    · subst hm
      simp [hik]
    · rw [if_neg (by omega : ¬ i = m + 1), if_neg hm]
  calc subconstij G x y i k * raising (𝕜 := ℂ) G x D * subconstij G x y (i - 1) j
      = ∑ m ∈ Finset.range D, subconstij G x y i k
          * (subconst (𝕜 := ℂ) G x (m + 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x m)
          * subconstij G x y (i - 1) j := by
        rw [raising, Finset.mul_sum, Finset.sum_mul]
    _ = ∑ m ∈ Finset.range D, (if m = i - 1 then
          subconstij G x y i k * adj (𝕜 := ℂ) G * subconstij G x y (i - 1) j else 0) :=
        Finset.sum_congr rfl hterm
    _ = subconstij G x y i k * adj (𝕜 := ℂ) G * subconstij G x y (i - 1) j := by
        rw [Finset.sum_eq_single (i - 1)]
        · simp
        · intro b _ hb; simp [hb]
        · intro hmem
          exact absurd (Finset.mem_range.mpr (by omega)) hmem
    _ = 0 := hband

namespace DRGData

/-! ### Sandwiches with `E*₁(x)` -/

/-- `E*₁ÃE*₁ = Ã`. -/
theorem subconst_sandwich_tildeA {G : SimpleGraph X} {x : X} {D : ℕ} (Y : DRGData G x D) :
    subconst (𝕜 := ℂ) G x 1 * Y.tildeA * subconst (𝕜 := ℂ) G x 1 = Y.tildeA := by
  rw [(tildeA_mul_e1star Y).2, (tildeA_mul_e1star Y).1]

/-- `E*₁J̃E*₁ = J̃`. -/
theorem subconst_sandwich_tildeJ {G : SimpleGraph X} {x : X} {D : ℕ} (Y : DRGData G x D) :
    subconst (𝕜 := ℂ) G x 1 * Y.tildeJ * subconst (𝕜 := ℂ) G x 1 = Y.tildeJ := by
  rw [(tildeJ_mul_e1star Y).2, (tildeJ_mul_e1star Y).1]

/-- `E*₁E*₁E*₁ = E*₁`. -/
theorem subconst_sandwich_self {G : SimpleGraph X} (x : X) :
    subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G x 1
      * subconst (𝕜 := ℂ) G x 1 = subconst (𝕜 := ℂ) G x 1 := by
  simp [subconst_mul_self]

/-- The `E*₁`-sandwich of a sum. -/
theorem subconst_sandwich_add {G : SimpleGraph X} {x : X} {M N : Matrix X X ℂ}
    (hM : subconst (𝕜 := ℂ) G x 1 * M * subconst (𝕜 := ℂ) G x 1 = M)
    (hN : subconst (𝕜 := ℂ) G x 1 * N * subconst (𝕜 := ℂ) G x 1 = N) :
    subconst (𝕜 := ℂ) G x 1 * (M + N) * subconst (𝕜 := ℂ) G x 1 = M + N := by
  rw [mul_add, add_mul, hM, hN]

/-- The `E*₁`-sandwich of a difference. -/
theorem subconst_sandwich_sub {G : SimpleGraph X} {x : X} {M N : Matrix X X ℂ}
    (hM : subconst (𝕜 := ℂ) G x 1 * M * subconst (𝕜 := ℂ) G x 1 = M)
    (hN : subconst (𝕜 := ℂ) G x 1 * N * subconst (𝕜 := ℂ) G x 1 = N) :
    subconst (𝕜 := ℂ) G x 1 * (M - N) * subconst (𝕜 := ℂ) G x 1 = M - N := by
  rw [mul_sub, sub_mul, hM, hN]

/-- The `E*₁`-sandwich of a scalar multiple. -/
theorem subconst_sandwich_smul {G : SimpleGraph X} {x : X} {M : Matrix X X ℂ} (c : ℂ)
    (hM : subconst (𝕜 := ℂ) G x 1 * M * subconst (𝕜 := ℂ) G x 1 = M) :
    subconst (𝕜 := ℂ) G x 1 * (c • M) * subconst (𝕜 := ℂ) G x 1 = c • M := by
  rw [Matrix.mul_smul, Matrix.smul_mul, hM]

/-- Entries of a matrix that is fixed by the `E*₁`-sandwich vanish outside `S₁(x)`. -/
theorem subconst_sandwich_apply {G : SimpleGraph X} {x : X} {M : Matrix X X ℂ}
    (h : subconst (𝕜 := ℂ) G x 1 * M * subconst (𝕜 := ℂ) G x 1 = M) {u v : X}
    (hu : G.dist x u ≠ 1) : M u v = 0 := by
  have h1 : (subconst (𝕜 := ℂ) G x 1 * M * subconst (𝕜 := ℂ) G x 1) u v
      = ((subconst (𝕜 := ℂ) G x 1 * M) u v) * (if G.dist x v = 1 then (1 : ℂ) else 0) := by
    rw [Matrix.mul_apply, Finset.sum_eq_single v]
    · rw [subconst_apply, if_pos rfl]
    · intro b _ hb
      simp [subconst_apply, hb]
    · intro h; exact absurd (Finset.mem_univ v) h
  have h2 : (subconst (𝕜 := ℂ) G x 1 * M) u v = 0 := by
    rw [Matrix.mul_apply, Finset.sum_eq_zero]
    intro k _
    rw [subconst_apply]
    by_cases hk : u = k
    · subst hk; rw [if_pos rfl, if_neg hu]; simp
    · rw [if_neg hk]; simp
  rw [← h, h1, h2, zero_mul]

/-! ### The support of `A⁺` and `A⁻` -/

/-- **`A⁺ = R⁻¹E*₂A₂E*₁ - ΨE*₁` is supported in `S₁(x) × S₁(x)`** — the third
conjunct of `IsGeneralizedAdjacencyFirstSubconst` for `A⁺`.

The hypothesis `hblock` is the level-`2` case of Lemma 31.1 (ii)
(`R⁻¹(E*_iV) ⊆ E*_{i-1}V`, i.e. `R⁻¹` lowers the `x`-level by exactly one).  It is
**not** implied by the one-sided inverse identity `Rinv * R = 1 - E*_D` of the audited
hypotheses of `aplus_aminus_generalized`; the extra input is recorded in `AUDIT-QH.md`
of the QH working directory. -/
theorem aplus_subconst_sandwich {G : SimpleGraph X} {x : X} {Rinv : Matrix X X ℂ} (Ψ : ℂ)
    (hblock : Rinv = subconst (𝕜 := ℂ) G x 1 * Rinv * subconst (𝕜 := ℂ) G x 2) :
    subconst (𝕜 := ℂ) G x 1
        * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1
          - Ψ • subconst (𝕜 := ℂ) G x 1)
        * subconst (𝕜 := ℂ) G x 1
      = Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1
        - Ψ • subconst (𝕜 := ℂ) G x 1 := by
  have step : subconst (𝕜 := ℂ) G x 1
        * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1
          - Ψ • subconst (𝕜 := ℂ) G x 1) * subconst (𝕜 := ℂ) G x 1
      = subconst (𝕜 := ℂ) G x 1
          * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1)
          * subconst (𝕜 := ℂ) G x 1
        - subconst (𝕜 := ℂ) G x 1 * (Ψ • subconst (𝕜 := ℂ) G x 1) * subconst (𝕜 := ℂ) G x 1 := by
    rw [mul_sub, sub_mul]
  have h1 : subconst (𝕜 := ℂ) G x 1
        * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1)
        * subconst (𝕜 := ℂ) G x 1
      = Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1 := by
    have e : subconst (𝕜 := ℂ) G x 1
          * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1)
          * subconst (𝕜 := ℂ) G x 1
        = (subconst (𝕜 := ℂ) G x 1 * Rinv * subconst (𝕜 := ℂ) G x 2)
            * distMatrix (𝕜 := ℂ) G 2 * (subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G x 1) := by
      noncomm_ring
    have hRE : Rinv * subconst (𝕜 := ℂ) G x 2 = Rinv := by
      rw [hblock, mul_assoc, subconst_mul_self, ← hblock]
    rw [e, subconst_mul_self, hblock.symm, hRE]
  have h2 : subconst (𝕜 := ℂ) G x 1 * (Ψ • subconst (𝕜 := ℂ) G x 1) * subconst (𝕜 := ℂ) G x 1
      = Ψ • subconst (𝕜 := ℂ) G x 1 := by
    rw [Matrix.mul_smul, Matrix.smul_mul, subconst_mul_self, subconst_mul_self]
  rw [step, h1, h2]

/-- Entries of `A⁺` vanish off the first subconstituent (third conjunct of
`IsGeneralizedAdjacencyFirstSubconst`). -/
theorem aplus_apply_eq_zero_of_dist_ne_one {G : SimpleGraph X} {x : X}
    {Rinv : Matrix X X ℂ} (Ψ : ℂ)
    (hblock : Rinv = subconst (𝕜 := ℂ) G x 1 * Rinv * subconst (𝕜 := ℂ) G x 2)
    {u v : X} (hu : G.dist x u ≠ 1) :
    (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1
        - Ψ • subconst (𝕜 := ℂ) G x 1) u v = 0 :=
  subconst_sandwich_apply (aplus_subconst_sandwich (G := G) (x := x) Ψ hblock) hu

/-- **`A⁻ = ÃA⁺ - (a₂/c₂ - Ψ)E*₁ + Ψ(J̃ - Ã - E*₁)` is supported in `S₁(x) × S₁(x)`**,
given the same statement for `A⁺`.  No level hypothesis is needed here: `Ã`, `J̃` and
`E*₁` all live on the first subconstituent. -/
theorem aminus_subconst_sandwich {G : SimpleGraph X} {x : X} {D : ℕ} (Y : DRGData G x D)
    {Rinv : Matrix X X ℂ} (Ψ : ℂ)
    (hP : subconst (𝕜 := ℂ) G x 1
        * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1
          - Ψ • subconst (𝕜 := ℂ) G x 1)
        * subconst (𝕜 := ℂ) G x 1
      = Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1
        - Ψ • subconst (𝕜 := ℂ) G x 1) :
    subconst (𝕜 := ℂ) G x 1
        * (Y.tildeA * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2
            * subconst (𝕜 := ℂ) G x 1 - Ψ • subconst (𝕜 := ℂ) G x 1)
          - (((aval G x 2 : ℂ) / (cval G x 2 : ℂ)) - Ψ) • subconst (𝕜 := ℂ) G x 1
          + Ψ • (Y.tildeJ - Y.tildeA - subconst (𝕜 := ℂ) G x 1))
        * subconst (𝕜 := ℂ) G x 1
      = Y.tildeA * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2
            * subconst (𝕜 := ℂ) G x 1 - Ψ • subconst (𝕜 := ℂ) G x 1)
          - (((aval G x 2 : ℂ) / (cval G x 2 : ℂ)) - Ψ) • subconst (𝕜 := ℂ) G x 1
          + Ψ • (Y.tildeJ - Y.tildeA - subconst (𝕜 := ℂ) G x 1) := by
  have hJ : subconst (𝕜 := ℂ) G x 1 * Y.tildeJ * subconst (𝕜 := ℂ) G x 1 = Y.tildeJ :=
    subconst_sandwich_tildeJ Y
  have hA : subconst (𝕜 := ℂ) G x 1 * Y.tildeA * subconst (𝕜 := ℂ) G x 1 = Y.tildeA :=
    subconst_sandwich_tildeA Y
  have hPE : (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2
        * subconst (𝕜 := ℂ) G x 1 - Ψ • subconst (𝕜 := ℂ) G x 1) * subconst (𝕜 := ℂ) G x 1
      = Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2
        * subconst (𝕜 := ℂ) G x 1 - Ψ • subconst (𝕜 := ℂ) G x 1 := by
    rw [← hP, mul_assoc, subconst_mul_self]
  have hprod : subconst (𝕜 := ℂ) G x 1
        * (Y.tildeA * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2
            * subconst (𝕜 := ℂ) G x 1 - Ψ • subconst (𝕜 := ℂ) G x 1))
        * subconst (𝕜 := ℂ) G x 1
      = Y.tildeA * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2
            * subconst (𝕜 := ℂ) G x 1 - Ψ • subconst (𝕜 := ℂ) G x 1) := by
    have e : subconst (𝕜 := ℂ) G x 1
          * (Y.tildeA * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2
              * subconst (𝕜 := ℂ) G x 1 - Ψ • subconst (𝕜 := ℂ) G x 1))
          * subconst (𝕜 := ℂ) G x 1
        = (subconst (𝕜 := ℂ) G x 1 * Y.tildeA)
            * ((Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2
              * subconst (𝕜 := ℂ) G x 1 - Ψ • subconst (𝕜 := ℂ) G x 1) * subconst (𝕜 := ℂ) G x 1) := by
      noncomm_ring
    rw [e, (tildeA_mul_e1star Y).2, hPE]
  have h2 : subconst (𝕜 := ℂ) G x 1
      * ((((aval G x 2 : ℂ) / (cval G x 2 : ℂ)) - Ψ) • subconst (𝕜 := ℂ) G x 1)
      * subconst (𝕜 := ℂ) G x 1
      = ((((aval G x 2 : ℂ) / (cval G x 2 : ℂ)) - Ψ) • subconst (𝕜 := ℂ) G x 1) :=
    subconst_sandwich_smul _ (subconst_sandwich_self x)
  have h3 : subconst (𝕜 := ℂ) G x 1
      * (Y.tildeJ - Y.tildeA - subconst (𝕜 := ℂ) G x 1) * subconst (𝕜 := ℂ) G x 1
      = Y.tildeJ - Y.tildeA - subconst (𝕜 := ℂ) G x 1 :=
    subconst_sandwich_sub (subconst_sandwich_sub hJ hA) (subconst_sandwich_self x)
  have h4 : subconst (𝕜 := ℂ) G x 1
      * (Y.tildeA * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2
          * subconst (𝕜 := ℂ) G x 1 - Ψ • subconst (𝕜 := ℂ) G x 1)
        - ((((aval G x 2 : ℂ) / (cval G x 2 : ℂ)) - Ψ) • subconst (𝕜 := ℂ) G x 1))
      * subconst (𝕜 := ℂ) G x 1
      = Y.tildeA * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2
          * subconst (𝕜 := ℂ) G x 1 - Ψ • subconst (𝕜 := ℂ) G x 1)
        - ((((aval G x 2 : ℂ) / (cval G x 2 : ℂ)) - Ψ) • subconst (𝕜 := ℂ) G x 1) :=
    subconst_sandwich_sub hprod h2
  exact subconst_sandwich_add h4 (subconst_sandwich_smul _ h3)

/-- Entries of `A⁻` vanish off the first subconstituent. -/
theorem aminus_apply_eq_zero_of_dist_ne_one {G : SimpleGraph X} {x : X} {D : ℕ}
    (Y : DRGData G x D) {Rinv : Matrix X X ℂ} (Ψ : ℂ)
    (hP : subconst (𝕜 := ℂ) G x 1
        * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1
          - Ψ • subconst (𝕜 := ℂ) G x 1)
        * subconst (𝕜 := ℂ) G x 1
      = Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1
        - Ψ • subconst (𝕜 := ℂ) G x 1)
    {u v : X} (hu : G.dist x u ≠ 1) :
    (Y.tildeA * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2
          * subconst (𝕜 := ℂ) G x 1 - Ψ • subconst (𝕜 := ℂ) G x 1)
        - (((aval G x 2 : ℂ) / (cval G x 2 : ℂ)) - Ψ) • subconst (𝕜 := ℂ) G x 1
        + Ψ • (Y.tildeJ - Y.tildeA - subconst (𝕜 := ℂ) G x 1)) u v = 0 :=
  subconst_sandwich_apply (aminus_subconst_sandwich Y Ψ hP) hu

/-! ### A defect in the relativization of Definition 37.2

`IsGeneralizedAdjacencyFirstSubconst` requires `B ∈ Algebra.adjoin ℂ {Ã, J̃}`.  In
Definition 37.2 of lecture 37 the algebra is the one generated *inside* the matrices on
the vertex set of the induced subgraph `Γ₁` on `S₁(x)`; its identity is therefore
`E*₁(x)`, not the identity of `Mat_X(ℂ)`.  As a subalgebra of `Mat_X(ℂ)` the algebra
`Algebra.adjoin ℂ {Ã, J̃}` contains the *full* identity (the empty product), so it can
only be the correct relativization if `E*₁(x)` happens to lie in it.  It does not in
general:  whenever `Ã = 0` (no two neighbours of `x` are adjacent) and `S₁(x)` has two
vertices and a vertex outside it, `Algebra.adjoin ℂ {Ã, J̃} = span{1, J̃}` while
`E*₁(x) ∉ span{1, J̃}`.  The correct generating set is `{Ã, J̃, E*₁}`. -/

/-- If `Ã = 0` then `Algebra.adjoin ℂ {Ã, J̃} ⊆ span{1, J̃}` (`J̃² = k J̃`). -/
theorem adjoin_tildeA_tildeJ_le_span {G : SimpleGraph X} {x : X} {D : ℕ} (Y : DRGData G x D)
    (hA : Y.tildeA = 0) :
    (Algebra.adjoin ℂ ({Y.tildeA, Y.tildeJ} : Set (Matrix X X ℂ)) : Set (Matrix X X ℂ))
      ⊆ (Submodule.span ℂ ({1, Y.tildeJ} : Set (Matrix X X ℂ)) : Set (Matrix X X ℂ)) := by
  set S : Submodule ℂ (Matrix X X ℂ) := Submodule.span ℂ ({1, Y.tildeJ} : Set (Matrix X X ℂ))
    with hS
  have h1 : (1 : Matrix X X ℂ) ∈ S := Submodule.subset_span (Set.mem_insert_iff.mpr (Or.inl rfl))
  have hJ : Y.tildeJ ∈ S :=
    Submodule.subset_span (Set.mem_insert_iff.mpr (Or.inr rfl))
  have hgen : ∀ x' ∈ ({Y.tildeA, Y.tildeJ} : Set (Matrix X X ℂ)), x' ∈ S := by
    intro x' hx'
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx'
    rcases hx' with rfl | rfl
    · rw [hA]; exact Submodule.zero_mem _
    · exact hJ
  have hclos : ∀ a b : Matrix X X ℂ, a ∈ S → b ∈ S → a * b ∈ S := by
    intro a b ha hb
    induction ha using Submodule.span_induction with
    | mem x' hx' =>
      induction hb using Submodule.span_induction with
      | mem y' hy' =>
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx' hy'
        rcases hx' with rfl | rfl <;> rcases hy' with rfl | rfl
        · simpa using h1
        · simpa using hJ
        · simpa using hJ
        · rw [tildeJ_mul_tildeJ Y]; exact Submodule.smul_mem _ _ hJ
      | add u v _ _ hu hv => rw [mul_add]; exact Submodule.add_mem _ hu hv
      | zero => rw [mul_zero]; exact Submodule.zero_mem _
      | smul c u _ hu => rw [Matrix.mul_smul]; exact Submodule.smul_mem _ _ hu
    | add u v _ _ hu hv => rw [add_mul]; exact Submodule.add_mem _ hu hv
    | zero => rw [zero_mul]; exact Submodule.zero_mem _
    | smul c u _ hu => rw [Matrix.smul_mul]; exact Submodule.smul_mem _ _ hu
  intro a ha
  induction ha using Algebra.adjoin_induction with
  | mem z hz => exact hgen z hz
  | algebraMap r =>
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ _ h1
  | add z w _ _ hz hw => exact Submodule.add_mem _ hz hw
  | mul z w _ _ hz hw => exact hclos z w hz hw

/-- **The identity `E*₁(x)` of the relativized algebra need not lie in
`Algebra.adjoin ℂ {Ã, J̃}`.**  If `Ã = 0` (the induced subgraph on `S₁(x)` has no
edges), `S₁(x)` has two distinct vertices and does not exhaust `X`, then
`E*₁(x) ∉ Algebra.adjoin ℂ {Ã, J̃}` — although it does lie in
`Algebra.adjoin ℂ {Ã, J̃, E*₁}` (trivially).  This is why the relativized Definition
37.2 (ii) must be stated with `E*₁` in the generating set. -/
theorem subconst_not_mem_adjoin_of_tildeA_eq_zero {G : SimpleGraph X} {x : X} {D : ℕ}
    (Y : DRGData G x D) (hA : Y.tildeA = 0)
    {u v w : X} (huv : u ≠ v) (hu : G.dist x u = 1) (hv : G.dist x v = 1)
    (hw : G.dist x w ≠ 1) :
    subconst (𝕜 := ℂ) G x 1 ∉ Algebra.adjoin ℂ ({Y.tildeA, Y.tildeJ} : Set (Matrix X X ℂ)) := by
  intro hmem
  have hspan := adjoin_tildeA_tildeJ_le_span Y hA hmem
  -- the functional `M ↦ M u v + M w w - M u u` vanishes on `span{1, J̃}`
  have hkill : ∀ z ∈ (Submodule.span ℂ ({1, Y.tildeJ} : Set (Matrix X X ℂ)) : Set (Matrix X X ℂ)),
      z u v + z w w - z u u = 0 := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem y' hy' =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy'
      rcases hy' with rfl | rfl
      · simp [huv]
      · rw [tildeJ_apply Y u v, tildeJ_apply Y w w, tildeJ_apply Y u u]
        simp [hu, hv, hw]
    | add a b _ _ ha hb =>
      simp only [Matrix.add_apply]
      linear_combination ha + hb
    | zero => simp
    | smul c a _ ha =>
      simp only [Matrix.smul_apply, smul_eq_mul]
      linear_combination c * ha
  have h := hkill _ hspan
  simp [subconst_apply, huv, hw, hu] at h
/-! ### The lecture-37 passage `E*_{i+1,k}R(x)E*_{ij} = E*_{i+1,k}A E*_{ij}`

Lecture 37's proof of `generalized-adjacecy-matrix` controls `R^{i-1}δ⁺₁₂` through
`E*_{i,i+1}R^{i-1}δ⁺₁₂ = R(y)^{i-1}δ⁺₁₂`; its `i = 2` case starts with the collapse below:
against the two-vertex levels only the `x`-level-`i` summand of `R(x)` survives. -/

/-- `E*_{ik}(E*_m(x) A E*_l(x)) = δ_{im} E*_{ik} A E*_l(x)`. -/
theorem subconstij_mul_subconst_adj_subconst (G : SimpleGraph X) (x y : X) (i k m l : ℕ) :
    subconstij G x y i k * (subconst (𝕜 := ℂ) G x m * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x l)
      = if i = m then subconstij G x y i k * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x l
        else 0 := by
  rw [show subconstij G x y i k
        * (subconst (𝕜 := ℂ) G x m * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x l)
      = (subconstij G x y i k * subconst (𝕜 := ℂ) G x m) * adj (𝕜 := ℂ) G
        * subconst (𝕜 := ℂ) G x l from by noncomm_ring]
  rw [subconstij_mul_subconst]
  by_cases h : i = m <;> simp [h]

/-- `E*_{i+1,k}R(x) = E*_{i+1,k}A E*_i(x)`: on the `x`-level `i` the whole sum in `R`
collapses to its single term. -/
theorem subconstij_mul_raising_eq {G : SimpleGraph X} {x y : X} {D i k : ℕ} (hi : i < D) :
    subconstij G x y (i + 1) k * raising (𝕜 := ℂ) G x D
      = subconstij G x y (i + 1) k * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x i := by
  rw [raising, Finset.mul_sum]
  rw [Finset.sum_eq_single i]
  · rw [subconstij_mul_subconst_adj_subconst (G := G) x y (i + 1) k (i + 1) i, if_pos rfl]
  · intro j _ hji
    rw [subconstij_mul_subconst_adj_subconst (G := G) x y (i + 1) k (j + 1) j,
      if_neg (by omega : ¬ i + 1 = j + 1)]
  · intro hmem
    exact absurd (Finset.mem_range.mpr hi) hmem

/-- `E*_{i+1,k}R(x)E*_{ij} = E*_{i+1,k}A E*_{ij}`. -/
theorem subconstij_mul_raising_mul_subconstij_eq {G : SimpleGraph X} {x y : X} {D i k j : ℕ}
    (hi : i < D) :
    subconstij G x y (i + 1) k * raising (𝕜 := ℂ) G x D * subconstij G x y i j
      = subconstij G x y (i + 1) k * adj (𝕜 := ℂ) G * subconstij G x y i j := by
  rw [subconstij_mul_raising_eq (G := G) (x := x) (y := y) (D := D) (i := i) (k := k) hi,
    mul_assoc, subconst_mul_subconstij (G := G) x y i i j, if_pos rfl]


/-- `E*_j(y)E*₁(x)E*₂(y) = δ_{j2} E*₁(x)E*₂(y)`. -/
theorem subconst_y_mul_subconst_x_mul_subconst_y (G : SimpleGraph X) (x y : X) (j : ℕ) :
    subconst (𝕜 := ℂ) G y j * subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 2
      = if j = 2 then subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 2 else 0 := by
  rw [subconst_mul_subconst_comm (G := G) y x j 1, mul_assoc, subconst_mul_subconst]
  by_cases h : j = 2 <;> simp [h]

/-- `R(y)(E*₁(x)E*₂(y)) = E*₃(y)A(E*₁(x)E*₂(y))`: against the two-vertex level `(1,2)`
only the `y`-level-`2` summand of `R(y)` survives. -/
theorem raising_y_mul_subconst_x_mul_subconst_y (G : SimpleGraph X) (x y : X) {D : ℕ}
    (hD : 2 ≤ D) :
    raising (𝕜 := ℂ) G y (D + 1) * (subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 2)
      = subconst (𝕜 := ℂ) G y 3 * adj (𝕜 := ℂ) G
        * (subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 2) := by
  rw [raising, Finset.sum_mul]
  rw [Finset.sum_eq_single 2]
  · rw [show subconst (𝕜 := ℂ) G y 3 * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G y 2
          * (subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 2)
        = subconst (𝕜 := ℂ) G y 3 * adj (𝕜 := ℂ) G
          * (subconst (𝕜 := ℂ) G y 2 * subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 2)
        from by noncomm_ring]
    rw [subconst_y_mul_subconst_x_mul_subconst_y (G := G) x y 2, if_pos rfl]
  · intro j _ hj2
    rw [show subconst (𝕜 := ℂ) G y (j + 1) * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G y j
          * (subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 2)
        = subconst (𝕜 := ℂ) G y (j + 1) * adj (𝕜 := ℂ) G
          * (subconst (𝕜 := ℂ) G y j * subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 2)
        from by noncomm_ring]
    rw [subconst_y_mul_subconst_x_mul_subconst_y (G := G) x y j, if_neg hj2]
    simp
  · intro hmem
    exact absurd (Finset.mem_range.mpr (by omega : 2 < D + 1)) hmem

/-- `E*₂(x)R(y)E*_{1,2} = E*_{2,3}(x,y)A E*_{1,2}`: the `y`-side companion of
`subconstij_mul_raising_mul_subconstij_eq`.  Together they give
`E*_{2,3}R(x)E*_{1,2} = E*₂(x)R(y)E*_{1,2}`, i.e. lecture 37's
`E*_{i,i+1}R^{i-1}δ⁺₁₂ = R(y)^{i-1}δ⁺₁₂` at `i = 2`. -/
theorem subconst_raising_y_mul_subconstij_eq {G : SimpleGraph X} {x y : X} {D : ℕ}
    (hD : 2 ≤ D) :
    subconst (𝕜 := ℂ) G x 2 * raising (𝕜 := ℂ) G y (D + 1) * subconstij G x y 1 2
      = subconstij G x y 2 3 * adj (𝕜 := ℂ) G * subconstij G x y 1 2 := by
  simp only [subconstij]
  rw [mul_assoc, raising_y_mul_subconst_x_mul_subconst_y (G := G) x y hD]
  noncomm_ring

/-- **The passage `R(x) → R(y)` at `i = 2`**: `E*_{2,3}R(x)E*_{1,2} = E*₂(x)R(y)E*_{1,2}`. -/
theorem subconstij_mul_raising_eq_subconst_raising_y {G : SimpleGraph X} {x y : X} {D : ℕ}
    (hD : 1 < D) :
    subconstij G x y 2 3 * raising (𝕜 := ℂ) G x D * subconstij G x y 1 2
      = subconst (𝕜 := ℂ) G x 2 * raising (𝕜 := ℂ) G y (D + 1) * subconstij G x y 1 2 := by
  rw [subconstij_mul_raising_mul_subconstij_eq (G := G) (x := x) (y := y) (D := D)
      (i := 1) (k := 3) (j := 2) (by omega),
    ← subconst_raising_y_mul_subconstij_eq (G := G) (x := x) (y := y) (D := D) (by omega)]


/-- Entrywise form of a two-vertex sandwich around the distance-`2` matrix. -/
theorem subconstij_mul_distMatrix_two_mul_subconstij_apply (G : SimpleGraph X) (x y : X)
    (i k l j : ℕ) (u v : X) :
    (subconstij G x y i k * distMatrix (𝕜 := ℂ) G 2 * subconstij G x y l j) u v
      = ((if G.dist x u = i then (1 : ℂ) else 0) * (if G.dist y u = k then 1 else 0))
        * distMatrix (𝕜 := ℂ) G 2 u v
        * ((if G.dist x v = l then (1 : ℂ) else 0) * (if G.dist y v = j then 1 else 0)) := by
  rw [subconstij_eq_diagonal (G := G) x y i k, subconstij_eq_diagonal (G := G) x y l j,
    Matrix.mul_assoc, Matrix.diagonal_mul, Matrix.mul_diagonal]
  noncomm_ring

/-- **Level calculus for the distance-`2` matrix** (the companion of
`subconstij_mul_raising_mul_subconstij_eq_zero`): `A₂` moves the `y`-level by at most
two, so `E*_{ik}A₂E*_{lj} = 0` when `|k-j| > 2`.  This is what confines
`A⁺ŷ + Ψŷ = R⁻¹E*₂A₂E*₁ŷ` to `E*_{1,0}V + E*_{1,1}V + E*_{1,2}V` in lecture 37. -/
theorem subconstij_mul_distMatrix_two_mul_subconstij_eq_zero {G : SimpleGraph X}
    (hG : G.Connected) {x y : X} {i k l j : ℕ} (h : k + 2 < j ∨ j + 2 < k) :
    subconstij G x y i k * distMatrix (𝕜 := ℂ) G 2 * subconstij G x y l j = 0 := by
  ext u v
  rw [subconstij_mul_distMatrix_two_mul_subconstij_apply, Matrix.zero_apply]
  by_cases hk : G.dist y u = k
  · by_cases hj : G.dist y v = j
    · by_cases hD : distMatrix (𝕜 := ℂ) G 2 u v = 0
      · rw [hD, mul_zero, zero_mul]
      · exfalso
        rw [distMatrix_apply] at hD
        have hd2 : G.dist u v = 2 := by
          by_contra hne
          exact hD (if_neg hne)
        have h1 : G.dist y u ≤ G.dist y v + G.dist v u := hG.dist_triangle
        have h2 : G.dist v u = 2 := by
          rw [SimpleGraph.dist_comm]
          exact hd2
        have h3 : G.dist y v ≤ G.dist y u + G.dist u v := hG.dist_triangle
        rw [hk, hj, h2] at h1
        rw [hk, hj, hd2] at h3
        omega
    · simp [hj]
  · simp [hk]


/-! ### The vector computation behind `A⁺ŷ`

The lecture-37/39 argument applies `A⁺ = R⁻¹E*₂A₂E*₁ - ΨE*₁` to `ŷ` and decomposes the
result over the two-vertex levels `E*_{1,j}` (`j ≤ 2`).  The lemmas here compute the two
ingredients: the action on `ŷ`, and the action of `R(x)`. -/

/-- `A₂ŷ` is the indicator of the sphere of radius `2` around `y`. -/
theorem distMatrix_two_mulVec_single (G : SimpleGraph X) (y z : X) :
    (distMatrix (𝕜 := ℂ) G 2 *ᵥ (Pi.single y 1 : X → ℂ)) z
      = if G.dist z y = 2 then (1 : ℂ) else 0 := by
  rw [Matrix.mulVec, dotProduct, Finset.sum_eq_single y]
  · simp [distMatrix_apply]
  · intro b _ hb
    rw [Pi.single_apply, if_neg hb, mul_zero]
  · intro h; exact absurd (Finset.mem_univ y) h

/-- `E*₁(x)ŷ = ŷ` for adjacent `x`, `y`. -/
theorem subconst_one_mulVec_single_of_adj {G : SimpleGraph X} {x y : X} (hy : G.Adj x y) :
    subconst (𝕜 := ℂ) G x 1 *ᵥ (Pi.single y 1 : X → ℂ) = Pi.single y 1 := by
  rw [subconst_mulVec_single, if_pos (SimpleGraph.dist_eq_one_iff_adj.mpr hy), one_smul]

/-- `E*₀(x)` kills anything supported at `x`-distance `2`. -/
theorem subconst_zero_mulVec_subconst_two (G : SimpleGraph X) (x : X) (u : X → ℂ) :
    subconst (𝕜 := ℂ) G x 0 *ᵥ (subconst (𝕜 := ℂ) G x 2 *ᵥ u) = 0 := by
  rw [Matrix.mulVec_mulVec, subconst_mul_subconst, if_neg (by norm_num), Matrix.zero_mulVec]

/-- **The `R(x)`-computation**: on `A⁺ŷ + Ψŷ = R⁻¹E*₂A₂E*₁ŷ` the raising operator `R(x)`
produces the indicator of `S₂(x) ∩ S₂(y)`.  This is where the companion inverse identity
`raising * Rinv = 1 - E*₀` (Lemma 31.1's other half) enters. -/
theorem raising_mul_aplus_w {G : SimpleGraph X} {x : X} {D : ℕ} {y : X} (hy : G.Adj x y)
    {Rinv : Matrix X X ℂ}
    (hR' : raising (𝕜 := ℂ) G x D * Rinv = 1 - subconst (𝕜 := ℂ) G x 0) :
    raising (𝕜 := ℂ) G x D
        *ᵥ ((Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2
            * subconst (𝕜 := ℂ) G x 1) *ᵥ (Pi.single y 1 : X → ℂ))
      = subconst (𝕜 := ℂ) G x 2 *ᵥ (distMatrix (𝕜 := ℂ) G 2 *ᵥ (Pi.single y 1 : X → ℂ)) := by
  have hT : (subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1)
      *ᵥ (Pi.single y 1 : X → ℂ)
      = subconst (𝕜 := ℂ) G x 2 *ᵥ (distMatrix (𝕜 := ℂ) G 2 *ᵥ (Pi.single y 1 : X → ℂ)) := by
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, subconst_one_mulVec_single_of_adj hy]
  have hZ : (subconst (𝕜 := ℂ) G x 0
        * (subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1))
      *ᵥ (Pi.single y 1 : X → ℂ) = 0 := by
    have h0 : subconst (𝕜 := ℂ) G x 0
        * (subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1) = 0 := by
      rw [show subconst (𝕜 := ℂ) G x 0
            * (subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1)
          = (subconst (𝕜 := ℂ) G x 0 * subconst (𝕜 := ℂ) G x 2)
            * (distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1) from by noncomm_ring,
        subconst_mul_subconst, if_neg (by norm_num), zero_mul]
    rw [h0, Matrix.zero_mulVec]
  rw [Matrix.mulVec_mulVec, show raising (𝕜 := ℂ) G x D
        * (Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1)
      = (raising (𝕜 := ℂ) G x D * Rinv)
        * (subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1) from by
    noncomm_ring,
    hR', sub_mul, Matrix.sub_mulVec, one_mul, hT, hZ, sub_zero]


/-- Lemma 31.1 (ii) in block form: `E*₁(R⁻¹) = R⁻¹` if `R⁻¹` lowers the `x`-level by one. -/
theorem subconst_one_mul_rinv_eq {G : SimpleGraph X} {x : X} {Rinv : Matrix X X ℂ}
    (hblock : Rinv = subconst (𝕜 := ℂ) G x 1 * Rinv * subconst (𝕜 := ℂ) G x 2) :
    subconst (𝕜 := ℂ) G x 1 * Rinv = Rinv := by
  rw [hblock, show subconst (𝕜 := ℂ) G x 1
        * (subconst (𝕜 := ℂ) G x 1 * Rinv * subconst (𝕜 := ℂ) G x 2)
      = (subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G x 1) * Rinv
        * subconst (𝕜 := ℂ) G x 2 from by noncomm_ring, subconst_mul_self]

/-- The same, on the right: `(R⁻¹)E*₂ = R⁻¹`. -/
theorem rinv_mul_subconst_two_eq {G : SimpleGraph X} {x : X} {Rinv : Matrix X X ℂ}
    (hblock : Rinv = subconst (𝕜 := ℂ) G x 1 * Rinv * subconst (𝕜 := ℂ) G x 2) :
    Rinv * subconst (𝕜 := ℂ) G x 2 = Rinv := by
  rw [hblock, mul_assoc, subconst_mul_self, ← hblock]

/-- The matrix part `R⁻¹E*₂A₂E*₁` of `A⁺` (lecture 39), as an abbreviation. -/
def aplusCore (G : SimpleGraph X) (x : X) (Rinv : Matrix X X ℂ) : Matrix X X ℂ :=
  Rinv * subconst (𝕜 := ℂ) G x 2 * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1

/-- `E*₁(x)` fixes `R⁻¹E*₂A₂E*₁ = A⁺ + ΨE*₁` on the left. -/
theorem subconst_one_mul_aplusCore {G : SimpleGraph X} {x : X} {Rinv : Matrix X X ℂ}
    (hblock : Rinv = subconst (𝕜 := ℂ) G x 1 * Rinv * subconst (𝕜 := ℂ) G x 2) :
    subconst (𝕜 := ℂ) G x 1 * aplusCore G x Rinv = aplusCore G x Rinv := by
  rw [aplusCore, rinv_mul_subconst_two_eq hblock,
    show subconst (𝕜 := ℂ) G x 1
        * (Rinv * distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1)
      = (subconst (𝕜 := ℂ) G x 1 * Rinv)
        * (distMatrix (𝕜 := ℂ) G 2 * subconst (𝕜 := ℂ) G x 1) from by noncomm_ring,
    subconst_one_mul_rinv_eq hblock]
  noncomm_ring

/-- `E*₁(x)` fixes `A⁺ŷ + Ψŷ`. -/
theorem subconst_one_mulVec_aplusCore {G : SimpleGraph X} {x : X} {y : X}
    {Rinv : Matrix X X ℂ}
    (hblock : Rinv = subconst (𝕜 := ℂ) G x 1 * Rinv * subconst (𝕜 := ℂ) G x 2) :
    subconst (𝕜 := ℂ) G x 1 *ᵥ (aplusCore G x Rinv *ᵥ (Pi.single y 1 : X → ℂ))
      = aplusCore G x Rinv *ᵥ (Pi.single y 1 : X → ℂ) := by
  rw [Matrix.mulVec_mulVec, subconst_one_mul_aplusCore hblock]

/-- **The `R(x)`-computation** in `aplusCore` form. -/
theorem raising_mul_aplusCore_w {G : SimpleGraph X} {x : X} {D : ℕ} {y : X} (hy : G.Adj x y)
    {Rinv : Matrix X X ℂ}
    (hR' : raising (𝕜 := ℂ) G x D * Rinv = 1 - subconst (𝕜 := ℂ) G x 0) :
    raising (𝕜 := ℂ) G x D *ᵥ (aplusCore G x Rinv *ᵥ (Pi.single y 1 : X → ℂ))
      = subconst (𝕜 := ℂ) G x 2 *ᵥ (distMatrix (𝕜 := ℂ) G 2 *ᵥ (Pi.single y 1 : X → ℂ)) := by
  rw [aplusCore, raising_mul_aplus_w (G := G) (x := x) (D := D) hy hR']


/-- Action of a subconstituent projection on a vector, entrywise. -/
theorem subconst_mulVec_apply (G : SimpleGraph X) (x : X) (i : ℕ) (v : X → ℂ) (z : X) :
    (subconst (𝕜 := ℂ) G x i *ᵥ v) z = (if G.dist x z = i then (1 : ℂ) else 0) * v z := by
  rw [subconst, Matrix.mulVec, dotProduct, Finset.sum_eq_single z]
  · simp [Matrix.diagonal_apply]
  · intro b _ hb; simp [Ne.symm hb]
  · intro h; exact absurd (Finset.mem_univ z) h

/-- The level calculus at the vector level: if `v` sits in the two-vertex level `(1,j)`
with `j ≤ 1`, then `E*_{2,3}R(x)v = 0`. -/
theorem subconstij_mul_raising_mulVec_eq_zero {G : SimpleGraph X} {x y : X} {D j : ℕ}
    (hD : 2 ≤ D) (h : 3 + 1 < j ∨ j + 1 < 3) (v : X → ℂ)
    (hv : subconstij G x y 1 j *ᵥ v = v) :
    subconstij G x y 2 3 *ᵥ (raising (𝕜 := ℂ) G x D *ᵥ v) = 0 := by
  rw [← hv, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
    subconstij_mul_raising_mul_subconstij_eq_zero (G := G) (x := x) (y := y) (D := D)
      (i := 2) (j := j) (k := 3) (by omega) hD h, Matrix.zero_mulVec]

/-- `E*_{2,3}(x,y)` kills `A₂ŷ`'s `x`-level-`2` part: the result is supported at
`y`-level `2`, while `E*_{2,3}` needs `y`-level `3`. -/
theorem subconstij_mul_subconst_distMatrix_two_mulVec_single {G : SimpleGraph X} {x y : X} :
    subconstij G x y 2 3
        *ᵥ (subconst (𝕜 := ℂ) G x 2 *ᵥ (distMatrix (𝕜 := ℂ) G 2 *ᵥ (Pi.single y 1 : X → ℂ)))
      = 0 := by
  funext z
  rw [Pi.zero_apply, subconstij_mulVec_apply, subconst_mulVec_apply,
    distMatrix_two_mulVec_single]
  by_cases hzy : G.dist z y = 2
  · have hyz : G.dist y z = 2 := by rwa [SimpleGraph.dist_comm]
    simp [hyz]
  · simp [hzy]


/-- `R(y)` sends a vector that lives at `x`-level `1` and `y`-level `2` into `x`-level `2`
(and `y`-level `3`).  This is the level bookkeeping behind
`E*_{2,3}R(x)δ⁺₁₂ = R(y)δ⁺₁₂` of lecture 37. -/
theorem raising_y_apply_eq_zero {G : SimpleGraph X} {x : X} {D : ℕ} {y : X} (hy : G.Adj x y)
    (hG : G.Connected) (hD : 2 ≤ D) {v : X → ℂ}
    (hv1 : ∀ k, v k ≠ 0 → G.dist x k = 1)
    (hv2 : subconst (𝕜 := ℂ) G y 2 *ᵥ v = v) {u : X} (hu : G.dist x u ≠ 2) :
    (raising (𝕜 := ℂ) G y (D + 1) *ᵥ v) u = 0 := by
  have hcollapse : ∀ j : ℕ, subconst (𝕜 := ℂ) G y j *ᵥ v = if j = 2 then v else 0 := by
    intro j
    rw [← hv2, Matrix.mulVec_mulVec, subconst_mul_subconst]
    by_cases hj : j = 2 <;> simp [hj, hv2]
  have hR : raising (𝕜 := ℂ) G y (D + 1) *ᵥ v
      = subconst (𝕜 := ℂ) G y 3 *ᵥ (adj (𝕜 := ℂ) G *ᵥ v) := by
    rw [raising, Matrix.sum_mulVec]
    rw [Finset.sum_eq_single 2]
    · rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hv2]
    · intro j _ hj
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hcollapse j, if_neg hj,
        Matrix.mulVec_zero, Matrix.mulVec_zero]
    · intro hmem
      exact absurd (Finset.mem_range.mpr (by omega : 2 < D + 1)) hmem
  rw [hR, subconst_mulVec_apply]
  by_cases hy3 : G.dist y u = 3
  · rw [if_pos hy3]
    have hA : (adj (𝕜 := ℂ) G *ᵥ v) u = 0 := by
      rw [Matrix.mulVec, dotProduct, Finset.sum_eq_zero]
      intro k _
      by_cases hk : v k = 0
      · simp [hk]
      · have hxk : G.dist x k = 1 := hv1 k hk
        have hnu : ¬ G.Adj u k := by
          intro hadj
          have h1 : G.dist x u ≤ G.dist x k + G.dist k u := hG.dist_triangle
          have h2 : G.dist k u = 1 := SimpleGraph.dist_eq_one_iff_adj.mpr hadj.symm
          have h3 : G.dist y u ≤ G.dist y x + G.dist x u := hG.dist_triangle
          have h4 : G.dist y x = 1 := SimpleGraph.dist_eq_one_iff_adj.mpr hy.symm
          omega
        simp [adj_apply, hnu]
    rw [hA, mul_zero]
  · rw [if_neg hy3, zero_mul]

/-- Support of `E*_{ij}v`, in the form used below. -/
theorem subconstij_mulVec_support {G : SimpleGraph X} {x y : X} {i j : ℕ} {v : X → ℂ} {u : X}
    (h : (subconstij G x y i j *ᵥ v) u ≠ 0) : G.dist x u = i ∧ G.dist y u = j := by
  by_contra hc
  refine h (subconstij_mulVec_apply_eq_zero G x y i j v ?_)
  rcases not_and_or.mp hc with h1 | h2
  · exact Or.inl h1
  · exact Or.inr h2


/-- The two-vertex level `(1,2)` sits inside the `y`-level `2`. -/
theorem subconst_two_mulVec_subconstij_one_two (G : SimpleGraph X) (x y : X) (w : X → ℂ) :
    subconst (𝕜 := ℂ) G y 2 *ᵥ (subconstij G x y 1 2 *ᵥ w) = subconstij G x y 1 2 *ᵥ w := by
  funext z
  rw [subconst_mulVec_apply, subconstij_mulVec_apply]
  by_cases h : G.dist y z = 2
  · rw [if_pos h]; ring
  · rw [if_neg h, mul_zero, zero_mul, zero_mul]

set_option maxHeartbeats 400000 in
/-- **Conjunct (ii) of Lemma 39.3 for `A⁺`, modulo the two inputs the audited hypotheses
miss.**

With `y ∼ x`, `Ψ : ℂ`, `R⁻¹` satisfying the block structure of Lemma 31.1 (ii) (`hblock`)
and the companion inverse identity `raising * Rinv = 1 - E*₀` (`hR'`), and with `R(y)`
injective on `E*₂(y)V` (`hinj`, supplied by thinness at `y`), the matrix
`A⁺ = R⁻¹E*₂A₂E*₁ - ΨE*₁` has no nonzero entry at a pair `(z,y)` with `∂(x,z) = 1` and
`∂(y,z) = 2`.

This is exactly the step the lecture-39 proof of `aplus-aminus` takes from
`A⁺ŷ = δ⁺₁₀ + δ⁺₁₁`: the `E*_{1,2}`-component `δ⁺₁₂` of `A⁺ŷ + Ψŷ` vanishes because
`R(x)δ⁺₁₂` is `E*_{2,3}`-free, and `E*_{2,3}R(x) = R(y)` there. -/
theorem aplus_apply_eq_zero_of_dist_eq_two {G : SimpleGraph X} {x : X} {D : ℕ}
    (Y : DRGData G x D) {y : X} (hy : G.Adj x y) {Rinv : Matrix X X ℂ} (Ψ : ℂ)
    (hblock : Rinv = subconst (𝕜 := ℂ) G x 1 * Rinv * subconst (𝕜 := ℂ) G x 2)
    (hR' : raising (𝕜 := ℂ) G x D * Rinv = 1 - subconst (𝕜 := ℂ) G x 0)
    (hinj : ∀ v : X → ℂ, subconst (𝕜 := ℂ) G y 2 *ᵥ v = v →
      raising (𝕜 := ℂ) G y (D + 1) *ᵥ v = 0 → v = 0)
    {z : X} (hzx : G.dist x z = 1) (hzy : G.dist y z = 2) :
    (aplusCore G x Rinv - Ψ • subconst (𝕜 := ℂ) G x 1) z y = 0 := by
  have hD3 : 3 ≤ D := Y.hD
  set w : X → ℂ := aplusCore G x Rinv *ᵥ (Pi.single y 1 : X → ℂ) with hw
  have hw1 : subconst (𝕜 := ℂ) G x 1 *ᵥ w = w := by
    rw [hw]; exact subconst_one_mulVec_aplusCore hblock
  have hdy : ∀ u, G.dist y u ≤ D + 1 := by
    intro u
    have h1 : G.dist y u ≤ G.dist y x + G.dist x u := Y.connected.dist_triangle
    have h2 : G.dist y x = 1 := SimpleGraph.dist_eq_one_iff_adj.mpr hy.symm
    have h3 := Y.diam u
    omega
  have hdecomp : w = subconstij G x y 1 0 *ᵥ w + subconstij G x y 1 1 *ᵥ w
      + subconstij G x y 1 2 *ᵥ w := by
    have hE1 : subconst (𝕜 := ℂ) G x 1 = ∑ j ∈ Finset.range (D + 2), subconstij G x y 1 j :=
      subconst_one_eq_sum_subconstij (G := G) x y (D := D + 1) hdy
    have hsum : w = ∑ j ∈ Finset.range (D + 2), subconstij G x y 1 j *ᵥ w := by
      calc w = subconst (𝕜 := ℂ) G x 1 *ᵥ w := hw1.symm
        _ = (∑ j ∈ Finset.range (D + 2), subconstij G x y 1 j) *ᵥ w := by rw [hE1]
        _ = ∑ j ∈ Finset.range (D + 2), subconstij G x y 1 j *ᵥ w :=
            Matrix.sum_mulVec _ _ _
    have hzero : ∀ j ∈ Finset.range (D - 1), subconstij G x y 1 (3 + j) *ᵥ w = 0 := by
      intro j _
      rw [subconstij_eq_zero_of_dist Y.connected hy (Or.inr (by omega)), Matrix.zero_mulVec]
    refine hsum.trans ?_
    rw [show D + 2 = 3 + (D - 1) from by have := Y.hD; omega, Finset.sum_range_add,
      Finset.sum_eq_zero hzero, add_zero]
    simp [Finset.sum_range_succ]
  have hRw : raising (𝕜 := ℂ) G x D *ᵥ w
      = subconst (𝕜 := ℂ) G x 2 *ᵥ (distMatrix (𝕜 := ℂ) G 2 *ᵥ (Pi.single y 1 : X → ℂ)) := by
    rw [hw]; exact raising_mul_aplusCore_w (G := G) (x := x) (D := D) hy hR'
  have hk0 : subconstij G x y 2 3
      *ᵥ (raising (𝕜 := ℂ) G x D *ᵥ (subconstij G x y 1 0 *ᵥ w)) = 0 :=
    subconstij_mul_raising_mulVec_eq_zero (G := G) (x := x) (y := y) (D := D) (j := 0)
      (by omega) (Or.inr (by omega)) (v := subconstij G x y 1 0 *ᵥ w)
      (by rw [Matrix.mulVec_mulVec, subconstij_mul_self])
  have hk1 : subconstij G x y 2 3
      *ᵥ (raising (𝕜 := ℂ) G x D *ᵥ (subconstij G x y 1 1 *ᵥ w)) = 0 :=
    subconstij_mul_raising_mulVec_eq_zero (G := G) (x := x) (y := y) (D := D) (j := 1)
      (by omega) (Or.inr (by omega)) (v := subconstij G x y 1 1 *ᵥ w)
      (by rw [Matrix.mulVec_mulVec, subconstij_mul_self])
  have hZ : subconstij G x y 2 3
      *ᵥ (raising (𝕜 := ℂ) G x D *ᵥ (subconstij G x y 1 2 *ᵥ w)) = 0 := by
    have h0 : subconstij G x y 2 3 *ᵥ (raising (𝕜 := ℂ) G x D *ᵥ w) = 0 := by
      rw [hRw]
      exact subconstij_mul_subconst_distMatrix_two_mulVec_single (x := x) (y := y)
    rw [hdecomp] at h0
    simp only [Matrix.mulVec_add] at h0
    rw [hk0, hk1, zero_add, zero_add] at h0
    exact h0
  set d2 : X → ℂ := subconstij G x y 1 2 *ᵥ w with hd2
  have hZ' : subconstij G x y 2 3 *ᵥ (raising (𝕜 := ℂ) G x D *ᵥ d2) = 0 := hZ
  have hpass : subconstij G x y 2 3 *ᵥ (raising (𝕜 := ℂ) G x D *ᵥ d2)
      = subconst (𝕜 := ℂ) G x 2 *ᵥ (raising (𝕜 := ℂ) G y (D + 1) *ᵥ d2) := by
    have hmat : subconstij G x y 2 3 * raising (𝕜 := ℂ) G x D * subconstij G x y 1 2
        = subconst (𝕜 := ℂ) G x 2 * raising (𝕜 := ℂ) G y (D + 1) * subconstij G x y 1 2 :=
      subconstij_mul_raising_eq_subconst_raising_y (G := G) (x := x) (y := y) (D := D) (by omega)
    calc subconstij G x y 2 3 *ᵥ (raising (𝕜 := ℂ) G x D *ᵥ d2)
        = (subconstij G x y 2 3 * raising (𝕜 := ℂ) G x D * subconstij G x y 1 2) *ᵥ w := by
          rw [hd2, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec]
      _ = (subconst (𝕜 := ℂ) G x 2 * raising (𝕜 := ℂ) G y (D + 1)
            * subconstij G x y 1 2) *ᵥ w := by rw [hmat]
      _ = subconst (𝕜 := ℂ) G x 2 *ᵥ (raising (𝕜 := ℂ) G y (D + 1) *ᵥ d2) := by
          rw [hd2, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  have hv2 : subconst (𝕜 := ℂ) G y 2 *ᵥ d2 = d2 := by
    rw [hd2]; exact subconst_two_mulVec_subconstij_one_two G x y w
  have hv1 : ∀ k, d2 k ≠ 0 → G.dist x k = 1 := by
    intro k hk
    rw [hd2] at hk
    exact (subconstij_mulVec_support hk).1
  have hRy_mem : raising (𝕜 := ℂ) G y (D + 1) *ᵥ d2
      = subconst (𝕜 := ℂ) G x 2 *ᵥ (raising (𝕜 := ℂ) G y (D + 1) *ᵥ d2) := by
    funext u
    by_cases h2 : G.dist x u = 2
    · rw [subconst_mulVec_apply, if_pos h2, one_mul]
    · rw [subconst_mulVec_apply, if_neg h2, zero_mul]
      exact raising_y_apply_eq_zero hy Y.connected (by omega) hv1 hv2 h2
  have hRy_zero : raising (𝕜 := ℂ) G y (D + 1) *ᵥ d2 = 0 := by
    rw [hRy_mem, ← hpass]
    exact hZ'
  have hδ2 : d2 = 0 := hinj _ hv2 hRy_zero
  have hwz : w z = 0 := by
    have h0 : (subconstij G x y 1 0 *ᵥ w) z = 0 :=
      subconstij_mulVec_apply_eq_zero G x y 1 0 w (Or.inr (by omega))
    have h1 : (subconstij G x y 1 1 *ᵥ w) z = 0 :=
      subconstij_mulVec_apply_eq_zero G x y 1 1 w (Or.inr (by omega))
    rw [hdecomp, hδ2, add_zero, Pi.add_apply, h0, h1, add_zero]
  have hentry : (aplusCore G x Rinv) z y = w z := by
    rw [hw, Matrix.mulVec, dotProduct, Finset.sum_eq_single y]
    · simp
    · intro b _ hb; simp [Pi.single_apply, hb]
    · intro h; exact absurd (Finset.mem_univ y) h
  have hentry2 : subconst (𝕜 := ℂ) G x 1 z y = 0 := by
    rw [subconst_apply, if_neg]
    intro hzy'
    rw [hzy'] at hzy
    simp at hzy
  rw [Matrix.sub_apply, Matrix.smul_apply, hentry, hentry2, smul_zero, sub_zero]
  exact hwz

end DRGData


/-! ## Audit: Lemma 37.1 (`thin_of_dim_two_eq_one`) is FALSE as stated

The statement of `thin_of_dim_two_eq_one` in this file carries neither the
distance-regularity nor the `Q`-polynomial hypothesis of the lecture-37 version, and
its conclusion already fails at level `1`: `IsEndpoint G x W 1` only records
`E*_1 W ≠ ⊥` and `E*_0 W = ⊥`, so `dim E*_1 W ≤ 1` (a special case of `ThinModule`)
is not implied by the hypotheses.

The counterexample below is a graph on 7 vertices with base vertex `0`, the
subconstituents of which are the levels `{0}`, `{p₀,p₁,p₂,p₃}`, `{a,b}`; the module
`W37` is spanned by the level-1 vectors `u37_1 = -p̂₀ + p̂₁`, `u37_2 = -p̂₂ + p̂₃` and the
level-2 vector `s37 = â - b̂`.  It is a `T(0)`-module of endpoint `1` with
`dim E*_1 W37 = 2`, `dim E*_2 W37 = 1`, and it is irreducible, so it satisfies every
hypothesis of `thin_of_dim_two_eq_one` while violating the conclusion. -/
section Thin37Audit

set_option maxHeartbeats 400000


def adj37 (u v : Fin 7) : Bool :=
  match u.val, v.val with
  | 0,1 | 1,0 | 0,2 | 2,0 | 0,3 | 3,0 | 0,4 | 4,0
  | 1,2 | 2,1 | 1,3 | 3,1 | 1,4 | 4,1 | 2,3 | 3,2 | 2,4 | 4,2
  | 5,1 | 1,5 | 5,3 | 3,5 | 6,2 | 2,6 | 6,4 | 4,6 => true
  | _, _ => false

def G37 : SimpleGraph (Fin 7) where
  Adj u v := adj37 u v = true
  symm := ⟨by intro u v h; revert h; revert u v; decide⟩
  loopless := ⟨by intro u h; revert h; revert u; decide⟩

def u37_1 : Fin 7 → ℂ := ![0, -1, 1, 0, 0, 0, 0]
def u37_2 : Fin 7 → ℂ := ![0, 0, 0, -1, 1, 0, 0]
def s37 : Fin 7 → ℂ := ![0, 0, 0, 0, 0, 1, -1]

/-! ### Distances from the base vertex `0` -/

lemma reach37_1 : G37.Reachable 0 1 :=
  ⟨SimpleGraph.Walk.cons (u := 0) (v := 1) (w := 1) (by simp [G37, adj37]) SimpleGraph.Walk.nil⟩
lemma reach37_2 : G37.Reachable 0 2 :=
  ⟨SimpleGraph.Walk.cons (u := 0) (v := 2) (w := 2) (by simp [G37, adj37]) SimpleGraph.Walk.nil⟩
lemma reach37_3 : G37.Reachable 0 3 :=
  ⟨SimpleGraph.Walk.cons (u := 0) (v := 3) (w := 3) (by simp [G37, adj37]) SimpleGraph.Walk.nil⟩
lemma reach37_4 : G37.Reachable 0 4 :=
  ⟨SimpleGraph.Walk.cons (u := 0) (v := 4) (w := 4) (by simp [G37, adj37]) SimpleGraph.Walk.nil⟩
lemma reach37_5 : G37.Reachable 0 5 :=
  ⟨SimpleGraph.Walk.cons (u := 0) (v := 1) (w := 5) (by simp [G37, adj37])
    (SimpleGraph.Walk.cons (u := 1) (v := 5) (w := 5) (by simp [G37, adj37]) SimpleGraph.Walk.nil)⟩
lemma reach37_6 : G37.Reachable 0 6 :=
  ⟨SimpleGraph.Walk.cons (u := 0) (v := 2) (w := 6) (by simp [G37, adj37])
    (SimpleGraph.Walk.cons (u := 2) (v := 6) (w := 6) (by simp [G37, adj37]) SimpleGraph.Walk.nil)⟩

lemma dist37_00 : G37.dist 0 0 = 0 := by
  rw [SimpleGraph.dist_eq_zero_iff_eq_or_not_reachable]; exact Or.inl rfl
lemma dist37_01 : G37.dist 0 1 = 1 :=
  SimpleGraph.dist_eq_one_iff_adj.mpr (by simp [G37, adj37])
lemma dist37_02 : G37.dist 0 2 = 1 :=
  SimpleGraph.dist_eq_one_iff_adj.mpr (by simp [G37, adj37])
lemma dist37_03 : G37.dist 0 3 = 1 :=
  SimpleGraph.dist_eq_one_iff_adj.mpr (by simp [G37, adj37])
lemma dist37_04 : G37.dist 0 4 = 1 :=
  SimpleGraph.dist_eq_one_iff_adj.mpr (by simp [G37, adj37])

lemma dist37_two (v : Fin 7) (hne : (0 : Fin 7) ≠ v) (hnadj : ¬ G37.Adj 0 v)
    (hreach : G37.Reachable 0 v) (p : G37.Walk 0 v) (hp : p.length = 2) :
    G37.dist 0 v = 2 := by
  have h1 : G37.dist 0 v ≤ 2 := by rw [← hp]; exact SimpleGraph.dist_le p
  have h2 : 1 < G37.dist 0 v := SimpleGraph.Reachable.one_lt_dist_of_ne_of_not_adj hreach hne hnadj
  omega

lemma len37_5 : (SimpleGraph.Walk.cons (u := 0) (v := 1) (w := 5) (by simp [G37, adj37])
    (SimpleGraph.Walk.cons (u := 1) (v := 5) (w := 5) (by simp [G37, adj37])
      SimpleGraph.Walk.nil) : G37.Walk 0 5).length = 2 := by decide
lemma len37_6 : (SimpleGraph.Walk.cons (u := 0) (v := 2) (w := 6) (by simp [G37, adj37])
    (SimpleGraph.Walk.cons (u := 2) (v := 6) (w := 6) (by simp [G37, adj37])
      SimpleGraph.Walk.nil) : G37.Walk 0 6).length = 2 := by decide

lemma dist37_05 : G37.dist 0 5 = 2 :=
  dist37_two 5 (by decide) (by simp [G37, adj37]) reach37_5 _ len37_5
lemma dist37_06 : G37.dist 0 6 = 2 :=
  dist37_two 6 (by decide) (by simp [G37, adj37]) reach37_6 _ len37_6

def lv37 : Fin 7 → ℕ := ![0,1,1,1,1,2,2]

lemma dist37_eq (v : Fin 7) : G37.dist 0 v = lv37 v := by
  fin_cases v
  · exact dist37_00
  · exact dist37_01
  · exact dist37_02
  · exact dist37_03
  · exact dist37_04
  · exact dist37_05
  · exact dist37_06

/-! ### The level projections -/

lemma subconst37_mulVec (i : ℕ) (w : Fin 7 → ℂ) :
    subconst (𝕜 := ℂ) G37 0 i *ᵥ w = fun v => (if lv37 v = i then 1 else 0) * w v := by
  funext v
  rw [subconst, mulVec_diagonal, dist37_eq]

lemma subconst37_of_supp (i : ℕ) (w : Fin 7 → ℂ) (hw : ∀ v, w v ≠ 0 → lv37 v = i) :
    subconst (𝕜 := ℂ) G37 0 i *ᵥ w = w := by
  rw [subconst37_mulVec]
  funext v
  by_cases h : w v = 0
  · simp [h]
  · rw [if_pos (hw v h), one_mul]

lemma subconst37_eq_zero (i : ℕ) (w : Fin 7 → ℂ) (hw : ∀ v, w v ≠ 0 → lv37 v ≠ i) :
    subconst (𝕜 := ℂ) G37 0 i *ᵥ w = 0 := by
  rw [subconst37_mulVec]
  funext v
  by_cases h : w v = 0
  · simp [h]
  · rw [if_neg (hw v h), zero_mul]
    rfl

lemma supp_u37_1 : ∀ v, u37_1 v ≠ 0 → lv37 v = 1 := by
  intro v hv
  fin_cases v <;> simp_all [u37_1, lv37]
lemma supp_u37_2 : ∀ v, u37_2 v ≠ 0 → lv37 v = 1 := by
  intro v hv
  fin_cases v <;> simp_all [u37_2, lv37]
lemma supp_s37 : ∀ v, s37 v ≠ 0 → lv37 v = 2 := by
  intro v hv
  fin_cases v <;> simp_all [s37, lv37]

lemma subconst37_u1 (i : ℕ) :
    subconst (𝕜 := ℂ) G37 0 i *ᵥ u37_1 = if i = 1 then u37_1 else 0 := by
  by_cases h : i = 1
  · rw [if_pos h, h]; exact subconst37_of_supp 1 _ supp_u37_1
  · rw [if_neg h]
    exact subconst37_eq_zero i _ (fun v hv => by rw [supp_u37_1 v hv]; exact fun hh => h hh.symm)
lemma subconst37_u2 (i : ℕ) :
    subconst (𝕜 := ℂ) G37 0 i *ᵥ u37_2 = if i = 1 then u37_2 else 0 := by
  by_cases h : i = 1
  · rw [if_pos h, h]; exact subconst37_of_supp 1 _ supp_u37_2
  · rw [if_neg h]
    exact subconst37_eq_zero i _ (fun v hv => by rw [supp_u37_2 v hv]; exact fun hh => h hh.symm)
lemma subconst37_s (i : ℕ) :
    subconst (𝕜 := ℂ) G37 0 i *ᵥ s37 = if i = 2 then s37 else 0 := by
  by_cases h : i = 2
  · rw [if_pos h, h]; exact subconst37_of_supp 2 _ supp_s37
  · rw [if_neg h]
    exact subconst37_eq_zero i _ (fun v hv => by rw [supp_s37 v hv]; exact fun hh => h hh.symm)

/-! ### The module -/

def W1_37 : Submodule ℂ (Fin 7 → ℂ) := Submodule.span ℂ ({u37_1, u37_2} : Set (Fin 7 → ℂ))
def W2_37 : Submodule ℂ (Fin 7 → ℂ) := Submodule.span ℂ ({s37} : Set (Fin 7 → ℂ))
def W37 : Submodule ℂ (Fin 7 → ℂ) := W1_37 ⊔ W2_37

lemma u1_mem_W1 : u37_1 ∈ W1_37 := Submodule.subset_span (by simp)
lemma u2_mem_W1 : u37_2 ∈ W1_37 := Submodule.subset_span (by simp)
lemma s_mem_W2 : s37 ∈ W2_37 := Submodule.subset_span (by simp)
lemma u1_mem_W37 : u37_1 ∈ W37 := Submodule.mem_sup_left u1_mem_W1
lemma u2_mem_W37 : u37_2 ∈ W37 := Submodule.mem_sup_left u2_mem_W1
lemma s_mem_W37 : s37 ∈ W37 := Submodule.mem_sup_right s_mem_W2

lemma W1_supp : ∀ w ∈ W1_37, ∀ v, w v ≠ 0 → lv37 v = 1 := by
  intro w hw
  induction hw using Submodule.span_induction with
  | mem x hx =>
      rcases hx with rfl | rfl
      · exact supp_u37_1
      · exact supp_u37_2
  | zero => intro v hv; simp at hv
  | add x y _ _ hx hy =>
      intro v hv
      by_cases hx0 : x v = 0
      · rw [Pi.add_apply, hx0, zero_add] at hv; exact hy v hv
      · exact hx v hx0
  | smul c x _ hx =>
      intro v hv
      have hxv : x v ≠ 0 := by
        intro h0
        apply hv
        rw [Pi.smul_apply, h0, smul_zero]
      exact hx v hxv

lemma W2_supp : ∀ w ∈ W2_37, ∀ v, w v ≠ 0 → lv37 v = 2 := by
  intro w hw
  induction hw using Submodule.span_induction with
  | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact supp_s37
  | zero => intro v hv; simp at hv
  | add x y _ _ hx hy =>
      intro v hv
      by_cases hx0 : x v = 0
      · rw [Pi.add_apply, hx0, zero_add] at hv; exact hy v hv
      · exact hx v hx0
  | smul c x _ hx =>
      intro v hv
      have hxv : x v ≠ 0 := by
        intro h0
        apply hv
        rw [Pi.smul_apply, h0, smul_zero]
      exact hx v hxv

lemma W37_supp : ∀ w ∈ W37, ∀ v, w v ≠ 0 → lv37 v = 1 ∨ lv37 v = 2 := by
  intro w hw
  rw [W37, Submodule.mem_sup] at hw
  obtain ⟨a, ha, b, hb, rfl⟩ := hw
  intro v hv
  by_cases ha0 : a v = 0
  · rw [Pi.add_apply, ha0, zero_add] at hv
    exact Or.inr (W2_supp b hb v hv)
  · exact Or.inl (W1_supp a ha v ha0)


/-! ### The adjacency action on the spanning vectors -/

lemma N37_0 : G37.neighborFinset 0 = ({1,2,3,4} : Finset (Fin 7)) := by
  ext y; rw [SimpleGraph.mem_neighborFinset]; fin_cases y <;> simp [G37, adj37]
lemma N37_1 : G37.neighborFinset 1 = ({0,2,3,4,5} : Finset (Fin 7)) := by
  ext y; rw [SimpleGraph.mem_neighborFinset]; fin_cases y <;> simp [G37, adj37]
lemma N37_2 : G37.neighborFinset 2 = ({0,1,3,4,6} : Finset (Fin 7)) := by
  ext y; rw [SimpleGraph.mem_neighborFinset]; fin_cases y <;> simp [G37, adj37]
lemma N37_3 : G37.neighborFinset 3 = ({0,1,2,5} : Finset (Fin 7)) := by
  ext y; rw [SimpleGraph.mem_neighborFinset]; fin_cases y <;> simp [G37, adj37]
lemma N37_4 : G37.neighborFinset 4 = ({0,1,2,6} : Finset (Fin 7)) := by
  ext y; rw [SimpleGraph.mem_neighborFinset]; fin_cases y <;> simp [G37, adj37]
lemma N37_5 : G37.neighborFinset 5 = ({1,3} : Finset (Fin 7)) := by
  ext y; rw [SimpleGraph.mem_neighborFinset]; fin_cases y <;> simp [G37, adj37]
lemma N37_6 : G37.neighborFinset 6 = ({2,4} : Finset (Fin 7)) := by
  ext y; rw [SimpleGraph.mem_neighborFinset]; fin_cases y <;> simp [G37, adj37]

lemma adj_mulVec37 (v : Fin 7) (w : Fin 7 → ℂ) :
    (adj (𝕜 := ℂ) G37 *ᵥ w) v = ∑ x ∈ G37.neighborFinset v, w x := by
  have h1 : (adj (𝕜 := ℂ) G37 *ᵥ w) v = ∑ x : Fin 7, (if G37.Adj v x then 1 else 0) * w x := by
    simp only [mulVec, dotProduct, adj_apply]
  rw [h1]
  have h2 : (∑ x : Fin 7, (if G37.Adj v x then 1 else 0) * w x)
      = ∑ x : Fin 7, (if G37.Adj v x then w x else 0) := by
    refine Finset.sum_congr rfl fun x _ => ?_
    by_cases h : G37.Adj v x <;> simp [h]
  rw [h2, ← Finset.sum_filter, neighborFinset_eq_filter' G37 v]

lemma A_u37_1 : adj (𝕜 := ℂ) G37 *ᵥ u37_1 = -u37_1 - s37 := by
  funext v
  rw [adj_mulVec37]
  fin_cases v <;>
    simp [N37_0, N37_1, N37_2, N37_3, N37_4, N37_5, N37_6, u37_1, s37]

lemma A_u37_2 : adj (𝕜 := ℂ) G37 *ᵥ u37_2 = -s37 := by
  funext v
  rw [adj_mulVec37]
  fin_cases v <;>
    simp [N37_0, N37_1, N37_2, N37_3, N37_4, N37_5, N37_6, u37_2, s37]

lemma A_s37 : adj (𝕜 := ℂ) G37 *ᵥ s37 = -u37_1 - u37_2 := by
  funext v
  rw [adj_mulVec37]
  fin_cases v <;>
    simp [N37_0, N37_1, N37_2, N37_3, N37_4, N37_5, N37_6, u37_1, u37_2, s37]


/-! ### `W37` is a `T(x)`-module -/

lemma W37_closed (M : Matrix (Fin 7) (Fin 7) ℂ)
    (h1 : M *ᵥ u37_1 ∈ W37) (h2 : M *ᵥ u37_2 ∈ W37) (h3 : M *ᵥ s37 ∈ W37) :
    ∀ x ∈ W37, M *ᵥ x ∈ W37 := by
  intro x hx
  rw [W37, Submodule.mem_sup] at hx
  obtain ⟨a, ha, b, hb, rfl⟩ := hx
  rw [mulVec_add]
  refine Submodule.add_mem _ ?_ ?_
  · induction ha using Submodule.span_induction with
    | mem z hz =>
        rcases hz with rfl | rfl
        · exact h1
        · exact h2
    | zero => simp
    | add p q _ _ hp hq => rw [mulVec_add]; exact Submodule.add_mem _ hp hq
    | smul c p _ hp => rw [mulVec_smul]; exact Submodule.smul_mem _ c hp
  · induction hb using Submodule.span_induction with
    | mem z hz =>
        rw [Set.mem_singleton_iff] at hz
        subst hz
        exact h3
    | zero => simp
    | add p q _ _ hp hq => rw [mulVec_add]; exact Submodule.add_mem _ hp hq
    | smul c p _ hp => rw [mulVec_smul]; exact Submodule.smul_mem _ c hp

lemma W37_adj_mem : ∀ x ∈ W37, adj (𝕜 := ℂ) G37 *ᵥ x ∈ W37 :=
  W37_closed _
    (by rw [A_u37_1]; exact Submodule.sub_mem _ (Submodule.neg_mem _ u1_mem_W37) s_mem_W37)
    (by rw [A_u37_2]; exact Submodule.neg_mem _ s_mem_W37)
    (by rw [A_s37]; exact Submodule.sub_mem _ (Submodule.neg_mem _ u1_mem_W37) u2_mem_W37)

lemma W37_sub_mem (i : ℕ) : ∀ x ∈ W37, subconst (𝕜 := ℂ) G37 0 i *ᵥ x ∈ W37 := by
  by_cases h1 : i = 1
  · subst h1
    refine W37_closed _ ?_ ?_ ?_
    · rw [subconst37_u1, if_pos rfl]; exact u1_mem_W37
    · rw [subconst37_u2, if_pos rfl]; exact u2_mem_W37
    · rw [subconst37_s, if_neg (by decide)]; exact Submodule.zero_mem _
  · by_cases h2 : i = 2
    · subst h2
      refine W37_closed _ ?_ ?_ ?_
      · rw [subconst37_u1, if_neg (by decide)]; exact Submodule.zero_mem _
      · rw [subconst37_u2, if_neg (by decide)]; exact Submodule.zero_mem _
      · rw [subconst37_s, if_pos rfl]; exact s_mem_W37
    · refine W37_closed _ ?_ ?_ ?_
      · rw [subconst37_u1, if_neg h1]; exact Submodule.zero_mem _
      · rw [subconst37_u2, if_neg h1]; exact Submodule.zero_mem _
      · rw [subconst37_s, if_neg h2]; exact Submodule.zero_mem _

lemma W37_isStable : IsStable (subconstituentAlgebra (𝕜 := ℂ) G37 0).toSubalgebra W37 := by
  intro a ha
  have hEq : (subconstituentAlgebra (𝕜 := ℂ) G37 0).toSubalgebra
      = Algebra.adjoin ℂ (({adj (𝕜 := ℂ) G37} ∪ Set.range (subconst (𝕜 := ℂ) G37 0)) ∪
          star ({adj (𝕜 := ℂ) G37} ∪ Set.range (subconst (𝕜 := ℂ) G37 0))) :=
    StarAlgebra.adjoin_toSubalgebra _ _
  rw [hEq] at ha
  induction ha using Algebra.adjoin_induction with
  | mem m hm =>
      rcases hm with hm | hm
      · rcases hm with hm | hm
        · rw [Set.mem_singleton_iff] at hm
          subst hm
          exact W37_adj_mem
        · obtain ⟨i, rfl⟩ := hm
          exact W37_sub_mem i
      · have hm' : star m ∈ ({adj (𝕜 := ℂ) G37} ∪ Set.range (subconst (𝕜 := ℂ) G37 0)) :=
          Set.mem_star.mp hm
        rcases hm' with hm' | hm'
        · rw [Set.mem_singleton_iff] at hm'
          have hm'' : m = adj (𝕜 := ℂ) G37 := by
            rw [← star_star m, hm']
            exact star_adj (𝕜 := ℂ) G37
          rw [hm'']
          exact W37_adj_mem
        · obtain ⟨i, hi⟩ := hm'
          have hm'' : m = subconst (𝕜 := ℂ) G37 0 i := by
            rw [← star_star m, ← hi]
            exact star_subconst G37 0 i
          rw [hm'']
          exact W37_sub_mem i
  | algebraMap r =>
      intro w hw
      rw [Matrix.algebraMap_eq_diagonal]
      have h : diagonal ((algebraMap ℂ (Fin 7 → ℂ)) r) *ᵥ w
          = (algebraMap ℂ (Fin 7 → ℂ)) r • w := by
        funext v
        rw [mulVec_diagonal]
        rfl
      rw [h]
      exact Submodule.smul_mem _ _ hw
  | add m n _ _ ihm ihn =>
      intro w hw
      rw [Matrix.add_mulVec]
      exact Submodule.add_mem _ (ihm w hw) (ihn w hw)
  | mul m n _ _ ihm ihn =>
      intro w hw
      rw [← Matrix.mulVec_mulVec]
      exact ihm _ (ihn w hw)


/-! ### The images of `W37` under the level projections -/

lemma matImage_W1_37 (M : Matrix (Fin 7) (Fin 7) ℂ) :
    Submodule.map M.mulVecLin W1_37
      = Submodule.span ℂ ({M *ᵥ u37_1, M *ᵥ u37_2} : Set (Fin 7 → ℂ)) := by
  rw [W1_37, Submodule.map_span]
  congr 1
  ext x
  simp only [Set.mem_image, Set.mem_insert_iff, Set.mem_singleton_iff, mulVecLin_apply]
  constructor
  · rintro ⟨y, (rfl | rfl), rfl⟩
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact ⟨u37_1, Or.inl rfl, rfl⟩
    · exact ⟨u37_2, Or.inr rfl, rfl⟩

lemma matImage_W2_37 (M : Matrix (Fin 7) (Fin 7) ℂ) :
    Submodule.map M.mulVecLin W2_37
      = Submodule.span ℂ ({M *ᵥ s37} : Set (Fin 7 → ℂ)) := by
  rw [W2_37, Submodule.map_span, Set.image_singleton, mulVecLin_apply]

lemma E1_image_37 : matImage (subconst (𝕜 := ℂ) G37 0 1) W37 = W1_37 := by
  rw [W37, matImage, Submodule.map_sup, matImage_W1_37, matImage_W2_37,
    subconst37_u1, subconst37_u2, subconst37_s]
  simp [W1_37]

lemma E0_image_37 : matImage (subconst (𝕜 := ℂ) G37 0 0) W37 = ⊥ := by
  rw [W37, matImage, Submodule.map_sup, matImage_W1_37, matImage_W2_37,
    subconst37_u1, subconst37_u2, subconst37_s]
  simp

lemma E2_image_37 : matImage (subconst (𝕜 := ℂ) G37 0 2) W37 = W2_37 := by
  rw [W37, matImage, Submodule.map_sup, matImage_W1_37, matImage_W2_37,
    subconst37_u1, subconst37_u2, subconst37_s]
  simp [W2_37]

lemma s37_ne_zero : s37 ≠ 0 := by
  intro h; have := congrFun h 5; simp [s37] at this
lemma u37_1_ne_zero : u37_1 ≠ 0 := by
  intro h; have := congrFun h 1; simp [u37_1] at this
lemma u37_2_ne_zero : u37_2 ≠ 0 := by
  intro h; have := congrFun h 3; simp [u37_2] at this

lemma finrank_E2_37 : Module.finrank ℂ (subconstImage (𝕜 := ℂ) G37 0 2 W37) = 1 := by
  rw [subconstImage, E2_image_37, W2_37, finrank_span_singleton s37_ne_zero]

lemma E1_image_ne_bot_37 : subconstImage (𝕜 := ℂ) G37 0 1 W37 ≠ ⊥ := by
  rw [subconstImage, E1_image_37]
  intro h
  have h1 : u37_1 ∈ W1_37 := u1_mem_W1
  rw [h] at h1
  exact u37_1_ne_zero (by simpa [Submodule.mem_bot] using h1)

lemma E0_image_37' : subconstImage (𝕜 := ℂ) G37 0 0 W37 = ⊥ := by
  rw [subconstImage, E0_image_37]

lemma endpoint_37 : IsEndpoint (𝕜 := ℂ) G37 0 W37 1 := by
  refine ⟨E1_image_ne_bot_37, ?_⟩
  intro i hi
  have h0 : i = 0 := by omega
  subst h0
  exact E0_image_37'

lemma span_pair_37 : (Submodule.span ℂ ({u37_1, u37_2} : Set (Fin 7 → ℂ)))
    = Submodule.span ℂ ({u37_1} : Set (Fin 7 → ℂ))
      ⊔ Submodule.span ℂ ({u37_2} : Set (Fin 7 → ℂ)) := by
  simp [Submodule.span_insert]

lemma span_u1_inf_span_u2_37 :
    Submodule.span ℂ ({u37_1} : Set (Fin 7 → ℂ))
      ⊓ Submodule.span ℂ ({u37_2} : Set (Fin 7 → ℂ)) = ⊥ := by
  rw [Submodule.eq_bot_iff]
  intro x hx
  rw [Submodule.mem_inf, Submodule.mem_span_singleton, Submodule.mem_span_singleton] at hx
  obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := hx
  have hb0 : b = 0 := by
    have h := congrFun (ha.trans hb.symm) 3
    simpa [u37_1, u37_2] using h
  rw [← hb, hb0, zero_smul]

lemma finrank_W1_37 : Module.finrank ℂ ↥W1_37 = 2 := by
  have h := Submodule.finrank_sup_add_finrank_inf_eq
    (Submodule.span ℂ ({u37_1} : Set (Fin 7 → ℂ)))
    (Submodule.span ℂ ({u37_2} : Set (Fin 7 → ℂ)))
  rw [finrank_span_singleton u37_1_ne_zero, finrank_span_singleton u37_2_ne_zero,
    span_u1_inf_span_u2_37, finrank_bot, add_zero] at h
  rw [W1_37, span_pair_37]
  omega

lemma not_thin_37 : ¬ ThinModule (𝕜 := ℂ) G37 0 W37 := by
  intro h
  have h1 : Module.finrank ℂ (subconstImage (𝕜 := ℂ) G37 0 1 W37) ≤ 1 := h 1
  rw [subconstImage, E1_image_37, finrank_W1_37] at h1
  omega


/-! ### Irreducibility of `W37` -/

lemma A_W1_37 (a b : ℂ) :
    adj (𝕜 := ℂ) G37 *ᵥ (a • u37_1 + b • u37_2) = -(a • u37_1) - (a + b) • s37 := by
  rw [mulVec_add, mulVec_smul, mulVec_smul, A_u37_1, A_u37_2]
  module

lemma E1_A_W1_37 (a b : ℂ) :
    subconst (𝕜 := ℂ) G37 0 1 *ᵥ (adj (𝕜 := ℂ) G37 *ᵥ (a • u37_1 + b • u37_2))
      = -(a • u37_1) := by
  rw [A_W1_37, subconst37_mulVec]
  funext v
  fin_cases v <;> simp [lv37, u37_1, s37]

lemma E2_A_W1_37 (a b : ℂ) :
    subconst (𝕜 := ℂ) G37 0 2 *ᵥ (adj (𝕜 := ℂ) G37 *ᵥ (a • u37_1 + b • u37_2))
      = -((a + b) • s37) := by
  rw [A_W1_37, subconst37_mulVec]
  funext v
  fin_cases v <;> simp [lv37, u37_1, s37]

lemma W37_le_of_mem (U : Submodule ℂ (Fin 7 → ℂ)) (h1 : u37_1 ∈ U) (h2 : u37_2 ∈ U)
    (h3 : s37 ∈ U) : W37 ≤ U := by
  rw [W37]
  refine sup_le ?_ ?_
  · rw [W1_37]
    refine Submodule.span_le.mpr ?_
    intro z hz
    rcases hz with rfl | rfl
    · exact h1
    · exact h2
  · rw [W2_37]
    refine Submodule.span_le.mpr ?_
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact h3

lemma key_W1_37 (U : Submodule ℂ (Fin 7 → ℂ))
    (hstab : IsStable (subconstituentAlgebra (𝕜 := ℂ) G37 0).toSubalgebra U)
    {w : Fin 7 → ℂ} (hwU : w ∈ U) (hwW1 : w ∈ W1_37) (hw0 : w ≠ 0) :
    u37_1 ∈ U ∧ u37_2 ∈ U := by
  obtain ⟨a, b, hab⟩ := Submodule.mem_span_pair.mp hwW1
  have hsub : (a • u37_1 + b • u37_2) ∈ U := by rw [hab]; exact hwU
  have hAwU : adj (𝕜 := ℂ) G37 *ᵥ (a • u37_1 + b • u37_2) ∈ U :=
    hstab _ (adj_mem_subconstituentAlgebra _ _) _ hsub
  have hE1U : -(a • u37_1) ∈ U := by
    rw [← E1_A_W1_37]
    exact hstab _ (subconst_mem_subconstituentAlgebra _ _ 1) _ hAwU
  have hE2U : -((a + b) • s37) ∈ U := by
    rw [← E2_A_W1_37]
    exact hstab _ (subconst_mem_subconstituentAlgebra _ _ 2) _ hAwU
  have hE1' : a • u37_1 ∈ U := by simpa using Submodule.neg_mem U hE1U
  have hE2' : (a + b) • s37 ∈ U := by simpa using Submodule.neg_mem U hE2U
  by_cases hab0 : a + b = 0
  · have ha0 : a ≠ 0 := by
      intro ha
      apply hw0
      have hb0 : b = 0 := by rw [ha] at hab0; simpa using hab0
      rw [← hab, ha, hb0]
      simp
    have hu1U : u37_1 ∈ U := by
      have h := Submodule.smul_mem U a⁻¹ hE1'
      rwa [smul_smul, inv_mul_cancel₀ ha0, one_smul] at h
    refine ⟨hu1U, ?_⟩
    have hb : b = -a := by linear_combination hab0
    have hu2U : u37_2 ∈ U := by
      have h1 : a • u37_2 = a • u37_1 - w := by
        rw [← hab, hb]; module
      have h2 : a • u37_2 ∈ U := by
        rw [h1]; exact Submodule.sub_mem _ hE1' hwU
      have h := Submodule.smul_mem U a⁻¹ h2
      rwa [smul_smul, inv_mul_cancel₀ ha0, one_smul] at h
    exact hu2U
  · have hsU : s37 ∈ U := by
      have h := Submodule.smul_mem U (a + b)⁻¹ hE2'
      rwa [smul_smul, inv_mul_cancel₀ hab0, one_smul] at h
    have hAsU : adj (𝕜 := ℂ) G37 *ᵥ s37 ∈ U :=
      hstab _ (adj_mem_subconstituentAlgebra _ _) _ hsU
    rw [A_s37] at hAsU
    by_cases ha0 : a = 0
    · have hb0 : b ≠ 0 := by
        rw [show b = a + b from by rw [ha0, zero_add]]; exact hab0
      have hu2U : u37_2 ∈ U := by
        have h1 : b • u37_2 = w := by rw [← hab, ha0]; simp
        have h2 : b • u37_2 ∈ U := by rw [h1]; exact hwU
        have h := Submodule.smul_mem U b⁻¹ h2
        rwa [smul_smul, inv_mul_cancel₀ hb0, one_smul] at h
      refine ⟨?_, hu2U⟩
      have h : -u37_1 ∈ U := by
        have hh := Submodule.add_mem U hAsU hu2U
        rwa [show -u37_1 - u37_2 + u37_2 = -u37_1 from by abel] at hh
      simpa using Submodule.neg_mem U h
    · have hu1U : u37_1 ∈ U := by
        have h := Submodule.smul_mem U a⁻¹ hE1'
        rwa [smul_smul, inv_mul_cancel₀ ha0, one_smul] at h
      refine ⟨hu1U, ?_⟩
      have h : -u37_2 ∈ U := by
        have hh := Submodule.sub_mem _ hAsU (Submodule.neg_mem _ hu1U)
        rwa [show -u37_1 - u37_2 - -u37_1 = -u37_2 from by abel] at hh
      simpa using Submodule.neg_mem U h

lemma W37_irreducible :
    IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G37 0).toSubalgebra W37 := by
  refine ⟨?_, ?_⟩
  · intro h
    have h1 : u37_1 ∈ W37 := u1_mem_W37
    rw [h] at h1
    exact u37_1_ne_zero (by simpa [Submodule.mem_bot] using h1)
  · intro U hU hstab hUne
    obtain ⟨u, huU, hu0⟩ := (Submodule.ne_bot_iff U).mp hUne
    have hmem : u ∈ W37 := hU huU
    have hw1U : subconst (𝕜 := ℂ) G37 0 1 *ᵥ u ∈ U :=
      hstab _ (subconst_mem_subconstituentAlgebra _ _ 1) _ huU
    have hw2U : subconst (𝕜 := ℂ) G37 0 2 *ᵥ u ∈ U :=
      hstab _ (subconst_mem_subconstituentAlgebra _ _ 2) _ huU
    rw [W37, Submodule.mem_sup] at hmem
    obtain ⟨x, hx, y, hy, rfl⟩ := hmem
    have hE1x : subconst (𝕜 := ℂ) G37 0 1 *ᵥ x = x := subconst37_of_supp 1 x (W1_supp x hx)
    have hE2x : subconst (𝕜 := ℂ) G37 0 2 *ᵥ x = 0 :=
      subconst37_eq_zero 2 x (fun v hv => by rw [W1_supp x hx v hv]; decide)
    have hE1y : subconst (𝕜 := ℂ) G37 0 1 *ᵥ y = 0 :=
      subconst37_eq_zero 1 y (fun v hv => by rw [W2_supp y hy v hv]; decide)
