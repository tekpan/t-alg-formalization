/-- `E*_1 A_1 E*_0 = E*_1 J E*_0`. -/
theorem Fe_A_one_mul_subconst_zero {Y : DRGData G x D} (hG : G.Connected)
    (hDall : ∀ a b : X, G.dist a b ≤ D) :
    Y.Fe * distMatrix (𝕜 := ℂ) G 1 * subconst (𝕜 := ℂ) G x 0
      = Y.Fe * Y.Jm * subconst (𝕜 := ℂ) G x 0 := by
  rw [Jm_eq_allOnes hDall]
  have hvx : ∀ v : X, G.dist x v = 0 → v = x := by
    intro v hv
    rcases (SimpleGraph.dist_eq_zero_iff_eq_or_not_reachable).mp hv with hh | hh
    · exact hh.symm
    · exact absurd (hG x v) hh
  simp only [Fe]
  ext u v
  simp only [subconst_mul_mul_subconst_apply2, distMatrix_apply, allOnes_apply, mul_one]
  by_cases hv : G.dist x v = 0
  · rw [if_pos hv, hvx v hv]
    rw [SimpleGraph.dist_comm (u := u) (v := x)]
    by_cases hu : G.dist x u = 1 <;> simp [hu]
  · rw [if_neg hv]
    by_cases hu : G.dist x u = 1 <;> simp [hu, hv]

