/-!
# The thin `Q`-polynomial core (Chapters 28–40)

The running hypotheses of the second half of the notes: `Γ` is a distance-regular
graph of diameter `D ≥ 3` which is `Q`-polynomial with respect to a fixed
ordering of the primitive idempotents, `x` is a base vertex, `E*_i = E*_i(x)`,
`A* = ∑ θ*_i E*_i`, `T = T(x)`, and `R, F, L` are the raising, flat and lowering
matrices of `Terwilliger/RFL.lean`.  `DRGData` collects this data.

Statements recorded here:

* Ch. 28: `dim E₁V ≤ 1 + k₁ + k₂`.
* Ch. 29: the tridiagonal pair theorem (existence of `β, γ, γ*, δ, δ*` with the
  two cubic relations).
* Ch. 30: the `R, F, L` relations.
* Ch. 32: `Vᵢ`, `(E*_iV)_new`, the action of `R⁻¹`, the generator lemma.
* Ch. 33: `E*₁TE*₁ = Span(J̃, E*₁, Ã, Ã², …)`.
* Ch. 34: `Tv` for `v ∈ (E*₁V)_new` is irreducible with `dim E*_iTv ≤ 2`.
* Ch. 35: at most four thin modules of endpoint `1`, `dim E*₁TE*₁ ≤ 5`.
* Ch. 36: the dual endpoint.
* Ch. 37: generalized adjacency matrices, and `dim E*₂W = 1 ⇒ W` thin.
* Ch. 38: `E*₂₂AE*₁₁` is injective, and the constant `Ψ`.
* Ch. 39: `A⁺` and `A⁻`, and `T(y)ŷ = T(x)ŷ`.
* Ch. 40: the constants `zᵢ`.
-/

set_option linter.unusedSectionVars false

open scoped Classical
open Matrix

noncomputable section

namespace Terwilliger

variable {X : Type*} [Fintype X] [DecidableEq X]

/-- The data of a distance-regular graph that is `Q`-polynomial with respect to a
fixed ordering of the primitive idempotents, together with a base vertex. -/
structure DRGData (G : SimpleGraph X) (x : X) (D : ℕ) where
  connected : G.Connected
  drg : IsDistanceRegular G
  diam : ∀ y, G.dist x y ≤ D
  /-- `D` bounds every distance (the diameter of `G` is at most `D`).  Added in
  wave 3: the eccentricity bound `diam` alone does not pin `D` down, and several
  Chapter 32-40 statements are false for `D` above the diameter (wave-3 audit,
  finding f8: `Q₃` with `D := 5` refutes the original drafts). -/
  diamAll : ∀ a b : X, G.dist a b ≤ D
  /-- `D` is the diameter of `G`: some pair is at distance `D`. -/
  diamExact : ∃ a b : X, G.dist a b = D
  hD : 3 ≤ D
  /-- The dual eigenvalues `θ*_i`. -/
  thetaStar : Fin (D + 1) → ℝ

/-- The cyclic `T`-module generated by a vector. -/
def cyclicModule (G : SimpleGraph X) (z : X) (v : X → ℂ) : Submodule ℂ (X → ℂ) :=
  Submodule.span ℂ ((fun a : Matrix X X ℂ => a *ᵥ v) '' ↑(subconstituentAlgebra (𝕜 := ℂ) G z).toSubalgebra)

/-! ## Auxiliary lemmas for Chapter 32 (R3d)

The two statements of Chapter 32 recorded below (`raising_inverse_action` and
`iSup_endpointSpace`) need a small amount of infrastructure that no earlier file
provides:

* the identities `R w = E*_{j+1} A w`, `L w = E*_{j-1} A w` for a vector `w`
  fixed by `E*_j` (immediate from the definitions and `E*_k E*_j = δ_{kj} E*_k`);
* the fact that for a *thin* module of endpoint `r` and diameter `d`, every
  vector of `E*_{r+i}W` with `i < d` lies in the image of `L` (lecture 32 feeds
  this into Lemma 31.1 (ib));
* the complete reducibility of the standard module (Lemma 1.8 (iii)), in the
  weak form needed for Definition 32.2: the irreducible `T(x)`-submodules span
  the standard module, and each of them has an endpoint.
-/

/-- `E*_k(x)` kills a vector fixed by `E*_j(x)` when `k ≠ j`. -/
theorem subconst_mulVec_eq_zero_of_ne {G : SimpleGraph X} {x : X} {j k : ℕ} {w : X → ℂ}
    (hw : subconst (𝕜 := ℂ) G x j *ᵥ w = w) (h : k ≠ j) :
    subconst (𝕜 := ℂ) G x k *ᵥ w = 0 := by
  rw [← hw, Matrix.mulVec_mulVec, subconst_mul_subconst, if_neg h, Matrix.zero_mulVec]

/-- The raising matrix applied to a vector fixed by `E*_j` is `E*_{j+1} A`. -/
theorem raising_mulVec_eq {G : SimpleGraph X} {x : X} {D : ℕ}
    (hD : ∀ y, G.dist x y ≤ D) {j : ℕ} {w : X → ℂ}
    (hw : subconst (𝕜 := ℂ) G x j *ᵥ w = w) :
    raising (𝕜 := ℂ) G x D *ᵥ w
      = subconst (𝕜 := ℂ) G x (j + 1) *ᵥ (adj (𝕜 := ℂ) G *ᵥ w) := by
  by_cases hj : j < D
  · rw [raising, Matrix.sum_mulVec, Finset.sum_eq_single j]
    · rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hw]
    · intro k _ hne
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
        subconst_mulVec_eq_zero_of_ne hw hne]
      simp
    · intro hmem
      exact absurd (Finset.mem_range.mpr hj) hmem
  · rw [not_lt] at hj
    have hz : subconst (𝕜 := ℂ) G x (j + 1) = 0 := subconst_eq_zero_of_lt hD (by omega)
    rw [hz, Matrix.zero_mulVec, raising, Matrix.sum_mulVec, Finset.sum_eq_zero]
    intro k hk
    rw [Finset.mem_range] at hk
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
      subconst_mulVec_eq_zero_of_ne hw (by omega)]
    simp

/-- The lowering matrix applied to a vector fixed by `E*_j` is `E*_{j-1} A`. -/
theorem lowering_mulVec_eq {G : SimpleGraph X} {x : X} {D j : ℕ}
    (hj : 1 ≤ j) (hjD : j ≤ D) {w : X → ℂ}
    (hw : subconst (𝕜 := ℂ) G x j *ᵥ w = w) :
    lowering (𝕜 := ℂ) G x D *ᵥ w
      = subconst (𝕜 := ℂ) G x (j - 1) *ᵥ (adj (𝕜 := ℂ) G *ᵥ w) := by
  rw [lowering, Matrix.sum_mulVec, Finset.sum_eq_single j]
  · rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hw]
  · intro k _ hne
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
      subconst_mulVec_eq_zero_of_ne hw hne]
    simp
  · intro hmem
    exact absurd (Finset.mem_Icc.mpr ⟨hj, hjD⟩) hmem

/-- **Image of `L` on a thin module.**  Let `W` be a thin irreducible
`T(x)`-module with endpoint `r` and diameter `d`.  Then for `i < d` every vector
of `E*_{r+i}(x)W` lies in the image of the lowering matrix `L`.

Proof (lecture 32, Lemma 32.1 (i)): `up_nonvanishing` produces `0 ≠ u₁` in
`E*_{r+i+1}W` of the shape `E*_{r+i+1} A v`; the Hermitian pairing gives
`⟨v, L u₁⟩ = ⟨u₁, u₁⟩ ≠ 0`, so `L u₁` is a nonzero multiple of `v`. -/
theorem exists_lowering_eq_of_thin {G : SimpleGraph X} {x : X} {W : Submodule ℂ (X → ℂ)}
    {r d D : ℕ} (hD : ∀ y, G.dist x y ≤ D)
    (hstable : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hirr : IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W)
    (hthin : ThinModule (𝕜 := ℂ) G x W) (hend : IsEndpoint (𝕜 := ℂ) G x W r)
    (hdiam : IsDiameter (𝕜 := ℂ) G x W r d) {i : ℕ} (hi : i < d) {v : X → ℂ}
    (hv : v ∈ subconstImage (𝕜 := ℂ) G x (r + i) W) :
    ∃ u : X → ℂ, lowering (𝕜 := ℂ) G x D *ᵥ u = v := by
  by_cases hv0 : v = 0
  · exact ⟨0, by rw [hv0, Matrix.mulVec_zero]⟩
  set u₁ : X → ℂ := subconst (𝕜 := ℂ) G x (r + i + 1) *ᵥ (adj (𝕜 := ℂ) G *ᵥ v)
    with hu₁def
  -- `up_nonvanishing` gives a vector of `E*_{r+i}W` whose image in `E*_{r+i+1}W` is nonzero
  have hup := up_nonvanishing (W := W) (r := r) (d := d) hstable hirr hend hdiam hD
    (j := r + i) (by omega) (by omega)
  have hex : ∃ v' ∈ subconstImage (𝕜 := ℂ) G x (r + i) W,
      subconst (𝕜 := ℂ) G x (r + i + 1) *ᵥ (adj (𝕜 := ℂ) G *ᵥ v') ≠ 0 := by
    by_contra h
    refine hup (fun v' hv' => ?_)
    by_contra hne
    exact h ⟨v', hv', hne⟩
  obtain ⟨v', hv', hv'ne⟩ := hex
  -- `v` spans `E*_{r+i}W`, so `u₁ ≠ 0`
  have hv'0 : v' ≠ 0 := by
    intro h0
    exact hv'ne (by rw [h0]; simp)
  obtain ⟨c, hc⟩ := exists_smul_of_mem_subconstImage hthin hv' hv hv'0
  have hc0 : c ≠ 0 := by
    intro h0
    exact hv0 (by rw [hc, h0, zero_smul])
  have hv'eq : v' = c⁻¹ • v := by
    rw [hc, smul_smul, inv_mul_cancel₀ hc0, one_smul]
  have hu₁ne : u₁ ≠ 0 := by
    rw [hu₁def]
    intro h0
    exact hv'ne (by rw [hv'eq, Matrix.mulVec_smul, Matrix.mulVec_smul, h0, smul_zero])
  have hu₁mem : u₁ ∈ subconstImage (𝕜 := ℂ) G x (r + i + 1) W := by
    rw [hu₁def]
    exact mem_matImage.2 ⟨adj (𝕜 := ℂ) G *ᵥ v, hstable _ (adj_mem_subconstituentAlgebra G x) v
      (mem_of_mem_subconstImage hstable hv), rfl⟩
  have hu₁W : u₁ ∈ W := mem_of_mem_subconstImage hstable hu₁mem
  have hEu₁ : subconst (𝕜 := ℂ) G x (r + i + 1) *ᵥ u₁ = u₁ := subconst_mulVec_self hu₁mem
  have hj1 : 1 ≤ r + i + 1 := by omega
  have hjD : r + i + 1 ≤ D := by
    have h := le_of_diam (W := W) (r := r) (d := d) hD hdiam (show i + 1 ≤ d by omega)
    omega
  -- `L u₁ = E*_{r+i} A u₁`
  have hLu₁ : lowering (𝕜 := ℂ) G x D *ᵥ u₁
      = subconst (𝕜 := ℂ) G x (r + i) *ᵥ (adj (𝕜 := ℂ) G *ᵥ u₁) := by
    have h := lowering_mulVec_eq (G := G) (x := x) (D := D) (j := r + i + 1) hj1 hjD hEu₁
    rw [show r + i + 1 - 1 = r + i from by omega] at h
    exact h
  -- the pairing computation `⟨v, L u₁⟩ = ⟨u₁, u₁⟩`
  have hEv : subconst (𝕜 := ℂ) G x (r + i) *ᵥ v = v := subconst_mulVec_self hv
  have hpair : star v ⬝ᵥ (lowering (𝕜 := ℂ) G x D *ᵥ u₁) = star u₁ ⬝ᵥ u₁ := by
    calc star v ⬝ᵥ (lowering (𝕜 := ℂ) G x D *ᵥ u₁)
        = star v ⬝ᵥ (subconst (𝕜 := ℂ) G x (r + i) *ᵥ (adj (𝕜 := ℂ) G *ᵥ u₁)) := by
          rw [hLu₁]
      _ = star (subconst (𝕜 := ℂ) G x (r + i) *ᵥ v) ⬝ᵥ (adj (𝕜 := ℂ) G *ᵥ u₁) := by
          rw [← selfAdj_star_dotProduct (star_subconst (𝕜 := ℂ) G x (r + i)) v
            (adj (𝕜 := ℂ) G *ᵥ u₁)]
      _ = star v ⬝ᵥ (adj (𝕜 := ℂ) G *ᵥ u₁) := by rw [hEv]
      _ = star (adj (𝕜 := ℂ) G *ᵥ v) ⬝ᵥ u₁ := by
          rw [← selfAdj_star_dotProduct (star_adj (𝕜 := ℂ) G) v u₁]
      _ = star (adj (𝕜 := ℂ) G *ᵥ v) ⬝ᵥ (subconst (𝕜 := ℂ) G x (r + i + 1) *ᵥ u₁) := by
          rw [hEu₁]
      _ = star (subconst (𝕜 := ℂ) G x (r + i + 1) *ᵥ (adj (𝕜 := ℂ) G *ᵥ v)) ⬝ᵥ u₁ := by
          rw [← selfAdj_star_dotProduct (star_subconst (𝕜 := ℂ) G x (r + i + 1))
            (adj (𝕜 := ℂ) G *ᵥ v) u₁]
      _ = star u₁ ⬝ᵥ u₁ := by rw [hu₁def]
  have hu₁sq : star u₁ ⬝ᵥ u₁ ≠ 0 := fun h => hu₁ne (star_dotProduct_self_eq_zero h)
  -- `L u₁` is a multiple of `v` (thinness: `E*_{r+i}W` is a line)
  have hLmem : lowering (𝕜 := ℂ) G x D *ᵥ u₁ ∈ subconstImage (𝕜 := ℂ) G x (r + i) W := by
    rw [hLu₁]
    exact mem_matImage.2 ⟨adj (𝕜 := ℂ) G *ᵥ u₁,
      hstable _ (adj_mem_subconstituentAlgebra G x) u₁ hu₁W, rfl⟩
  obtain ⟨c, hc⟩ := exists_smul_of_mem_subconstImage hthin hv hLmem hv0
  have hcne : c ≠ 0 := by
    intro hc0
    have h0 : star u₁ ⬝ᵥ u₁ = 0 := by
      rw [← hpair, hc, hc0, zero_smul, dotProduct_zero]
    exact hu₁sq h0
  refine ⟨c⁻¹ • u₁, ?_⟩
  rw [Matrix.mulVec_smul, hc, smul_smul, inv_mul_cancel₀ hcne, one_smul]

/-- Intersections of stable subspaces are stable. -/
theorem isStable_inf' {T : Subalgebra ℂ (Matrix X X ℂ)} {U U' : Submodule ℂ (X → ℂ)}
    (hU : IsStable T U) (hU' : IsStable T U') : IsStable T (U ⊓ U') := by
  intro a ha w hw
  rw [Submodule.mem_inf] at hw ⊢
  exact ⟨hU a ha w hw.1, hU' a ha w hw.2⟩

/-- The span of all irreducible `T(x)`-submodules of the standard module. -/
def irredSpan (G : SimpleGraph X) (x : X) : Submodule ℂ (X → ℂ) :=
  Submodule.span ℂ {w : X → ℂ | ∃ U : Submodule ℂ (X → ℂ),
    IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra U ∧
      IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra U ∧ w ∈ U}

/-- **Lemma 1.8 (iii), the form needed for Definition 32.2.**  The irreducible
`T(x)`-submodules span the standard module.  (Induction on the dimension of a
stable subspace, splitting off a proper stable submodule and its orthogonal
complement inside that subspace.) -/
theorem le_irredSpan_of_isStable :
    ∀ (n : ℕ) (Z : Submodule ℂ (X → ℂ)),
      Module.finrank ℂ ↥Z ≤ n →
      IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra Z →
        Z ≤ irredSpan G x := by
  intro n
  induction n with
  | zero =>
    intro Z hfin _
    have hbot : Z = ⊥ := by
      by_contra hne
      obtain ⟨b, hbZ, hb0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
      have hle : Submodule.span ℂ ({b} : Set (X → ℂ)) ≤ Z :=
        Submodule.span_le.mpr (by simpa using hbZ)
      have h1 : Module.finrank ℂ ↥(Submodule.span ℂ ({b} : Set (X → ℂ))) = 1 :=
        finrank_span_singleton (K := ℂ) (V := X → ℂ) hb0
      have h2 : Module.finrank ℂ ↥(Submodule.span ℂ ({b} : Set (X → ℂ)))
          ≤ Module.finrank ℂ ↥Z := Submodule.finrank_mono hle
      omega
    rw [hbot]
    exact bot_le
  | succ n ih =>
    intro Z _ hZ
    by_cases hbot : Z = ⊥
    · rw [hbot]
      exact bot_le
    by_cases hirr : IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra Z
    · intro v hv
      exact Submodule.subset_span ⟨Z, hirr, hZ, hv⟩
    · obtain ⟨U, hUZ, hUstab, hUne, hUZne⟩ :
        ∃ U : Submodule ℂ (X → ℂ), U ≤ Z ∧
          IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra U ∧ U ≠ ⊥ ∧ U ≠ Z := by
        by_contra h
        refine hirr ⟨hbot, fun U hUZ hUstab hUne => ?_⟩
        by_contra hUZne
        exact h ⟨U, hUZ, hUstab, hUne, hUZne⟩
      have hUfin : Module.finrank ℂ ↥U < Module.finrank ℂ ↥Z :=
        Submodule.finrank_lt_finrank_of_lt (lt_of_le_of_ne hUZ hUZne)
      set Z₁ : Submodule ℂ (X → ℂ) := Z ⊓ orthCompl U with hZ₁def
      have hZ₁stab : IsStable (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra Z₁ :=
        isStable_inf' hZ (isStable_orthCompl (fun a ha =>
          StarMemClass.star_mem (s := subconstituentAlgebra (𝕜 := ℂ) G x) ha) hUstab)
      have hZ₁ne : Z₁ ≠ Z := by
        obtain ⟨u, huU, hu0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hUne
        intro hEq
        have huZ : u ∈ Z₁ := hEq ▸ hUZ huU
        have huorth : u ∈ orthCompl U := (Submodule.mem_inf.mp huZ).2
        exact hu0 (star_dotProduct_self_eq_zero (mem_orthCompl.mp huorth u huU))
      have hZ₁fin : Module.finrank ℂ ↥Z₁ < Module.finrank ℂ ↥Z :=
        Submodule.finrank_lt_finrank_of_lt (lt_of_le_of_ne inf_le_left hZ₁ne)
      intro v hv
      obtain ⟨h, hhU, horth⟩ := exists_orthogonal_decomp (W := U) v
      have hvsub : v - h ∈ Z₁ := by
        refine Submodule.mem_inf.mpr ⟨Submodule.sub_mem _ hv (hUZ hhU), ?_⟩
        exact fun u hu => horth u hu
      have h1 : h ∈ irredSpan G x := ih U (by omega) hUstab hhU
      have h2 : v - h ∈ irredSpan G x := ih Z₁ (by omega) hZ₁stab hvsub
      have hsum : h + (v - h) = v := by abel
      rw [← hsum]
      exact Submodule.add_mem _ h1 h2

/-- Every irreducible `T(x)`-module has an endpoint: `E*_k = 0` beyond the
eccentricity of `x`, and some `E*_k` is nonzero on a nonzero module. -/
theorem exists_isEndpoint_of_irreducible {G : SimpleGraph X} {x : X}
    {W : Submodule ℂ (X → ℂ)}
    (hW : IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W) :
    ∃ r : ℕ, IsEndpoint G x W r := by
  obtain ⟨v, hvW, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hW.1
  set D : ℕ := Finset.univ.sup (fun y : X => G.dist x y) with hDdef
  have hD : ∀ y, G.dist x y ≤ D := fun y => Finset.le_sup (Finset.mem_univ y)
  have hex : ∃ k, subconstImage (𝕜 := ℂ) G x k W ≠ ⊥ := by
    by_contra h
    have hterm : ∀ k, subconst (𝕜 := ℂ) G x k *ᵥ v = 0 := by
      intro k
      have hmem : subconst (𝕜 := ℂ) G x k *ᵥ v ∈ subconstImage (𝕜 := ℂ) G x k W :=
        mem_matImage.2 ⟨v, hvW, rfl⟩
      have hbot : subconstImage (𝕜 := ℂ) G x k W = ⊥ := by
        by_contra hk
        exact h ⟨k, hk⟩
      rw [hbot] at hmem
      simpa using hmem
    have hvsum := mulVec_eq_sum_subconst_mulVec (G := G) (x := x) hD v
    have hzero : ∑ k ∈ Finset.range (D + 1), subconst (𝕜 := ℂ) G x k *ᵥ v = 0 :=
      Finset.sum_eq_zero (fun k _ => hterm k)
    rw [hzero] at hvsum
    exact hv0 hvsum
  refine ⟨Nat.find hex, Nat.find_spec hex, ?_⟩
  intro i hi
  by_contra hne
  exact Nat.find_min hex hi hne

/-! ## Chapter 38 auxiliary material: the two-vertex subconstituents `E*_{ij}`

The calculus of the projections `E*_{ij} = E*_i(x)E*_j(y)` and the three
computations of lecture 38, proved here for every graph (no hypotheses). -/

variable {X : Type*} [Fintype X] [DecidableEq X]

/-! ## The two-vertex subconstituents `E*_{ij} = E*_i(x) E*_j(y)` -/

/-- `E*_{ij} = E*_i(x) E*_j(y)`: the projection onto the vertices `z` with
`∂(x,z) = i` and `∂(y,z) = j` (Chapter 38 notation). -/
def subconstij (G : SimpleGraph X) (x y : X) (i j : ℕ) : Matrix X X ℂ :=
  subconst (𝕜 := ℂ) G x i * subconst (𝕜 := ℂ) G y j

/-- Subconstituent projections with respect to different base vertices commute
(all are diagonal). -/
theorem subconst_mul_subconst_comm {G : SimpleGraph X} (x y : X) (i j : ℕ) :
    subconst (𝕜 := ℂ) G x i * subconst (𝕜 := ℂ) G y j
      = subconst (𝕜 := ℂ) G y j * subconst (𝕜 := ℂ) G x i := by
  rw [subconst, subconst, diagonal_mul_diagonal, diagonal_mul_diagonal]
  congr 1
  funext z
  exact mul_comm _ _

/-- `E*_{ij}` is the diagonal matrix of the products of the two subconstituent
indicators. -/
theorem subconstij_eq_diagonal (G : SimpleGraph X) (x y : X) (i j : ℕ) :
    subconstij G x y i j
      = diagonal (fun z => ((if G.dist x z = i then (1 : ℂ) else 0)
          * (if G.dist y z = j then 1 else 0))) := by
  rw [subconstij, subconst, subconst, diagonal_mul_diagonal]

theorem subconstij_apply (G : SimpleGraph X) (x y : X) (i j : ℕ) (u v : X) :
    subconstij G x y i j u v = if u = v then
      ((if G.dist x u = i then (1 : ℂ) else 0) * (if G.dist y u = j then 1 else 0))
      else 0 := by
  rw [subconstij_eq_diagonal, diagonal_apply]

/-- Reordering the factors of a five-fold product along a commutation. -/
theorem mul_five_swap {P Q M N R : Matrix X X ℂ} (h : P * Q = Q * P) :
    P * Q * M * (N * R) = Q * (P * M * N) * R := by
  rw [h]
  simp only [mul_assoc]

/-- Swapping the last two factors of a five-fold product. -/
theorem mul_five_swap_last {P Q M N R : Matrix X X ℂ} (h : N * R = R * N) :
    P * Q * M * (N * R) = P * (Q * M * R) * N := by
  rw [h]
  simp only [mul_assoc]

/-- A vanishing `x`-sandwich stays zero inside `y`-projections. -/
theorem raw_sandwich_eq_zero_of_x {G : SimpleGraph X} {x y : X} {i j k l m : ℕ}
    (h0 : subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G ^ m * subconst (𝕜 := ℂ) G x k = 0) :
    subconst (𝕜 := ℂ) G x i * subconst (𝕜 := ℂ) G y j * adj (𝕜 := ℂ) G ^ m
      * (subconst (𝕜 := ℂ) G x k * subconst (𝕜 := ℂ) G y l) = 0 := by
  rw [mul_five_swap (subconst_mul_subconst_comm (G := G) x y i j), h0, mul_zero, zero_mul]

/-- A vanishing `y`-sandwich stays zero inside `x`-projections. -/
theorem raw_sandwich_eq_zero_of_y {G : SimpleGraph X} {x y : X} {i j k l m : ℕ}
    (h0 : subconst (𝕜 := ℂ) G y j * adj (𝕜 := ℂ) G ^ m * subconst (𝕜 := ℂ) G y l = 0) :
    subconst (𝕜 := ℂ) G x i * subconst (𝕜 := ℂ) G y j * adj (𝕜 := ℂ) G ^ m
      * (subconst (𝕜 := ℂ) G x k * subconst (𝕜 := ℂ) G y l) = 0 := by
  rw [mul_five_swap_last (subconst_mul_subconst_comm (G := G) y x l k).symm, h0, mul_zero,
    zero_mul]

/-- Two-vertex form of the iterated band lemma: `E*_{ij} A^m E*_{kl} = 0` when the
`x`-levels or the `y`-levels differ by more than `m`. -/
theorem subconstij_mul_adj_pow_mul_subconstij_eq_zero {G : SimpleGraph X} {x y : X}
    {i j k l m : ℕ} (h : k + m < i ∨ i + m < k ∨ l + m < j ∨ j + m < l) :
    subconstij G x y i j * adj (𝕜 := ℂ) G ^ m * subconstij G x y k l = 0 := by
  rcases h with h | h | h | h
  · exact raw_sandwich_eq_zero_of_x (x := x) (y := y)
      (subconst_mul_adj_pow_mul_subconst_eq_zero (Or.inl h))
  · exact raw_sandwich_eq_zero_of_x (x := x) (y := y)
      (subconst_mul_adj_pow_mul_subconst_eq_zero (Or.inr h))
  · exact raw_sandwich_eq_zero_of_y (x := x) (y := y)
      (subconst_mul_adj_pow_mul_subconst_eq_zero (Or.inl h))
  · exact raw_sandwich_eq_zero_of_y (x := x) (y := y)
      (subconst_mul_adj_pow_mul_subconst_eq_zero (Or.inr h))

/-- Two-vertex form of the one-step band lemma. -/
theorem subconstij_mul_adj_mul_subconstij_eq_zero {G : SimpleGraph X} {x y : X}
    {i j k l : ℕ} (h : k + 1 < i ∨ i + 1 < k ∨ l + 1 < j ∨ j + 1 < l) :
    subconstij G x y i j * adj (𝕜 := ℂ) G * subconstij G x y k l = 0 := by
  simpa [pow_one] using subconstij_mul_adj_pow_mul_subconstij_eq_zero (m := 1) (by
    rcases h with h | h | h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr h)))

/-- Geometry of the two spheres: for adjacent `x`, `y` there is no vertex `z` with
`∂(x,z) = i` and `∂(y,z) = j` when `i`, `j` differ by more than one; hence
`E*_{ij} = 0`. -/
theorem subconstij_eq_zero_of_dist {G : SimpleGraph X} (hG : G.Connected) {x y : X}
    (hy : G.Adj x y) {i j : ℕ} (h : j + 1 < i ∨ i + 1 < j) :
    subconstij G x y i j = 0 := by
  have hxy : G.dist x y = 1 := SimpleGraph.dist_eq_one_iff_adj.mpr hy
  have hyx : G.dist y x = 1 := SimpleGraph.dist_eq_one_iff_adj.mpr hy.symm
  ext u v
  rw [subconstij_apply, Matrix.zero_apply]
  by_cases huv : u = v
  · subst huv
    rw [if_pos rfl]
    by_cases hx : G.dist x u = i
    · by_cases hyl : G.dist y u = j
      · exfalso
        rcases h with h | h
        · exact not_dist_eq_of_lt hG (by omega) u ⟨hx, hyl⟩
        · exact not_dist_eq_of_lt hG (x := y) (y := x) (i := j) (j := i) (by omega) u ⟨hyl, hx⟩
      · simp [hx, hyl]
    · simp [hx]
  · rw [if_neg huv]

/-- `E*_{ij}` is an idempotent. -/
theorem subconstij_mul_self (G : SimpleGraph X) (x y : X) (i j : ℕ) :
    subconstij G x y i j * subconstij G x y i j = subconstij G x y i j := by
  rw [subconstij_eq_diagonal, diagonal_mul_diagonal]
  congr 1
  funext z
  by_cases h1 : G.dist x z = i <;> by_cases h2 : G.dist y z = j <;> simp [h1, h2]

/-- Unfolding a two-fold matrix product against a vector. -/
theorem mulVec_three (M N : Matrix X X ℂ) (v : X → ℂ) :
    (M * N) *ᵥ v = M *ᵥ (N *ᵥ v) := (Matrix.mulVec_mulVec ..).symm

/-- Unfolding a five-fold matrix product against a vector. -/
theorem mulVec_chain5 (M1 M2 M3 M4 M5 : Matrix X X ℂ) (u : X → ℂ) :
    (M1 * M2 * M3 * M4 * M5) *ᵥ u
      = M1 *ᵥ (M2 *ᵥ (M3 *ᵥ (M4 *ᵥ (M5 *ᵥ u)))) := by
  simp only [← Matrix.mulVec_mulVec]

/-- Unfolding a seven-fold matrix product against a vector. -/
theorem mulVec_chain7 (M1 M2 M3 M4 M5 M6 M7 : Matrix X X ℂ) (u : X → ℂ) :
    (M1 * M2 * M3 * M4 * M5 * M6 * M7) *ᵥ u
      = M1 *ᵥ (M2 *ᵥ (M3 *ᵥ (M4 *ᵥ (M5 *ᵥ (M6 *ᵥ (M7 *ᵥ u)))))) := by
  simp only [← Matrix.mulVec_mulVec]

/-! ## Vector-level consequences of the band lemma -/

/-- If `w` lies in the `j`-th subconstituent of `x`, then `E*_i(x) A^m w = 0` for
`i > j + m`. -/
theorem subconst_mulVec_adj_pow_eq_zero_of_level {G : SimpleGraph X} {x : X} {j m i : ℕ}
    {w : X → ℂ} (hw : subconst (𝕜 := ℂ) G x j *ᵥ w = w) (h : j + m < i) :
    subconst (𝕜 := ℂ) G x i *ᵥ (adj (𝕜 := ℂ) G ^ m *ᵥ w) = 0 := by
  have h1 : subconst (𝕜 := ℂ) G x i *ᵥ (adj (𝕜 := ℂ) G ^ m *ᵥ w)
      = (subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G ^ m * subconst (𝕜 := ℂ) G x j) *ᵥ w := by
    calc subconst (𝕜 := ℂ) G x i *ᵥ (adj (𝕜 := ℂ) G ^ m *ᵥ w)
        = (subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G ^ m) *ᵥ w := by
          rw [Matrix.mulVec_mulVec]
      _ = (subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G ^ m)
            *ᵥ (subconst (𝕜 := ℂ) G x j *ᵥ w) := by rw [hw]
      _ = (subconst (𝕜 := ℂ) G x i * adj (𝕜 := ℂ) G ^ m * subconst (𝕜 := ℂ) G x j) *ᵥ w := by
          rw [Matrix.mulVec_mulVec]
  rw [h1, subconst_mul_adj_pow_mul_subconst_eq_zero (Or.inl h), Matrix.zero_mulVec]

/-- The `E*_{11}`-component of a vector in `E*_1(x)V` and `E*_1(y)V` fixes it. -/
theorem subconst_one_mulVec_of_subconstij {G : SimpleGraph X} {x y : X} {u : X → ℂ}
    (hu : subconstij G x y 1 1 *ᵥ u = u) :
    subconst (𝕜 := ℂ) G x 1 *ᵥ u = u ∧ subconst (𝕜 := ℂ) G y 1 *ᵥ u = u := by
  have hxy : subconstij G x y 1 1
      = subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 1 := rfl
  have hu' : (subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 1) *ᵥ u = u := by
    rw [← hxy]; exact hu
  have hu'' : (subconst (𝕜 := ℂ) G y 1 * subconst (𝕜 := ℂ) G x 1) *ᵥ u = u := by
    rw [← subconst_mul_subconst_comm (G := G) x y 1 1]; exact hu'
  constructor
  · calc subconst (𝕜 := ℂ) G x 1 *ᵥ u
        = subconst (𝕜 := ℂ) G x 1
            *ᵥ ((subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 1) *ᵥ u) := by rw [hu']
      _ = (subconst (𝕜 := ℂ) G x 1
            * (subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 1)) *ᵥ u := by
            rw [Matrix.mulVec_mulVec]
      _ = ((subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G x 1)
            * subconst (𝕜 := ℂ) G y 1) *ᵥ u := by rw [mul_assoc]
      _ = (subconst (𝕜 := ℂ) G x 1 * subconst (𝕜 := ℂ) G y 1) *ᵥ u := by
            rw [subconst_mul_self]
      _ = u := hu'
  · calc subconst (𝕜 := ℂ) G y 1 *ᵥ u
        = subconst (𝕜 := ℂ) G y 1
            *ᵥ ((subconst (𝕜 := ℂ) G y 1 * subconst (𝕜 := ℂ) G x 1) *ᵥ u) := by rw [hu'']
      _ = (subconst (𝕜 := ℂ) G y 1
            * (subconst (𝕜 := ℂ) G y 1 * subconst (𝕜 := ℂ) G x 1)) *ᵥ u := by
            rw [Matrix.mulVec_mulVec]
      _ = ((subconst (𝕜 := ℂ) G y 1 * subconst (𝕜 := ℂ) G y 1)
            * subconst (𝕜 := ℂ) G x 1) *ᵥ u := by rw [mul_assoc]
      _ = (subconst (𝕜 := ℂ) G y 1 * subconst (𝕜 := ℂ) G x 1) *ᵥ u := by
            rw [subconst_mul_self]
      _ = u := hu''

/-! ## Step 1 of the proof of Lemma 38.1 (i) -/

/-- If `u ∈ E*_{11}V` and `E*_{22}AE*_{11}u = 0`, then `E*_2(y)Au` already lies in
`E*_{12}V`. -/
theorem subconst_y_two_adj_eq {G : SimpleGraph X} {x y : X} (hG : G.Connected) (hy : G.Adj x y)
    {D : ℕ} (hDx : ∀ z, G.dist x z ≤ D) {u : X → ℂ}
    (hu1 : subconst (𝕜 := ℂ) G x 1 *ᵥ u = u)
    (h22 : subconstij G x y 2 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ u) = 0) :
    subconst (𝕜 := ℂ) G y 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ u)
      = subconstij G x y 1 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ u) := by
  have hD1 : 1 ≤ D := by
    have h := hDx y
    rw [SimpleGraph.dist_eq_one_iff_adj.mpr hy] at h
    omega
  set w : X → ℂ := adj (𝕜 := ℂ) G *ᵥ u with hw
  have hexp : w = ∑ k ∈ Finset.range (D + 1), subconst (𝕜 := ℂ) G x k *ᵥ w :=
    mulVec_eq_sum_subconst_mulVec (x := x) hDx w
  have hL : subconst (𝕜 := ℂ) G y 2 *ᵥ w
      = ∑ k ∈ Finset.range (D + 1),
          (subconst (𝕜 := ℂ) G y 2 * subconst (𝕜 := ℂ) G x k) *ᵥ w := by
    conv_lhs => rw [hexp]
    rw [Matrix.mulVec_sum]
    exact Finset.sum_congr rfl (fun k _ => Matrix.mulVec_mulVec ..)
  have hsingle : ∑ k ∈ Finset.range (D + 1),
        (subconst (𝕜 := ℂ) G y 2 * subconst (𝕜 := ℂ) G x k) *ᵥ w
      = (subconst (𝕜 := ℂ) G y 2 * subconst (𝕜 := ℂ) G x 1) *ᵥ w := by
    refine Finset.sum_eq_single 1 (fun k _ hk => ?_)
      (fun h => absurd (Finset.mem_range.2 (by omega)) h)
    rcases Nat.eq_zero_or_pos k with hk0 | hkpos
    · subst hk0
      have hz : subconstij G x y 0 2 = 0 := subconstij_eq_zero_of_dist hG hy (Or.inr (by omega))
      have hz' : subconst (𝕜 := ℂ) G y 2 * subconst (𝕜 := ℂ) G x 0 = 0 := by
        rw [← subconst_mul_subconst_comm (G := G) x y 0 2]
        exact hz
      rw [hz', Matrix.zero_mulVec]
    · have hk2 : 2 ≤ k := by omega
      rcases Nat.eq_or_lt_of_le hk2 with hk2' | hk3
      · subst hk2'
        have hcomm : subconst (𝕜 := ℂ) G y 2 * subconst (𝕜 := ℂ) G x 2
            = subconst (𝕜 := ℂ) G x 2 * subconst (𝕜 := ℂ) G y 2 :=
          (subconst_mul_subconst_comm (G := G) x y 2 2).symm
        rw [hcomm]
        exact h22
      · have hzero : subconst (𝕜 := ℂ) G x k *ᵥ w = 0 := by
          have h := subconst_mulVec_adj_pow_eq_zero_of_level (x := x) (j := 1) (m := 1) (i := k)
            hu1 (by omega : 1 + 1 < k)
          simpa [hw, pow_one] using h
        rw [← Matrix.mulVec_mulVec, hzero, Matrix.mulVec_zero]
  rw [hL, hsingle]
  have hfin : subconst (𝕜 := ℂ) G y 2 * subconst (𝕜 := ℂ) G x 1
      = subconstij G x y 1 2 := (subconst_mul_subconst_comm (G := G) x y 1 2).symm
  rw [hfin]

/-! ## Steps 2–4: identifying `E*_4(y) A³ u` -/

/-- **Key computation for Lemma 38.1 (i).**  If `u ∈ E*_{11}V` and
`E*_{22}AE*_{11}u = 0`, then `E*_4(y)A³u = E*_{34}A²E*_{12}AE*_{11}u`. -/
theorem subconst_y_four_adj_pow_three_eq {G : SimpleGraph X} {x y : X} (hG : G.Connected)
    (hy : G.Adj x y) {D : ℕ} (hD : 5 ≤ D) (hDx : ∀ z, G.dist x z ≤ D)
    (hDy : ∀ z, G.dist y z ≤ D) {u : X → ℂ}
    (hu1 : subconst (𝕜 := ℂ) G x 1 *ᵥ u = u)
    (hu2 : subconst (𝕜 := ℂ) G y 1 *ᵥ u = u)
    (h22 : subconstij G x y 2 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ u) = 0) :
    subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ u)
      = subconstij G x y 3 4 *ᵥ (adj (𝕜 := ℂ) G ^ 2 *ᵥ
          (subconstij G x y 1 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ u))) := by
  set w : X → ℂ := adj (𝕜 := ℂ) G *ᵥ u with hw
  have hstep1 : subconst (𝕜 := ℂ) G y 2 *ᵥ w = subconstij G x y 1 2 *ᵥ w :=
    subconst_y_two_adj_eq hG hy hDx hu1 h22
  have hexp2 : subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 2 *ᵥ w)
      = ∑ j ∈ Finset.range (D + 1),
          (subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconst (𝕜 := ℂ) G y j) *ᵥ w := by
    conv_lhs => rw [Matrix.mulVec_mulVec, mulVec_eq_sum_subconst_mulVec (x := y) hDy w]
    rw [Matrix.mulVec_sum]
    exact Finset.sum_congr rfl (fun j _ => by simp only [← Matrix.mulVec_mulVec])
  have hsingle2 : ∑ j ∈ Finset.range (D + 1),
        (subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconst (𝕜 := ℂ) G y j) *ᵥ w
      = (subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconst (𝕜 := ℂ) G y 2) *ᵥ w := by
    refine Finset.sum_eq_single 2 (fun j _ hj => ?_)
      (fun h => absurd (Finset.mem_range.2 (by omega)) h)
    rcases lt_or_gt_of_ne hj with hj1 | hj3
    · have h0 : subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconst (𝕜 := ℂ) G y j = 0 :=
        subconst_mul_adj_pow_mul_subconst_eq_zero (x := y) (i := 4) (j := j) (m := 2)
          (Or.inl (by omega))
      rw [h0, Matrix.zero_mulVec]
    · have hzero : subconst (𝕜 := ℂ) G y j *ᵥ w = 0 := by
        have h := subconst_mulVec_adj_pow_eq_zero_of_level (x := y) (j := 1) (m := 1) (i := j)
          hu2 (by omega : 1 + 1 < j)
        simpa [hw, pow_one] using h
      rw [← Matrix.mulVec_mulVec, hzero, Matrix.mulVec_zero]
  have hstep3 : (subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconst (𝕜 := ℂ) G y 2) *ᵥ w
      = (subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2) *ᵥ w := by
    have h1 : (subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconst (𝕜 := ℂ) G y 2) *ᵥ w
        = (subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2) *ᵥ (subconst (𝕜 := ℂ) G y 2 *ᵥ w) :=
      mulVec_three ..
    rw [h1, hstep1]
    exact (mulVec_three ..).symm
  have hstep4 : subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2
      = subconstij G x y 3 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2 := by
    have hins : subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2
        = ∑ k ∈ Finset.range (D + 1),
            subconstij G x y k 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2 := by
      calc subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2
          = (∑ k ∈ Finset.range (D + 1), subconst (𝕜 := ℂ) G x k)
              * (subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2) := by
            rw [sum_subconst_eq_one G x D hDx, one_mul]
        _ = ∑ k ∈ Finset.range (D + 1), subconst (𝕜 := ℂ) G x k
              * (subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2) :=
            Finset.sum_mul ..
        _ = ∑ k ∈ Finset.range (D + 1),
              subconstij G x y k 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2 := by
            exact Finset.sum_congr rfl (fun k _ => by
              simp only [subconstij, mul_assoc])
    rw [hins]
    refine Finset.sum_eq_single 3 (fun k _ hk => ?_)
      (fun h => absurd (Finset.mem_range.2 (by omega)) h)
    rcases lt_or_gt_of_ne hk with hk3 | hk3
    · have h0 : subconstij G x y k 4 = 0 := subconstij_eq_zero_of_dist hG hy (Or.inr (by omega))
      simp [h0]
    · have h0 : subconstij G x y k 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2 = 0 :=
        subconstij_mul_adj_pow_mul_subconstij_eq_zero (m := 2) (Or.inl (by omega))
      simp [h0]
  have h3 : adj (𝕜 := ℂ) G ^ 3 = adj (𝕜 := ℂ) G ^ 2 * adj (𝕜 := ℂ) G := by
    rw [show (3 : ℕ) = 2 + 1 from rfl, pow_succ]
  calc subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ u)
      = subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ u)) := by
        simp only [h3, ← Matrix.mulVec_mulVec]
    _ = subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 2 *ᵥ w) := by rw [hw]
    _ = (subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconst (𝕜 := ℂ) G y 2) *ᵥ w := by
        rw [hexp2, hsingle2]
    _ = (subconst (𝕜 := ℂ) G y 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2) *ᵥ w := hstep3
    _ = (subconstij G x y 3 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2) *ᵥ w := by rw [hstep4]
    _ = subconstij G x y 3 4 *ᵥ (adj (𝕜 := ℂ) G ^ 2 *ᵥ (subconstij G x y 1 2 *ᵥ w)) := by
        rw [mulVec_three, mulVec_three]
    _ = subconstij G x y 3 4 *ᵥ (adj (𝕜 := ℂ) G ^ 2 *ᵥ
          (subconstij G x y 1 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ u))) := by rw [hw]

/-! ## The kernel of `E*_{22} A E*_{11}` is trivial -/

/-- The notes' display `(eq:g3plus-minus-zero)` of Chapter 38: the `i = 3` case of
Theorem 30.1 (i), sandwiched between `E*_1(y)` and `E*_1(x)`.  The notes transcribe
this as a matrix identity in the two-vertex projections; what their derivation from
Theorem 30.1 (i) actually gives is that the combination kills `E*_{11}V` (the
`y`-levels of the sandwiched expression are only pinned on that subspace).  So the
hypothesis is stated at the vector level. -/
def RFLThreeTerm (G : SimpleGraph X) (x y : X) : Prop :=
  ∃ gm gp γ : ℂ, gm ≠ 0 ∧
    ∀ u : X → ℂ, subconstij G x y 1 1 *ᵥ u = u →
      (gm • (subconstij G x y 3 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2
              * adj (𝕜 := ℂ) G * subconstij G x y 1 1)
        + (subconstij G x y 3 4 * adj (𝕜 := ℂ) G * subconstij G x y 2 3
              * adj (𝕜 := ℂ) G * subconstij G x y 2 2 * adj (𝕜 := ℂ) G
              * subconstij G x y 1 1)
        + gp • (subconstij G x y 3 4 * adj (𝕜 := ℂ) G * subconstij G x y 3 3
              * adj (𝕜 := ℂ) G * subconstij G x y 2 2 * adj (𝕜 := ℂ) G
              * subconstij G x y 1 1)) *ᵥ u = 0

/-- **Lemma 38.1 (i), kernel form.**  The kernel of `E*_{22}AE*_{11}` on `E*_{11}V`
is trivial (given the Chapter 32 and Chapter 30 inputs). -/
theorem e11_kernel {G : SimpleGraph X} {x y : X} (hG : G.Connected) (hy : G.Adj x y)
    {D : ℕ} (hD : 5 ≤ D) (hDx : ∀ z, G.dist x z ≤ D) (hDy : ∀ z, G.dist y z ≤ D)
    (hRinj : ∀ w : X → ℂ, subconst (𝕜 := ℂ) G y 1 *ᵥ w = w → w ≠ 0 →
      subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ w) ≠ 0)
    (hRFL : RFLThreeTerm G x y) {u : X → ℂ}
    (hu : u ∈ matImage (subconstij G x y 1 1) ⊤)
    (h0 : subconstij G x y 2 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ u) = 0)
    (hne : u ≠ 0) : False := by
  have hidem : subconstij G x y 1 1 *ᵥ u = u := by
    obtain ⟨t, -, ht⟩ := mem_matImage.mp hu
    rw [← ht, Matrix.mulVec_mulVec, subconstij_mul_self]
  obtain ⟨hu1, hu2⟩ := subconst_one_mulVec_of_subconstij hidem
  have hkey : subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ u)
      = subconstij G x y 3 4 *ᵥ (adj (𝕜 := ℂ) G ^ 2 *ᵥ
          (subconstij G x y 1 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ u))) :=
    subconst_y_four_adj_pow_three_eq (D := D) hG hy hD hDx hDy hu1 hu2 h0
  have hRinju : subconst (𝕜 := ℂ) G y 4 *ᵥ (adj (𝕜 := ℂ) G ^ 3 *ᵥ u) ≠ 0 := hRinj u hu2 hne
  have hclaim1 : subconstij G x y 3 4 *ᵥ (adj (𝕜 := ℂ) G ^ 2 *ᵥ
      (subconstij G x y 1 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ u))) ≠ 0 := by
    rw [← hkey]
    exact hRinju
  obtain ⟨gm, gp, γ, hgm, hrel⟩ := hRFL
  have hrelu : (gm • (subconstij G x y 3 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2
          * adj (𝕜 := ℂ) G * subconstij G x y 1 1)
      + (subconstij G x y 3 4 * adj (𝕜 := ℂ) G * subconstij G x y 2 3
          * adj (𝕜 := ℂ) G * subconstij G x y 2 2 * adj (𝕜 := ℂ) G * subconstij G x y 1 1)
      + gp • (subconstij G x y 3 4 * adj (𝕜 := ℂ) G * subconstij G x y 3 3
          * adj (𝕜 := ℂ) G * subconstij G x y 2 2 * adj (𝕜 := ℂ) G
          * subconstij G x y 1 1)) *ᵥ u = 0 := hrel u hidem
  have hM2u : (subconstij G x y 3 4 * adj (𝕜 := ℂ) G * subconstij G x y 2 3
      * adj (𝕜 := ℂ) G * subconstij G x y 2 2 * adj (𝕜 := ℂ) G * subconstij G x y 1 1) *ᵥ u
      = 0 := by
    rw [mulVec_chain7]
    rw [hidem, h0]
    simp
  have hM3u : (subconstij G x y 3 4 * adj (𝕜 := ℂ) G * subconstij G x y 3 3
      * adj (𝕜 := ℂ) G * subconstij G x y 2 2 * adj (𝕜 := ℂ) G * subconstij G x y 1 1) *ᵥ u
      = 0 := by
    rw [mulVec_chain7]
    rw [hidem, h0]
    simp
  have hM1u : (subconstij G x y 3 4 * adj (𝕜 := ℂ) G ^ 2 * subconstij G x y 1 2
      * adj (𝕜 := ℂ) G * subconstij G x y 1 1) *ᵥ u
      = subconstij G x y 3 4 *ᵥ (adj (𝕜 := ℂ) G ^ 2 *ᵥ
          (subconstij G x y 1 2 *ᵥ (adj (𝕜 := ℂ) G *ᵥ u))) := by
    rw [mulVec_chain5, hidem]
  rw [Matrix.add_mulVec, Matrix.add_mulVec, Matrix.smul_mulVec, Matrix.smul_mulVec,
    hM1u, hM2u, hM3u] at hrelu
  simp only [add_zero, mulVec_zero, smul_zero] at hrelu
  rcases smul_eq_zero.mp hrelu with h | h
  · exact hgm h
  · exact hclaim1 h


namespace DRGData

variable {G : SimpleGraph X} {x : X} {D : ℕ} (Y : DRGData G x D)

/-- `A* = ∑ᵢ θ*_i E*_i(x)`. -/
def Astar : Matrix X X ℂ := ∑ i : Fin (D + 1), (Y.thetaStar i : ℂ) • subconst (𝕜 := ℂ) G x i

/-- The `i`-th distance matrix `Aᵢ`. -/
def A (i : Fin (D + 1)) : Matrix X X ℂ := distMatrix (𝕜 := ℂ) G i

/-- `J̃ = E*₁(x) J E*₁(x)`. -/
def tildeJ (Y : DRGData G x D) : Matrix X X ℂ :=
  subconst (𝕜 := ℂ) G x 1 * allOnes * subconst (𝕜 := ℂ) G x 1

/-- `Ã = E*₁(x) A E*₁(x)`. -/
def tildeA (Y : DRGData G x D) : Matrix X X ℂ :=
  subconst (𝕜 := ℂ) G x 1 * adj (𝕜 := ℂ) G * subconst (𝕜 := ℂ) G x 1

/-- `Vᵢ`: the sum of the irreducible `T`-modules of endpoint `i`. -/
def endpointSpace (Y : DRGData G x D) (i : ℕ) : Submodule ℂ (X → ℂ) :=
  Submodule.span ℂ {v | ∃ W : Submodule ℂ (X → ℂ),
    IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W ∧ IsEndpoint G x W i ∧ v ∈ W}

/-- `(E*_iV)_new = E*_i V_i`. -/
def newSubconst (Y : DRGData G x D) (i : ℕ) : Submodule ℂ (X → ℂ) :=
  Submodule.span ℂ {v | ∃ W : Submodule ℂ (X → ℂ),
    IsIrreducible (subconstituentAlgebra (𝕜 := ℂ) G x).toSubalgebra W ∧
      IsEndpoint G x W i ∧ v ∈ subconstImage (𝕜 := ℂ) G x i W}

