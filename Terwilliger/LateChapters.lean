/-! ## Chapter 36: the dual endpoint -/

/-- **Definition 36.1.**  The dual endpoint `r*(W) = min{i | E_iW ≠ 0}`. -/
def IsDualEndpoint (W : Submodule ℂ (X → ℂ)) (E : Fin (D + 1) → Matrix X X ℂ) (r : Fin (D + 1)) : Prop :=
  matImage (E r) W ≠ ⊥ ∧ ∀ i : Fin (D + 1), i < r → matImage (E i) W = ⊥

/-! ## Chapter 37: generalized adjacency matrices -/

/-- **Definition 37.2.**  A generalized adjacency matrix of a graph: nonzero,
supported on the diagonal and the edges, and lying in the algebra generated by
`A` and `J`. -/
def IsGeneralizedAdjacency (G : SimpleGraph X) (B : Matrix X X ℂ) : Prop :=
  B ≠ 0 ∧ (∀ u v, B u v ≠ 0 → G.Adj u v ∨ u = v) ∧
    B ∈ Algebra.adjoin ℂ ({adj (𝕜 := ℂ) G, allOnes (𝕜 := ℂ)} : Set (Matrix X X ℂ))

