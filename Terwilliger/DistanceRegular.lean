/-!
# Distance-regularity, the trivial module, thin modules

Chapters 11–13 of Terwilliger's notes.

* `Terwilliger.cnum`, `anum`, `bnum` are the numbers
  `cᵢ(x,y) = #{z | ∂(x,z) = i-1, y ∼ z}`,
  `aᵢ(x,y) = #{z | ∂(x,z) = i, y ∼ z}`,
  `bᵢ(x,y) = #{z | ∂(x,z) = i+1, y ∼ z}`
  of Definition 11.1.
* `Terwilliger.IsDistanceRegularAt` says these depend only on `i = ∂(x,y)`.
* `Terwilliger.ThinModule` is Definition 6.6 (i): `dim Eᵢ*W ≤ 1` for all `i`.

The main result of Chapter 12 is that, for a distance-regular graph, the trivial
module `T(x)x̂` is thin and has the sphere sums as a basis.
-/

set_option linter.unusedSectionVars false

open scoped Classical
open Matrix

noncomputable section

namespace Terwilliger

variable {𝕜 : Type*} [RCLike 𝕜]
variable {X : Type*} [Fintype X] [DecidableEq X]

/-! ## The intersection numbers `cᵢ`, `aᵢ`, `bᵢ` -/

/-- `cᵢ(x,y) = #{z | ∂(x,z) = i - 1, y ∼ z}` (Definition 11.1). -/
def cnum (G : SimpleGraph X) (x y : X) (i : ℕ) : ℕ :=
  (Finset.univ.filter fun z => G.dist x z + 1 = i ∧ G.Adj y z).card

/-- `aᵢ(x,y) = #{z | ∂(x,z) = i, y ∼ z}` (Definition 11.1). -/
def anum (G : SimpleGraph X) (x y : X) (i : ℕ) : ℕ :=
  (Finset.univ.filter fun z => G.dist x z = i ∧ G.Adj y z).card

/-- `bᵢ(x,y) = #{z | ∂(x,z) = i + 1, y ∼ z}` (Definition 11.1). -/
def bnum (G : SimpleGraph X) (x y : X) (i : ℕ) : ℕ :=
  (Finset.univ.filter fun z => G.dist x z = i + 1 ∧ G.Adj y z).card

/-- **Definition 11.1.** `Γ` is distance-regular with respect to `x` if the
numbers `cᵢ`, `aᵢ`, `bᵢ` depend only on `i` and `x`, not on the choice of the
vertex `y` at distance `i` from `x`. -/
def IsDistanceRegularAt (G : SimpleGraph X) (x : X) : Prop :=
  ∀ (i : ℕ) (y y' : X), G.dist x y = i → G.dist x y' = i →
    (∀ j, cnum G x y j = cnum G x y' j) ∧
    (∀ j, anum G x y j = anum G x y' j) ∧
    (∀ j, bnum G x y j = bnum G x y' j)

/-- `Γ` is distance-regular (with respect to every vertex). -/
def IsDistanceRegular (G : SimpleGraph X) : Prop := ∀ x, IsDistanceRegularAt G x

/-- A graph is regular of valency `k`. -/
def IsRegular (G : SimpleGraph X) (k : ℕ) : Prop := ∀ x, valency G x = k

/-! ## The trivial `T(x)`-module -/

/-- The cyclic `T(x)`-module generated by `x̂` (the "trivial module"). -/
def trivialModule (G : SimpleGraph X) (x : X) : Submodule 𝕜 (X → 𝕜) :=
  Submodule.span 𝕜 ((fun a : Matrix X X 𝕜 => a *ᵥ Pi.single x 1) ''
    ↑(subconstituentAlgebra (𝕜 := 𝕜) G x).toSubalgebra)

theorem mulVec_single_mem_trivialModule (G : SimpleGraph X) (x : X)
    {a : Matrix X X 𝕜} (ha : a ∈ (subconstituentAlgebra (𝕜 := 𝕜) G x).toSubalgebra) :
    a *ᵥ Pi.single x 1 ∈ trivialModule (𝕜 := 𝕜) G x :=
  Submodule.subset_span ⟨a, ha, rfl⟩

/-- The trivial module is a `T(x)`-module. -/
theorem isStable_trivialModule (G : SimpleGraph X) (x : X) :
    IsStable (subconstituentAlgebra (𝕜 := 𝕜) G x).toSubalgebra
      (trivialModule (𝕜 := 𝕜) G x) := by
  intro a ha v hv
  induction hv using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨b, hb, rfl⟩ := hx
      rw [mulVec_mulVec]
      exact mulVec_single_mem_trivialModule G x (mul_mem ha hb)
  | zero => simp
  | add u v _ _ hu hv => rw [mulVec_add]; exact Submodule.add_mem _ hu hv
  | smul c u _ hu => rw [mulVec_smul]; exact Submodule.smul_mem _ c hu

/-! ## Thin modules and endpoints -/

/-- **Definition 6.6 (i).** An irreducible `T(x)`-module `W` is thin if
`dim Eᵢ*W ≤ 1` for every `i`. -/
def ThinModule (G : SimpleGraph X) (x : X) (W : Submodule 𝕜 (X → 𝕜)) : Prop :=
  ∀ i : ℕ, Module.finrank 𝕜 (subconstImage (𝕜 := 𝕜) G x i W) ≤ 1

/-- The endpoint `r(W) = min{i | Eᵢ*W ≠ 0}` (Definition 4.1). -/
def IsEndpoint (G : SimpleGraph X) (x : X) (W : Submodule 𝕜 (X → 𝕜)) (r : ℕ) : Prop :=
  subconstImage (𝕜 := 𝕜) G x r W ≠ ⊥ ∧ ∀ i < r, subconstImage (𝕜 := 𝕜) G x i W = ⊥

/-- The `T(x)`-module `W` is supported on the subconstituents `r, …, r+d`;
`d = d(W)` is its diameter (Definition 4.1). -/
def IsDiameter (G : SimpleGraph X) (x : X) (W : Submodule 𝕜 (X → 𝕜)) (r d : ℕ) : Prop :=
  (∀ i, r ≤ i → i ≤ r + d → subconstImage (𝕜 := 𝕜) G x i W ≠ ⊥) ∧
    (∀ i, subconstImage (𝕜 := 𝕜) G x i W ≠ ⊥ → r ≤ i ∧ i ≤ r + d)

/-! ## Sphere sums -/

/-- The sum of the standard basis vectors over the `i`-th sphere around `x`. -/
def sphereSum (G : SimpleGraph X) (x : X) (i : ℕ) : X → 𝕜 :=
  fun z => if G.dist x z = i then 1 else 0

@[simp]
theorem sphereSum_apply (G : SimpleGraph X) (x z : X) (i : ℕ) :
    sphereSum (𝕜 := 𝕜) G x i z = if G.dist x z = i then 1 else 0 := rfl

/-- `Sᵢ` is `Eᵢ*(x)` applied to the all-ones vector. -/
theorem sphereSum_eq_sum_single (G : SimpleGraph X) (x : X) (i : ℕ) :
    sphereSum (𝕜 := 𝕜) G x i = ∑ y ∈ sphere G x i, Pi.single y (1 : 𝕜) := by
  ext z
  simp only [sphereSum_apply, Finset.sum_apply, Pi.single_apply]
  by_cases hz : G.dist x z = i <;> simp [hz, mem_sphere_iff, Finset.sum_ite_eq]

/-! ## The action of `A` on the sphere sums -/

theorem adj_mulVec_sphereSum_apply (G : SimpleGraph X) (x z : X) (i : ℕ) :
    (adj (𝕜 := 𝕜) G *ᵥ sphereSum G x i) z
      = ((Finset.univ.filter fun y => G.Adj z y ∧ G.dist x y = i).card : 𝕜) := by
  rw [mulVec, dotProduct]
  have h : ∀ y, adj (𝕜 := 𝕜) G z y * sphereSum G x i y
      = (if G.Adj z y ∧ G.dist x y = i then (1 : 𝕜) else 0) := by
    intro y
    rw [adj_apply, sphereSum_apply]
    by_cases h1 : G.Adj z y <;> by_cases h2 : G.dist x y = i <;> simp [h1, h2]
  simp only [h]
  rw [Finset.sum_boole]

theorem filter_card_eq_bnum {G : SimpleGraph X} {x z : X} {i : ℕ} (hi : 1 ≤ i) :
    (Finset.univ.filter fun y => G.Adj z y ∧ G.dist x y = i).card = bnum G x z (i - 1) := by
  rw [bnum, Nat.sub_add_cancel hi]
  congr 1
  ext y
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact ⟨fun h => ⟨h.2, h.1⟩, fun h => ⟨h.2, h.1⟩⟩

theorem filter_card_eq_cnum {G : SimpleGraph X} {x z : X} {i : ℕ} :
    (Finset.univ.filter fun y => G.Adj z y ∧ G.dist x y = i).card = cnum G x z (i + 1) := by
  rw [cnum]
  congr 1
  ext y
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨h1, h2⟩; exact ⟨by omega, h1⟩
  · rintro ⟨h1, h2⟩; exact ⟨h2, by omega⟩

theorem filter_card_eq_anum {G : SimpleGraph X} {x z : X} {i : ℕ} :
    (Finset.univ.filter fun y => G.Adj z y ∧ G.dist x y = i).card = anum G x z i := by
  rw [anum]
  congr 1
  ext y
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact ⟨fun h => ⟨h.2, h.1⟩, fun h => ⟨h.2, h.1⟩⟩

theorem filter_card_eq_zero {G : SimpleGraph X} {x z : X} {i : ℕ}
    (h1 : G.dist x z ≠ i - 1) (h2 : G.dist x z ≠ i) (h3 : G.dist x z ≠ i + 1) :
    (Finset.univ.filter fun y => G.Adj z y ∧ G.dist x y = i).card = 0 := by
  rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro y _ hy
  have hd := hy.1.diff_dist_adj (u := x)
  rcases hd with h | h | h
  · exact h2 (by omega)
  · exact h1 (by omega)
  · exact h3 (by omega)

/-- The common value of a function of the vertex on the `i`-th sphere around `x`. -/
def sphereConst (G : SimpleGraph X) (x : X) (i : ℕ) (f : X → ℕ) : ℕ :=
  if h : ∃ y, G.dist x y = i then f (Classical.choose h) else 0

theorem sphereConst_bnum {G : SimpleGraph X} {x z : X} {j : ℕ} (hdr : IsDistanceRegularAt G x)
    (hz : G.dist x z = j) : sphereConst G x j (fun y => bnum G x y j) = bnum G x z j := by
  have hex : ∃ y, G.dist x y = j := ⟨z, hz⟩
  have hw : G.dist x (Classical.choose hex) = j := Classical.choose_spec hex
  unfold sphereConst
  rw [dif_pos hex]
  obtain ⟨-, -, hb⟩ := hdr j (Classical.choose ⟨z, hz⟩) z
    hw hz
  exact hb j

theorem sphereConst_anum {G : SimpleGraph X} {x z : X} {j : ℕ} (hdr : IsDistanceRegularAt G x)
    (hz : G.dist x z = j) : sphereConst G x j (fun y => anum G x y j) = anum G x z j := by
  have hex : ∃ y, G.dist x y = j := ⟨z, hz⟩
  have hw : G.dist x (Classical.choose hex) = j := Classical.choose_spec hex
  unfold sphereConst
  rw [dif_pos hex]
  obtain ⟨-, ha, -⟩ := hdr j (Classical.choose ⟨z, hz⟩) z
    hw hz
  exact ha j

theorem sphereConst_cnum {G : SimpleGraph X} {x z : X} {j : ℕ} (hdr : IsDistanceRegularAt G x)
    (hz : G.dist x z = j) : sphereConst G x j (fun y => cnum G x y j) = cnum G x z j := by
  have hex : ∃ y, G.dist x y = j := ⟨z, hz⟩
  have hw : G.dist x (Classical.choose hex) = j := Classical.choose_spec hex
  unfold sphereConst
  rw [dif_pos hex]
  obtain ⟨hc, -, -⟩ := hdr j (Classical.choose ⟨z, hz⟩) z
    hw hz
  exact hc j

/-- **Lemma 12.1 (the action of `A` on the sphere sums).**  For a graph that is
distance-regular with respect to `x`,
`A Sᵢ = b_{i-1} S_{i-1} + aᵢ Sᵢ + c_{i+1} S_{i+1}`,
where `Sⱼ = ∑_{∂(x,y)=j} ŷ` and `b, a, c` are the common intersection numbers. -/
theorem adj_mulVec_sphereSum {G : SimpleGraph X} {x : X} (hdr : IsDistanceRegularAt G x)
    {i : ℕ} (hi : 1 ≤ i) :
    adj (𝕜 := 𝕜) G *ᵥ sphereSum G x i
      = (sphereConst G x (i - 1) (fun y => bnum G x y (i - 1)) : 𝕜) • sphereSum G x (i - 1)
      + (sphereConst G x i (fun y => anum G x y i) : 𝕜) • sphereSum G x i
      + (sphereConst G x (i + 1) (fun y => cnum G x y (i + 1)) : 𝕜) • sphereSum G x (i + 1) := by
  ext z
  rw [adj_mulVec_sphereSum_apply]
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, sphereSum_apply]
  by_cases h1 : G.dist x z = i - 1
  · have h2 : ¬ G.dist x z = i := by omega
    have h3 : ¬ G.dist x z = i + 1 := by omega
    rw [if_pos h1, if_neg h2, if_neg h3, filter_card_eq_bnum (x := x) (z := z) hi,
      sphereConst_bnum hdr h1]
    ring
  · by_cases h2 : G.dist x z = i
    · have h3 : ¬ G.dist x z = i + 1 := by omega
      rw [if_neg h1, if_pos h2, if_neg h3, filter_card_eq_anum,
        sphereConst_anum hdr h2]
      ring
    · by_cases h3 : G.dist x z = i + 1
      · rw [if_neg h1, if_neg h2, if_pos h3, filter_card_eq_cnum,
          sphereConst_cnum hdr (j := i + 1) h3]
        ring
      · rw [if_neg h1, if_neg h2, if_neg h3, filter_card_eq_zero h1 h2 h3]
        simp

/-! ## Lemma 1.2 (ii): regular graphs -/

/-- **Lemma 1.2 (ii).**  If `Γ` is connected and regular of valency `k`, the
spectral radius is exactly `k`: the all-ones vector is an eigenvector with
eigenvalue `k`, so `k ≤ θ` by domination, while `θ ≤ k` by Lemma 1.2 (i). -/
theorem largest_eigenvalue_eq_valency {G : SimpleGraph X} (hG : G.Connected)
    (hcard : 2 ≤ Fintype.card X) {k : ℕ} (hreg : IsRegular G k) :
    ∃ θ : ℝ, θ = (k : ℝ) ∧ (∃ v : X → ℝ, v ≠ 0 ∧ adj (𝕜 := ℝ) G *ᵥ v = θ • v) ∧
      (∀ μ : ℝ, (∃ u : X → ℝ, u ≠ 0 ∧ adj (𝕜 := ℝ) G *ᵥ u = μ • u) → μ ≤ θ) := by
  haveI : Nonempty X := Fintype.card_pos_iff.mp (by omega)
  obtain ⟨θ, v, hv0, heav, hdom, hle⟩ := largest_eigenvalue_le_max_valency hG hcard
  -- `sup valency = k`
  have hsup : ((Finset.univ.sup fun x => valency G x : ℕ) : ℝ) = (k : ℝ) := by
    apply le_antisymm
    · exact_mod_cast Finset.sup_le (fun x _ => le_of_eq (hreg x))
    · obtain ⟨x⟩ : Nonempty X := ‹Nonempty X›
      have h1 : (k : ℝ) = (valency G x : ℝ) := by rw [hreg x]
      have h2 : (valency G x : ℝ) ≤ ((Finset.univ.sup fun x => valency G x : ℕ) : ℝ) := by
        exact_mod_cast Finset.le_sup (Finset.mem_univ x)
      rw [h1]; exact h2
  -- the all-ones vector is an eigenvector with eigenvalue `k`
  have hone : adj (𝕜 := ℝ) G *ᵥ (fun _ => (1 : ℝ)) = (k : ℝ) • (fun _ => (1 : ℝ)) := by
    funext x
    have h1 : ∑ y, adj (𝕜 := ℝ) G x y * (1 : ℝ) = (k : ℝ) := by
      rw [← Finset.sum_mul, sum_adj_eq_valency G x, hreg x]
      push_cast
      ring
    show ∑ y, adj (𝕜 := ℝ) G x y * (1 : ℝ) = (k : ℝ) * (1 : ℝ)
    rw [h1]
    ring
  have hone' : (fun _ => (1 : ℝ)) ≠ (0 : X → ℝ) := by
    intro h
    have h1 := congrFun h (Classical.arbitrary X)
    norm_num at h1
  have hkle : (k : ℝ) ≤ θ := hdom (k : ℝ) ⟨fun _ => (1 : ℝ), hone', hone⟩
  refine ⟨θ, le_antisymm (hle.trans hsup.le) hkle, ⟨v, hv0, heav⟩, hdom⟩

/-! ## The sphere sums span the trivial module (Lemma 12.1, (iii) ⇒ (i), (ii)) -/

/-- The span of all the sphere sums around `x`. -/
def sphereSpan (G : SimpleGraph X) (x : X) : Submodule 𝕜 (X → 𝕜) :=
  Submodule.span 𝕜 (Set.range (sphereSum (𝕜 := 𝕜) G x))

theorem sphereSum_mem_sphereSpan (G : SimpleGraph X) (x : X) (i : ℕ) :
    sphereSum (𝕜 := 𝕜) G x i ∈ sphereSpan G x :=
  Submodule.subset_span ⟨i, rfl⟩

theorem span_singleton_sphereSum_le (G : SimpleGraph X) (x : X) (i : ℕ) :
    Submodule.span 𝕜 ({sphereSum (𝕜 := 𝕜) G x i} : Set (X → 𝕜)) ≤ sphereSpan G x :=
  Submodule.span_le.2 (Set.singleton_subset_iff.2 (sphereSum_mem_sphereSpan G x i))

/-- The `0`-th sphere sum is the standard basis vector `x̂`. -/
theorem sphereSum_zero (G : SimpleGraph X) (hG : G.Connected) (x : X) :
    sphereSum (𝕜 := 𝕜) G x 0 = Pi.single x (1 : 𝕜) := by
  funext z
  by_cases h : x = z
  · subst h
    simp [sphereSum_apply]
  · have hd : ¬ G.dist x z = 0 := by
      intro hd
      rcases (G.dist_eq_zero_iff_eq_or_not_reachable).mp hd with h' | h'
      · exact h h'
      · exact absurd (hG x z) h'
    rw [sphereSum_apply, if_neg hd, Pi.single_eq_of_ne (Ne.symm h)]

/-- `Eⱼ*(x)` acts on the sphere sums by the Kronecker delta. -/
theorem subconst_mulVec_sphereSum (G : SimpleGraph X) (x : X) (i j : ℕ) :
    subconst (𝕜 := 𝕜) G x j *ᵥ sphereSum G x i
      = if i = j then sphereSum G x i else 0 := by
  funext z
  rw [mulVec, dotProduct, Finset.sum_eq_single z]
  · simp only [subconst_apply, sphereSum_apply]
    by_cases hij : i = j
    · rw [if_pos hij, ← hij]
      by_cases hd : G.dist x z = i <;> simp [hd]
    · rw [if_neg hij]
      by_cases hd : G.dist x z = i
      · have hd2 : ¬ G.dist x z = j := by
          intro h
          exact hij (by rw [← hd, ← h])
        rw [if_pos hd, if_neg hd2]
        simp
      · rw [if_neg hd]
        simp
  · intro b _ hb
    simp only [subconst_apply, sphereSum_apply]
    rw [if_neg (Ne.symm hb)]
    simp
  · intro h
    exact absurd (Finset.mem_univ z) h

/-- `A S₀ = S₁` for a connected graph. -/
theorem adj_mulVec_sphereSum_zero (G : SimpleGraph X) (hG : G.Connected) (x : X) :
    adj (𝕜 := 𝕜) G *ᵥ sphereSum G x 0 = sphereSum G x 1 := by
  have hfs : G.neighborFinset x = sphere G x 1 := by
    ext y
    simp only [sphere, Finset.mem_filter, Finset.mem_univ, true_and,
      SimpleGraph.mem_neighborFinset]
    rw [SimpleGraph.dist_eq_one_iff_adj]
  rw [sphereSum_zero G hG x, adj_mulVec_single, sphereSum_eq_sum_single, hfs]

/-- `A Sᵢ` lies in the span of the sphere sums: for `i = 0` it is `S₁`, and for
`i ≥ 1` Lemma 12.1 gives the three-term recurrence. -/
theorem adj_mulVec_sphereSum_mem {G : SimpleGraph X} {x : X} (hdr : IsDistanceRegularAt G x)
    (hG : G.Connected) (i : ℕ) :
    adj (𝕜 := 𝕜) G *ᵥ sphereSum G x i ∈ sphereSpan G x := by
  by_cases hi : i = 0
  · rw [hi, adj_mulVec_sphereSum_zero G hG x]
    exact sphereSum_mem_sphereSpan G x 1
  · rw [adj_mulVec_sphereSum (𝕜 := 𝕜) hdr (Nat.one_le_iff_ne_zero.mpr hi)]
    have h1 := sphereSum_mem_sphereSpan (𝕜 := 𝕜) G x (i - 1)
    have h2 := sphereSum_mem_sphereSpan (𝕜 := 𝕜) G x i
    have h3 := sphereSum_mem_sphereSpan (𝕜 := 𝕜) G x (i + 1)
    exact Submodule.add_mem _
      (Submodule.add_mem _ (Submodule.smul_mem _ _ h1) (Submodule.smul_mem _ _ h2))
      (Submodule.smul_mem _ _ h3)

/-- `Eⱼ*(x)` maps the span of the sphere sums into the line spanned by `Sⱼ`. -/
theorem subconst_map_sphereSpan_le (G : SimpleGraph X) (x : X) (j : ℕ) :
    Submodule.map (subconst (𝕜 := 𝕜) G x j).mulVecLin (sphereSpan G x)
      ≤ Submodule.span 𝕜 ({sphereSum (𝕜 := 𝕜) G x j} : Set (X → 𝕜)) := by
  show Submodule.map (subconst (𝕜 := 𝕜) G x j).mulVecLin
      (Submodule.span 𝕜 (Set.range (sphereSum (𝕜 := 𝕜) G x)))
    ≤ Submodule.span 𝕜 ({sphereSum (𝕜 := 𝕜) G x j} : Set (X → 𝕜))
  rw [Submodule.map_span, Submodule.span_le]
  rintro w ⟨v, hv, rfl⟩
  obtain ⟨i, rfl⟩ := hv
  have h1 : subconst (𝕜 := 𝕜) G x j *ᵥ sphereSum G x i
      ∈ Submodule.span 𝕜 ({sphereSum (𝕜 := 𝕜) G x j} : Set (X → 𝕜)) := by
    rw [subconst_mulVec_sphereSum (𝕜 := 𝕜)]
    by_cases h : i = j
    · rw [if_pos h, ← h]
      exact Submodule.subset_span rfl
    · rw [if_neg h]
      exact Submodule.zero_mem _
  exact h1

/-- Auxiliary: `A` maps the span of the sphere sums into itself. -/
theorem adj_stable_sphereSpan {G : SimpleGraph X} {x : X} (hdr : IsDistanceRegularAt G x)
    (hG : G.Connected) : ∀ w ∈ sphereSpan G x, adj (𝕜 := 𝕜) G *ᵥ w ∈ sphereSpan G x := by
  intro w hw
  induction hw using Submodule.span_induction with
  | mem v hv =>
      obtain ⟨i, rfl⟩ := hv
      exact adj_mulVec_sphereSum_mem hdr hG i
  | zero => rw [mulVec_zero]; exact Submodule.zero_mem _
  | add u v _ _ hu hv => rw [mulVec_add]; exact Submodule.add_mem _ hu hv
  | smul c u _ hu => rw [mulVec_smul]; exact Submodule.smul_mem _ c hu

/-- Auxiliary: `Eᵢ*(x)` maps the span of the sphere sums into itself. -/
theorem subconst_stable (G : SimpleGraph X) (x : X) (i : ℕ) :
    ∀ w ∈ sphereSpan G x, subconst (𝕜 := 𝕜) G x i *ᵥ w ∈ sphereSpan G x := by
  intro w hw
  have h1 : (subconst (𝕜 := 𝕜) G x i) *ᵥ w
      ∈ Submodule.map (subconst (𝕜 := 𝕜) G x i).mulVecLin (sphereSpan G x) :=
    Submodule.mem_map.2 ⟨w, hw, rfl⟩
  exact (span_singleton_sphereSum_le G x i) (subconst_map_sphereSpan_le G x i h1)

/-- **The span of the sphere sums is a `T(x)`-module.** -/
theorem sphereSpan_isStable {G : SimpleGraph X} {x : X} (hdr : IsDistanceRegularAt G x)
    (hG : G.Connected) :
    IsStable (subconstituentAlgebra (𝕜 := 𝕜) G x).toSubalgebra (sphereSpan G x) := by
  intro a ha
  have hEq : (subconstituentAlgebra (𝕜 := 𝕜) G x).toSubalgebra
      = Algebra.adjoin 𝕜 (({adj (𝕜 := 𝕜) G} ∪ Set.range (subconst (𝕜 := 𝕜) G x)) ∪
          star ({adj (𝕜 := 𝕜) G} ∪ Set.range (subconst (𝕜 := 𝕜) G x))) :=
    StarAlgebra.adjoin_toSubalgebra _ _
  rw [hEq] at ha
  induction ha using Algebra.adjoin_induction with
  | mem m hm =>
      rcases hm with hm | hm
      · rcases hm with hm | hm
        · rw [Set.mem_singleton_iff] at hm
          subst hm
          exact adj_stable_sphereSpan hdr hG
        · obtain ⟨i, rfl⟩ := hm
          exact subconst_stable G x i
      · have hm' : star m ∈ ({adj (𝕜 := 𝕜) G} ∪ Set.range (subconst (𝕜 := 𝕜) G x)) :=
          Set.mem_star.mp hm
        rcases hm' with hm' | hm'
        · rw [Set.mem_singleton_iff] at hm'
          intro w hw
          have hm'' : m = adj (𝕜 := 𝕜) G := by
            rw [← star_star m, hm']
            exact star_adj (𝕜 := 𝕜) G
          rw [hm'']
          exact adj_stable_sphereSpan hdr hG w hw
        · obtain ⟨i, hi⟩ := hm'
          intro w hw
          have hm'' : m = subconst (𝕜 := 𝕜) G x i := by
            rw [← star_star m, ← hi]
            exact star_subconst G x i
          rw [hm'']
          exact subconst_stable G x i w hw
  | algebraMap r =>
      intro w hw
      have h1 : (algebraMap 𝕜 (Matrix X X 𝕜)) r *ᵥ w = r • w := by
        funext i
        rw [Matrix.algebraMap_eq_diagonal, Matrix.mulVec_diagonal]
        rfl
      rw [h1]
      exact Submodule.smul_mem _ r hw
  | add m n _ _ ihm ihn =>
      intro w hw
      rw [Matrix.add_mulVec]
      exact Submodule.add_mem _ (ihm w hw) (ihn w hw)
  | mul m n _ _ ihm ihn =>
      intro w hw
      rw [← Matrix.mulVec_mulVec]
      exact ihm _ (ihn w hw)

/-- **The trivial module is contained in the span of the sphere sums** (Lemma 12.1,
(iii) ⇒ (ii), spanning half): `x̂ = S₀` lies in the span and the span is
`T(x)`-stable. -/
theorem trivialModule_le_sphereSpan {G : SimpleGraph X} {x : X}
    (hdr : IsDistanceRegularAt G x) (hG : G.Connected) :
    trivialModule (𝕜 := 𝕜) G x ≤ sphereSpan G x := by
  rw [trivialModule, Submodule.span_le]
  rintro w ⟨a, ha, rfl⟩
  have hx : sphereSum (𝕜 := 𝕜) G x 0 ∈ sphereSpan G x :=
    sphereSum_mem_sphereSpan G x 0
  rw [← sphereSum_zero G hG x]
  exact sphereSpan_isStable hdr hG a ha _ hx

/-- **Lemma 12.1, (iii) ⇒ (i).**  For a graph distance-regular with respect to
`x`, the trivial `T(x)`-module is thin. -/
theorem trivialModule_thin {G : SimpleGraph X} {x : X} (hdr : IsDistanceRegularAt G x)
    (hG : G.Connected) :
    ThinModule (𝕜 := 𝕜) G x (trivialModule (𝕜 := 𝕜) G x) := by
  intro i
  have hle : subconstImage (𝕜 := 𝕜) G x i (trivialModule (𝕜 := 𝕜) G x)
      ≤ Submodule.span 𝕜 ({sphereSum (𝕜 := 𝕜) G x i} : Set (X → 𝕜)) := by
    rw [subconstImage, matImage]
    calc Submodule.map (subconst (𝕜 := 𝕜) G x i).mulVecLin (trivialModule (𝕜 := 𝕜) G x)
        ≤ Submodule.map (subconst (𝕜 := 𝕜) G x i).mulVecLin (sphereSpan G x) :=
          Submodule.map_mono (trivialModule_le_sphereSpan hdr hG)
      _ ≤ Submodule.span 𝕜 ({sphereSum (𝕜 := 𝕜) G x i} : Set (X → 𝕜)) :=
          subconst_map_sphereSpan_le G x i
  have h1 : Module.finrank 𝕜
      (Submodule.span 𝕜 ({sphereSum (𝕜 := 𝕜) G x i} : Set (X → 𝕜))) ≤ 1 := by
    by_cases hz : sphereSum (𝕜 := 𝕜) G x i = 0
    · have h0 : Submodule.span 𝕜 ({0} : Set (X → 𝕜)) = ⊥ := by simp
      rw [hz, h0]
      simp
    · exact le_of_eq (finrank_span_singleton hz)
  exact (Submodule.finrank_mono hle).trans h1

/-- **Lemma 12.1 (i), the (iii) ⇒ (i) direction, for every vertex.** -/
theorem trivialModule_thin_of_distanceRegular {G : SimpleGraph X} (hG : G.Connected)
    (hdr : IsDistanceRegular G) :
    ∀ x, ThinModule (𝕜 := 𝕜) G x (trivialModule (𝕜 := 𝕜) G x) :=
  fun x => trivialModule_thin (hdr x) hG

/-- The sphere sums with nonempty spheres are linearly independent (Lemma 12.1
(ii), independence half). -/
theorem linearIndependent_sphereSum (G : SimpleGraph X) (x : X) (s : Finset ℕ)
    (hne : ∀ i ∈ s, (sphere G x i).Nonempty) :
    LinearIndependent 𝕜 (fun i : (s : Set ℕ) => sphereSum (𝕜 := 𝕜) G x (i : ℕ)) := by
  rw [Fintype.linearIndependent_iff]
  intro g hg i
  obtain ⟨y, hy⟩ := hne (i : ℕ) (Finset.mem_coe.mp i.2)
  have hdy : G.dist x y = (i : ℕ) := (mem_sphere_iff G x y (i : ℕ)).mp hy
  have h1 : (∑ j : (s : Set ℕ), g j • sphereSum (𝕜 := 𝕜) G x (j : ℕ)) y = 0 := by
    rw [hg]
    rfl
  rw [Finset.sum_apply] at h1
  rw [Finset.sum_eq_single i] at h1
  · rw [Pi.smul_apply, smul_eq_mul, sphereSum_apply, if_pos hdy] at h1
    simpa using h1
  · intro j _ hj
    rw [Pi.smul_apply, smul_eq_mul, sphereSum_apply, if_neg]
    · simp
    · intro h
      rw [hdy] at h
      exact hj (Subtype.ext h.symm)
  · intro h
    exact absurd (Finset.mem_univ i) h

/-! ## Lemma 12.1, (i) ⇒ (ii): the Perron vector is constant on spheres

The argument has three stages.  First the Perron vector `δ` belongs to the
trivial `T(x)`-module for every `x` (`perron_mem_trivialModule`): otherwise the
dual functional `v ↦ v ⬝ᵥ δ` exhibits `θ₀` as an eigenvalue of the restriction
of `A` to the Krylov space `span{Aᵏx̂}`, producing a second eigenvector for `θ₀`
inside the Krylov space, and the simplicity part of Perron–Frobenius forces it
to be proportional to `δ`.  Second, thinness of the trivial module at a vertex
`w` makes `E₁*(w)δ` a multiple of `Aŵ`, so `δ` is constant on the neighbourhood
of every vertex, hence (`perron_const_of_even_walk`) constant along walks of
even length, hence (`perron_const_on_sphere`) constant on spheres.  Third, the
sphere sums are then multiples of `Eᵢ*δ` and lie in the trivial module, while
the trivial module is spanned by the `Eᵢ*δ` (`Eᵢ*δ ≠ 0` on nonempty spheres by
strict positivity, and thinness makes each `Eᵢ*W` a line). -/

/-- The Perron data of a connected graph with at least two vertices. -/
theorem exists_perron_data {G : SimpleGraph X} (hG : G.Connected)
    (hcard : 2 ≤ Fintype.card X) :
    ∃ θ : ℝ, ∃ δ : X → ℝ,
      (0 < θ) ∧ (∀ y, 0 < δ y) ∧ adj (𝕜 := ℝ) G *ᵥ δ = θ • δ ∧
      (∀ u : X → ℝ, adj (𝕜 := ℝ) G *ᵥ u = θ • u → ∃ c : ℝ, u = c • δ) := by
  haveI : Nonempty X := Fintype.card_pos_iff.mp (by omega)
  have hsym : (adj (𝕜 := ℝ) G)ᵀ = adj (𝕜 := ℝ) G := adj_transpose G
  have hnn : ∀ i j, 0 ≤ adj (𝕜 := ℝ) G i j := by
    intro i j
    by_cases h : G.Adj i j <;> simp [adj_apply, h]
  obtain ⟨θ, δ, hθ, hδpos, heig, -, huniq⟩ :=
    perron_frobenius (adj (𝕜 := ℝ) G) hsym (isIrreducible_adj hG) hnn (adj_ne_zero hG hcard)
  exact ⟨θ, δ, hθ, hδpos, heig, huniq⟩

/-- The bilinear pairing is invariant under the symmetric adjacency matrix. -/
theorem dotProduct_adj_symm {G : SimpleGraph X} (u w : X → ℝ) :
    (adj (𝕜 := ℝ) G *ᵥ u) ⬝ᵥ w = u ⬝ᵥ (adj (𝕜 := ℝ) G *ᵥ w) := by
  rw [dotProduct_comm, dotProduct_mulVec, ← Matrix.mulVec_transpose, adj_transpose,
    dotProduct_comm]

/-- The Krylov space of `x`: the span of `{Aᵏ x̂ | k ∈ ℕ}`. -/
def krylov (G : SimpleGraph X) (x : X) : Submodule ℝ (X → ℝ) :=
  Submodule.span ℝ (Set.range fun k : ℕ => (adj (𝕜 := ℝ) G) ^ k *ᵥ (Pi.single x (1 : ℝ)))

theorem single_mem_krylov (G : SimpleGraph X) (x : X) :
    (Pi.single x (1 : ℝ)) ∈ krylov G x := by
  refine Submodule.subset_span ⟨0, ?_⟩
  show (adj (𝕜 := ℝ) G) ^ 0 *ᵥ (Pi.single x (1 : ℝ)) = Pi.single x (1 : ℝ)
  rw [pow_zero, one_mulVec]

theorem adj_mulVec_mem_krylov {G : SimpleGraph X} {x : X} :
    ∀ v ∈ krylov G x, adj (𝕜 := ℝ) G *ᵥ v ∈ krylov G x := by
  intro v hv
  induction hv using Submodule.span_induction with
  | mem w hw =>
      obtain ⟨k, rfl⟩ := hw
      show adj (𝕜 := ℝ) G *ᵥ ((adj (𝕜 := ℝ) G) ^ k *ᵥ Pi.single x (1 : ℝ)) ∈ krylov G x
      rw [Matrix.mulVec_mulVec]
      refine Submodule.subset_span ⟨k + 1, ?_⟩
      show (adj (𝕜 := ℝ) G) ^ (k + 1) *ᵥ Pi.single x (1 : ℝ)
        = ((adj (𝕜 := ℝ) G) * (adj (𝕜 := ℝ) G) ^ k) *ᵥ Pi.single x (1 : ℝ)
      rw [pow_succ']
  | zero => rw [mulVec_zero]; exact Submodule.zero_mem _
  | add u w _ _ hu hw => rw [mulVec_add]; exact Submodule.add_mem _ hu hw
  | smul c u _ hu => rw [mulVec_smul]; exact Submodule.smul_mem _ c hu

theorem krylov_le_trivialModule (G : SimpleGraph X) (x : X) :
    krylov G x ≤ trivialModule (𝕜 := ℝ) G x := by
  rw [krylov, Submodule.span_le]
  rintro w ⟨k, rfl⟩
  refine mulVec_single_mem_trivialModule G x ?_
  induction k with
  | zero => simpa [pow_zero] using Subalgebra.one_mem _
  | succ k ih =>
      have h1 : adj (𝕜 := ℝ) G ∈ (subconstituentAlgebra (𝕜 := ℝ) G x).toSubalgebra :=
        adj_mem_subconstituentAlgebra G x
      rw [pow_succ]
      exact (subconstituentAlgebra (𝕜 := ℝ) G x).toSubalgebra.mul_mem ih h1

/-- **The Perron vector lies in every Krylov space.**  If no eigenvector for
`θ₀` lay in `span{Aᵏx̂}`, the map `v ↦ Av - θ₀v` would be injective on it, hence
surjective (finite dimensionality), so `x̂ = Av - θ₀v` for some `v` in the space;
pairing with `δ` then gives `δ x = 0`, contradicting the strict positivity of
`δ`. -/
theorem exists_eigenvector_mem_krylov {G : SimpleGraph X} {x : X} {θ : ℝ} {δ : X → ℝ}
    (hδpos : ∀ y, 0 < δ y) (hδeig : adj (𝕜 := ℝ) G *ᵥ δ = θ • δ)
    (hδuniq : ∀ u : X → ℝ, adj (𝕜 := ℝ) G *ᵥ u = θ • u → ∃ c : ℝ, u = c • δ) :
    ∃ v ∈ krylov G x, v ≠ 0 ∧ adj (𝕜 := ℝ) G *ᵥ v = θ • v := by
  by_contra hcon
  have hzero : ∀ v ∈ krylov G x, adj (𝕜 := ℝ) G *ᵥ v = θ • v → v = 0 := by
    intro v hv heig
    by_contra hv0
    exact hcon ⟨v, hv, hv0, heig⟩
  -- the endomorphism `v ↦ Av - θv` of the Krylov space
  set f : (X → ℝ) →ₗ[ℝ] (X → ℝ) :=
    (adj (𝕜 := ℝ) G).mulVecLin - (θ • LinearMap.id) with hf
  have hfapply : ∀ v : X → ℝ, f v = adj (𝕜 := ℝ) G *ᵥ v - θ • v := by
    intro v
    rw [hf]
    simp only [LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.id_apply,
      Matrix.mulVecLin_apply]
  set g : (krylov G x) →ₗ[ℝ] (krylov G x) :=
    LinearMap.codRestrict _ (f.comp (krylov G x).subtype)
      (fun v => Submodule.sub_mem _
        (adj_mulVec_mem_krylov (v : X → ℝ) v.2)
        (Submodule.smul_mem _ θ v.2)) with hg
  -- `g` is injective
  have hinj : Function.Injective ⇑g := by
    intro a b hab
    have h1 : f ((a - b : X → ℝ)) = 0 := by
      have h2 : g (a - b) = 0 := by
        rw [map_sub, hab, sub_self]
      have h3 : ((g (a - b) : krylov G x) : X → ℝ) = 0 := by
        rw [h2]
        rfl
      rw [hg, LinearMap.codRestrict_apply, LinearMap.comp_apply] at h3
      exact h3
    have h3 : adj (𝕜 := ℝ) G *ᵥ ((a - b : X → ℝ)) = θ • ((a - b : X → ℝ)) := by
      rw [hfapply] at h1
      exact eq_of_sub_eq_zero h1
    have h4 : (a - b : X → ℝ) = 0 := hzero _ (Submodule.sub_mem _ a.2 b.2) h3
    exact Subtype.ext (sub_eq_zero.mp h4)
  -- hence surjective, so `x̂` is in the image
  have hsurj : Function.Surjective ⇑g := LinearMap.injective_iff_surjective.mp hinj
  obtain ⟨v, hv⟩ := hsurj ⟨Pi.single x (1 : ℝ), single_mem_krylov G x⟩
  have h1 : f ((v : X → ℝ)) = Pi.single x (1 : ℝ) := by
    have h2 : ((g v : krylov G x) : X → ℝ) = Pi.single x (1 : ℝ) := by
      rw [hv]
    rw [hg, LinearMap.codRestrict_apply, LinearMap.comp_apply] at h2
    exact h2
  rw [hfapply] at h1
  -- pair with `δ`
  have h3 : (Pi.single x (1 : ℝ)) ⬝ᵥ δ
      = (adj (𝕜 := ℝ) G *ᵥ (v : X → ℝ)) ⬝ᵥ δ - (θ • (v : X → ℝ)) ⬝ᵥ δ := by
    rw [← h1, sub_dotProduct]
  rw [dotProduct_adj_symm, hδeig, dotProduct_smul, smul_dotProduct, sub_self,
    single_dotProduct] at h3
  exact (hδpos x).ne' h3

/-- **The Perron vector belongs to the trivial `T(x)`-module for every `x`.** -/
theorem perron_mem_trivialModule {G : SimpleGraph X} {x : X} {θ : ℝ} {δ : X → ℝ}
    (hδpos : ∀ y, 0 < δ y) (hδeig : adj (𝕜 := ℝ) G *ᵥ δ = θ • δ)
    (hδuniq : ∀ u : X → ℝ, adj (𝕜 := ℝ) G *ᵥ u = θ • u → ∃ c : ℝ, u = c • δ) :
    δ ∈ trivialModule (𝕜 := ℝ) G x := by
  obtain ⟨v, hvK, hv0, heig⟩ := exists_eigenvector_mem_krylov hδpos hδeig hδuniq
  obtain ⟨c, hc⟩ := hδuniq v heig
  rcases eq_or_ne c 0 with rfl | hc0
  · have hv0' : v = 0 := by rw [hc, zero_smul]
    exact absurd hv0' hv0
  · have hδ : δ = c⁻¹ • v := by
      rw [hc, smul_smul, inv_mul_cancel₀ hc0, one_smul]
    rw [hδ]
    exact krylov_le_trivialModule G x (Submodule.smul_mem _ c⁻¹ hvK)

/-- A subspace of dimension at most one is spanned by any of its nonzero vectors. -/
theorem exists_smul_of_finrank_le_one {p : Submodule ℝ (X → ℝ)}
    (hfr : Module.finrank ℝ ↥p ≤ 1) {u v : X → ℝ}
    (hu : u ∈ p) (hv : v ∈ p) (hu0 : u ≠ 0) : ∃ c : ℝ, v = c • u := by
  have hspan : Submodule.span ℝ ({u} : Set (X → ℝ)) = p := by
    refine Submodule.eq_of_le_of_finrank_le ?_ ?_
    · rw [Submodule.span_le]
      simpa using hu
    · rw [finrank_span_singleton (K := ℝ) (V := X → ℝ) hu0]
      exact hfr
  rw [← hspan] at hv
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hv
  exact ⟨c, hc.symm⟩

/-- `Eᵢ*(x)` is the diagonal matrix that keeps the `i`-th subconstituent. -/
theorem subconst_mulVec_apply (G : SimpleGraph X) (x : X) (i : ℕ) (u : X → ℝ) (z : X) :
    (subconst (𝕜 := ℝ) G x i *ᵥ u) z = (if G.dist x z = i then 1 else 0) * u z := by
  rw [mulVec, dotProduct, Finset.sum_eq_single z]
  · rw [subconst_apply, if_pos rfl]
  · intro b _ hb
    rw [subconst_apply, if_neg (Ne.symm hb), zero_mul]
  · intro h
    exact absurd (Finset.mem_univ z) h

/-- A connected graph with at least two vertices has no isolated vertex. -/
theorem exists_adj {G : SimpleGraph X} (hG : G.Connected) (hcard : 2 ≤ Fintype.card X)
    (w : X) : ∃ y, G.Adj w y := by
  by_contra h
  push_neg at h
  have hclosed : ∀ z ∈ ({w} : Set X), ∀ v : X, G.Adj z v → v ∈ ({w} : Set X) := by
    intro z hz v hzv
    rw [Set.mem_singleton_iff] at hz ⊢
    subst hz
    exact absurd hzv (h v)
  have hall : ∀ y : X, y = w := by
    intro y
    have hmem := mem_of_reachable (G := G) (S := ({w} : Set X))
      (x := w) (by rw [Set.mem_singleton_iff]) hclosed (hG.preconnected w y)
    simpa using hmem
  haveI : Subsingleton X := ⟨fun a b => by rw [hall a, hall b]⟩
  have hle : Fintype.card X ≤ 1 := Fintype.card_le_one_iff_subsingleton.mpr inferInstance
  omega

/-- **The Perron vector is constant on the neighbourhood of every vertex.**  Thinness
of the trivial module at `w` makes `E₁*(w)δ` a multiple of `Aŵ`, and `Aŵ` takes the
value `1` at every neighbour of `w`. -/
theorem perron_const_on_neighbors {G : SimpleGraph X} (hG : G.Connected)
    (hcard : 2 ≤ Fintype.card X)
    (hthin : ∀ w : X, ThinModule (𝕜 := ℝ) G w (trivialModule (𝕜 := ℝ) G w))
    {θ : ℝ} {δ : X → ℝ} (hδpos : ∀ y, 0 < δ y)
    (hδeig : adj (𝕜 := ℝ) G *ᵥ δ = θ • δ)
    (hδuniq : ∀ u : X → ℝ, adj (𝕜 := ℝ) G *ᵥ u = θ • u → ∃ c : ℝ, u = c • δ)
    {w y z : X} (hy : G.Adj w y) (hz : G.Adj w z) : δ y = δ z := by
  set ŵ : X → ℝ := Pi.single w 1 with hŵdef
  have hδmem : δ ∈ trivialModule (𝕜 := ℝ) G w :=
    perron_mem_trivialModule hδpos hδeig hδuniq
  have hŵmem : ŵ ∈ trivialModule (𝕜 := ℝ) G w := by
    have h1 := mulVec_single_mem_trivialModule (𝕜 := ℝ) G w
      (Subalgebra.one_mem (subconstituentAlgebra (𝕜 := ℝ) G w).toSubalgebra)
    rw [one_mulVec] at h1
    rw [hŵdef]
    exact h1
  set W : Submodule ℝ (X → ℝ) :=
    subconstImage (𝕜 := ℝ) G w 1 (trivialModule (𝕜 := ℝ) G w) with hW
  -- `Aŵ` takes the value `1` at every neighbour of `w` and `0` elsewhere
  have hAval : ∀ v : X, (adj (𝕜 := ℝ) G *ᵥ ŵ) v = if G.Adj w v then 1 else 0 := by
    intro v
    rw [mulVec, dotProduct, Finset.sum_eq_single w]
    · rw [hŵdef, Pi.single_eq_same, adj_apply, mul_one]
      by_cases h : G.Adj w v
      · rw [if_pos h, if_pos h.symm]
      · rw [if_neg h, if_neg (fun hh => h hh.symm)]
    · intro b _ hb
      rw [hŵdef, Pi.single_eq_of_ne hb, mul_zero]
    · intro h
      exact absurd (Finset.mem_univ w) h
  -- `E₁*(w)` fixes `Aŵ`
  have hEq : subconst (𝕜 := ℝ) G w 1 *ᵥ (adj (𝕜 := ℝ) G *ᵥ ŵ)
      = adj (𝕜 := ℝ) G *ᵥ ŵ := by
    funext v
    rw [subconst_mulVec_apply]
    by_cases hv : G.dist w v = 1
    · rw [if_pos hv, one_mul]
    · rw [if_neg hv, zero_mul, hAval v, if_neg]
      intro hcon
      exact hv (SimpleGraph.dist_eq_one_iff_adj.mpr hcon)
  have hAmem : adj (𝕜 := ℝ) G *ᵥ ŵ ∈ W :=
    mem_matImage.2 ⟨adj (𝕜 := ℝ) G *ᵥ ŵ,
      isStable_trivialModule G w (adj (𝕜 := ℝ) G) (adj_mem_subconstituentAlgebra G w) ŵ hŵmem,
      hEq⟩
  have hPmem : subconst (𝕜 := ℝ) G w 1 *ᵥ δ ∈ W :=
    mem_matImage.2 ⟨δ, hδmem, rfl⟩
  have hfr : Module.finrank ℝ ↥W ≤ 1 := hthin w 1
  have hAne : adj (𝕜 := ℝ) G *ᵥ ŵ ≠ 0 := by
    obtain ⟨v, hv⟩ := exists_adj hG hcard w
    intro h0
    have h1 := congrFun h0 v
    rw [hAval v, if_pos hv, Pi.zero_apply] at h1
    exact one_ne_zero h1
  obtain ⟨c, hc⟩ := exists_smul_of_finrank_le_one hfr hAmem hPmem hAne
  have hsub : ∀ v : X, G.Adj w v → (subconst (𝕜 := ℝ) G w 1 *ᵥ δ) v = δ v := by
    intro v hv
    rw [subconst_mulVec_apply, if_pos (SimpleGraph.dist_eq_one_iff_adj.mpr hv), one_mul]
  have hy' : δ y = c := by
    have h1 := congrFun hc y
    rw [hsub y hy, Pi.smul_apply, hAval y, if_pos hy, smul_eq_mul, mul_one] at h1
    exact h1
  have hz' : δ z = c := by
    have h1 := congrFun hc z
    rw [hsub z hz, Pi.smul_apply, hAval z, if_pos hz, smul_eq_mul, mul_one] at h1
    exact h1
  rw [hy', hz']

/-! ## Section B of Lemma 12.1, (i) ⇒ (ii): `δ` is constant on spheres

Assume the Perron vector `δ` is constant on the neighbourhood of every vertex
(the conclusion of Section A).  Then `δ` is constant along every walk of even
length, hence on every sphere around every vertex, and consequently `Eᵢ*(x)δ`
is a scalar multiple of the `i`-th sphere sum `Sᵢ(x)`. -/

/-- **`δ` is constant along walks of even length.**  Strip two adjacent edges at
a time; the hypothesis identifies the values at the two endpoints reached after
each pair of steps. -/
theorem perron_const_of_even_walk {G : SimpleGraph X} {δ : X → ℝ}
    (hconst : ∀ w y z : X, G.Adj w y → G.Adj w z → δ y = δ z) {y z : X}
    (p : G.Walk y z) (k : ℕ) (hk : p.length = 2 * k) : δ y = δ z := by
  have key : ∀ (k : ℕ) {a b : X} (p : G.Walk a b), p.length = 2 * k → δ a = δ b := by
    intro k
    induction k with
    | zero =>
        intro a b p hp
        cases p with
        | nil => rfl
        | cons h q =>
            simp only [SimpleGraph.Walk.length_cons] at hp
            exfalso; omega
    | succ k ih =>
        intro a b p hp
        cases p with
        | nil =>
            simp only [SimpleGraph.Walk.length_nil] at hp
            exfalso; omega
        | cons h1 q =>
            cases q with
            | nil =>
                simp only [SimpleGraph.Walk.length_cons, SimpleGraph.Walk.length_nil] at hp
                exfalso; omega
            | cons h2 r =>
                have hp' : r.length = 2 * k := by
                  simp only [SimpleGraph.Walk.length_cons] at hp
                  omega
                exact (hconst _ _ _ h1.symm h2).trans (ih r hp')
  exact key k p hk

/-- **`δ` is constant on every sphere.**  In a connected graph two vertices at
the same distance from `x` are joined by a walk of even length (through `x`). -/
theorem perron_const_on_sphere {G : SimpleGraph X} (hG : G.Connected) {δ : X → ℝ}
    (hconst : ∀ w y z : X, G.Adj w y → G.Adj w z → δ y = δ z) (x y z : X)
    (hyz : G.dist x y = G.dist x z) : δ y = δ z := by
  obtain ⟨p1, hp1⟩ := hG.exists_walk_length_eq_dist y x
  obtain ⟨p2, hp2⟩ := hG.exists_walk_length_eq_dist x z
  have hlen : (p1.append p2).length = 2 * (G.dist x y) := by
    rw [SimpleGraph.Walk.length_append, hp1, hp2, SimpleGraph.dist_comm, hyz]
    ring
  exact perron_const_of_even_walk hconst (p1.append p2) (G.dist x y) hlen

/-- **`Eᵢ*(x) δ` is a multiple of the sphere sum `Sᵢ(x)`.**  Both vectors vanish
off the `i`-th sphere, and on it `δ` is the constant `δ y₀`. -/
theorem subconst_mulVec_perron {G : SimpleGraph X} (hG : G.Connected) {δ : X → ℝ}
    (hconst : ∀ w y z : X, G.Adj w y → G.Adj w z → δ y = δ z) (x : X) (i : ℕ) :
    ∃ c : ℝ, subconst (𝕜 := ℝ) G x i *ᵥ δ = c • sphereSum (𝕜 := ℝ) G x i := by
  have key : ∀ z : X,
      (subconst (𝕜 := ℝ) G x i *ᵥ δ) z = (if G.dist x z = i then 1 else 0) * δ z := by
    intro z
    rw [mulVec, dotProduct, Finset.sum_eq_single z]
    · simp only [subconst_apply, if_true]
    · intro b _ hb
      rw [subconst_apply, if_neg (Ne.symm hb), zero_mul]
    · intro h
      exact absurd (Finset.mem_univ z) h
  by_cases hne : (sphere G x i).Nonempty
  · obtain ⟨y₀, hy₀⟩ := hne
    rw [mem_sphere_iff] at hy₀
    refine ⟨δ y₀, ?_⟩
    funext z
    rw [key z, Pi.smul_apply, smul_eq_mul, sphereSum_apply]
    by_cases hz : G.dist x z = i
    · rw [if_pos hz, one_mul, mul_one]
      exact perron_const_on_sphere hG hconst x z y₀ (by rw [hz, hy₀])
    · rw [if_neg hz, mul_zero, zero_mul]
  · refine ⟨0, ?_⟩
    funext z
    rw [key z, Pi.smul_apply, smul_eq_mul, sphereSum_apply]
    have hz : ¬ G.dist x z = i := by
      intro h
      exact hne ⟨z, by simpa using h⟩
    rw [if_neg hz, mul_zero, zero_mul]

/-! ## Lemma 12.1, (i) ⇒ (ii), stage 2: the sphere sums lie in the trivial module

If `Eᵢ*(x)δ` is a multiple of the `i`-th sphere sum `Sᵢ(x)` for the Perron vector
`δ` (`subconst_mulVec_perron`, Section B), then `Sᵢ(x)` is a multiple of
`Eᵢ*(x)δ`: on a nonempty sphere the multiplier is `δ y₀ ≠ 0`.  Since `δ` lies in
the trivial module `T(x)x̂` and that module is `T(x)`-stable, `Eᵢ*(x)δ` lies in
it too, and hence so does `Sᵢ(x)`. -/

/-- **Lemma 12.1, (i) ⇒ (ii), Section C** (single sphere).  If `Eᵢ*(x)δ` is a
scalar multiple of the sphere sum `Sᵢ(x)`, then `Sᵢ(x)` belongs to the trivial
`T(x)`-module `T(x)x̂`. -/
theorem sphereSum_mem_trivialModule_perron {G : SimpleGraph X} {x : X} {θ : ℝ}
    {δ : X → ℝ} (hδpos : ∀ y, 0 < δ y)
    (hδeig : adj (𝕜 := ℝ) G *ᵥ δ = θ • δ)
    (hδuniq : ∀ u : X → ℝ, adj (𝕜 := ℝ) G *ᵥ u = θ • u → ∃ c : ℝ, u = c • δ)
    {i : ℕ} (hsub : ∃ c : ℝ, subconst (𝕜 := ℝ) G x i *ᵥ δ = c • sphereSum (𝕜 := ℝ) G x i) :
    sphereSum (𝕜 := ℝ) G x i ∈ trivialModule (𝕜 := ℝ) G x := by
  have hmul : ∀ z : X, (subconst (𝕜 := ℝ) G x i *ᵥ δ) z
      = (if G.dist x z = i then 1 else 0) * δ z := by
    intro z
    rw [show subconst (𝕜 := ℝ) G x i
        = Matrix.diagonal (fun y => if G.dist x y = i then 1 else 0) from rfl,
      Matrix.mulVec_diagonal]
  have hmem : subconst (𝕜 := ℝ) G x i *ᵥ δ ∈ trivialModule (𝕜 := ℝ) G x :=
    isStable_trivialModule G x (subconst (𝕜 := ℝ) G x i)
      (subconst_mem_subconstituentAlgebra G x i) δ
      (perron_mem_trivialModule hδpos hδeig hδuniq)
  by_cases hne : (sphere G x i).Nonempty
  · obtain ⟨y₀, hy₀⟩ := hne
    have hdy : G.dist x y₀ = i := (mem_sphere_iff G x y₀ i).mp hy₀
    obtain ⟨c, hc⟩ := hsub
    have hkey : (subconst (𝕜 := ℝ) G x i *ᵥ δ) y₀ = δ y₀ := by
      rw [hmul y₀, if_pos hdy, one_mul]
    have hcR : (c • sphereSum (𝕜 := ℝ) G x i) y₀ = c := by
      simp [sphereSum_apply, hdy]
    have hcv : c = δ y₀ := by
      have h := congrFun hc y₀
      rw [hkey, hcR] at h
      exact h.symm
    have hc0 : c ≠ 0 := by
      rw [hcv]
      exact (hδpos y₀).ne'
    have hEq : sphereSum (𝕜 := ℝ) G x i = c⁻¹ • (subconst (𝕜 := ℝ) G x i *ᵥ δ) := by
      rw [hc, smul_smul, inv_mul_cancel₀ hc0, one_smul]
    rw [hEq]
    exact Submodule.smul_mem _ c⁻¹ hmem
  · have hzero : sphereSum (𝕜 := ℝ) G x i = 0 := by
      funext z
      have hz : ¬ G.dist x z = i := fun h => hne ⟨z, (mem_sphere_iff G x z i).mpr h⟩
      simp [sphereSum_apply, hz]
    rw [hzero]
    exact Submodule.zero_mem _

/-- **Lemma 12.1, (i) ⇒ (ii), Section C** (all spheres).  If every `Eᵢ*(x)δ` is
a multiple of the corresponding sphere sum, then the sphere span `span{Sᵢ(x)}` is
contained in the trivial `T(x)`-module. -/
theorem sphereSpan_le_trivialModule_perron {G : SimpleGraph X} {x : X} {θ : ℝ} {δ : X → ℝ}
    (hδpos : ∀ y, 0 < δ y)
    (hδeig : adj (𝕜 := ℝ) G *ᵥ δ = θ • δ)
    (hδuniq : ∀ u : X → ℝ, adj (𝕜 := ℝ) G *ᵥ u = θ • u → ∃ c : ℝ, u = c • δ)
    (hsub : ∀ i : ℕ, ∃ c : ℝ, subconst (𝕜 := ℝ) G x i *ᵥ δ = c • sphereSum (𝕜 := ℝ) G x i) :
    sphereSpan (𝕜 := ℝ) G x ≤ trivialModule (𝕜 := ℝ) G x := by
  rw [sphereSpan, Submodule.span_le]
  rintro v ⟨i, rfl⟩
  exact sphereSum_mem_trivialModule_perron hδpos hδeig hδuniq (hsub i)

/-! ## Lemma 12.1, (i) ⇒ (ii): the trivial module is spanned by the sphere sums

The last spanning step of Section D: once `δ` is constant on spheres, `Eᵢ*(x)δ`
is a multiple of the sphere sum `Sᵢ`, thinness makes `Eᵢ*(x)T(x)x̂` the line
through `Eᵢ*(x)δ`, and the subconstituent projections decompose every
`w ∈ T(x)x̂` into its pieces `Eᵢ*(x)w`.  (Written to depend on no other
section: the two facts about `Eᵢ*` used here are proved below.) -/

/-- The subconstituent projections give a direct sum decomposition of a vector:
`w = ∑ᵢ Eᵢ*(x) w` as soon as `D` bounds the eccentricity of `x`. -/
theorem mulVec_sum_subconst (G : SimpleGraph X) (x : X) (w : X → ℝ) (D : ℕ)
    (hD : ∀ y, G.dist x y ≤ D) :
    w = ∑ i ∈ Finset.range (D + 1), subconst (𝕜 := ℝ) G x i *ᵥ w := by
  funext z
  rw [Finset.sum_apply]
  have hterm : ∀ i : ℕ,
      (subconst (𝕜 := ℝ) G x i *ᵥ w) z = if G.dist x z = i then w z else 0 := by
    intro i
    rw [subconst_mulVec_apply]
    by_cases h : G.dist x z = i
    · rw [if_pos h, if_pos h, one_mul]
    · rw [if_neg h, if_neg h, zero_mul]
  simp only [hterm]
  rw [Finset.sum_ite_eq]
  rw [if_pos (Finset.mem_range.mpr (by have := hD z; omega))]

/-- **Lemma 12.1, (i) ⇒ (ii), spanning half.**  If the trivial `T(x)`-module is
thin and `Eᵢ*(x)δ` is a multiple of the `i`-th sphere sum for every `i`, then the
trivial module is spanned by the sphere sums: every `w ∈ T(x)x̂` decomposes as
`∑ᵢ Eᵢ*(x)w`, each `Eᵢ*(x)w` lies in the thin line `Eᵢ*(x)T(x)x̂`, and that line
is generated by the nonzero vector `Eᵢ*(x)δ = cᵢ Sᵢ`. -/
theorem trivialModule_le_sphereSpan_perron {G : SimpleGraph X} {x : X} {θ : ℝ} {δ : X → ℝ}
    (hδpos : ∀ y, 0 < δ y)
    (hδeig : adj (𝕜 := ℝ) G *ᵥ δ = θ • δ)
    (hδuniq : ∀ u : X → ℝ, adj (𝕜 := ℝ) G *ᵥ u = θ • u → ∃ c : ℝ, u = c • δ)
    (hthin : ThinModule (𝕜 := ℝ) G x (trivialModule (𝕜 := ℝ) G x))
    (hsub : ∀ i : ℕ, ∃ c : ℝ, subconst (𝕜 := ℝ) G x i *ᵥ δ = c • sphereSum (𝕜 := ℝ) G x i) :
    trivialModule (𝕜 := ℝ) G x ≤ sphereSpan (𝕜 := ℝ) G x := by
  intro w hw
  have hD : ∀ y, G.dist x y ≤ Finset.univ.sup (fun y => G.dist x y) :=
    fun y => Finset.le_sup (Finset.mem_univ y)
  rw [mulVec_sum_subconst G x w _ hD]
  refine Submodule.sum_mem _ (fun i _ => ?_)
  have hmem : subconst (𝕜 := ℝ) G x i *ᵥ w
      ∈ subconstImage (𝕜 := ℝ) G x i (trivialModule (𝕜 := ℝ) G x) :=
    mem_matImage.2 ⟨w, hw, rfl⟩
  by_cases hne : (sphere G x i).Nonempty
  · -- the sphere is nonempty: `Eᵢ*(x)δ` is a nonzero vector of the thin line
    obtain ⟨y₀, hy₀⟩ := hne
    have hdy₀ : G.dist x y₀ = i := (mem_sphere_iff G x y₀ i).mp hy₀
    have he_mem : subconst (𝕜 := ℝ) G x i *ᵥ δ
        ∈ subconstImage (𝕜 := ℝ) G x i (trivialModule (𝕜 := ℝ) G x) :=
      mem_matImage.2 ⟨δ, perron_mem_trivialModule hδpos hδeig hδuniq, rfl⟩
    have he_ne : subconst (𝕜 := ℝ) G x i *ᵥ δ ≠ 0 := by
      intro h0
      have h1 := congrFun h0 y₀
      rw [subconst_mulVec_apply, Pi.zero_apply, if_pos hdy₀, one_mul] at h1
      exact (hδpos y₀).ne' h1
    -- thinness: the line through `Eᵢ*(x)δ` is all of `Eᵢ*(x)T(x)x̂`
    have hline : ∃ a : ℝ,
        subconst (𝕜 := ℝ) G x i *ᵥ w = a • (subconst (𝕜 := ℝ) G x i *ᵥ δ) := by
      have h1 : Submodule.span ℝ ({subconst (𝕜 := ℝ) G x i *ᵥ δ} : Set (X → ℝ))
          = subconstImage (𝕜 := ℝ) G x i (trivialModule (𝕜 := ℝ) G x) := by
        refine Submodule.eq_of_le_of_finrank_le ?_ ?_
        · rw [Submodule.span_le]
          exact Set.singleton_subset_iff.2 he_mem
        · rw [finrank_span_singleton he_ne]
          exact hthin i
      have h2 : subconst (𝕜 := ℝ) G x i *ᵥ w
          ∈ Submodule.span ℝ ({subconst (𝕜 := ℝ) G x i *ᵥ δ} : Set (X → ℝ)) := by
        rw [h1]; exact hmem
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.1 h2
      exact ⟨a, ha.symm⟩
    obtain ⟨a, ha⟩ := hline
    obtain ⟨c, hc⟩ := hsub i
    have hEq : subconst (𝕜 := ℝ) G x i *ᵥ w
        = (a * c) • sphereSum (𝕜 := ℝ) G x i := by
      rw [ha, hc, smul_smul]
    rw [hEq]
    exact (span_singleton_sphereSum_le G x i)
      (Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton _)))
  · -- the sphere is empty: `Eᵢ*(x) w = 0`
    have hz : subconst (𝕜 := ℝ) G x i *ᵥ w = 0 := by
      funext z
      rw [subconst_mulVec_apply, Pi.zero_apply]
      have hzi : ¬ G.dist x z = i := fun h => hne ⟨z, (mem_sphere_iff G x z i).mpr h⟩
      rw [if_neg hzi, zero_mul]
    rw [hz]
    exact Submodule.zero_mem _

/-! ## Lemma 12.1 (ii) ⇒ (iii): stability of the sphere span gives distance-regularity

If `A *ᵥ Sᵢ(x)` lies in the span of the sphere sums for every `i`, then it is
constant on the spheres around `x` (every sphere sum is, and the property is
preserved under linear combinations).  But its value at `z` counts the neighbours
of `z` in the `i`-th sphere around `x` (`adj_mulVec_sphereSum_apply`), so the
intersection numbers `cⱼ`, `aⱼ`, `bⱼ` depend only on the sphere of the vertex,
which is distance-regularity with respect to `x`. -/

/-- A vector of the standard module is constant on the spheres around `x`. -/
def ConstantOnSpheres (G : SimpleGraph X) (x : X) (v : X → ℝ) : Prop :=
  ∀ y z : X, G.dist x y = G.dist x z → v y = v z

theorem sphereSum_constantOnSpheres (G : SimpleGraph X) (x : X) (i : ℕ) :
    ConstantOnSpheres G x (sphereSum (𝕜 := ℝ) G x i) := by
  intro y z h
  simp only [sphereSum_apply, h]

theorem mem_sphereSpan_constantOnSpheres {G : SimpleGraph X} {x : X} {v : X → ℝ}
    (hv : v ∈ sphereSpan (𝕜 := ℝ) G x) : ConstantOnSpheres G x v := by
  induction hv using Submodule.span_induction with
  | mem w hw =>
      obtain ⟨i, rfl⟩ := hw
      exact sphereSum_constantOnSpheres G x i
  | zero => intro y z _; rfl
  | add u v _ _ hu hv =>
      intro y z h
      simp only [Pi.add_apply, hu y z h, hv y z h]
  | smul c u _ hu =>
      intro y z h
      simp only [Pi.smul_apply, hu y z h]

/-- **Lemma 12.1 (ii) ⇒ (iii).**  If `A` maps every sphere sum into the span of
the sphere sums around `x`, then `Γ` is distance-regular with respect to `x`. -/
theorem isDistanceRegularAt_of_adj_mem_sphereSpan {G : SimpleGraph X} {x : X}
    (h : ∀ i : ℕ, adj (𝕜 := ℝ) G *ᵥ sphereSum (𝕜 := ℝ) G x i ∈ sphereSpan (𝕜 := ℝ) G x) :
    IsDistanceRegularAt G x := by
  -- `A Sᵢ` is constant on the spheres around `x`
  have hconst : ∀ (i : ℕ) (y y' : X), G.dist x y = G.dist x y' →
      (adj (𝕜 := ℝ) G *ᵥ sphereSum (𝕜 := ℝ) G x i) y
        = (adj (𝕜 := ℝ) G *ᵥ sphereSum (𝕜 := ℝ) G x i) y' :=
    fun i => mem_sphereSpan_constantOnSpheres (G := G) (x := x) (h i)
  -- therefore the number of neighbours of `y` in the `i`-th sphere is sphere-constant
  have hcard : ∀ (i : ℕ) (y y' : X), G.dist x y = G.dist x y' →
      (Finset.univ.filter fun t => G.Adj y t ∧ G.dist x t = i).card
        = (Finset.univ.filter fun t => G.Adj y' t ∧ G.dist x t = i).card := by
    intro i y y' hyy
    have h1 := hconst i y y' hyy
    rw [adj_mulVec_sphereSum_apply (𝕜 := ℝ) (G := G) (x := x) (z := y),
      adj_mulVec_sphereSum_apply (𝕜 := ℝ) (G := G) (x := x) (z := y')] at h1
    exact Nat.cast_injective h1
  intro i y y' hy hy'
  have hyy : G.dist x y = G.dist x y' := by rw [hy, hy']
  have hc0 : ∀ z : X, cnum G x z 0 = 0 := by
    intro z
    rw [cnum, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
    rintro t - ⟨h1, -⟩
    omega
  refine ⟨?_, ?_, ?_⟩
  · intro j
    cases j with
    | zero => rw [hc0 y, hc0 y']
    | succ k =>
        have hck := hcard k y y' hyy
        rwa [filter_card_eq_cnum (G := G) (x := x) (z := y) (i := k),
          filter_card_eq_cnum (G := G) (x := x) (z := y') (i := k)] at hck
  · intro j
    have haj := hcard j y y' hyy
    rwa [filter_card_eq_anum (G := G) (x := x) (z := y) (i := j),
      filter_card_eq_anum (G := G) (x := x) (z := y') (i := j)] at haj
  · intro j
    have hbj := hcard (j + 1) y y' hyy
    rw [filter_card_eq_bnum (G := G) (x := x) (z := y) (i := j + 1) (by omega),
      filter_card_eq_bnum (G := G) (x := x) (z := y') (i := j + 1) (by omega)] at hbj
    simpa using hbj

/-- **Lemma 12.1 (ii) ⇒ (iii), globally.**  If the sphere sums span the trivial
module at every vertex, then `Γ` is distance-regular. -/
theorem isDistanceRegular_of_sphereSpan_eq {G : SimpleGraph X} (hG : G.Connected)
    (h : ∀ x : X, sphereSpan (𝕜 := ℝ) G x = trivialModule (𝕜 := ℝ) G x) :
    IsDistanceRegular G := by
  intro x
  apply isDistanceRegularAt_of_adj_mem_sphereSpan (G := G) (x := x)
  intro i
  have hS : sphereSum (𝕜 := ℝ) G x i ∈ sphereSpan (𝕜 := ℝ) G x :=
    sphereSum_mem_sphereSpan G x i
  rw [h x] at hS
  have hstab := isStable_trivialModule (𝕜 := ℝ) G x (adj (𝕜 := ℝ) G)
    (adj_mem_subconstituentAlgebra G x) (sphereSum (𝕜 := ℝ) G x i) hS
  rwa [← h x] at hstab

/-! ## Lemma 12.1, final packaging (Section F)

Assembly of the two implications Lemma 12.1 (i) ⇔ (ii) and (ii) ⇔ (iii) from
the pieces proved in the earlier sections:

* `perron_const_on_neighbors` and `subconst_mulVec_perron` produce, for Perron
  data `(θ, δ)` and every vertex `x`, scalars `cᵢ` with `Eᵢ*(x)δ = cᵢ Sᵢ(x)`;
* `sphereSpan_le_trivialModule_perron` and `trivialModule_le_sphereSpan_perron`
  then identify the sphere span with the trivial module when the latter is thin
  at `x`;
* `isDistanceRegular_of_sphereSpan_eq` is the (ii) ⇒ (iii) direction, and the
  (iii) ⇒ (ii) direction goes through (iii) ⇒ (i) (`trivialModule_thin_of_distanceRegular`)
  and (i) ⇒ (ii). -/

/-- **Lemma 12.1, (i) ⇒ (ii), the sphere span is the trivial module.**  If the
trivial `T(w)`-module is thin at every vertex `w`, then for every `x` the sphere
sums `Sᵢ(x)` span the trivial `T(x)`-module `T(x)x̂`.

Proof: take Perron data `(θ, δ)`.  Thinness at `w` makes `δ` constant on the
neighbourhood of `w` (`perron_const_on_neighbors`), so `Eᵢ*(x)δ` is a multiple
of `Sᵢ(x)` for every `i` (`subconst_mulVec_perron`).  Those multiples of `Sᵢ(x)`
all lie in the trivial module, so the sphere span is contained in it; conversely
each `Eᵢ*(x)W` is at most one-dimensional by thinness and `Eᵢ*(x)δ ≠ 0` is a
multiple of `Sᵢ(x)`, so the sphere sums are recovered from the trivial module.
-/
theorem sphereSpan_eq_trivialModule_of_thin {G : SimpleGraph X} (hG : G.Connected)
    (hcard : 2 ≤ Fintype.card X)
    (hthin : ∀ w : X, ThinModule (𝕜 := ℝ) G w (trivialModule (𝕜 := ℝ) G w)) (x : X) :
    sphereSpan (𝕜 := ℝ) G x = trivialModule (𝕜 := ℝ) G x := by
  obtain ⟨θ, δ, -, hδpos, hδeig, hδuniq⟩ := exists_perron_data hG hcard
  have hconst : ∀ w y z : X, G.Adj w y → G.Adj w z → δ y = δ z :=
    fun w y z hy hz => perron_const_on_neighbors hG hcard hthin hδpos hδeig hδuniq hy hz
  have hsub : ∀ i : ℕ,
      ∃ c : ℝ, subconst (𝕜 := ℝ) G x i *ᵥ δ = c • sphereSum (𝕜 := ℝ) G x i :=
    fun i => subconst_mulVec_perron hG hconst x i
  exact le_antisymm (sphereSpan_le_trivialModule_perron hδpos hδeig hδuniq hsub)
    (trivialModule_le_sphereSpan_perron hδpos hδeig hδuniq (hthin x) hsub)

/-- **Lemma 12.1, (i) ⇔ (ii).**  For a connected graph with at least two
vertices, thinness of the trivial module at every vertex is equivalent to the
sphere sums spanning the trivial module at every vertex. -/
theorem lemma12_1_i_iff_ii {G : SimpleGraph X} (hG : G.Connected) (hcard : 2 ≤ Fintype.card X) :
    (∀ w : X, ThinModule (𝕜 := ℝ) G w (trivialModule (𝕜 := ℝ) G w)) ↔
      ∀ x : X, sphereSpan (𝕜 := ℝ) G x = trivialModule (𝕜 := ℝ) G x := by
  constructor
  · intro hthin x
    exact sphereSpan_eq_trivialModule_of_thin hG hcard hthin x
  · intro h
    have hdr : IsDistanceRegular G := isDistanceRegular_of_sphereSpan_eq hG h
    exact trivialModule_thin_of_distanceRegular (𝕜 := ℝ) hG hdr

/-- **Lemma 12.1, (i) ⇔ (ii) ⇔ (iii).**  For a connected graph with at least two
vertices, the trivial module being thin at every vertex, the sphere sums spanning
the trivial module at every vertex, and distance-regularity are equivalent. -/
theorem lemma12_1_iff {G : SimpleGraph X} (hG : G.Connected) (hcard : 2 ≤ Fintype.card X) :
    ((∀ w : X, ThinModule (𝕜 := ℝ) G w (trivialModule (𝕜 := ℝ) G w)) ↔
      ∀ x : X, sphereSpan (𝕜 := ℝ) G x = trivialModule (𝕜 := ℝ) G x) ∧
    ((∀ x : X, sphereSpan (𝕜 := ℝ) G x = trivialModule (𝕜 := ℝ) G x) ↔ IsDistanceRegular G) := by
  refine ⟨lemma12_1_i_iff_ii hG hcard, ⟨?_, ?_⟩⟩
  · intro h
    exact isDistanceRegular_of_sphereSpan_eq hG h
  · intro hdr
    exact fun x => sphereSpan_eq_trivialModule_of_thin hG hcard
      (trivialModule_thin_of_distanceRegular (𝕜 := ℝ) hG hdr) x


end Terwilliger
